---
interface Props {
  className?: string;
}

const { className = "" } = Astro.props;
---

<div class={`form-actions ${className}`}>
  <slot />
</div>

<style>
.form-actions {
  display: flex;
  gap: var(--gap-lg);
  justify-content: flex-end;
  align-items: center;
  padding-top: var(--spacing-2xl);
}

.form-actions > * {
  text-decoration: none;
}

@media (max-width: 640px) {
  .form-actions {
    flex-direction: column-reverse;
    align-items: stretch;
  }
}
</style>
