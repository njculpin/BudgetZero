---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'select'> & {
  name: string;
  error?: boolean;
};

const { name, id, error = false, class: className, ...rest } = Astro.props;
import './select.css';
---

<select
  name={name}
  id={id || name}
  class:list={['select', error && 'select--error', className]}
  {...rest}
>
  <slot />
</select>
