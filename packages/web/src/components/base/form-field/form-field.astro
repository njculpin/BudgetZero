---
interface Props {
  label: string;
  name: string;
  required?: boolean;
  error?: string;
  helpText?: string;
  /** Label beside the control rather than above it, for toolbar controls. */
  inline?: boolean;
  class?: string;
}

const {
  label,
  name,
  required = false,
  error,
  helpText,
  inline = false,
  class: className,
} = Astro.props;
import './form-field.css';
---

<div class:list={['form-field', inline && 'form-field--inline', className]}>
  <label for={name} class="form-field__label">
    {label}
    {required && <span class="form-field__required">*</span>}
  </label>
  <slot />
  {error && (
    <p class="form-field__error" role="alert">
      {error}
    </p>
  )}
  {!error && helpText && <p class="form-field__help">{helpText}</p>}
</div>
