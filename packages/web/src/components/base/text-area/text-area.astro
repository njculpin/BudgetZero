---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'textarea'> & {
  name: string;
  error?: boolean;
};

const { name, id, rows = 4, error = false, class: className, ...rest } = Astro.props;
import './text-area.css';
---

<textarea
  name={name}
  id={id || name}
  rows={rows}
  class:list={['textarea', error && 'textarea--error', className]}
  {...rest}
></textarea>
