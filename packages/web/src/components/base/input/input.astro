---
import type { HTMLAttributes } from 'astro/types';

/**
 * A text input.
 *
 * Extends the element's own attributes rather than listing a handful of them:
 * the payouts form needed `step` and `min`, which the previous fixed prop list
 * did not offer, so it hand-rolled an `<input>` and a second `.form-field`
 * block that collided with this one.
 */
type Props = HTMLAttributes<'input'> & {
  name: string;
  error?: boolean;
  /** A fixed symbol shown inside the field, e.g. a currency sign. */
  prefix?: string;
};

const { name, id, error = false, prefix, class: className, ...rest } = Astro.props;
const input = { name, id: id || name, ...rest };
import './input.css';
---

{prefix ? (
  <div class="input-group">
    <span class="input-group__prefix" aria-hidden="true">
      {prefix}
    </span>
    <input
      class:list={['input', 'input--prefixed', error && 'input--error', className]}
      {...input}
    />
  </div>
) : (
  <input class:list={['input', error && 'input--error', className]} {...input} />
)}
