---
interface Props {
  handle: string;
  name: string;
  bio?: string;
  avatarUrl?: string;
  tags: string[];
}

const { handle, name, bio, avatarUrl, tags } = Astro.props;
const displayAvatar = avatarUrl || 'https://placehold.co/400x400?text=' + encodeURIComponent(name);
---

<a href={`/users/${handle}`} class="creator-card">
  <div class="creator-card__avatar-wrapper">
    <img
      src={displayAvatar}
      alt={name}
      class="creator-card__avatar"
    />
  </div>
  <div class="creator-card__content">
    <h3 class="creator-card__name">{name}</h3>
    <p class="creator-card__handle">@{handle}</p>
    {bio && (
      <p class="creator-card__bio">
        {bio.length > 120 ? bio.substring(0, 120) + '...' : bio}
      </p>
    )}
    {tags.length > 0 && (
      <div class="creator-card__tags">
        {tags.map((tag) => (
          <span class="creator-card__tag">{tag}</span>
        ))}
      </div>
    )}
  </div>
</a>

<style>
  .creator-card {
    display: flex;
    flex-direction: column;
    gap: var(--gap-lg);
    padding: var(--spacing-2xl);
    background-color: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all var(--duration-normal) var(--ease-in-out);
  }

  .creator-card:hover {
    border-color: var(--primary);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .creator-card__avatar-wrapper {
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius-full);
    background-color: var(--muted);
  }

  .creator-card__avatar {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .creator-card__content {
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm);
  }

  .creator-card__name {
    margin: 0;
    font-size: var(--text-lg);
    font-weight: var(--font-weight-bold);
    color: var(--foreground);
  }

  .creator-card__handle {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--muted-foreground);
  }

  .creator-card__bio {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--foreground);
    line-height: var(--leading-relaxed);
  }

  .creator-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-xs);
    margin-top: var(--spacing-xs);
  }

  .creator-card__tag {
    display: inline-block;
    padding: var(--spacing-xxs) var(--spacing-sm);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    color: var(--primary);
    background-color: oklch(from var(--primary) l c h / 0.1);
    border: 1px solid var(--primary);
    border-radius: var(--radius-full);
  }
</style>
