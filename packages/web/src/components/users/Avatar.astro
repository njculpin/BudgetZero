---
/**
 * Avatar Component
 *
 * Displays user profile images with fallback to initials.
 * Used across: ProductReview, User cards, Contributor lists
 *
 * @example
 * <Avatar
 *   src={user.avatar_url}
 *   alt={user.name}
 *   size="md"
 * />
 */

export interface Props {
  src?: string | null;
  alt: string;
  size?: 'xs' | 'sm' | 'md' | 'lg' | 'xl';
  fallbackText?: string;
}

const { src, alt, size = 'md', fallbackText } = Astro.props;

// Generate initials from alt text if no fallbackText provided
const getInitials = (text: string): string => {
  return text
    .split(' ')
    .map(word => word[0])
    .join('')
    .toUpperCase()
    .slice(0, 2);
};

const initials = fallbackText || getInitials(alt);
---

<div class={`avatar avatar--${size}`}>
  {src ? (
    <img src={src} alt={alt} class="avatar__image" />
  ) : (
    <span class="avatar__fallback">{initials}</span>
  )}
</div>

<style>
/* Block: Avatar */
.avatar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-full);
  background-color: var(--primary);
  color: var(--primary-foreground);
  font-weight: var(--font-weight-bold);
  overflow: hidden;
  flex-shrink: 0;
}

/* Size Modifiers */
.avatar--xs {
  width: 1.5rem;
  height: 1.5rem;
  font-size: var(--text-xs);
}

.avatar--sm {
  width: 2rem;
  height: 2rem;
  font-size: var(--text-xs);
}

.avatar--md {
  width: 2.5rem;
  height: 2.5rem;
  font-size: var(--text-base);
}

.avatar--lg {
  width: 3rem;
  height: 3rem;
  font-size: var(--text-lg);
}

.avatar--xl {
  width: 4rem;
  height: 4rem;
  font-size: var(--text-xl);
}

/* Element: Image */
.avatar__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* Element: Fallback (initials) */
.avatar__fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}
</style>
