---
/**
 * The heading block at the top of a page.
 *
 * Three pages hand-rolled this markup rather than using the component, and the
 * reason was the same in each case: they needed an action button or a line of
 * metadata, and the component only accepted a title and a description. The
 * answer to that is slots, not a fourth copy of the markup.
 *
 * `--with-action` is gone: a page used to wrap this component in a div carrying
 * that class to lay a button out beside it, which meant the layout lived at the
 * call site while the heading lived here.
 */
interface Props {
  title: string;
  description?: string;
  /**
   * Keep the h1 in the document outline but out of the design. The landing
   * page is a set of product grids with no visible page title, and without
   * this it had no h1 at all — the outline started at h2.
   */
  titleHidden?: boolean;
}

const { title, description, titleHidden = false } = Astro.props;
const hasActions = Astro.slots.has('actions');
// A leading image: the avatar on a public profile, which had its own copy of
// this whole block because the component had nowhere to put one.
const hasMedia = Astro.slots.has('media');
import './page-header.css';
---

<div class="page-header">
  {hasMedia && (
    <div class="page-header__media">
      <slot name="media" />
    </div>
  )}
  <div class="page-header__content">
    <h1 class:list={[titleHidden ? 'sr-only' : 'page-header__title']}>{title}</h1>
    {description && <p class="page-header__description">{description}</p>}
    <slot name="meta" />
  </div>
  {hasActions && (
    <div class="page-header__actions">
      <slot name="actions" />
    </div>
  )}
</div>
