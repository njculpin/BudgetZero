---
import Button from '@/components/button/button.astro';
import { BellIcon, ShoppingCartIcon } from '@/assets/svgs';
import NavigationMobile from '@/components/interactive/navigation-mobile/navigation-mobile';
import NavigationUserMenu from '@/components/interactive/navigation-user-menu/navigation-user-menu';
import { setSession } from '@gameloopers/core/auth';
import { getUserById } from '@gameloopers/core/data-access/users';
import {
  getRecentProducts,
  getUserProducts,
  type ProductSummary,
} from '@gameloopers/core/data-access/products';
import { getUnreadNotificationCount } from '@gameloopers/core/data-access/notifications';

// Check authentication via cookies
let isAuthenticated = false;
let userId: string | null;
let userHandle = '';
let recentProducts: ProductSummary[] = [];
let totalProductCount = 0;
let unreadNotificationCount = 0;

const accessToken = Astro.cookies.get('sb-access-token');
const refreshToken = Astro.cookies.get('sb-refresh-token');

if (accessToken && refreshToken) {
  try {
    const session = await setSession({
      refresh_token: refreshToken.value,
      access_token: accessToken.value,
    });
    if (!session.error && session.data.user) {
      isAuthenticated = true;
      userId = session.data.user.id;

      // Fetch user to get handle
      const user = await getUserById(userId);
      if (user) {
        userHandle = user.handle;
      }

      // Fetch recent products for navigation dropdown
      recentProducts = await getRecentProducts(userId, 3);
      const allProducts = await getUserProducts(userId);
      totalProductCount = allProducts.length;

      // Fetch unread notification count for badge
      unreadNotificationCount = await getUnreadNotificationCount(userId);
    }
  } catch {
    // User not authenticated
  }
}

// Kickstarter-style navigation structure
const userMenuLinks = [
  { href: `/users/${userHandle}`, label: 'Profile' },
  { isDivider: true, label: '' },
  { href: '/purchases', label: 'Purchases' },
  { isDivider: true, label: '' },
  { href: '/settings', label: 'Settings' },
  { isSignOut: true, label: 'Sign out' },
];

// Mobile navigation links
const authedLinks = [
  { href: '/products', label: 'Products' },
  { href: '/cart', label: 'Cart' },
  { href: `/users/${userHandle}`, label: 'Profile' },
  { href: '/purchases', label: 'Purchases' },
  { href: '/settings', label: 'Settings' },
];

const unAuthedLinks = [
  { href: '/products', label: 'Products' },
  { href: '/about', label: 'About' },
];
import './navigation.css';
---

<nav class="navigation" role="navigation" aria-label="Main navigation">
  <div class="navigation__container">
    <a href="/" class="navigation__brand">
      <span class="navigation__logo">Game Loopers</span>
    </a>

    {/* Mobile Navigation */}
    <div class="navigation__mobile">
      <NavigationMobile
        client:load
        isAuthenticated={isAuthenticated}
        links={isAuthenticated ? authedLinks : unAuthedLinks}
      />
    </div>

    {/* Main Navigation Links */}
    <div class="navigation__menu">
      <a href="/products" class="navigation__link">
        Products
      </a>
      <a href="/users" class="navigation__link">
        Creators
      </a>
      <a href="/tags" class="navigation__link">
        Tags
      </a>
    </div>

    <div class="navigation__actions">
      {isAuthenticated ? (
        <>
          <a href="/cart" class="navigation__cart">
            <ShoppingCartIcon width={20} height={20} aria-hidden="true" />
            <span class="sr-only">Shopping cart</span>
          </a>
          <a href="/notifications" class="navigation__notifications">
            <BellIcon
              class="navigation__notifications-icon"
              width={20}
              height={20}
              aria-hidden="true"
            />
            {unreadNotificationCount > 0 && (
              <span class="navigation__notifications-badge">
                {unreadNotificationCount}
              </span>
            )}
            <span class="sr-only">
              Notifications{' '}
              {unreadNotificationCount > 0 ? `(${unreadNotificationCount} unread)` : ''}
            </span>
          </a>
          <NavigationUserMenu
            client:load
            userHandle={userHandle}
            links={userMenuLinks}
            recentProducts={recentProducts}
            totalProductCount={totalProductCount}
          />
        </>
      ) : (
        <>
          <Button href="/sign-in" variant="ghost" size="sm">
            <span slot="text">Sign in</span>
          </Button>
          <Button href="/sign-up" variant="primary" size="sm">
            <span slot="text">Start Creating</span>
          </Button>
        </>
      )}
    </div>
  </div>
</nav>
