---
import {
  BellIcon,
  DownloadIcon,
  FileTextIcon,
  ImageIcon,
  PackageIcon,
  SearchIcon,
  ShoppingCartIcon,
  TagIcon,
} from '@/assets/svgs';

interface Props {
  icon:
    | 'cart'
    | 'products'
    | 'assets'
    | 'documents'
    | 'purchases'
    | 'search'
    | 'tags'
    | 'notifications';
  title: string;
  description: string;
  actionText?: string;
  actionHref?: string;
}

const { icon, title, description, actionText, actionHref } = Astro.props;

/**
 * The icons live in assets/svgs and are shared with the rest of the app; this
 * block used to be eight `<svg>` strings pasted into a map, and the bell in it
 * had drifted to a different stroke width from the bell on the notifications
 * page.
 */
const ICONS = {
  cart: ShoppingCartIcon,
  products: PackageIcon,
  assets: ImageIcon,
  documents: FileTextIcon,
  purchases: DownloadIcon,
  notifications: BellIcon,
  tags: TagIcon,
  search: SearchIcon,
};

const Icon = ICONS[icon];

import './empty-state.css';
---

<div class="empty-state">
  <div class="empty-state__icon" aria-hidden="true">
    <Icon width={64} height={64} stroke-width={1.5} />
  </div>
  {/* h2, not h3: every page that renders this has an h1 and nothing between,
      so an h3 left the outline skipping a level. */}
  <h2 class="empty-state__title">{title}</h2>
  <p class="empty-state__description">{description}</p>
  {actionText && actionHref && (
    <div class="empty-state__action">
      <a href={actionHref} class="empty-state__button">
        {actionText}
      </a>
    </div>
  )}
  {/* For actions that are not a link — a form submit, say. Pages were
      hand-rolling the whole component to get one, which meant duplicating the
      markup without the scoped styles that make it look like anything. */}
  {Astro.slots.has('action') && (
    <div class="empty-state__action">
      <slot name="action" />
    </div>
  )}
</div>
