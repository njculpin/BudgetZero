---
export interface ProductImage {
  url: string;
  alt?: string;
}

export interface Props {
  images: ProductImage[];
}

const { images } = Astro.props;

if (images.length === 0) {
  return null;
}

const featuredImage = images[0];
const thumbnailImages = images.slice(1);
import './product-image-gallery.css';
---

<div class="product-image-gallery">
  <!-- Featured Image -->
  <div class="product-image-gallery__featured">
    <img
      src={featuredImage.url}
      alt={featuredImage.alt || 'Product image'}
      class="product-image-gallery__featured-img"
      loading="eager"
    />
  </div>

  <!-- Thumbnail Images -->
  {thumbnailImages.length > 0 && (
    <div class="product-image-gallery__thumbnails">
      {thumbnailImages.map((img) => (
        <div class="product-image-gallery__thumbnail">
          <img
            src={img.url}
            alt={img.alt || 'Product image'}
            class="product-image-gallery__thumbnail-img"
            loading="lazy"
          />
        </div>
      ))}
    </div>
  )}
</div>
