---
import Button from '@/components/button/button.astro';

/**
 * The site footer.
 *
 * There were two of these: this one and `users/profile-footer`, a copy that
 * differed in its links, one word of copy and one padding value. The links are
 * now a slot and the padding a modifier, so the public profile layout uses this
 * component rather than a second copy of it.
 */
interface Props {
  /** Rendered as "{label} @ {year}". */
  label?: string;
  /** The profile layout sits on a shorter page and wants less footer. */
  compact?: boolean;
}

const { label = 'Game Loopers', compact = false } = Astro.props;
const year = new Date().getFullYear();
import './footer.css';
---

<footer class:list={['footer', compact && 'footer--compact']} role="contentinfo">
  <div class="footer__content">
    <a href="/" class="footer__copyright">
      <p class="footer__copyright-label">
        {label} @ {year}
      </p>
    </a>
    <div class="footer__links">
      <slot>
        <Button href="/privacy" variant="ghost-secondary" size="sm">
          <span slot="text">Privacy Policy</span>
        </Button>
        <Button href="/terms" variant="ghost-secondary" size="sm">
          <span slot="text">Terms of Service</span>
        </Button>
        <Button href="/about" variant="ghost-secondary" size="sm">
          <span slot="text">About</span>
        </Button>
      </slot>
    </div>
  </div>
</footer>
