---
import type { HTMLAttributes } from 'astro/types';

// Props are the element's own attributes, spelled `class` like everywhere else.
type Props = HTMLAttributes<'p'>;

const { class: className, ...rest } = Astro.props;
import './card-description.css';
---

<p class:list={['card__description', className]} {...rest}>
  <slot />
</p>
