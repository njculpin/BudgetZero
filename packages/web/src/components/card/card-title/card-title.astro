---
import type { HTMLAttributes } from 'astro/types';

// Props are the element's own attributes, spelled `class` like everywhere else.
type Props = HTMLAttributes<'h3'>;

const { class: className, ...rest } = Astro.props;
import './card-title.css';
---

<h3 class:list={['card__title', className]} {...rest}>
  <slot />
</h3>
