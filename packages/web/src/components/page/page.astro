---
/**
 * The page shell.
 *
 * Twenty-six of twenty-seven pages opened with the same two wrapper divs —
 * fifty-one of the two hundred and eighty raw `<div>`s in the pages directory.
 * A page should say what it contains, not restate the frame it sits in.
 *
 * Sign-in and sign-up use a narrower container that centres a card, and the
 * checkout outcome pages want a middle width, so those are variants rather
 * than three shells.
 */
interface Props {
  variant?: 'default' | 'auth' | 'narrow';
}

const CONTAINERS = {
  default: 'page__container',
  auth: 'auth-page__container',
  narrow: 'page__container page__container--narrow',
};

const { variant = 'default' } = Astro.props;
const containerClass = CONTAINERS[variant];
import './page.css';
---

<div class="page">
  <div class={containerClass}>
    <slot />
  </div>
</div>
