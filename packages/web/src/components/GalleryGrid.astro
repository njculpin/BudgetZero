---
export interface GalleryImage {
  url: string;
  alt?: string;
  href: string;
}

export interface Props {
  images: GalleryImage[];
  cols?: number;
  borderRadius?: 'square' | 'circle';
}

const { images, cols = 3, borderRadius = 'square' } = Astro.props;

// Generate CSS class for column/row configuration
const gridClass = `gallery--cols-${cols}`;
const radiusClass = borderRadius === 'circle' ? 'gallery__item--circle' : '';
---
<div class={`gallery ${gridClass}`}>
  {images.map((img) => (
    <div class={`gallery__item ${radiusClass}`}>
      <a href={img.href}><img src={img.url} alt={img.alt || ''} class="gallery__image" loading="lazy" /></a>
    </div>
  ))}
</div>

<style>
  .gallery {
    display: grid;
    gap: var(--spacing-3xl);
  }

  /* Column configurations - desktop defaults */
  .gallery--cols-2 {
    grid-template-columns: repeat(2, 1fr);
  }

  .gallery--cols-3 {
    grid-template-columns: repeat(3, 1fr);
  }

  .gallery--cols-5 {
    grid-template-columns: repeat(5, 1fr);
  }

  .gallery--cols-9 {
    grid-template-columns: repeat(9, 1fr);
  }

  .gallery__item {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1; /* Makes squares */
    overflow: hidden;
    border-radius: 0.5rem;
    background-color: #f5f5f5;
  }

  .gallery__item--circle {
    border-radius: var(--radius-full);
  }

  .gallery__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Tablet breakpoint (768px) */
  @media (max-width: 768px) {
    .gallery--cols-5 {
      grid-template-columns: repeat(3, 1fr);
    }

    .gallery--cols-9 {
      grid-template-columns: repeat(6, 1fr);
    }
  }

  /* Mobile breakpoint (480px) */
  @media (max-width: 480px) {
    .gallery {
      gap: var(--spacing-2xl);
    }

    .gallery--cols-2,
    .gallery--cols-3 {
      grid-template-columns: repeat(2, 1fr);
    }

    .gallery--cols-5 {
      grid-template-columns: repeat(2, 1fr);
    }

    .gallery--cols-9 {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
