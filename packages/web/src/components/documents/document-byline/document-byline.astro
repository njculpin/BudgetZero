---
import MetaRow from '@/components/meta-row/meta-row.astro';
import Badge from '@/components/badge/badge.astro';
import './document-byline.css';

/** Who owns a document, and what your relationship to it is. */
interface Props {
  ownerHandle?: string | null;
  ownerName?: string | null;
  canEdit: boolean;
  isOwner: boolean;
}

const { ownerHandle, ownerName, canEdit, isOwner } = Astro.props;
---

<MetaRow>
  {ownerHandle && (
    <span>
      by{' '}
      <a href={`/users/${ownerHandle}`} class="document-byline__author">
        {ownerName}
      </a>
    </span>
  )}
  <Badge variant="draft" size="sm">
    DRAFT
  </Badge>
  {canEdit && (
    <Badge variant="primary" size="sm">
      {isOwner ? 'Owner • Changes auto-save' : 'Collaborator • Changes auto-save'}
    </Badge>
  )}
</MetaRow>
