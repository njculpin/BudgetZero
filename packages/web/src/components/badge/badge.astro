---
interface Props {
  variant:
    | 'draft'
    | 'private'
    | 'public'
    | 'archived'
    | 'primary'
    | 'secondary'
    | 'muted'
    | 'success'
    | 'warning'
    | 'info'
    | 'error';
  size?: 'sm' | 'md' | 'lg';
}

const { variant, size = 'md' } = Astro.props;
import './badge.css';
---

<span class={`badge badge--${variant} badge--${size}`}>
  <slot />
</span>
