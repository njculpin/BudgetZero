---
import type { HTMLAttributes } from 'astro/types';

/**
 * A tag pill.
 *
 * Three pages carried their own: `.product-tag` on the product page,
 * `.browse-tags__tag` on the browse and creators pages, and this component,
 * which nothing used. They differed in element too — a link on two pages, a
 * button on the third — which is why this picks its element from the props
 * rather than being a `<span>` a caller has to wrap.
 */
type Props = HTMLAttributes<'span'> &
  Pick<HTMLAttributes<'a'>, 'href'> & {
    variant?: 'default' | 'primary' | 'removable';
    size?: 'sm' | 'md';
    /** Renders a <button>; the filter lists are click handlers, not links. */
    button?: boolean;
    /** The currently applied filter. */
    active?: boolean;
    /** Shown after the label, e.g. how many products carry the tag. */
    count?: number;
    onRemove?: string;
  };

const {
  variant = 'default',
  size = 'md',
  href,
  button = false,
  active = false,
  count,
  onRemove,
  class: className,
  ...rest
} = Astro.props;

const Tag = href ? 'a' : button ? 'button' : 'span';
const tagProps = href ? { href } : button ? { type: 'button' as const } : {};
import './tag.css';
---

<Tag
  class:list={[
    'tag',
    `tag--${variant}`,
    `tag--${size}`,
    active && 'tag--active',
    (href || button) && 'tag--interactive',
    className,
  ]}
  aria-current={href && active ? 'true' : undefined}
  {...tagProps}
  {...rest}
>
  <slot />
  {count !== undefined && <span class="tag__count">({count})</span>}
  {onRemove && variant === 'removable' && (
    <button type="button" class="tag__remove" onclick={onRemove}>
      ×
    </button>
  )}
</Tag>
