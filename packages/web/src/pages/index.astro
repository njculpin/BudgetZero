---
import Layout from '@/layouts/layout.astro';
import Page from '@/components/page/page.astro';
import PageHeader from '@/components/page-header/page-header.astro';
import Section from '@/components/section/section.astro';
import CardGrid from '@/components/card-grid/card-grid.astro';
import CtaBanner from '@/components/cta-banner/cta-banner.astro';
import Button from '@/components/button/button.astro';
import {
  getAllProducts,
  getProductImages,
  getProductFiles,
  getProductDocuments,
  getProductComponents,
  getProductPriceBreakdown,
} from '@gameloopers/core/data-access/products';
import { getUserById } from '@gameloopers/core/data-access/users';
import ProductCard from '@/components/products/product-card/product-card.astro';

// Fetch products with full details
const allProducts = await getAllProducts();

// Get product cards for sections (with enhanced data)
const getProductCards = async (products: typeof allProducts) => {
  return await Promise.all(
    products.map(async (product) => {
      const images = await getProductImages(product.id);
      const coverImage =
        images.length > 0 ? images.sort((a, b) => a.position - b.position)[0] : null;
      const owner = await getUserById(product.user_id);

      // Get content counts for "What's Included" preview
      const files = await getProductFiles(product.id);
      const documents = await getProductDocuments(product.id);
      const components = await getProductComponents(product.id);
      const prices = await getProductPriceBreakdown(product.id);

      return {
        id: product.id,
        handle: product.handle,
        title: product.title,
        description: product.description?.slice(0, 100) + '...' || '',
        imageUrl:
          coverImage?.file_url ||
          'https://placehold.co/600x400?text=' + encodeURIComponent(product.title),
        ownerName: owner?.name || owner?.handle || 'Creator',
        ownerHandle: owner?.handle || '',
        status: product.status,
        createdAt: product.created_at,
        fileCount: files.length,
        documentCount: documents.length,
        componentCount: components.length,
        prices: prices,
      };
    })
  );
};

const newLaunches = await getProductCards(allProducts.slice(0, 6));
const trending = await getProductCards(allProducts.slice(6, 12));
---

<Layout title="Game Loopers - Bring Creative Projects to Life">
  <Page>
    <PageHeader title="Game Loopers" titleHidden />

    <Section title="New Launches">
      <Button slot="actions" href="/products?sort=newest" variant="link" size="sm">
        <span slot="text">See more</span>
      </Button>
      <CardGrid>
        {newLaunches.map((product, index) => (
          <ProductCard
            handle={product.handle}
            title={product.title}
            creatorName={product.ownerName}
            imageUrl={product.imageUrl}
            priceCents={product.prices.totalPrice}
            loading={index < 3 ? 'eager' : 'lazy'}
          />
        ))}
      </CardGrid>
    </Section>

    <Section title="Trending Now">
      <Button slot="actions" href="/products?sort=popular" variant="link" size="sm">
        <span slot="text">See more</span>
      </Button>
      <CardGrid>
        {trending.map((product) => (
          <ProductCard
            handle={product.handle}
            title={product.title}
            creatorName={product.ownerName}
            imageUrl={product.imageUrl}
            priceCents={product.prices.totalPrice}
          />
        ))}
      </CardGrid>
    </Section>

    <CtaBanner
      title="Ready to bring your game to life?"
      description="Join thousands of creators sharing their tabletop game projects with the community"
    >
      <Button href="/sign-up" variant="primary" size="lg">
        <span slot="text">Start Creating</span>
      </Button>
      <Button href="/products" variant="outline" size="lg">
        <span slot="text">Explore Products</span>
      </Button>
    </CtaBanner>
  </Page>
</Layout>
