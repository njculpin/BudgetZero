---
import Layout from '@/layouts/layout.astro';
import Page from '@/components/page/page.astro';
import Card from '@/components/card/card.astro';
import CardContent from '@/components/card/card-content/card-content.astro';
import PageHeader from '@/components/page-header/page-header.astro';
import CardGrid from '@/components/card-grid/card-grid.astro';
import EmptyState from '@/components/empty-state/empty-state.astro';
import TagCard from '@/components/tag/tag-card/tag-card.astro';
import { getAllTags } from '@gameloopers/core/data-access/tags';

const tags = await getAllTags();
---

<Layout title="Tags - Game Loopers">
  <Page>
    <PageHeader title="Tags" description="Explore products and assets by topic" />

    {tags.length > 0 ? (
      <CardGrid>
        {tags.map((tag) => (
          <TagCard
            value={tag.value}
            count={tag.count}
            productCount={tag.productCount}
            assetCount={tag.assetCount}
          />
        ))}
      </CardGrid>
    ) : (
      <Card>
        <CardContent>
          <EmptyState
            icon="tags"
            title="No tags found"
            description="Tags will appear here as products and assets are created."
          />
        </CardContent>
      </Card>
    )}
  </Page>
</Layout>
