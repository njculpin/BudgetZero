---
import Layout from '@/layouts/layout.astro';
import Page from '@/components/page/page.astro';
import Card from '@/components/card/card.astro';
import CardContent from '@/components/card/card-content/card-content.astro';
import Section from '@/components/section/section.astro';
import CardGrid from '@/components/card-grid/card-grid.astro';
import EmptyState from '@/components/empty-state/empty-state.astro';
import PageHeader from '@/components/page-header/page-header.astro';
import MetaRow from '@/components/meta-row/meta-row.astro';
import Button from '@/components/button/button.astro';
import ProductCard from '@/components/products/product-card/product-card.astro';
import {
  getProductsByTag,
  getProductImages,
  getProductPriceBreakdown,
} from '@gameloopers/core/data-access/products';
import { getUserById } from '@gameloopers/core/data-access/users';

const { tag } = Astro.params;

if (!tag) {
  return Astro.redirect('/tags');
}

// Decode the tag from the URL
const decodedTag = decodeURIComponent(tag);

// Fetch products with this tag
const products = await getProductsByTag(decodedTag);

// Fetch cover images for each product
const productsWithImages = await Promise.all(
  products.map(async (product) => {
    const images = await getProductImages(product.id);
    const coverImage =
      images.length > 0 ? images.sort((a, b) => a.position - b.position)[0] : null;

    // The tag page used to render a fourth copy of the product card that showed
    // neither the creator nor the price, because it never fetched them.
    const owner = await getUserById(product.user_id);
    const prices = await getProductPriceBreakdown(product.id);

    return {
      ...product,
      coverImageUrl: coverImage?.file_url || null,
      ownerName: owner?.name || owner?.handle || 'Creator',
      priceCents: prices.totalPrice,
    };
  })
);

const totalCount = productsWithImages.length;
---

<Layout title={`${decodedTag} - Game Loopers`}>
  <Page>
    <PageHeader title={`#${decodedTag}`}>
      <MetaRow slot="meta">
        <span>
          {totalCount} total {totalCount === 1 ? 'item' : 'items'}
        </span>
        {productsWithImages.length > 0 && (
          <span>
            {productsWithImages.length} product
            {productsWithImages.length !== 1 ? 's' : ''}
          </span>
        )}
      </MetaRow>
    </PageHeader>

    {totalCount > 0 ? (
      <>
        <!-- Products Section -->
        {productsWithImages.length > 0 && (
          <Section title="Products">
            <CardGrid>
              {productsWithImages.map((product, index) => (
                <ProductCard
                  handle={product.handle}
                  title={product.title}
                  creatorName={product.ownerName}
                  imageUrl={product.coverImageUrl}
                  description={product.description}
                  priceCents={product.priceCents}
                  loading={index < 3 ? 'eager' : 'lazy'}
                />
              ))}
            </CardGrid>
          </Section>
        )}
      </>
    ) : (
      <Card>
        <CardContent>
          <EmptyState
            icon="tags"
            title="No items found with this tag"
            description="Nothing has been published under this tag yet."
            actionText="Browse all tags"
            actionHref="/tags"
          />
        </CardContent>
      </Card>
    )}

    <Button href="/tags" variant="link" size="sm">
      <span slot="text">← Back to All Tags</span>
    </Button>
  </Page>
</Layout>
