---
import Layout from '@/layouts/layout.astro';
import { getPageUser } from '@/lib/page-auth';
import Page from '@/components/page/page.astro';
import StatusPanel from '@/components/status-panel/status-panel.astro';
import OrderDownloads from '@/components/checkout/order-downloads/order-downloads.astro';
import Section from '@/components/section/section.astro';
import DetailList from '@/components/detail-list/detail-list.astro';
import DetailRow from '@/components/detail-list/detail-row/detail-row.astro';
import { formatMoney } from '@gameloopers/core/utils/money';
import Badge from '@/components/badge/badge.astro';
import Card from '@/components/card/card.astro';
import CardContent from '@/components/card/card-content/card-content.astro';
import Button from '@/components/button/button.astro';
import { getCheckoutSession } from '@gameloopers/core/payments';
import { getOrCreateCart, clearCart } from '@gameloopers/core/data-access/cart';
import {
  getSaleByStripeChargeId,
  getSaleById,
  getSaleItems,
} from '@gameloopers/core/data-access/sales';
import {
  getProductById,
  getProductFiles,
  getProductDocuments,
  getProductComponents,
} from '@gameloopers/core/data-access/products';
import type { Product, ProductFile } from '@gameloopers/core/types';

const sessionId = Astro.url.searchParams.get('session_id');
const saleId = Astro.url.searchParams.get('sale_id');
const isMockCheckout = Astro.url.searchParams.get('mock') === 'true';

if (!sessionId && !saleId) {
  return Astro.redirect('/cart');
}
const currentUser = await getPageUser(Astro.cookies);

// Handle mock checkout vs Stripe checkout
// Every branch below assigns these before anything reads them, so the
// initialisers were dead. Declared without one, TypeScript's control-flow
// analysis now checks that each path really does assign.
let customerEmail: string | null;
let amountTotal: number;
let currency: string;
let sale: Awaited<ReturnType<typeof getSaleById>>;
let orderId: string;

if (isMockCheckout && saleId) {
  // Mock checkout - fetch sale directly
  sale = await getSaleById(saleId);

  if (!sale) {
    return Astro.redirect('/cart');
  }

  customerEmail = sale.user_email;
  amountTotal = sale.price_cents;
  currency = sale.currency;
  orderId = `mock_${sale.id}`;
} else if (sessionId) {
  // Stripe checkout - retrieve session
  let checkoutSession: Awaited<ReturnType<typeof getCheckoutSession>>;
  try {
    checkoutSession = await getCheckoutSession(sessionId);
  } catch (error) {
    console.error('Error retrieving checkout session:', error);
    return Astro.redirect('/cart');
  }

  customerEmail = checkoutSession.customer_email;
  amountTotal = checkoutSession.amount_total || 0;
  currency = checkoutSession.currency || 'usd';
  orderId = sessionId;

  // Get the sale by Stripe charge ID
  const paymentIntent = (checkoutSession.payment_intent as string) || sessionId;
  sale = await getSaleByStripeChargeId(paymentIntent);
} else {
  return Astro.redirect('/cart');
}

// If user is logged in, clear their cart (only for non-mock or first-time mock).
// The token check that used to be here was redundant: a non-null currentUser
// already means the session verified.
if (currentUser) {
  const cart = await getOrCreateCart(currentUser.id);
  if (cart) {
    await clearCart(cart.id);
  }
}

// Get sale items for download links
const saleItems = sale ? await getSaleItems(sale.id) : [];

// Get product details, files, and documents for each sale item
const purchasedProducts: Array<{
  saleItem: Awaited<ReturnType<typeof getSaleItems>>[number];
  product: Product | null;
  files: Array<ProductFile & { is_document?: boolean; source_product_title?: string }>;
}> = await Promise.all(
  saleItems.map(async (saleItem) => {
    const product = await getProductById(saleItem.product_id);

    // Get files from main product
    const mainProductFiles = product ? await getProductFiles(product.id) : [];

    // Get documents from main product (all will have PDFs generated on purchase)
    const mainProductDocuments = product ? await getProductDocuments(product.id) : [];
    const mainProductDocumentFiles = mainProductDocuments
      .filter((doc) => doc.pdf_url) // Only include documents with PDFs
      .map((doc) => ({
        id: doc.id,
        document_id: doc.document_id,
        title: doc.document?.title || 'Document',
        description: doc.document?.description || '',
        file_url: doc.pdf_url!,
        storage_path: doc.pdf_storage_path || '',
        file_size_bytes: 0,
        mime_type: 'application/pdf',
        position: doc.position,
        price_cents: doc.price_cents,
        product_id: product!.id,
        created_at: doc.created_at,
        updated_at: doc.updated_at,
        deleted: false,
        deleted_at: null,
        source_product_title: product?.title || 'Unknown Product',
        is_document: true,
      }));

    // Get embedded products and their files + documents
    const embeddedProducts = product ? await getProductComponents(product.id) : [];
    const embeddedFilesAndDocs = await Promise.all(
      embeddedProducts.map(async (component) => {
        const childProduct = await getProductById(component.child_product_id);
        const childFiles = childProduct ? await getProductFiles(childProduct.id) : [];
        const childDocuments = childProduct
          ? await getProductDocuments(childProduct.id)
          : [];

        const childDocumentFiles = childDocuments
          .filter((doc) => doc.pdf_url) // Only include documents with PDFs
          .map((doc) => ({
            id: doc.id,
            document_id: doc.document_id,
            title: doc.document?.title || 'Document',
            description: doc.document?.description || '',
            file_url: doc.pdf_url!,
            storage_path: doc.pdf_storage_path || '',
            file_size_bytes: 0,
            mime_type: 'application/pdf',
            position: doc.position,
            price_cents: doc.price_cents,
            product_id: childProduct!.id,
            created_at: doc.created_at,
            updated_at: doc.updated_at,
            deleted: false,
            deleted_at: null,
            source_product_title: childProduct?.title || 'Unknown Product',
            is_document: true,
          }));

        return [
          ...childFiles.map((file) => ({
            ...file,
            source_product_title: childProduct?.title || 'Unknown Product',
            is_document: false,
          })),
          ...childDocumentFiles,
        ];
      })
    );

    // Flatten and combine all files and documents
    const allFiles = [
      ...mainProductFiles.map((file) => ({
        ...file,
        source_product_title: product?.title || 'Unknown Product',
        is_document: false,
      })),
      ...mainProductDocumentFiles,
      ...embeddedFilesAndDocs.flat(),
    ];

    return {
      saleItem,
      product,
      files: allFiles,
    };
  })
);
---

<Layout title="Order Confirmed - Game Loopers">
  <Page variant="narrow">
    <Card>
      <CardContent>
        <StatusPanel
          title="Order Confirmed!"
          description={
            isMockCheckout
              ? 'Mock purchase completed. In production, customers would receive a confirmation email.'
              : "Thank you for your purchase. Your order has been confirmed and you'll receive a confirmation email shortly."
          }
          tone="success"
        >
          <Fragment slot="actions">
            {currentUser ? (
              <>
                <Button href="/purchases" variant="primary" size="lg">
                  <span slot="text">View All My Purchases</span>
                </Button>
                <Button href="/products" variant="outline" size="lg">
                  <span slot="text">Continue Shopping</span>
                </Button>
              </>
            ) : (
              <Button href="/products" variant="primary" size="lg">
                <span slot="text">Continue Shopping</span>
              </Button>
            )}
          </Fragment>

          {isMockCheckout && (
            <Badge variant="warning">Mock Purchase — Development Mode</Badge>
          )}

          <DetailList>
            <DetailRow label="Order ID" mono>
              {orderId}
            </DetailRow>
            {customerEmail && <DetailRow label="Email">{customerEmail}</DetailRow>}
            <DetailRow label="Total">{formatMoney(amountTotal, { currency })}</DetailRow>
          </DetailList>

          {purchasedProducts.length > 0 && (
            <Section
              title="Your Downloads"
              description="Click below to download your purchased files:"
            >
              <OrderDownloads
                products={purchasedProducts
                  .filter(({ product }) => product)
                  .map(({ product, files }) => ({ title: product!.title, files }))}
              />
            </Section>
          )}

          {!isMockCheckout && (
            <Fragment slot="note">
              A confirmation email with your order details and download links has been
              sent to {customerEmail}.
            </Fragment>
          )}
        </StatusPanel>
      </CardContent>
    </Card>
  </Page>
</Layout>
