---
import Layout from '@/layouts/layout.astro';
import Page from '@/components/page/page.astro';
import StatusPanel from '@/components/status-panel/status-panel.astro';
import SupportLink from '@/components/support-link/support-link.astro';
import ErrorCode from '@/components/error-code/error-code.astro';
import Card from '@/components/card/card.astro';
import CardContent from '@/components/card/card-content/card-content.astro';
import Button from '@/components/button/button.astro';
// This page renders the same for everyone, so it resolves no session. It
// previously exchanged the auth cookies with the provider and looked the user
// up, then rendered neither — a network round trip and a query per view, for
// nothing.

// Get error code from query param
const errorCode = Astro.url.searchParams.get('error') || 'unknown';

// Map Stripe error codes to user-friendly messages
const errorMessages: Record<
  string,
  { title: string; description: string; canRetry: boolean }
> = {
  card_declined: {
    title: 'Card Declined',
    description:
      'Your card was declined. Please try a different payment method or contact your bank.',
    canRetry: true,
  },
  insufficient_funds: {
    title: 'Insufficient Funds',
    description:
      'Your card has insufficient funds. Please try a different payment method.',
    canRetry: true,
  },
  expired_card: {
    title: 'Expired Card',
    description: 'Your card has expired. Please use a different payment method.',
    canRetry: true,
  },
  incorrect_cvc: {
    title: 'Incorrect Security Code',
    description:
      'The card security code (CVC) you entered is incorrect. Please try again.',
    canRetry: true,
  },
  processing_error: {
    title: 'Processing Error',
    description: 'There was an error processing your payment. Please try again.',
    canRetry: true,
  },
  cancelled: {
    title: 'Payment Cancelled',
    description: 'You cancelled the payment. Your items are still in your cart.',
    canRetry: true,
  },
  session_expired: {
    title: 'Session Expired',
    description:
      'Your checkout session has expired. Please start checkout again from your cart.',
    canRetry: true,
  },
  unknown: {
    title: 'Payment Failed',
    description: "We couldn't process your payment. Please try again or contact support.",
    canRetry: true,
  },
};

const errorInfo = errorMessages[errorCode] || errorMessages.unknown;
---

<Layout title="Payment Failed - Game Loopers">
  <Page variant="narrow">
    <Card>
      <CardContent>
        <StatusPanel
          title={errorInfo.title}
          description={errorInfo.description}
          tone="error"
        >
          <Fragment slot="actions">
            {errorInfo.canRetry && (
              <Button href="/cart" variant="primary" size="lg">
                <span slot="text">Try Again</span>
              </Button>
            )}
            <Button href="/products" variant="ghost" size="lg">
              <span slot="text">Continue Shopping</span>
            </Button>
          </Fragment>

          <SupportLink />
          <ErrorCode code={errorCode} />
        </StatusPanel>
      </CardContent>
    </Card>
  </Page>
</Layout>
