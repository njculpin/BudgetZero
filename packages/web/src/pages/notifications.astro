---
import Layout from '@/layouts/layout.astro';
import { getPageUser } from '@/lib/page-auth';
import Page from '@/components/page/page.astro';
import Card from '@/components/card/card.astro';
import CardContent from '@/components/card/card-content/card-content.astro';
import PageHeader from '@/components/page-header/page-header.astro';
import EmptyState from '@/components/empty-state/empty-state.astro';
import Button from '@/components/button/button.astro';
import NotificationList from '@/components/notifications/notification-list/notification-list.astro';
import { getNotifications } from '@gameloopers/core/data-access/notifications';

const currentUser = await getPageUser(Astro.cookies);

if (!currentUser) {
  return Astro.redirect('/sign-in');
}

const notifications = await getNotifications(currentUser.id);
const hasUnread = notifications.some((n) => !n.read);
---

<Layout title="Notifications - Game Loopers">
  <Page>
    <PageHeader
      title="Notifications"
      description="Stay updated with your activity and important events"
    >
      {hasUnread && (
        <form slot="actions" action="/api/notifications/mark-all-read" method="post">
          <Button type="submit" variant="outline" size="md">
            <span slot="text">Mark all as read</span>
          </Button>
        </form>
      )}
    </PageHeader>

    {notifications.length > 0 ? (
      <NotificationList notifications={notifications} />
    ) : (
      <Card>
        <CardContent>
          <EmptyState
            icon="notifications"
            title="No notifications yet"
            description="When you receive notifications about your activity, they'll appear here."
          />
        </CardContent>
      </Card>
    )}
  </Page>
</Layout>
