---
import Layout from '@/layouts/layout.astro';
import Page from '@/components/page/page.astro';
import PageHeader from '@/components/page-header/page-header.astro';
import Toolbar from '@/components/toolbar/toolbar.astro';
import SearchField from '@/components/search-field/search-field.astro';
import TagFilter from '@/components/tag-filter/tag-filter.astro';
import Tag from '@/components/tag/tag.astro';
import CardGrid from '@/components/card-grid/card-grid.astro';
import CreatorTile from '@/components/users/creator-tile/creator-tile.astro';
import ResultCount from '@/components/result-count/result-count.astro';
import EmptyState from '@/components/empty-state/empty-state.astro';
import { getCreators } from '@gameloopers/core/data-access/users';

// Get all creators with their tags
const creators = await getCreators({ limit: 100 });

// Get unique tags
const allTags = new Set<string>();
creators.forEach(({ tags }) => {
  tags.forEach((tag) => allTags.add(tag));
});
const tagsList = Array.from(allTags).sort();
---

<Layout title="Creator Directory - Game Loopers">
  <Page>
    <PageHeader
      title="Creator Directory"
      description="Discover talented game designers, illustrators, 3D modelers, and other creators."
    />

    <Toolbar>
      <SearchField
        name="creator-search"
        label="Search creators"
        placeholder="Search creators..."
      />

      {tagsList.length > 0 && (
        <TagFilter label="Filter by tag:">
          <Tag button active data-tag="all">
            All
          </Tag>
          {tagsList.map((tag) => (
            <Tag button data-tag={tag}>
              {tag}
            </Tag>
          ))}
        </TagFilter>
      )}
    </Toolbar>

    <ResultCount
      id="creators-count"
      count={creators.length}
      singular="Creator"
      plural="Creators"
    />

    {creators.length === 0 ? (
      <EmptyState
        icon="products"
        title="No creators found"
        description="Nobody has published a profile yet."
      />
    ) : (
      <CardGrid size="xs" id="creators-grid">
        {creators.map(({ user, tags }) => (
          <CreatorTile
            handle={user.handle}
            name={user.name}
            bio={user.bio}
            avatarUrl={user.avatar_url}
            tags={tags}
          />
        ))}
      </CardGrid>
    )}
  </Page>
</Layout>

<script>
  // Client-side filtering
  const searchInput = document.getElementById('creator-search') as HTMLInputElement;
  const filterTags = document.querySelectorAll('.tag-filter .tag');
  const creatorCards = document.querySelectorAll('.creator-tile');
  const countElement = document.getElementById('creators-count');

  let currentSearch = '';
  let currentTag = 'all';

  function filterCreators() {
    let visibleCount = 0;

    creatorCards.forEach((card) => {
      const element = card as HTMLElement;
      const cardSearch = element.dataset.search || '';
      const cardTags = element.dataset.tags || '';

      const matchesSearch =
        !currentSearch || cardSearch.toLowerCase().includes(currentSearch.toLowerCase());
      const matchesTag = currentTag === 'all' || cardTags.includes(currentTag);

      // Clearing the property lets the stylesheet decide how the card lays
      // out; hard-coding 'flex' here broke when the card became a block.
      element.style.display = matchesSearch && matchesTag ? '' : 'none';
      if (matchesSearch && matchesTag) visibleCount++;
    });

    if (countElement) {
      countElement.textContent = `${visibleCount} ${visibleCount === 1 ? 'Creator' : 'Creators'}`;
    }
  }

  searchInput?.addEventListener('input', (e) => {
    currentSearch = (e.target as HTMLInputElement).value;
    filterCreators();
  });

  filterTags.forEach((tag) => {
    tag.addEventListener('click', () => {
      filterTags.forEach((t) => t.classList.remove('tag--active'));
      tag.classList.add('tag--active');
      currentTag = tag.getAttribute('data-tag') || 'all';
      filterCreators();
    });
  });
</script>
