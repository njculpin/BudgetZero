---
import Layout from '@/layouts/layout.astro';
import { getPageUser } from '@/lib/page-auth';
import Page from '@/components/page/page.astro';
import PageHeader from '@/components/page-header/page-header.astro';
import Section from '@/components/section/section.astro';
import CardGrid from '@/components/card-grid/card-grid.astro';
import EmptyState from '@/components/empty-state/empty-state.astro';
import Button from '@/components/button/button.astro';
import ProfileSummary from '@/components/users/profile-summary/profile-summary.astro';
import ProfileTile from '@/components/users/profile-tile/profile-tile.astro';
import Avatar from '@/components/users/avatar/avatar.astro';
import Card from '@/components/card/card.astro';
import CardContent from '@/components/card/card-content/card-content.astro';
import { getUserByHandle, getUserTags } from '@gameloopers/core/data-access/users';
import {
  getUserProducts,
  getProductImages,
} from '@gameloopers/core/data-access/products';

const { user } = Astro.params;

if (!user) {
  return Astro.redirect('/404');
}

// Fetch the profile user
const profileUser = await getUserByHandle(user);

if (!profileUser) {
  return Astro.redirect('/404');
}
const currentUser = await getPageUser(Astro.cookies);

// Fetch user's products (public only for public profile)
const userProducts = await getUserProducts(profileUser.id);

// Fetch user tags
const userTags = await getUserTags(profileUser.id);

// Check if viewing own profile
const canEdit = currentUser?.id === profileUser.id;

// Filter for public only
const publicProducts = userProducts.filter((product) => product.status === 'public');

// Create product content array with images
type ContentItem = {
  id: string;
  handle: string;
  title: string;
  imageUrl: string;
  createdAt: string;
};

const contentItems: ContentItem[] = await Promise.all(
  publicProducts.map(async (product) => {
    const images = await getProductImages(product.id);
    const coverImage =
      images.length > 0 ? images.sort((a, b) => a.position - b.position)[0] : null;
    return {
      id: product.id,
      handle: product.handle,
      title: product.title,
      imageUrl: coverImage?.file_url || 'https://placehold.co/400x400?text=Product',
      createdAt: product.created_at,
    };
  })
);

// Sort by creation date (newest first)
contentItems.sort(
  (a, b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime()
);
---

<Layout title={`${profileUser.name || profileUser.handle} - Game Loopers`}>
  <Page>
    <Card>
      <CardContent>
        <PageHeader title={profileUser.name || profileUser.handle}>
          <Avatar
            slot="media"
            src={profileUser.avatar_url}
            alt={profileUser.name || profileUser.handle}
            size="2xl"
          />
          {canEdit && (
            <Button slot="actions" href="/settings" variant="outline" size="sm">
              <span slot="text">Edit Profile</span>
            </Button>
          )}
          <ProfileSummary
            slot="meta"
            handle={profileUser.handle}
            bio={profileUser.bio}
            tags={userTags}
            productCount={publicProducts.length}
            memberSince={profileUser.created_at}
          />
        </PageHeader>
      </CardContent>
    </Card>

    <Section title="Products" titleHidden>
      {contentItems.length > 0 ? (
        <CardGrid size="sm">
          {contentItems.map((item) => (
            <ProfileTile
              handle={item.handle}
              title={item.title}
              imageUrl={item.imageUrl}
            />
          ))}
        </CardGrid>
      ) : (
        <Card>
          <CardContent>
            <EmptyState
              icon="products"
              title="No public products yet"
              description={`${profileUser.name || profileUser.handle} has not published anything yet.`}
            />
          </CardContent>
        </Card>
      )}
    </Section>
  </Page>
</Layout>
