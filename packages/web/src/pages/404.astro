---
import Layout from '@/layouts/layout.astro';
import Page from '@/components/page/page.astro';
import Section from '@/components/section/section.astro';
import StatusPanel from '@/components/status-panel/status-panel.astro';
import ButtonGroup from '@/components/button-group/button-group.astro';
import Button from '@/components/button/button.astro';
import DetailList from '@/components/detail-list/detail-list.astro';
import DetailRow from '@/components/detail-list/detail-row/detail-row.astro';
import RequestedPath from '@/components/not-found/requested-path/requested-path.astro';
import RouteSuggestions from '@/components/not-found/route-suggestions/route-suggestions.astro';
import SiteMap from '@/components/not-found/site-map/site-map.astro';
import {
  findSimilarRoutes,
  detectPatternMatch,
} from '@gameloopers/core/utils/fuzzy-route-match';

const requestedPath = Astro.url.pathname;
const similarRoutes = findSimilarRoutes(requestedPath, 5, 3);
const patternMatch = detectPatternMatch(requestedPath);
const hasSuggestions = similarRoutes.length > 0 || patternMatch !== null;
---

<Layout title="Page Not Found - Game Loopers">
  <Page>
    <StatusPanel
      title="404 - Page Not Found"
      description="The page you're looking for doesn't exist or has been moved."
    >
      {requestedPath && <RequestedPath path={requestedPath} />}
    </StatusPanel>

    {hasSuggestions && (
      <Section
        title="Did you mean?"
        description="We found similar routes that might be what you're looking for:"
      >
        <RouteSuggestions patternMatch={patternMatch} fuzzyMatches={similarRoutes} />
      </Section>
    )}

    <Section title="Or explore these sections">
      <ButtonGroup align="center">
        <Button href="/" variant="primary" size="md">
          <span slot="text">Go to Homepage</span>
        </Button>
        <Button href="/products" variant="outline" size="md">
          <span slot="text">Browse Products</span>
        </Button>
        <Button href="/about" variant="ghost" size="md">
          <span slot="text">About Us</span>
        </Button>
      </ButtonGroup>
    </Section>

    <Section title="For AI Assistants & Web Crawlers">
      <DetailList>
        <DetailRow label="Status">HTTP 404 - Resource Not Found</DetailRow>
        <DetailRow label="Site">Game Loopers - Tabletop Game Creator Platform</DetailRow>
        <DetailRow label="Fuzzy Search">
          Levenshtein distance, up to 5 character edits. See "Did you mean?" above.
        </DetailRow>
        {similarRoutes.length > 0 && (
          <DetailRow label="Smart Suggestions">
            Found {similarRoutes.length} similar route
            {similarRoutes.length > 1 ? 's' : ''} by fuzzy matching.
          </DetailRow>
        )}
      </DetailList>

      <SiteMap />
    </Section>
  </Page>
</Layout>
