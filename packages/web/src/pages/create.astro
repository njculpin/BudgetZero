---
import Layout from '@/layouts/layout.astro';
import { getPageUser } from '@/lib/page-auth';
import Page from '@/components/page/page.astro';
import PageHeader from '@/components/page-header/page-header.astro';
import Section from '@/components/section/section.astro';
import CardGrid from '@/components/card-grid/card-grid.astro';
import Button from '@/components/button/button.astro';
import Card from '@/components/card/card.astro';
import CardContent from '@/components/card/card-content/card-content.astro';
import WorkflowStep from '@/components/workflow-step/workflow-step.astro';
import FeatureItem from '@/components/feature-item/feature-item.astro';
import CtaBanner from '@/components/cta-banner/cta-banner.astro';

const isAuthenticated = (await getPageUser(Astro.cookies)) !== null;

const WORKFLOW = [
  {
    title: 'Create Assets',
    body: 'Upload 3D models, illustrations, rulebooks, or documents. Set royalty rates so you earn whenever your work is used.',
  },
  {
    title: 'Build Products',
    body: "Combine your assets (and others') into complete game packages. Set pricing and bundles.",
  },
  {
    title: 'Publish & Earn',
    body: 'Launch your product to the marketplace. Sales automatically split among all contributors based on royalty agreements.',
  },
];

const FEATURES = [
  {
    icon: '💰',
    title: 'Transparent Royalties',
    body: 'Automatic royalty splitting means every contributor gets paid fairly when a product sells.',
  },
  {
    icon: '🤝',
    title: 'Easy Collaboration',
    body: 'Work with designers, artists, and modelers. Build games together with shared ownership.',
  },
  {
    icon: '🛍️',
    title: 'Built-in Storefront',
    body: 'Your products get a beautiful storefront. No need for external payment processors or hosting.',
  },
  {
    icon: '📄',
    title: 'Collaborative Documents',
    body: 'Write rulebooks and reference cards together in real-time. Export as PDFs when ready.',
  },
  {
    icon: '🔒',
    title: 'License Protection',
    body: 'Define usage terms for your assets. Protect your work while enabling collaboration.',
  },
];
---

<Layout title="Start Creating - Game Loopers">
  <Page>
    <PageHeader
      title="Bring Your Tabletop Game to Life"
      description="Join a community of creators who design, collaborate, and sell tabletop games on Game Loopers."
    >
      <Fragment slot="actions">
        {isAuthenticated ? (
          <Button href="/products" variant="primary" size="lg">
            <span slot="text">Go to My Products</span>
          </Button>
        ) : (
          <>
            <Button href="/sign-up" variant="primary" size="lg">
              <span slot="text">Sign Up Free</span>
            </Button>
            <Button href="/sign-in" variant="outline" size="lg">
              <span slot="text">Sign In</span>
            </Button>
          </>
        )}
      </Fragment>
    </PageHeader>

    <Section title="How It Works" align="center">
      <CardGrid>
        {WORKFLOW.map((step, index) => (
          <Card>
            <CardContent>
              <WorkflowStep step={index + 1} title={step.title}>
                {step.body}
              </WorkflowStep>
            </CardContent>
          </Card>
        ))}
      </CardGrid>
    </Section>

    <Section title="Why Game Loopers?" align="center">
      <CardGrid>
        {FEATURES.map((feature) => (
          <FeatureItem icon={feature.icon} title={feature.title}>
            {feature.body}
          </FeatureItem>
        ))}
      </CardGrid>
    </Section>

    <CtaBanner
      title="Ready to Start Creating?"
      description="Join thousands of tabletop game creators building the future of collaborative game design."
    >
      {isAuthenticated ? (
        <Button href="/products" variant="primary" size="lg">
          <span slot="text">Browse Products</span>
        </Button>
      ) : (
        <Button href="/sign-up" variant="primary" size="lg">
          <span slot="text">Get Started Free</span>
        </Button>
      )}
    </CtaBanner>
  </Page>
</Layout>
