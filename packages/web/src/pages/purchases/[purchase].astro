---
import Layout from '@/layouts/layout.astro';
import Page from '@/components/page/page.astro';
import PageHeader from '@/components/page-header/page-header.astro';
import PurchaseLine from '@/components/purchases/purchase-line/purchase-line.astro';
import ButtonGroup from '@/components/button-group/button-group.astro';
import Button from '@/components/button/button.astro';
import DetailList from '@/components/detail-list/detail-list.astro';
import DetailRow from '@/components/detail-list/detail-row/detail-row.astro';
import { formatMoney } from '@gameloopers/core/utils/money';
import Card from '@/components/card/card.astro';
import CardHeader from '@/components/card/card-header/card-header.astro';
import CardTitle from '@/components/card/card-title/card-title.astro';
import CardContent from '@/components/card/card-content/card-content.astro';
import Badge from '@/components/badge/badge.astro';
import { getSaleById, getSaleItems } from '@gameloopers/core/data-access/sales';
import { getProductById, getProductFiles } from '@gameloopers/core/data-access/products';
import { requirePageUser } from '@/lib/page-auth';

const { purchase: saleId } = Astro.params;

if (!saleId) {
  return Astro.redirect('/purchases');
}

// Check authentication
const auth = await requirePageUser(Astro);
if (auth instanceof Response) return auth;
const userId = auth.id;

// Get sale
const sale = await getSaleById(saleId);

if (!sale) {
  return Astro.redirect('/purchases');
}

// Verify ownership
if (sale.user_id !== userId) {
  return Astro.redirect('/purchases');
}

// Get sale items
const saleItems = await getSaleItems(saleId);

// Fetch product and files for each sale item
const itemsWithDetails = await Promise.all(
  saleItems.map(async (item) => {
    const product = await getProductById(item.product_id);
    const files = product ? await getProductFiles(product.id) : [];

    return {
      ...item,
      product,
      files,
    };
  })
);

const saleDate = new Date(sale.created_at);
const completedDate = sale.completed_at ? new Date(sale.completed_at) : null;
---

<Layout title={`Purchase #${saleId.slice(0, 8)} - Game Loopers`}>
  <Page>
    <PageHeader title="Purchase Details" description={`Order #${saleId.slice(0, 8)}...`}>
      <Badge slot="actions" variant={sale.status === 'paid' ? 'success' : 'muted'}>
        {sale.status.toUpperCase()}
      </Badge>
    </PageHeader>

    {/* Order Info */}
    <Card>
      <CardHeader>
        <CardTitle>Order Information</CardTitle>
      </CardHeader>
      <CardContent>
        <DetailList>
          <DetailRow label="Order Date">{saleDate.toLocaleDateString()}</DetailRow>
          {completedDate && (
            <DetailRow label="Completed">{completedDate.toLocaleDateString()}</DetailRow>
          )}
          <DetailRow label="Email">{sale.user_email}</DetailRow>
          <DetailRow label="Total">
            {formatMoney(sale.price_cents, { currency: sale.currency })}
          </DetailRow>
          <DetailRow label="Payment ID" mono>
            {sale.stripe_charge_id}
          </DetailRow>
        </DetailList>
      </CardContent>
    </Card>

    {itemsWithDetails.map((item) => (
      <PurchaseLine
        title={item.product?.title || 'Unknown Product'}
        description={item.product?.description}
        priceCents={item.price_cents}
        currency={item.currency}
        quantity={item.quantity}
        files={item.files ?? []}
      />
    ))}

    <ButtonGroup align="center">
      <Button href="/purchases" variant="link" size="sm">
        <span slot="text">← Back to Purchases</span>
      </Button>
    </ButtonGroup>
  </Page>
</Layout>
