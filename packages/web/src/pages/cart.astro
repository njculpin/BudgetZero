---
import Layout from '@/layouts/layout.astro';
import Page from '@/components/page/page.astro';
import PageHeader from '@/components/page-header/page-header.astro';
import PageColumns from '@/components/page-columns/page-columns.astro';
import CartItemList from '@/components/cart/cart-item-list/cart-item-list.astro';
import Alert from '@/components/alert/alert.astro';
import DetailList from '@/components/detail-list/detail-list.astro';
import DetailRow from '@/components/detail-list/detail-row/detail-row.astro';
import ButtonGroup from '@/components/button-group/button-group.astro';
import { formatMoney } from '@gameloopers/core/utils/money';
import Card from '@/components/card/card.astro';
import CardHeader from '@/components/card/card-header/card-header.astro';
import CardTitle from '@/components/card/card-title/card-title.astro';
import CardContent from '@/components/card/card-content/card-content.astro';
import Button from '@/components/button/button.astro';
import CheckoutButton from '@/components/checkout/checkout-button/checkout-button';
import EmptyState from '@/components/empty-state/empty-state.astro';
import { getOrCreateCart, getCartItems } from '@gameloopers/core/data-access/cart';
import { requirePageUser } from '@/lib/page-auth';
import {
  getProductById,
  getProductPriceBreakdown,
} from '@gameloopers/core/data-access/products';

const auth = await requirePageUser(Astro, '/cart');
if (auth instanceof Response) return auth;
const userId = auth.id;

// Get cart and items (cart operations now handled client-side)
const cart = await getOrCreateCart(userId);

const cartItems = cart ? await getCartItems(cart.id) : [];

// Fetch product details and calculate prices for each cart item
const cartItemsWithDetails = await Promise.all(
  cartItems.map(async (item) => {
    const product = await getProductById(item.product_id);

    // Both figures are kept: `price_cents` is what the line costs and what
    // Stripe charges, `subtotal_cents` is that price before the platform fee.
    // The summary needs both so the fee can be shown as its own line rather
    // than appearing for the first time on the payment page.
    let price_cents = 0;
    let subtotal_cents = 0;
    if (product) {
      const priceBreakdown = await getProductPriceBreakdown(product.id);
      price_cents = priceBreakdown.totalPrice;
      subtotal_cents = priceBreakdown.subtotal;
    }

    return {
      ...item,
      product,
      price_cents,
      subtotal_cents,
    };
  })
);

// Calculate totals.
//
// `total` is what Stripe will charge — the sum of each line's fee-inclusive
// price. It was previously named `subtotal` and rendered under both the
// "Subtotal" and "Total" labels, so the platform fee was never disclosed
// anywhere before the payment step.
const subtotal = cartItemsWithDetails.reduce(
  (sum, item) => sum + (item.subtotal_cents || 0) * item.quantity,
  0
);
const total = cartItemsWithDetails.reduce(
  (sum, item) => sum + (item.price_cents || 0) * item.quantity,
  0
);
const platformFee = total - subtotal;

const showAddedMessage = Astro.url.searchParams.get('added') === 'true';
const showCancelledMessage = Astro.url.searchParams.get('cancelled') === 'true';
---

<Layout title="Shopping Cart - Game Loopers">
  <Page>
    <PageHeader title="Shopping Cart" />

    {showAddedMessage && <Alert tone="success">Item added to cart!</Alert>}

    {showCancelledMessage && (
      <Alert tone="error">
        Checkout was cancelled. Your items are still in your cart.
      </Alert>
    )}

    {cartItemsWithDetails.length > 0 ? (
      <PageColumns>
        <Card slot="main">
          <CardContent>
            <CartItemList items={cartItemsWithDetails} />
          </CardContent>
        </Card>

        <Fragment slot="aside">
          <Card>
            <CardHeader>
              <CardTitle>Order Summary</CardTitle>
            </CardHeader>
            <CardContent>
              <DetailList>
                <DetailRow label="Subtotal">{formatMoney(subtotal)}</DetailRow>
                <DetailRow label="Platform fee (10%)">
                  {formatMoney(platformFee)}
                </DetailRow>
                <DetailRow label="Total">{formatMoney(total)}</DetailRow>
              </DetailList>

              <ButtonGroup align="center">
                <CheckoutButton client:load variant="primary" size="lg" />
              </ButtonGroup>
            </CardContent>
          </Card>

          <ButtonGroup align="center">
            <Button href="/products" variant="outline" size="md">
              <span slot="text">Continue Shopping</span>
            </Button>
          </ButtonGroup>
        </Fragment>
      </PageColumns>
    ) : (
      <Card>
        <CardContent>
          <EmptyState
            icon="cart"
            title="Your cart is empty"
            description="Start shopping and add products to your cart to see them here."
            actionText="Browse Products"
            actionHref="/products"
          />
        </CardContent>
      </Card>
    )}
  </Page>
</Layout>
