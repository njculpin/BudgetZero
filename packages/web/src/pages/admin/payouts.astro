---
import Layout from '@/layouts/layout.astro';
import Page from '@/components/page/page.astro';
import Card from '@/components/card/card.astro';
import CardHeader from '@/components/card/card-header/card-header.astro';
import CardTitle from '@/components/card/card-title/card-title.astro';
import CardDescription from '@/components/card/card-description/card-description.astro';
import CardContent from '@/components/card/card-content/card-content.astro';
import PageHeader from '@/components/page-header/page-header.astro';
import PayoutQueue from '@/components/admin/payout-queue/payout-queue';
import type { PayoutQueueEntry } from '@/components/admin/payout-queue/payout-queue';
import { resolvePageAuth } from '@/lib/page-auth';
import { verifyAdmin } from '@gameloopers/core/auth/admin';
import { getPendingPayoutsForAdmin } from '@gameloopers/core/data-access/payouts';

// The execute endpoint enforces admin authorization itself; this check keeps the
// page from rendering the queue to anyone who cannot act on it.
const { userId } = await resolvePageAuth(Astro.cookies);
const authResult = await verifyAdmin(userId);

if (!authResult.authorized) {
  if (
    authResult.error === 'Not authenticated' ||
    authResult.error === 'Invalid session'
  ) {
    return Astro.redirect('/sign-in?redirect=/admin/payouts');
  }
  return Astro.redirect('/');
}

const pendingPayouts = await getPendingPayoutsForAdmin();

const queueEntries: PayoutQueueEntry[] = pendingPayouts
  .filter((payout) => payout.recipient !== null)
  .map((payout) => ({
    id: payout.id,
    amountCents: payout.amount_cents,
    requestedAt: payout.requested_at,
    notes: payout.notes,
    itemCount: payout.item_count,
    recipientHandle: payout.recipient!.handle,
    recipientName: payout.recipient!.name,
    payoutsEnabled: payout.recipient!.stripe_connect_payouts_enabled,
  }));

const totalOwedCents = queueEntries.reduce((sum, entry) => sum + entry.amountCents, 0);

const formatCurrency = (cents: number) =>
  new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: 'USD',
  }).format(cents / 100);
---

<Layout title="Payout Queue - Game Loopers">
  <Page>
    <PageHeader
      title="Payout Queue"
      description="Pending payout requests, oldest first. Executing a payout transfers funds through Stripe Connect and marks the underlying royalties paid."
    />

    <Card>
      <CardHeader>
        <CardTitle>Pending</CardTitle>
        <CardDescription>
          {queueEntries.length}
          {queueEntries.length === 1 ? ' payout' : ' payouts'} totalling{' '}
          {formatCurrency(totalOwedCents)}
        </CardDescription>
      </CardHeader>
      <CardContent>
        <PayoutQueue client:load payouts={queueEntries} />
      </CardContent>
    </Card>
  </Page>
</Layout>
