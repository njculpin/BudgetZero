---
import Layout from '@/layouts/layout.astro';
import { getPageUser } from '@/lib/page-auth';
import Page from '@/components/page/page.astro';
import Card from '@/components/card/card.astro';
import CardContent from '@/components/card/card-content/card-content.astro';
import PageHeader from '@/components/page-header/page-header.astro';
import Section from '@/components/section/section.astro';
import CardGrid from '@/components/card-grid/card-grid.astro';
import SearchField from '@/components/search-field/search-field.astro';
import TagFilter from '@/components/tag-filter/tag-filter.astro';
import Tag from '@/components/tag/tag.astro';
import Toolbar from '@/components/toolbar/toolbar.astro';
import Pagination from '@/components/pagination/pagination.astro';
import Button from '@/components/button/button.astro';
import { FormField, Select } from '@/components/base';
import BrowseCTA from '@/components/home/browse-cta/browse-cta.astro';
import {
  getAllProducts,
  getProductImages,
  getProductPriceBreakdown,
} from '@gameloopers/core/data-access/products';
import { getUserById } from '@gameloopers/core/data-access/users';
import { getAllTags } from '@gameloopers/core/data-access/tags';
import EmptyState from '@/components/empty-state/empty-state.astro';
import { FormSubmitButton } from '@/components/interactive';
import ProductCard from '@/components/products/product-card/product-card.astro';

const { url } = Astro;
const searchParams = url.searchParams;
const currentUser = await getPageUser(Astro.cookies);

const searchQuery = searchParams.get('search') || '';
const tagFilter = searchParams.get('tag') || '';
const sortBy = searchParams.get('sort') || 'newest';
const page = parseInt(searchParams.get('page') || '1');
const limit = 20;
const offset = (page - 1) * limit;

const tagArray = tagFilter ? [tagFilter] : undefined;
const allProducts = await getAllProducts(searchQuery, tagArray, limit, offset, sortBy);

// Fetch images and calculate prices for each product
const productsWithDetails = await Promise.all(
  allProducts.map(async (product) => {
    const images = await getProductImages(product.id);

    // One source of price truth. This page previously summed file and component
    // prices itself, which omitted documents entirely — a document-only product
    // displayed as "Free" — and left off the platform fee, so every card
    // understated what Stripe would charge by 10%.
    const priceBreakdown = await getProductPriceBreakdown(product.id);

    return {
      ...product,
      cover_image_url: images[0]?.file_url || null,
      total_price_cents: priceBreakdown.totalPrice,
    };
  })
);

// Apply price-based sorting if needed (since prices are calculated client-side)
if (sortBy === 'price-low') {
  productsWithDetails.sort((a, b) => a.total_price_cents - b.total_price_cents);
} else if (sortBy === 'price-high') {
  productsWithDetails.sort((a, b) => b.total_price_cents - a.total_price_cents);
}

// Get owners for all products
const allProductOwnerIds = [...new Set(productsWithDetails.map((p) => p.user_id))];
const allProductOwners = await Promise.all(
  allProductOwnerIds.map((id) => getUserById(id))
);
const allOwnersMap = new Map(allProductOwners.filter((o) => o).map((o) => [o!.id, o]));

// Get popular tags for filtering (show top 10 product tags)
const allTags = await getAllTags();
const productTags = allTags.filter((tag) => tag.productCount > 0).slice(0, 10);
---

<Layout title="Browse Products - Game Loopers">
  <Page>
    <PageHeader title="Products" description="Discover tabletop games from the community">
      {currentUser && (
        <FormSubmitButton
          slot="actions"
          client:load
          action="/api/products/create-product"
          method="post"
          variant="primary"
          size="lg"
        >
          Create Product
        </FormSubmitButton>
      )}
    </PageHeader>

    <form method="get" action="/products" class="browse-search">
      <SearchField
        name="search"
        label="Search products"
        value={searchQuery}
        placeholder="Search products..."
        submitLabel="Search"
      />
      {(searchQuery || tagFilter) && (
        <Button href="/products" variant="link" size="sm">
          <span slot="text">Clear filters</span>
        </Button>
      )}
    </form>

    <Toolbar>
      <FormField label="Sort by:" name="sort-select" inline>
        <Select
          id="sort-select"
          name="sort-select"
          onchange="window.location.href = '/products?sort=' + this.value + (new URLSearchParams(window.location.search).get('search') ? '&search=' + encodeURIComponent(new URLSearchParams(window.location.search).get('search')) : '') + (new URLSearchParams(window.location.search).get('tag') ? '&tag=' + encodeURIComponent(new URLSearchParams(window.location.search).get('tag')) : '')"
        >
          <option value="newest" selected={sortBy === 'newest'}>
            Newest First
          </option>
          <option value="oldest" selected={sortBy === 'oldest'}>
            Oldest First
          </option>
          <option value="price-low" selected={sortBy === 'price-low'}>
            Price: Low to High
          </option>
          <option value="price-high" selected={sortBy === 'price-high'}>
            Price: High to Low
          </option>
          <option value="popular" selected={sortBy === 'popular'}>
            Most Viewed
          </option>
          <option value="title-az" selected={sortBy === 'title-az'}>
            Title: A-Z
          </option>
          <option value="title-za" selected={sortBy === 'title-za'}>
            Title: Z-A
          </option>
        </Select>
      </FormField>

      {productTags.length > 0 && (
        <TagFilter label="Filter by tag:">
          {productTags.map((tag) => (
            <Tag
              href={
                tagFilter === tag.value
                  ? `/products${searchQuery ? `?search=${encodeURIComponent(searchQuery)}` : ''}${sortBy !== 'newest' ? `${searchQuery ? '&' : '?'}sort=${sortBy}` : ''}`
                  : `/products?tag=${encodeURIComponent(tag.value)}${searchQuery ? `&search=${encodeURIComponent(searchQuery)}` : ''}${sortBy !== 'newest' ? `&sort=${sortBy}` : ''}`
              }
              active={tagFilter === tag.value}
              count={tag.productCount}
            >
              {tag.value}
            </Tag>
          ))}
        </TagFilter>
      )}
    </Toolbar>

    {!currentUser && (
      <Card>
        <CardContent>
          <BrowseCTA message="Sign in to create and sell your tabletop games" />
        </CardContent>
      </Card>
    )}

    <!-- All Products Section -->
    {productsWithDetails.length > 0 ? (
      <Section title="All products" titleHidden>
        <CardGrid>
          {productsWithDetails.map((product, index) => {
            const owner = allOwnersMap.get(product.user_id);
            return (
              <ProductCard
                handle={product.handle}
                title={product.title}
                creatorName={owner?.name || owner?.handle || 'Unknown'}
                imageUrl={product.cover_image_url}
                description={product.description}
                priceCents={product.total_price_cents}
                loading={index < 3 ? 'eager' : 'lazy'}
              />
            );
          })}
        </CardGrid>
      </Section>
    ) : (
      productsWithDetails.length === 0 && (
        <Card>
          <CardContent>
            {searchQuery || tagFilter ? (
              <EmptyState
                icon="search"
                title="No products found"
                description="Try adjusting your search or clearing filters to see more results."
                actionText="Clear filters"
                actionHref="/products"
              />
            ) : currentUser ? (
              <EmptyState
                icon="products"
                title="No products yet"
                description="Be the first to create a product and share it with the community."
              >
                <FormSubmitButton
                  slot="action"
                  client:load
                  action="/api/products/create-product"
                  method="post"
                  variant="primary"
                  size="lg"
                >
                  Create Product
                </FormSubmitButton>
              </EmptyState>
            ) : (
              <EmptyState
                icon="products"
                title="No products yet"
                description="Be the first to create a product and share it with the community."
                actionText="Sign in to create"
                actionHref="/sign-in"
              />
            )}
          </CardContent>
        </Card>
      )
    )}

    {productsWithDetails.length === limit && (
      <Pagination>
        {page > 1 && (
          <li class="pagination__item">
            <a
              href={`/products?page=${page - 1}${searchQuery ? `&search=${encodeURIComponent(searchQuery)}` : ''}${tagFilter ? `&tag=${encodeURIComponent(tagFilter)}` : ''}`}
              class="pagination__link pagination__previous"
              rel="prev"
            >
              ← Previous
            </a>
          </li>
        )}
        <li class="pagination__item">
          <span class="pagination__link" aria-current="page">
            Page {page}
          </span>
        </li>
        <li class="pagination__item">
          <a
            href={`/products?page=${page + 1}${searchQuery ? `&search=${encodeURIComponent(searchQuery)}` : ''}${tagFilter ? `&tag=${encodeURIComponent(tagFilter)}` : ''}`}
            class="pagination__link pagination__next"
            rel="next"
          >
            Next →
          </a>
        </li>
      </Pagination>
    )}
  </Page>
</Layout>
