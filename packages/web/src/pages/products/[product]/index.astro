---
import Layout from '@/layouts/layout.astro';
import { getPageUser } from '@/lib/page-auth';
import Page from '@/components/page/page.astro';
import PageHeader from '@/components/page-header/page-header.astro';
import PageColumns from '@/components/page-columns/page-columns.astro';
import ProductTags from '@/components/products/product-tags/product-tags.astro';
import CreatorProfile from '@/components/users/creator-profile/creator-profile.astro';
import Button from '@/components/button/button.astro';
import { ProductContentViewer, AddToCartButton } from '@/components/products';
import ProductContributors from '@/components/products/product-contributors/product-contributors.astro';
import ProductImageGallery from '@/components/products/product-image-gallery/product-image-gallery.astro';
import {
  getProductByHandle,
  getProductTags,
  getProductImages,
  getProductFiles,
  getProductDocuments,
  getProductContributorsWithRoles,
  getProductComponentsWithDetails,
  getProductPriceBreakdown,
} from '@gameloopers/core/data-access/products';
import { getUserById } from '@gameloopers/core/data-access/users';
import Card from '@/components/card/card.astro';
import CardHeader from '@/components/card/card-header/card-header.astro';
import CardTitle from '@/components/card/card-title/card-title.astro';
import CardDescription from '@/components/card/card-description/card-description.astro';
import CardContent from '@/components/card/card-content/card-content.astro';

const { product } = Astro.params;

if (!product) {
  return Astro.redirect('/404');
}

const productData = await getProductByHandle(product);

if (!productData) {
  return Astro.redirect('/404');
}

// Parallelize data fetching for better performance
const [
  owner,
  tags,
  productImages,
  productFiles,
  productDocuments,
  embeddedProductsWithCreators,
  priceBreakdown,
] = await Promise.all([
  getUserById(productData.user_id),
  getProductTags(productData.id),
  getProductImages(productData.id),
  getProductFiles(productData.id),
  getProductDocuments(productData.id),
  getProductComponentsWithDetails(productData.id),
  // A product has no price column: its price is the sum of its files,
  // documents and embedded components, plus the platform fee. This is the same
  // figure checkout charges, so the button and the invoice agree.
  getProductPriceBreakdown(productData.id),
]);

// Null guard: redirect if owner not found
if (!owner) {
  return Astro.redirect('/404');
}
const currentUser = await getPageUser(Astro.cookies);

const isOwner = currentUser?.id === productData.user_id;

// Get product contributors with role information
const productContributorsWithRoles = await getProductContributorsWithRoles(
  productData.id
);

// Helper: Check if we should show the content viewer (has content)
const shouldShowContentViewer =
  productFiles.length > 0 ||
  productDocuments.length > 0 ||
  embeddedProductsWithCreators.length > 0;
---

<Layout title={`${productData.title} - Game Loopers`}>
  <Page>
    <PageColumns>
      <Fragment slot="main">
        <!-- Product Images -->
        {productImages.length > 0 && (
          <ProductImageGallery
            images={productImages.map((img) => ({
              url: img.file_url,
              alt: img.title,
            }))}
          />
        )}
      </Fragment>

      <Fragment slot="aside">
        <PageHeader
          title={productData.title}
          description={productData.description ?? undefined}
        >
          {isOwner && (
            <Button
              slot="actions"
              href={`/products/${product}/edit`}
              variant="outline"
              size="sm"
            >
              <span slot="text">Edit</span>
            </Button>
          )}
          {tags.length > 0 && (
            <ProductTags slot="meta" tags={tags.map((tag) => tag.value)} />
          )}
        </PageHeader>

        <!-- Add to Cart Button -->
        <Card>
          <CardContent>
            <AddToCartButton
              client:load
              productId={productData.id}
              productTitle={productData.title}
              priceCents={priceBreakdown.totalPrice}
              status={productData.status}
              isOwner={isOwner}
              isAuthenticated={!!currentUser}
            />
          </CardContent>
        </Card>

        <!-- Product Content Viewer -->
        {shouldShowContentViewer && (
          <Card>
            <CardHeader>
              <CardTitle>What's Included</CardTitle>
              <CardDescription>
                All files, documents, and embedded products included with purchase
              </CardDescription>
            </CardHeader>
            <CardContent>
              <ProductContentViewer
                client:load
                productId={productData.id}
                productTitle={productData.title}
                isAuthenticated={!!currentUser}
                files={productFiles}
                documents={productDocuments}
                embeddedProducts={embeddedProductsWithCreators}
                platformFeeCents={priceBreakdown.platformFee}
                totalPriceCents={priceBreakdown.totalPrice}
              />
            </CardContent>
          </Card>
        )}

        <!-- Creator & Contributors -->
        <Card>
          <CardHeader>
            <CardTitle>Created By</CardTitle>
          </CardHeader>
          <CardContent>
            <CreatorProfile
              handle={owner.handle}
              name={owner.name}
              bio={owner.bio}
              avatarUrl={owner.avatar_url}
            />
          </CardContent>
          {productContributorsWithRoles.length > 0 && (
            <>
              <CardHeader>
                <CardTitle>Contributors</CardTitle>
                <CardDescription>
                  Creators earning royalties from embedded content
                </CardDescription>
              </CardHeader>
              <CardContent>
                <ProductContributors
                  contributorsWithRoles={productContributorsWithRoles}
                />
              </CardContent>
            </>
          )}
        </Card>
      </Fragment>
    </PageColumns>
  </Page>
</Layout>
