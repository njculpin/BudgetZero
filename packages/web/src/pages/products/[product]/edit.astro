---
import Layout from '@/layouts/layout.astro';
import { getPageUser } from '@/lib/page-auth';
import Page from '@/components/page/page.astro';
import Button from '@/components/button/button.astro';
import PageHeader from '@/components/page-header/page-header.astro';
import PageColumns from '@/components/page-columns/page-columns.astro';
import ProductSettings from '@/components/products/product-settings/product-settings.astro';
import {
  ProductBasicInfoForm,
  ProductStatusEditor,
  ProductEmbeddableToggle,
  ProductTagsForm,
  ProductImagesForm,
  ProductContentManager,
  ProductDeleteButton,
} from '@/components/products';
import ProductContributors from '@/components/products/product-contributors/product-contributors.astro';
import {
  getProductByHandle,
  getProductTags,
  getProductImages,
  getProductFiles,
  getProductDocuments,
  getProductContributorsWithRoles,
  getProductComponentsWithDetails,
} from '@gameloopers/core/data-access/products';
import { getUserById } from '@gameloopers/core/data-access/users';
import Card from '@/components/card/card.astro';
import CardHeader from '@/components/card/card-header/card-header.astro';
import CardTitle from '@/components/card/card-title/card-title.astro';
import CardDescription from '@/components/card/card-description/card-description.astro';
import CardContent from '@/components/card/card-content/card-content.astro';

const { product } = Astro.params;

if (!product) {
  return Astro.redirect('/404');
}

const productData = await getProductByHandle(product);

if (!productData) {
  return Astro.redirect('/404');
}
const currentUser = await getPageUser(Astro.cookies);

const isOwner = currentUser?.id === productData.user_id;

// Redirect non-owners to view page
if (!isOwner) {
  return Astro.redirect(`/products/${product}`);
}

// Parallelize data fetching for better performance
const [
  owner,
  tags,
  productImages,
  productFiles,
  productDocuments,
  embeddedProductsWithCreators,
] = await Promise.all([
  getUserById(productData.user_id),
  getProductTags(productData.id),
  getProductImages(productData.id),
  getProductFiles(productData.id),
  getProductDocuments(productData.id),
  getProductComponentsWithDetails(productData.id),
]);

// Null guard: redirect if owner not found
if (!owner) {
  return Astro.redirect('/404');
}

// Get product contributors with role information
const productContributorsWithRoles = await getProductContributorsWithRoles(
  productData.id
);
---

<Layout title={`Edit ${productData.title} - Game Loopers`}>
  <Page>
    <PageHeader
      title="Edit Product"
      description="Manage your product content, pricing, and settings"
    >
      <Button slot="actions" href={`/products/${product}`} variant="outline" size="md">
        <span slot="text">View Product</span>
      </Button>
    </PageHeader>

    <PageColumns>
      <Fragment slot="main">
        <!-- Product Images Form -->
        <Card>
          <CardHeader>
            <CardTitle>Product Images</CardTitle>
            <CardDescription>
              Upload and manage product images (up to 9). First image is the cover.
            </CardDescription>
          </CardHeader>
          <CardContent>
            <ProductImagesForm
              client:load
              productId={productData.id}
              existingImages={productImages}
            />
          </CardContent>
        </Card>

        <!-- Product Content Manager -->
        <Card>
          <CardHeader>
            <CardTitle>Content & Pricing</CardTitle>
            <CardDescription>
              Manage all content, pricing, and revenue distribution
            </CardDescription>
          </CardHeader>
          <CardContent>
            <ProductContentManager
              client:load
              productId={productData.id}
              productTitle={productData.title}
              userId={currentUser!.id}
              isOwner={true}
              isAuthenticated={true}
              existingFiles={productFiles}
              existingDocuments={productDocuments}
              existingEmbeddedProducts={embeddedProductsWithCreators}
              productOwnerId={productData.user_id}
              productOwnerHandle={owner?.handle}
              productOwnerName={owner?.name || owner?.handle}
            />
          </CardContent>
        </Card>
      </Fragment>

      <Fragment slot="aside">
        <!-- Basic Info Form -->
        <Card>
          <CardContent>
            <ProductBasicInfoForm
              client:load
              productId={productData.id}
              initialData={{
                title: productData.title,
                description: productData.description,
              }}
            />
          </CardContent>
        </Card>

        <!-- Tags Form -->
        <Card>
          <CardHeader>
            <CardTitle>Tags</CardTitle>
            <CardDescription>Help users discover your product</CardDescription>
          </CardHeader>
          <CardContent>
            <ProductTagsForm
              client:load
              productId={productData.id}
              initialTags={tags.map((t) => t.value)}
            />
          </CardContent>
        </Card>

        <!-- Contributors -->
        {productContributorsWithRoles.length > 0 && (
          <Card>
            <CardHeader>
              <CardTitle>Contributors</CardTitle>
              <CardDescription>
                Creators earning royalties from embedded content
              </CardDescription>
            </CardHeader>
            <CardContent>
              <ProductContributors contributorsWithRoles={productContributorsWithRoles} />
            </CardContent>
          </Card>
        )}

        <!-- Embeddable Toggle -->
        <Card>
          <CardHeader>
            <CardTitle>Embeddable</CardTitle>
            <CardDescription>
              Allow other creators to embed this product in their work
            </CardDescription>
          </CardHeader>
          <CardContent>
            <ProductEmbeddableToggle
              client:load
              productId={productData.id}
              isEmbeddable={productData.is_embeddable}
              productStatus={productData.status}
              embeddingRoyaltyCents={productData.embedding_royalty_cents}
            />
          </CardContent>
        </Card>

        <!-- Product Settings -->
        <Card>
          <CardHeader>
            <CardTitle>Product Settings</CardTitle>
            <CardDescription>Manage visibility and lifecycle</CardDescription>
          </CardHeader>
          <CardContent>
            <ProductSettings
              productId={productData.id}
              productTitle={productData.title}
              status={productData.status}
            />
          </CardContent>
        </Card>
      </Fragment>

      <Fragment slot="aside">
        <!-- Basic Info Form -->
        <Card>
          <CardContent>
            <ProductBasicInfoForm
              client:load
              productId={productData.id}
              initialData={{
                title: productData.title,
                description: productData.description,
              }}
            />
          </CardContent>
        </Card>

        <!-- Tags Form -->
        <Card>
          <CardHeader>
            <CardTitle>Tags</CardTitle>
            <CardDescription>Help users discover your product</CardDescription>
          </CardHeader>
          <CardContent>
            <ProductTagsForm
              client:load
              productId={productData.id}
              initialTags={tags.map((t) => t.value)}
            />
          </CardContent>
        </Card>

        <!-- Contributors -->
        {productContributorsWithRoles.length > 0 && (
          <Card>
            <CardHeader>
              <CardTitle>Contributors</CardTitle>
              <CardDescription>
                Creators earning royalties from embedded content
              </CardDescription>
            </CardHeader>
            <CardContent>
              <ProductContributors contributorsWithRoles={productContributorsWithRoles} />
            </CardContent>
          </Card>
        )}

        <!-- Embeddable Toggle -->
        <Card>
          <CardHeader>
            <CardTitle>Embeddable</CardTitle>
            <CardDescription>
              Allow other creators to embed this product in their work
            </CardDescription>
          </CardHeader>
          <CardContent>
            <ProductEmbeddableToggle
              client:load
              productId={productData.id}
              isEmbeddable={productData.is_embeddable}
              productStatus={productData.status}
              embeddingRoyaltyCents={productData.embedding_royalty_cents}
            />
          </CardContent>
        </Card>

        <!-- Product Settings -->
        <Card>
          <CardHeader>
            <CardTitle>Product Settings</CardTitle>
            <CardDescription>Manage visibility and lifecycle</CardDescription>
          </CardHeader>
          <CardContent>
            <section class="product-settings__section">
              <h4 class="product-settings__section-title">Publish Status</h4>
              <ProductStatusEditor
                client:load
                productId={productData.id}
                currentStatus={productData.status}
              />
            </section>

            <section class="product-settings__section product-settings__section--danger">
              <h4 class="product-settings__section-title">Danger Zone</h4>
              <ProductDeleteButton
                client:load
                productId={productData.id}
                productTitle={productData.title}
              />
            </section>
          </CardContent>
        </Card>
      </Fragment>
    </PageColumns>
  </Page>
</Layout>
