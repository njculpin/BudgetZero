---
import Layout from '@/layouts/layout.astro';
import { getPageUser } from '@/lib/page-auth';
import Page from '@/components/page/page.astro';
import Card from '@/components/card/card.astro';
import CardHeader from '@/components/card/card-header/card-header.astro';
import CardTitle from '@/components/card/card-title/card-title.astro';
import CardDescription from '@/components/card/card-description/card-description.astro';
import CardContent from '@/components/card/card-content/card-content.astro';
import PageHeader from '@/components/page-header/page-header.astro';
import CardGrid from '@/components/card-grid/card-grid.astro';
import PayoutBalance from '@/components/payouts/payout-balance/payout-balance';
import PayoutHistory from '@/components/payouts/payout-history/payout-history';
import PayoutShortcuts from '@/components/payouts/payout-shortcuts/payout-shortcuts.astro';
import { getUserById } from '@gameloopers/core/data-access/users';

const currentUser = await getPageUser(Astro.cookies);

if (!currentUser) {
  return Astro.redirect('/sign-in');
}

const user = await getUserById(currentUser.id);

if (!user) {
  return Astro.redirect('/products');
}
---

<Layout title="Payouts - Game Loopers">
  <Page>
    <PageHeader
      title="Payouts"
      description="Manage your earnings from sales and royalties"
    />

    <CardGrid size="lg">
      <Card>
        <CardHeader>
          <CardTitle>Available Balance</CardTitle>
          <CardDescription>Earnings ready to be paid out</CardDescription>
        </CardHeader>
        <CardContent>
          <PayoutBalance client:load />
        </CardContent>
      </Card>

      <Card>
        <CardHeader>
          <CardTitle>Quick Actions</CardTitle>
          <CardDescription>Manage your payout settings</CardDescription>
        </CardHeader>
        <CardContent>
          <PayoutShortcuts />
        </CardContent>
      </Card>
    </CardGrid>

    <Card>
      <CardHeader>
        <CardTitle>Payout History</CardTitle>
        <CardDescription>Your recent payout requests</CardDescription>
      </CardHeader>
      <CardContent>
        {/* Shares one fetch with the balance card, so a successful request
            refreshes both. See components/payouts/payouts-store. */}
        <PayoutHistory client:load />
      </CardContent>
    </Card>
  </Page>
</Layout>
