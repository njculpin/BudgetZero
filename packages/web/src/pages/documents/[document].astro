---
import Layout from '@/layouts/layout.astro';
import Page from '@/components/page/page.astro';
import Card from '@/components/card/card.astro';
import CardContent from '@/components/card/card-content/card-content.astro';
import CardHeader from '@/components/card/card-header/card-header.astro';
import CardTitle from '@/components/card/card-title/card-title.astro';
import CardDescription from '@/components/card/card-description/card-description.astro';
import DocumentContributors from '@/components/documents/document-contributors/document-contributors.astro';
import {
  getDocumentByHandle,
  canUserViewDocument,
  canUserEditDocument,
  getDocumentCollaboratorUsers,
  getDocumentContent,
  getDocumentAttachments,
} from '@gameloopers/core/data-access/documents';
import { getUserById } from '@gameloopers/core/data-access/users';
import DocumentEditor from '@/components/documents/document-editor/document-editor';
import DocumentDeleteButton from '@/components/documents/document-delete-button/document-delete-button';
import { DocumentAttachmentsForm } from '@/components/documents';
import PageHeader from '@/components/page-header/page-header.astro';
import PageColumns from '@/components/page-columns/page-columns.astro';
import DocumentByline from '@/components/documents/document-byline/document-byline.astro';
import ButtonGroup from '@/components/button-group/button-group.astro';
import DetailList from '@/components/detail-list/detail-list.astro';
import DetailRow from '@/components/detail-list/detail-row/detail-row.astro';
import { getPageUser } from '@/lib/page-auth';

const { params } = Astro;
const documentHandle = params.document;

if (!documentHandle) {
  return Astro.redirect('/documents');
}

// Check authentication
const currentUser = await getPageUser(Astro.cookies);

// Fetch document
const document = await getDocumentByHandle(documentHandle);

if (!document) {
  return Astro.redirect('/documents');
}

// Check permissions
const canView = currentUser
  ? await canUserViewDocument(document.id, currentUser.id)
  : false;
const canEdit = currentUser
  ? await canUserEditDocument(document.id, currentUser.id)
  : false;
const isOwner = currentUser?.id === document.user_id;

// Documents are private - redirect if user can't view
if (!canView) {
  return Astro.redirect('/documents');
}

// Get document content
const content = await getDocumentContent(document.id);
const contentJson = content ? JSON.stringify(content) : null;

// Get owner info
const owner = await getUserById(document.user_id);

// Get current user details for presence
const currentUserDetails = currentUser ? await getUserById(currentUser.id) : null;

// Get collaborators
const collaborators = await getDocumentCollaboratorUsers(document.id);
const collaboratorImages = collaborators.map((user) => ({
  url: user.avatar_url,
  alt: user.name || user.handle,
  href: `/users/${user.handle}`,
}));

// Get attachments
const attachments = await getDocumentAttachments(document.id);

// Format date helper
const formatDate = (dateStr: string) => {
  return new Date(dateStr).toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
};
---

<Layout title={`${document.title} - Game Loopers`}>
  <Page>
    <PageHeader title={document.title} description={document.description ?? undefined}>
      <DocumentByline
        slot="meta"
        ownerHandle={owner?.handle}
        ownerName={owner?.name || owner?.handle}
        canEdit={canEdit}
        isOwner={isOwner}
      />
    </PageHeader>

    <PageColumns>
      <Fragment slot="main">
        <Card>
          <CardHeader>
            <CardTitle>Editor</CardTitle>
            <CardDescription>
              {canEdit
                ? 'Write your document content below. Changes are auto-saved.'
                : 'View-only mode'}
            </CardDescription>
          </CardHeader>
          <CardContent>
            <DocumentEditor
              client:idle
              documentId={document.id}
              initialContent={contentJson}
              canEdit={canEdit}
              userId={currentUser?.id}
              userName={currentUserDetails?.name}
              userHandle={currentUserDetails?.handle}
            />
          </CardContent>
        </Card>
      </Fragment>

      <Fragment slot="aside">
        <!-- Contributors -->
        <Card>
          <CardHeader>
            <CardTitle>Contributors</CardTitle>
          </CardHeader>
          <CardContent>
            <DocumentContributors collaborators={collaboratorImages} isOwner={isOwner} />
          </CardContent>
        </Card>

        <!-- Attachments (editors only) -->
        {canEdit && currentUser && (
          <Card>
            <CardContent>
              <DocumentAttachmentsForm
                client:visible
                documentId={document.id}
                userId={currentUser.id}
                existingAttachments={attachments}
              />
            </CardContent>
          </Card>
        )}

        <!-- Document Information -->
        <Card>
          <CardHeader>
            <CardTitle>Document Information</CardTitle>
          </CardHeader>
          <CardContent>
            <DetailList>
              <DetailRow label="Created">{formatDate(document.created_at)}</DetailRow>
              <DetailRow label="Last Updated">
                {formatDate(document.updated_at)}
              </DetailRow>
              <DetailRow label="Owner">
                {owner?.name || owner?.handle || 'Unknown'}
              </DetailRow>
              <DetailRow label="Contributors">{collaborators.length}</DetailRow>
            </DetailList>
          </CardContent>
        </Card>

        <!-- Actions (owner only) -->
        {isOwner && (
          <Card>
            <CardHeader>
              <CardTitle>Actions</CardTitle>
            </CardHeader>
            <CardContent>
              <ButtonGroup>
                <DocumentDeleteButton
                  client:load
                  documentId={document.id}
                  documentTitle={document.title}
                />
              </ButtonGroup>
            </CardContent>
          </Card>
        )}
      </Fragment>
    </PageColumns>
  </Page>
</Layout>
