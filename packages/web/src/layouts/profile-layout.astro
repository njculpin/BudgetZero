---
// This page is for the public user profile which will not show a header.
import '@fontsource/inter';
import '@/styles/global.css';
import Footer from '@/components/footer/footer.astro';
import Button from '@/components/button/button.astro';

const { title = 'Game Loopers' } = Astro.props;
import './profile-layout.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <Footer label="Powered by Game Loopers" compact>
      <Button href="/sign-up" variant="ghost-secondary" size="sm">
        <span slot="text">Make Yours Today</span>
      </Button>
    </Footer>
  </body>
</html>
