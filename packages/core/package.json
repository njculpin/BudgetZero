{
  "name": "@gameloopers/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Domain logic and third-party SDK isolation layers. Imported by api, web and workers; imports none of them.",
  "exports": {
    "./env": "./src/env.ts",
    "./types": "./src/types/index.ts",
    "./auth": "./src/auth/index.ts",
    "./auth/*": "./src/auth/*.ts",
    "./data-access/*": "./src/data-access/*.ts",
    "./email": "./src/email/index.ts",
    "./email/*": "./src/email/*.ts",
    "./monitoring": "./src/monitoring/index.ts",
    "./monitoring/*": "./src/monitoring/*.ts",
    "./payments": "./src/payments/index.ts",
    "./payments/*": "./src/payments/*.ts",
    "./rate-limit": "./src/rate-limit/index.ts",
    "./storage": "./src/storage/index.ts",
    "./storage/*": "./src/storage/*.ts",
    "./realtime/*": "./src/realtime/*.ts",
    "./utils/*": "./src/utils/*.ts",
    "./test/*": "./src/test/*.ts"
  },
  "scripts": {
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.76.1",
    "jose": "^6.2.12",
    "resend": "^6.4.2",
    "stripe": "^19.3.1"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^24.9.1"
  }
}
