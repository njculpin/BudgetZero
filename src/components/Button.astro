---
const { variant = "primary", size = "md" } = Astro.props;
---

<button class={`button button--${variant} button--${size}`}>
  <slot name="icon" class="button__icon"></slot>
  <slot name="text" class="button__text"></slot>
</button>

<style>
/* ===== Base ===== */
.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  font-size: 0.875rem;
  font-weight: 500;
  border: none;
  border-radius: 6px;
  cursor: pointer;
  transition: all 0.2s ease;
  white-space: nowrap;
}

.button:disabled {
  opacity: 0.5;
  pointer-events: none;
}

.button__icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 0.5rem;
}

.button__text {
  display: inline-block;
}

/* ===== Variants ===== */
.button--primary {
  background-color: var(--color-primary, #0070f3);
  color: var(--color-on-primary, #fff);
}
.button--primary:hover {
  background-color: #005ad6;
}

.button--secondary {
  background-color: var(--color-secondary, #e5e7eb);
  color: var(--color-on-secondary, #111);
}
.button--secondary:hover {
  background-color: #d1d5db;
}

.button--destructive {
  background-color: var(--color-destructive, #ef4444);
  color: #fff;
}
.button--destructive:hover {
  background-color: #dc2626;
}

.button--outline {
  background-color: transparent;
  border: 1px solid var(--color-border, #d1d5db);
  color: var(--color-text, #111);
}
.button--outline:hover {
  background-color: #f9fafb;
}

.button--ghost {
  background-color: transparent;
  color: var(--color-text, #111);
}
.button--ghost:hover {
  background-color: #f3f4f6;
}

.button--link {
  background: none;
  border: none;
  color: var(--color-primary, #0070f3);
  text-decoration: underline;
  text-underline-offset: 4px;
}
.button--link:hover {
  opacity: 0.8;
}

/* ===== Sizes ===== */
.button--sm {
  height: 2rem;
  padding: 0 0.75rem;
  font-size: 0.8125rem;
}

.button--md {
  height: 2.25rem;
  padding: 0 1rem;
}

.button--lg {
  height: 2.5rem;
  padding: 0 1.5rem;
}

.button--icon {
  width: 2.25rem;
  height: 2.25rem;
  padding: 0;
  justify-content: center;
}
</style>
