---
const { variant = "primary", size = "md", class: className, ...rest } = Astro.props;
const classNames = [`button`, `button--${variant}`, `button--${size}`, className].filter(Boolean).join(' ');
---

<button class={classNames} {...rest}>
  <slot name="icon" class="button__icon"></slot>
  <slot name="text" class="button__text"></slot>
</button>

<style>
/* ===== Base ===== */
.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--gap-xs);
  font-size: var(--text-sm);
  font-weight: var(--font-weight-medium);
  border: none;
  border-radius: var(--radius-md);
  cursor: pointer;
  transition: all var(--duration-fast) var(--ease-in-out);
  white-space: nowrap;
}

.button:focus-visible {
  outline: 2px solid var(--ring);
  outline-offset: 2px;
}

.button:disabled {
  opacity: var(--opacity-50);
  pointer-events: none;
}

.button__icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: var(--spacing-xs);
}

.button__text {
  display: inline-block;
}

/* ===== Variants ===== */
.button--primary {
  background-color: var(--primary);
  color: var(--primary-foreground);
}
.button--primary:hover:not(:disabled) {
  background-color: oklch(from var(--primary) calc(l * 0.9) c h);
  transform: var(--transform-scale-sm);
}
.button--primary:active:not(:disabled) {
  transform: scale(0.98);
}

.button--secondary {
  background-color: var(--secondary);
  color: var(--secondary-foreground);
}
.button--secondary:hover:not(:disabled) {
  background-color: oklch(from var(--secondary) calc(l * 0.9) c h);
  transform: var(--transform-scale-sm);
}
.button--secondary:active:not(:disabled) {
  transform: scale(0.98);
}

.button--destructive {
  background-color: var(--destructive);
  color: var(--destructive-foreground);
}
.button--destructive:hover:not(:disabled) {
  background-color: oklch(from var(--destructive) calc(l * 0.9) c h);
  transform: var(--transform-scale-sm);
}
.button--destructive:active:not(:disabled) {
  transform: scale(0.98);
}

.button--outline {
  background-color: transparent;
  border: var(--border-width-default) solid var(--border);
  color: var(--foreground);
}
.button--outline:hover:not(:disabled) {
  background-color: var(--muted);
  border-color: var(--border-strong);
}

.button--ghost {
  background-color: transparent;
  color: var(--foreground);
}
.button--ghost:hover:not(:disabled) {
  background-color: var(--muted);
}

.button--ghost-secondary {
  background-color: transparent;
  color: var(--muted-foreground);
}
.button--ghost-secondary:hover:not(:disabled) {
  background-color: var(--muted);
  color: var(--foreground);
}

.button--accent {
  background-color: var(--accent);
  color: var(--accent-foreground);
}
.button--accent:hover:not(:disabled) {
  background-color: oklch(from var(--accent) calc(l * 0.9) c h);
  transform: var(--transform-scale-sm);
}
.button--accent:active:not(:disabled) {
  transform: scale(0.98);
}

.button--link {
  background: none;
  border: none;
  color: var(--primary);
  text-decoration: underline;
  text-underline-offset: var(--spacing-xs);
}
.button--link:hover:not(:disabled) {
  opacity: var(--opacity-80);
}

/* ===== Sizes ===== */
.button--sm {
  height: var(--button-height-sm);
  padding: 0 var(--button-padding-x-sm);
  font-size: var(--text-xs);
}

.button--md {
  height: var(--button-height-md);
  padding: 0 var(--button-padding-x-md);
}

.button--lg {
  height: var(--button-height-lg);
  padding: 0 var(--button-padding-x-lg);
}

.button--icon {
  width: var(--button-height-md);
  height: var(--button-height-md);
  padding: 0;
  justify-content: center;
}
</style>
