---
import type { Jam } from "@/types";

interface Props {
  jam: Jam;
}
const { jam } = Astro.props;
---

<div class="jam">
    <a
        href={`/jams/${jam.handle}`}
        class={`jam__item`}
        style={jam.preview_image_url ? `background-image: url('${jam.preview_image_url}')` : ''}
    >
        {jam.preview_image_url && <div class="jam__overlay"></div>}
        <h3 class="jam__title">{jam.title}</h3>
        <p class="jam__desc">{jam.description || 'Join the latest game jam!'}</p>
        <span class="jam__date">Ends: {new Date(jam.end_date).toLocaleDateString()}</span>
    </a>
</div>

<style>
    .jam {
        display: flex;
    }
    .jam__item {
        flex: 1;
        background: var(--primary);
        border-radius: 0.75rem;
        padding: 2rem;
        display: flex;
        flex-direction: column;
        align-items: start;
        text-align: left;
        text-decoration: none;
        transition: transform 0.2s ease;
        position: relative;
        overflow: hidden;
        background-size: cover;
        background-position: center;
        min-height: 200px;
    }
    .jam__item:hover {
        transform: translateY(-2px);
    }
    .jam__overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(to bottom, rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.6));
        z-index: 0;
    }
    .jam__title {
        font-size: var(--text-3xl);
        margin-bottom: 0.5rem;
        color: var(--accent);
        position: relative;
        z-index: 1;
    }
    .jam__desc {
        font-size: var(--text-base);
        line-height: var(--leading-normal);
        color: var(--accent-foreground);
        position: relative;
        z-index: 1;
        flex: 1;
    }
    .jam__date {
        font-size: var(--text-sm);
        color: var(--accent-foreground);
        opacity: 0.8;
        position: relative;
        z-index: 1;
        margin-top: var(--spacing-2xl);
    }

    /* Responsive: Reduce padding and font size on mobile */
    @media (max-width: 768px) {
        .jam__item {
            padding: var(--spacing-2xl);
        }

        .jam__title {
            font-size: var(--text-2xl);
        }

        .jam__desc {
            font-size: var(--text-sm);
        }
    }
</style>