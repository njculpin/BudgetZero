---
import type { CategoryVotingResult, Product } from "@/types";
import Card from "./Card.astro";
import CardContent from "./CardContent.astro";

interface Props {
  results: CategoryVotingResult[];
  productsMap: Map<string, Product>;
}

const { results, productsMap } = Astro.props;
---

<div class="jam-results">
  {results.map((categoryResult) => (
    <Card>
      <CardContent>
        <div class="jam-results__category">
          <h3 class="jam-results__category-title">{categoryResult.category.title}</h3>
          {categoryResult.category.description && (
            <p class="jam-results__category-description">
              {categoryResult.category.description}
            </p>
          )}

          {categoryResult.products.length > 0 ? (
            <div class="jam-results__podium">
              {categoryResult.products.slice(0, 3).map((entry) => {
                const product = productsMap.get(entry.product_id);
                if (!product) return null;

                return (
                  <div
                    class={`jam-results__entry jam-results__entry--${
                      entry.rank === 1 ? "winner" : entry.rank === 2 ? "second" : "third"
                    }`}
                  >
                    {entry.rank === 1 && (
                      <div class="jam-results__badge jam-results__badge--winner">
                        🏆 Winner
                      </div>
                    )}
                    {entry.rank === 2 && (
                      <div class="jam-results__badge jam-results__badge--second">
                        🥈 2nd Place
                      </div>
                    )}
                    {entry.rank === 3 && (
                      <div class="jam-results__badge jam-results__badge--third">
                        🥉 3rd Place
                      </div>
                    )}

                    <a
                      href={`/products/${product.handle}`}
                      class="jam-results__product-link"
                    >
                      <div class="jam-results__product-card">
                        {product.cover_image_url && (
                          <div
                            class="jam-results__product-image"
                            style={`background-image: url('${product.cover_image_url}')`}
                          />
                        )}
                        <div class="jam-results__product-content">
                          <h4 class="jam-results__product-title">{product.title}</h4>
                        </div>
                      </div>
                    </a>

                    <div class="jam-results__votes">
                      {entry.vote_count} {entry.vote_count === 1 ? "vote" : "votes"}
                    </div>
                  </div>
                );
              })}
            </div>
          ) : (
            <p class="jam-results__empty">No votes received in this category.</p>
          )}

          {categoryResult.products.length > 3 && (
            <details class="jam-results__full-list">
              <summary class="jam-results__toggle">View All Results ({categoryResult.products.length} products)</summary>
              <div class="jam-results__list">
                {categoryResult.products.slice(3).map((entry) => {
                  const product = productsMap.get(entry.product_id);
                  if (!product) return null;

                  return (
                    <div class="jam-results__list-item">
                      <span class="jam-results__rank">#{entry.rank}</span>
                      <a href={`/products/${product.handle}`} class="jam-results__list-link">
                        {product.title}
                      </a>
                      <span class="jam-results__list-votes">
                        {entry.vote_count} {entry.vote_count === 1 ? "vote" : "votes"}
                      </span>
                    </div>
                  );
                })}
              </div>
            </details>
          )}
        </div>
      </CardContent>
    </Card>
  ))}
</div>

<style>
  /* ===== Jam Results Base ===== */
  .jam-results {
    display: flex;
    flex-direction: column;
    gap: var(--gap-3xl);
  }

  /* ===== Category ===== */
  .jam-results__category {
    padding: var(--spacing-xl) 0;
  }

  .jam-results__category-title {
    margin: 0 0 var(--spacing-md) 0;
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-bold);
    color: var(--foreground);
  }

  .jam-results__category-description {
    margin: 0 0 var(--spacing-3xl) 0;
    font-size: var(--text-sm);
    color: var(--muted-foreground);
    line-height: var(--leading-relaxed);
  }

  /* ===== Podium ===== */
  .jam-results__podium {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--gap-xl);
    margin-bottom: var(--spacing-3xl);
  }

  .jam-results__entry {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
  }

  .jam-results__badge {
    position: absolute;
    top: var(--spacing-md);
    right: var(--spacing-md);
    z-index: 2;
    padding: var(--spacing-xs) var(--spacing-lg);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    box-shadow: var(--shadow-sm);
  }

  .jam-results__badge--winner {
    background-color: #fbbf24;
    color: #78350f;
  }

  .jam-results__badge--second {
    background-color: #d1d5db;
    color: #374151;
  }

  .jam-results__badge--third {
    background-color: #cd7f32;
    color: #fff;
  }

  .jam-results__product-link {
    text-decoration: none;
  }

  .jam-results__product-card {
    display: flex;
    flex-direction: column;
    background-color: var(--card);
    border: var(--border-width-default) solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: all var(--duration-normal) var(--ease-in-out);
  }

  .jam-results__product-link:hover .jam-results__product-card {
    border-color: var(--primary);
    box-shadow: var(--shadow-md);
  }

  .jam-results__product-image {
    width: 100%;
    height: 12rem;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-color: var(--muted);
  }

  .jam-results__product-content {
    padding: var(--spacing-lg);
  }

  .jam-results__product-title {
    margin: 0;
    font-size: var(--text-base);
    font-weight: var(--font-weight-semibold);
    color: var(--foreground);
    line-height: var(--leading-tight);
  }

  .jam-results__votes {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--muted-foreground);
    text-align: center;
  }

  .jam-results__entry--winner .jam-results__votes {
    color: #fbbf24;
  }

  .jam-results__entry--second .jam-results__votes {
    color: #9ca3af;
  }

  .jam-results__entry--third .jam-results__votes {
    color: #cd7f32;
  }

  /* ===== Empty State ===== */
  .jam-results__empty {
    padding: var(--spacing-3xl);
    text-align: center;
    font-size: var(--text-sm);
    color: var(--muted-foreground);
    background-color: var(--muted);
    border-radius: var(--radius-md);
  }

  /* ===== Full List ===== */
  .jam-results__full-list {
    margin-top: var(--spacing-3xl);
    border-top: 1px solid var(--border);
    padding-top: var(--spacing-xl);
  }

  .jam-results__toggle {
    cursor: pointer;
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--primary);
    user-select: none;
    padding: var(--spacing-md);
    border-radius: var(--radius-md);
    transition: background-color var(--duration-fast) var(--ease-in-out);
  }

  .jam-results__toggle:hover {
    background-color: var(--muted);
  }

  .jam-results__list {
    margin-top: var(--spacing-lg);
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm);
  }

  .jam-results__list-item {
    display: flex;
    align-items: center;
    gap: var(--gap-md);
    padding: var(--spacing-md) var(--spacing-lg);
    background-color: var(--muted);
    border-radius: var(--radius-md);
    transition: background-color var(--duration-fast) var(--ease-in-out);
  }

  .jam-results__list-item:hover {
    background-color: var(--accent);
  }

  .jam-results__rank {
    font-weight: var(--font-weight-semibold);
    color: var(--muted-foreground);
    min-width: 3ch;
  }

  .jam-results__list-link {
    flex: 1;
    color: var(--foreground);
    text-decoration: none;
    font-size: var(--text-sm);
  }

  .jam-results__list-link:hover {
    text-decoration: underline;
  }

  .jam-results__list-votes {
    font-size: var(--text-xs);
    color: var(--muted-foreground);
  }

  /* ===== Responsive ===== */
  @media (max-width: 768px) {
    .jam-results__podium {
      grid-template-columns: 1fr;
    }

    .jam-results__badge {
      top: var(--spacing-sm);
      right: var(--spacing-sm);
      padding: var(--spacing-xs) var(--spacing-md);
    }
  }
</style>
