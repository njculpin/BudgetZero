---
import type { JamProductReview } from '@/types';
import RatingStars from './RatingStars.astro';
import Avatar from './Avatar.astro';

interface Props {
  review: JamProductReview;
  reviewer: { name?: string; handle: string; avatar_url?: string };
  jamHandle?: string;
  featured?: boolean;
}

const { review, reviewer, jamHandle, featured = false } = Astro.props;

const reviewDate = new Date(review.created_at);
const formattedDate = reviewDate.toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric'
});
---

<article class={`product-review ${featured ? 'product-review--featured' : ''}`}>
  <div class="product-review__header">
    <div class="product-review__author">
      <Avatar
        src={reviewer.avatar_url}
        alt={reviewer.name || reviewer.handle}
        size="sm"
      />
      <div class="product-review__author-info">
        <h4 class="product-review__author-name">
          {reviewer.name || reviewer.handle}
        </h4>
        <p class="product-review__author-handle">@{reviewer.handle}</p>
      </div>
    </div>
    <div class="product-review__meta">
      <time class="product-review__date" datetime={review.created_at}>
        {formattedDate}
      </time>
      {jamHandle && (
        <a href={`/jams/${jamHandle}`} class="product-review__jam-badge">
          Jam Review
        </a>
      )}
    </div>
  </div>

  <div class="product-review__rating">
    <RatingStars rating={review.review_rating} size="sm" />
  </div>

  <div class="product-review__content">
    <p class="product-review__text">{review.review_text}</p>
  </div>
</article>

<style>
/* Block */
.product-review {
  padding: var(--spacing-2xl);
  background-color: var(--card);
  border: var(--border-width-default) solid var(--border);
  border-radius: var(--radius-lg);
  display: flex;
  flex-direction: column;
  gap: var(--gap-lg);
  transition: border-color var(--duration-fast) var(--ease-in-out);
}

.product-review:hover {
  border-color: var(--border-strong);
}

/* Modifier: Featured Review */
.product-review--featured {
  background: linear-gradient(135deg,
    oklch(from var(--primary) l c h / 0.03) 0%,
    oklch(from var(--primary) l c h / 0.06) 100%
  );
  border-color: var(--primary);
  border-width: var(--border-width-thick);
}

/* Element: Header */
.product-review__header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: var(--gap-lg);
  flex-wrap: wrap;
}

/* Element: Author Container */
.product-review__author {
  display: flex;
  align-items: center;
  gap: var(--gap-md);
}

/* Avatar styles now handled by Avatar.astro component */

.product-review__author-info {
  display: flex;
  flex-direction: column;
  gap: var(--gap-xxs);
}

.product-review__author-name {
  margin: 0;
  font-size: var(--text-base);
  font-weight: var(--font-weight-semibold);
  color: var(--foreground);
}

.product-review__author-handle {
  margin: 0;
  font-size: var(--text-sm);
  color: var(--muted-foreground);
}

/* Element: Meta Info */
.product-review__meta {
  display: flex;
  align-items: center;
  gap: var(--gap-md);
  flex-wrap: wrap;
}

.product-review__date {
  font-size: var(--text-sm);
  color: var(--muted-foreground);
}

.product-review__jam-badge {
  display: inline-flex;
  align-items: center;
  padding: var(--spacing-xxs) var(--spacing-md);
  font-size: var(--text-xs);
  font-weight: var(--font-weight-semibold);
  color: var(--primary-foreground);
  background-color: var(--primary);
  border-radius: var(--radius-full);
  text-decoration: none;
  transition: background-color var(--duration-fast) var(--ease-in-out);
}

.product-review__jam-badge:hover {
  background-color: oklch(from var(--primary) calc(l * 0.9) c h);
}

/* Element: Rating */
.product-review__rating {
  display: flex;
  align-items: center;
}

/* Element: Content */
.product-review__content {
  flex: 1;
}

.product-review__text {
  margin: 0;
  font-size: var(--text-base);
  color: var(--foreground);
  line-height: var(--leading-relaxed);
  white-space: pre-wrap;
}

/* Responsive */
@media (max-width: 768px) {
  .product-review {
    padding: var(--spacing-xl);
  }

  .product-review__header {
    flex-direction: column;
    gap: var(--gap-md);
  }

  /* Avatar sizes now handled by Avatar.astro component */
}
</style>
