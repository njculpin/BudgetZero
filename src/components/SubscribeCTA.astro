---
import Label from "./Label.astro"
import Input from "./Input.astro"
import Button from "./Button.astro"
---

<div class="subscribe-card">
  <div class="subscribe-section">
    <h1>Stay Current</h1>
    <p>Subscribe to our news letter to get up to date information on the development and progress of Game Loopers. Be the first to know about upcoming changes and features. We promise not to spam.</p> 
  </div>
   <div class="subscribe-section">
    <form action="/api/subscribe" method="post" class="subscribe-form">
      <div class="subscribe-form__field">
        <Label for="email">Email address</Label>
        <Input
          type="email"
          name="email"
          id="email"
          placeholder="you@example.com"
          required
        />
      </div>
      <Button type="submit" variant="primary" size="md">
        <span slot="text">Sign Up</span>
      </Button>
    </form>
  </div>
</div>


<style>
.subscribe-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
    gap: var(--spacing-3xl);
    margin-bottom: var(--spacing-3xl);
    border-radius: var(--radius-lg);
}

.subscribe-section {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--spacing-3xl);
}

/* 🔹 Form */
.subscribe-form {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.subscribe-form__field {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

/* 🔹 Input */
.subscribe-form input[type="email"] {
  padding: 0.75rem 1rem;
  border-radius: 0.5rem;
  border: 1px solid var(--border, hsl(0 0% 85%));
  background: var(--input-bg, hsl(0 0% 98%));
  color: var(--foreground, hsl(0 0% 10%));
  font-size: 1rem;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.subscribe-form input[type="email"]:focus {
  outline: none;
  border-color: var(--accent, hsl(220 80% 60%));
  box-shadow: 0 0 0 3px hsl(220 80% 60% / 0.2);
}

/* 🔹 Button */
.subscribe-form button {
  width: 100%;
  font-weight: 600;
  border-radius: 0.5rem;
  padding: 0.75rem 1.25rem;
}

/* 🔹 Typography */
.subscribe-card h2,
.subscribe-card .card-title {
  font-size: 1.4rem;
  font-weight: 600;
  margin-bottom: 0.25rem;
}

.subscribe-card p,
.subscribe-card .card-description {
  font-size: 0.95rem;
  color: var(--muted-foreground, hsl(0 0% 40%));
}

/* 🔹 Divider (optional section if you use it later) */
.subscribe-form__divider {
  position: relative;
  text-align: center;
  margin: 1.5rem 0;
}

.subscribe-form__divider::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  height: 1px;
  background-color: var(--border, hsl(0 0% 90%));
}

.subscribe-form__divider-text {
  position: relative;
  background-color: var(--card-bg, hsl(0 0% 100%));
  padding: 0 0.75rem;
  font-size: 0.85rem;
  color: var(--muted-foreground, hsl(0 0% 45%));
}
</style>
