---
const { className = "", for: htmlFor } = Astro.props;
---

<label for={htmlFor} class={`label ${className}`}>
  <slot />
</label>

<style>
/* ===== Base Label ===== */
.label {
  display: inline-block;
  font-size: 0.875rem;
  font-weight: 500;
  line-height: 1;
  color: var(--color-text, #111);
  margin-bottom: 0.5rem;
  cursor: pointer;
}

/* ===== Disabled State ===== */
.label[data-disabled="true"] {
  cursor: not-allowed;
  opacity: 0.7;
}

/* ===== Peer Invalid ===== */
.label:has(+ .input[aria-invalid="true"]) {
  color: var(--color-destructive, #ef4444);
}
</style>
