---
interface Props {
  variant: "error" | "success" | "warning" | "info";
  message: string;
}

const { variant, message } = Astro.props;
---

<div class={`alert alert--${variant}`}>
  <p class="alert__message">{message}</p>
</div>

<style>
  .alert {
    padding: var(--spacing-lg) var(--spacing-2xl);
    border-radius: var(--radius-md);
    margin-bottom: var(--spacing-2xl);
  }

  .alert--error {
    background-color: var(--error-bg);
    border: var(--border-width-default) solid var(--error-border);
  }

  .alert--success {
    background-color: var(--success-bg);
    border: var(--border-width-default) solid var(--success-border);
  }

  .alert--warning {
    background-color: var(--warning-bg);
    border: var(--border-width-default) solid var(--warning-border);
  }

  .alert--info {
    background-color: var(--info-bg);
    border: var(--border-width-default) solid var(--info-border);
  }

  .alert__message {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--foreground);
  }

  .alert--error .alert__message {
    color: var(--error-fg);
  }

  .alert--success .alert__message {
    color: var(--success-fg);
  }

  .alert--warning .alert__message {
    color: var(--warning-fg);
  }

  .alert--info .alert__message {
    color: var(--info-fg);
  }
</style>
