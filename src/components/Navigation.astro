---
import Button from "./Button.astro";
import NavigationMobile from "./islands/NavigationMobile";
import { setSession } from '@/lib/auth';

// Check authentication via cookies
let isAuthenticated = false;
const accessToken = Astro.cookies.get("sb-access-token");
const refreshToken = Astro.cookies.get("sb-refresh-token");

if (accessToken && refreshToken) {
  try {
    const session = await setSession({
      refresh_token: refreshToken.value,
      access_token: accessToken.value,
    });
    if (!session.error && session.data.user) {
      isAuthenticated = true;
    }
  } catch (error) {
    // User not authenticated
  }
}

const navLinks = [
  { href: "/documents", label: "Documents" },
  { href: "/assets", label: "Assets" },
  { href: "/products", label: "Products" },
  { href: "/jams", label: "Jams" },
  { href: "/purchases", label: "Purchases" },
  { href: "/users", label: "Users" },
  { href: "/tags", label: "Tags" },
  { href: "/about", label: "About" },
  { href: "/cart", label: "Cart" },
  { href: "/terms", label: "Terms" },
  { href: "/privacy", label: "Privacy" },
];
---

<nav class={`navigation`}>
  <div class="navigation__container">
    <a href="/" class="navigation__brand">
      <span class="navigation__logo"><h3>Game Loopers</h3></span>
    </a>

    {/* Mobile Navigation */}
    <div class="navigation__mobile">
      <NavigationMobile client:load isAuthenticated={isAuthenticated} links={isAuthenticated ? navLinks : []} />
    </div>

    {
    isAuthenticated && 
    <div class="navigation__menu">
      <a href="/documents">
        <Button variant="ghost" size="sm">
          <span slot="text"><p>Documents</p></span>
        </Button>
      </a>
      <a href="/assets">
        <Button variant="ghost" size="sm">
          <span slot="text"><p>Assets</p></span>
        </Button>
      </a>
      <a href="/products">
        <Button variant="ghost" size="sm">
          <span slot="text"><p>Products</p></span>
        </Button>
      </a>
      <a href="/jams">
        <Button variant="ghost" size="sm">
          <span slot="text"><p>Jams</p></span>
        </Button>
      </a>
      <a href="/purchases">
        <Button variant="ghost" size="sm">
          <span slot="text"><p>Purchases</p></span>
        </Button>
      </a>
      <a href="/users">
        <Button variant="ghost" size="sm">
          <span slot="text"><p>Users</p></span>
        </Button>
      </a>
      <a href="/tags">
        <Button variant="ghost" size="sm">
          <span slot="text"><p>Tags</p></span>
        </Button>
      </a>
      <a href="/about">
        <Button variant="ghost" size="sm">
          <span slot="text"><p>About</p></span>
        </Button>
      </a>
      <a href="/cart">
        <Button variant="ghost" size="sm">
          <span slot="text"><p>Cart</p></span>
        </Button>
      </a>
      <a href="/terms">
        <Button variant="ghost" size="sm">
          <span slot="text"><p>Terms</p></span>
        </Button>
      </a>
      <a href="/privacy">
        <Button variant="ghost" size="sm">
          <span slot="text"><p>Privacy</p></span>
        </Button>
      </a>
    </div>
    }

    <div class="navigation__actions">
      {isAuthenticated ? (
        <>
          <a href="/dashboard">
            <Button variant="ghost" size="sm">
              <span slot="text"><p>Dashboard</p></span>
            </Button>
          </a>
          <form action="/api/auth/sign-out" method="post" class="navigation__signout-form">
            <Button type="submit" variant="outline" size="sm">
              <span slot="text">Sign out</span>
            </Button>
          </form>
        </>
      ) : (
        <>
          <a href="/sign-in">
            <Button variant="ghost" size="sm">
              <span slot="text">Sign in</span>
            </Button>
          </a>
          <a href="/sign-up">
            <Button variant="accent" size="sm">
              <span slot="text">Sign up</span>
            </Button>
          </a>
        </>
      )}
    </div>
  </div>
</nav>

<style>
/* ===== Navigation Base ===== */
.navigation {
  position: sticky;
  top: 0;
  z-index: 50;
  background-color: var(--background);
  backdrop-filter: blur(8px);
}

.navigation__container {
  max-width: var(--container-7xl);
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0;
  gap: 2rem;
}

/* ===== Brand ===== */
.navigation__brand {
  display: flex;
  align-items: center;
  gap: var(--gap-xs);
  text-decoration: none;
  color: var(--foreground);
}

.navigation__logo {
  font-size: var(--text-xl);
  color: var(--primary);
  margin-right: var(--spacing-lg)
}

/* ===== Menu ===== */
.navigation__menu {
  display: none;
  align-items: center;
  gap: 1rem;
  flex: 1;
}

@media (min-width: 768px) {
  .navigation__menu {
    display: flex;
  }
}

.navigation__link {
  position: relative;
  padding: var(--spacing-xs) 0.75rem;
  font-size: var(--text-sm);
  font-weight: var(--font-weight-medium);
  color: var(--muted-foreground);
  text-decoration: none;
  border-radius: var(--radius-md);
  transition: color 0.2s var(--ease-in-out), background-color 0.2s var(--ease-in-out);
}

.navigation__link:hover {
  color: var(--foreground);
  background-color: var(--accent);
}

.navigation__link--active {
  color: var(--foreground);
  background-color: var(--accent);
}

/* ===== Actions ===== */
.navigation__actions {
  display: flex;
  align-items: center;
  gap: var(--gap-xs);
}

.navigation__actions a {
  text-decoration: none;
}

.navigation__signout-form {
  margin: 0;
  display: inline-flex;
}

/* ===== Mobile Navigation ===== */
.navigation__mobile {
  display: block;
}

@media (min-width: 768px) {
  .navigation__mobile {
    display: none;
  }
}

/* Hamburger Button */
.navigation__hamburger {
  display: flex;
  flex-direction: column;
  justify-content: space-around;
  width: 2rem;
  height: 2rem;
  background: transparent;
  border: none;
  cursor: pointer;
  padding: 0;
  z-index: 60;
}

.navigation__hamburger-line {
  width: 2rem;
  height: 0.25rem;
  background-color: var(--foreground);
  border-radius: 0.25rem;
  transition: all 0.3s ease;
  transform-origin: center;
}

.navigation__hamburger-line--open-1 {
  transform: rotate(45deg) translateY(0.5rem);
}

.navigation__hamburger-line--open-2 {
  opacity: 0;
}

.navigation__hamburger-line--open-3 {
  transform: rotate(-45deg) translateY(-0.5rem);
}

/* Backdrop */
.navigation__backdrop {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 55;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

/* Mobile Drawer */
.navigation__drawer {
  position: fixed;
  top: 0;
  right: -100%;
  width: 80%;
  max-width: 320px;
  height: 100%;
  background-color: var(--background);
  box-shadow: -2px 0 8px rgba(0, 0, 0, 0.1);
  z-index: 60;
  transition: right 0.3s ease;
  display: flex;
  flex-direction: column;
  overflow-y: auto;
}

.navigation__drawer--open {
  right: 0;
}

.navigation__drawer-nav {
  display: flex;
  flex-direction: column;
  padding: var(--spacing-3xl) var(--spacing-2xl);
  gap: var(--spacing-sm);
  flex: 1;
}

.navigation__drawer-link {
  padding: var(--spacing-md);
  font-size: var(--text-md);
  color: var(--foreground);
  text-decoration: none;
  border-radius: var(--radius-md);
  transition: background-color 0.2s ease;
}

.navigation__drawer-link:hover {
  background-color: var(--accent);
}

.navigation__drawer-actions {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
  padding: var(--spacing-2xl);
  border-top: 1px solid var(--border);
}

.navigation__drawer-button {
  padding: var(--spacing-md) var(--spacing-lg);
  font-size: var(--text-md);
  font-weight: var(--font-weight-medium);
  text-align: center;
  text-decoration: none;
  border-radius: var(--radius-md);
  border: none;
  cursor: pointer;
  transition: all 0.2s ease;
  width: 100%;
}

.navigation__drawer-button--primary {
  background-color: var(--primary);
  color: var(--primary-foreground);
}

.navigation__drawer-button--primary:hover {
  opacity: 0.9;
}

.navigation__drawer-button--secondary {
  background-color: transparent;
  color: var(--foreground);
  border: 1px solid var(--border);
}

.navigation__drawer-button--secondary:hover {
  background-color: var(--accent);
}

/* Hide actions on mobile (shown in drawer) */
@media (max-width: 767px) {
  .navigation__actions {
    display: none;
  }
}
</style>
