---
import Button from "./Button.astro";
import NavigationMobile from "@/components/interactive/NavigationMobile";
import NavigationDropdown from "@/components/interactive/NavigationDropdown";
import NavigationUserMenu from "@/components/interactive/NavigationUserMenu";
import { setSession } from '@/lib/auth';
import { getUserById } from '@/lib/data-access/users';

// Check authentication via cookies
let isAuthenticated = false;
let userId: string | null = null;
let userHandle = '';

const accessToken = Astro.cookies.get("sb-access-token");
const refreshToken = Astro.cookies.get("sb-refresh-token");

if (accessToken && refreshToken) {
  try {
    const session = await setSession({
      refresh_token: refreshToken.value,
      access_token: accessToken.value,
    });
    if (!session.error && session.data.user) {
      isAuthenticated = true;
      userId = session.data.user.id;

      // Fetch user to get handle
      const user = await getUserById(userId);
      if (user) {
        userHandle = user.handle;
      }
    }
  } catch (error) {
    // User not authenticated
  }
}

// Kickstarter-style navigation structure
const userMenuLinks = [
  { href: `/users/${userHandle}`, label: "Profile" },
  { isDivider: true, label: "" },
  { href: "/products", label: "My Products" },
  { href: "/assets", label: "My Assets" },
  { href: "/documents", label: "My Documents" },
  { isDivider: true, label: "" },
  { href: "/purchases", label: "Purchases" },
  { href: "/connect/onboarding", label: "Payouts" },
  { isDivider: true, label: "" },
  { href: "/settings", label: "Settings" },
  { isSignOut: true, label: "Sign out" },
];

// Mobile navigation links
const authedLinks = [
  { href: "/products", label: "Products" },
  { href: "/jams", label: "Jams" },
  { href: "/cart", label: "Cart" },
  { href: `/users/${userHandle}`, label: "Profile" },
  { href: "/assets", label: "My Assets" },
  { href: "/documents", label: "My Documents" },
  { href: "/purchases", label: "Purchases" },
  { href: "/connect/onboarding", label: "Payouts" },
  { href: "/settings", label: "Settings" },
];

const unAuthedLinks = [
  { href: "/products", label: "Products" },
  { href: "/jams", label: "Jams" },
  { href: "/about", label: "About" },
];
---

<nav class="navigation" role="navigation" aria-label="Main navigation">
  <div class="navigation__container">
    <a href="/" class="navigation__brand">
      <span class="navigation__logo">Game Loopers</span>
    </a>

    {/* Mobile Navigation */}
    <div class="navigation__mobile">
      <NavigationMobile client:load isAuthenticated={isAuthenticated} links={isAuthenticated ? authedLinks : unAuthedLinks} />
    </div>

    {/* Main Navigation Links */}
    <div class="navigation__menu">
      <a href="/products" class="navigation__link">Products</a>
      <a href="/jams" class="navigation__link">Jams</a>
    </div>

    <div class="navigation__actions">
      {isAuthenticated ? (
        <>
          <a href="/cart">
            <Button variant="ghost" size="sm">
              <span slot="text">Cart</span>
            </Button>
          </a>
          <NavigationUserMenu client:load userHandle={userHandle} links={userMenuLinks} />
        </>
      ) : (
        <>
          <a href="/sign-in">
            <Button variant="ghost" size="sm">
              <span slot="text">Sign in</span>
            </Button>
          </a>
          <a href="/sign-up">
            <Button variant="accent" size="sm">
              <span slot="text">Sign up</span>
            </Button>
          </a>
        </>
      )}
    </div>
  </div>
</nav>

<style>
/* ===== Navigation Base ===== */
.navigation {
  position: sticky;
  top: 0;
  z-index: 50;
  background-color: var(--background);
  backdrop-filter: blur(8px);
}

.navigation__container {
  max-width: var(--container-7xl);
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-2xl) 0;
  gap: 2rem;
}

/* ===== Brand ===== */
.navigation__brand {
  display: flex;
  align-items: center;
  gap: var(--gap-xs);
  text-decoration: none;
  color: var(--foreground);
  border-radius: var(--radius-md);
}

.navigation__brand:focus-visible {
  outline: 2px solid var(--ring);
  outline-offset: 2px;
}

.navigation__logo {
  font-size: var(--text-xl);
  font-weight: var(--font-weight-bold);
  color: var(--primary);
  margin-right: var(--spacing-lg);
}

/* ===== Menu ===== */
.navigation__menu {
  display: none;
  align-items: center;
  gap: 1rem;
  flex: 1;
}

@media (min-width: 768px) {
  .navigation__menu {
    display: flex;
  }
}

.navigation__link {
  position: relative;
  padding: var(--spacing-xs) 0.75rem;
  font-size: var(--text-sm);
  font-weight: var(--font-weight-medium);
  color: var(--muted-foreground);
  text-decoration: none;
  border-radius: var(--radius-md);
  transition: color 0.2s var(--ease-in-out), background-color 0.2s var(--ease-in-out);
}

.navigation__link:hover {
  color: var(--foreground);
  background-color: var(--accent);
}

.navigation__link:focus-visible {
  outline: 2px solid var(--ring);
  outline-offset: 2px;
}

.navigation__link--active {
  color: var(--foreground);
  background-color: var(--accent);
}

/* ===== Actions ===== */
.navigation__actions {
  display: flex;
  align-items: center;
  gap: var(--gap-xs);
}

.navigation__actions a {
  text-decoration: none;
}

.navigation__signout-form {
  margin: 0;
  display: inline-flex;
}

/* ===== Mobile Navigation ===== */
.navigation__mobile {
  display: block;
}

@media (min-width: 768px) {
  .navigation__mobile {
    display: none;
  }
}

/* Hamburger Button */
.navigation__hamburger {
  display: flex;
  flex-direction: column;
  justify-content: space-around;
  width: 2rem;
  height: 2rem;
  background: transparent;
  border: none;
  cursor: pointer;
  padding: 0;
  z-index: 60;
  border-radius: var(--radius-sm);
}

.navigation__hamburger:focus-visible {
  outline: 2px solid var(--ring);
  outline-offset: 2px;
}

.navigation__hamburger-line {
  width: 2rem;
  height: 0.25rem;
  background-color: var(--foreground);
  border-radius: 0.25rem;
  transition: all 0.3s ease;
  transform-origin: center;
}

.navigation__hamburger-line--open-1 {
  transform: rotate(45deg) translateY(0.5rem);
}

.navigation__hamburger-line--open-2 {
  opacity: 0;
}

.navigation__hamburger-line--open-3 {
  transform: rotate(-45deg) translateY(-0.5rem);
}

/* Backdrop */
.navigation__backdrop {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 55;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

/* Mobile Drawer */
.navigation__drawer {
  position: fixed;
  top: 0;
  right: -100%;
  width: 80%;
  max-width: 320px;
  height: 100%;
  background-color: var(--background);
  box-shadow: -2px 0 8px rgba(0, 0, 0, 0.1);
  z-index: 60;
  transition: right 0.3s ease;
  display: flex;
  flex-direction: column;
  overflow-y: auto;
}

.navigation__drawer--open {
  right: 0;
}

.navigation__drawer-nav {
  display: flex;
  flex-direction: column;
  padding: var(--spacing-3xl) var(--spacing-2xl);
  gap: var(--spacing-sm);
  flex: 1;
}

.navigation__drawer-link {
  padding: var(--spacing-md);
  font-size: var(--text-base);
  color: var(--foreground);
  text-decoration: none;
  border-radius: var(--radius-md);
  transition: background-color 0.2s ease;
}

.navigation__drawer-link:hover {
  background-color: var(--accent);
}

.navigation__drawer-link:focus-visible {
  outline: 2px solid var(--ring);
  outline-offset: 2px;
}

.navigation__drawer-actions {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
  padding: var(--spacing-2xl);
  border-top: 1px solid var(--border);
}

.navigation__drawer-button {
  padding: var(--spacing-md) var(--spacing-lg);
  font-size: var(--text-base);
  font-weight: var(--font-weight-medium);
  text-align: center;
  text-decoration: none;
  border-radius: var(--radius-md);
  border: none;
  cursor: pointer;
  transition: all 0.2s ease;
  width: 100%;
}

.navigation__drawer-button:focus-visible {
  outline: 2px solid var(--ring);
  outline-offset: 2px;
}

.navigation__drawer-button--primary {
  background-color: var(--primary);
  color: var(--primary-foreground);
}

.navigation__drawer-button--primary:hover {
  opacity: 0.9;
}

.navigation__drawer-button--secondary {
  background-color: transparent;
  color: var(--foreground);
  border: 1px solid var(--border);
}

.navigation__drawer-button--secondary:hover {
  background-color: var(--accent);
}

/* Hide actions on mobile (shown in drawer) */
@media (max-width: 767px) {
  .navigation__actions {
    display: none;
  }
}
</style>
