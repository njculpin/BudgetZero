---
import Button from "./Button.astro";
import NavigationMobile from "@/components/interactive/NavigationMobile";
import NavigationUserMenu from "@/components/interactive/NavigationUserMenu";
import { setSession } from '@/lib/auth';
import { getUserById } from '@/lib/data-access/users';
import { getRecentProducts, getUserProducts, type ProductSummary } from '@/lib/data-access/products';
import { getRecentDocuments, getUserDocuments, type DocumentSummary } from '@/lib/data-access/documents';
import { getUnreadNotificationCount } from '@/lib/data-access/notifications';

// Check authentication via cookies
let isAuthenticated = false;
let userId: string | null = null;
let userHandle = '';
let recentProducts: ProductSummary[] = [];
let totalProductCount = 0;
let recentDocuments: DocumentSummary[] = [];
let totalDocumentCount = 0;
let unreadNotificationCount = 0;

const accessToken = Astro.cookies.get("sb-access-token");
const refreshToken = Astro.cookies.get("sb-refresh-token");

if (accessToken && refreshToken) {
  try {
    const session = await setSession({
      refresh_token: refreshToken.value,
      access_token: accessToken.value,
    });
    if (!session.error && session.data.user) {
      isAuthenticated = true;
      userId = session.data.user.id;

      // Fetch user to get handle
      const user = await getUserById(userId);
      if (user) {
        userHandle = user.handle;
      }

      // Fetch recent products for navigation dropdown
      recentProducts = await getRecentProducts(userId, 3);
      const allProducts = await getUserProducts(userId);
      totalProductCount = allProducts.length;

      // Fetch recent documents for navigation dropdown
      recentDocuments = await getRecentDocuments(userId, 2);
      const allDocuments = await getUserDocuments(userId);
      totalDocumentCount = allDocuments.length;

      // Fetch unread notification count for badge
      unreadNotificationCount = await getUnreadNotificationCount(userId);
    }
  } catch (error) {
    // User not authenticated
  }
}

// Kickstarter-style navigation structure
const userMenuLinks = [
  { href: `/users/${userHandle}`, label: "Profile" },
  { isDivider: true, label: "" },
  { href: "/purchases", label: "Purchases" },
  { isDivider: true, label: "" },
  { href: "/settings", label: "Settings" },
  { isSignOut: true, label: "Sign out" },
];

// Mobile navigation links
const authedLinks = [
  { href: "/products", label: "Products" },
  { href: "/cart", label: "Cart" },
  { href: `/users/${userHandle}`, label: "Profile" },
  { href: "/purchases", label: "Purchases" },
  { href: "/settings", label: "Settings" },
];

const unAuthedLinks = [
  { href: "/products", label: "Products" },
  { href: "/about", label: "About" },
];
---

<nav class="navigation" role="navigation" aria-label="Main navigation">
  <div class="navigation__container">
    <a href="/" class="navigation__brand">
      <span class="navigation__logo">Game Loopers</span>
    </a>

    {/* Mobile Navigation */}
    <div class="navigation__mobile">
      <NavigationMobile client:load isAuthenticated={isAuthenticated} links={isAuthenticated ? authedLinks : unAuthedLinks} />
    </div>

    {/* Main Navigation Links */}
    <div class="navigation__menu">
      <a href="/products" class="navigation__link">Products</a>
      <a href="/jams" class="navigation__link">Jams</a>
      <a href="/users" class="navigation__link">Creators</a>
      <a href="/tags" class="navigation__link">Tags</a>
    </div>

    <div class="navigation__actions">
      {isAuthenticated ? (
        <>
          <a href="/cart" class="navigation__cart">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="9" cy="21" r="1"></circle>
              <circle cx="20" cy="21" r="1"></circle>
              <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
            </svg>
            <span class="sr-only">Shopping cart</span>
          </a>
          <a href="/notifications" class="navigation__notifications">
            <svg class="navigation__notifications-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
              <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
            </svg>
            {unreadNotificationCount > 0 && (
              <span class="navigation__notifications-badge">{unreadNotificationCount}</span>
            )}
            <span class="sr-only">Notifications {unreadNotificationCount > 0 ? `(${unreadNotificationCount} unread)` : ''}</span>
          </a>
          <NavigationUserMenu
            client:load
            userHandle={userHandle}
            links={userMenuLinks}
            recentProducts={recentProducts}
            totalProductCount={totalProductCount}
          />
        </>
      ) : (
        <>
          <a href="/sign-in">
            <Button variant="ghost" size="sm">
              <span slot="text">Sign in</span>
            </Button>
          </a>
          <a href="/sign-up">
            <Button variant="primary" size="sm">
              <span slot="text">Start Creating</span>
            </Button>
          </a>
        </>
      )}
    </div>
  </div>
</nav>

<style>
/* ===== Navigation Base ===== */
.navigation {
  position: sticky;
  top: 0;
  z-index: 50;
  background-color: var(--background);
  backdrop-filter: blur(8px);
  border-bottom: 1px solid var(--border);
}

.navigation__container {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-xl) var(--spacing-2xl);
  gap: var(--spacing-3xl);
}

/* ===== Brand ===== */
.navigation__brand {
  display: flex;
  align-items: center;
  gap: var(--gap-xs);
  text-decoration: none;
  color: var(--foreground);
  border-radius: var(--radius-md);
}

.navigation__brand:focus-visible {
  outline: 2px solid var(--ring);
  outline-offset: 2px;
}

.navigation__logo {
  font-size: var(--text-xl);
  font-weight: var(--font-weight-bold);
  color: var(--primary);
  margin-right: var(--spacing-lg);
}

/* ===== Menu ===== */
.navigation__menu {
  display: none;
  align-items: center;
  gap: var(--spacing-2xl);
  flex: 1;
  justify-content: center;
}

@media (min-width: 768px) {
  .navigation__menu {
    display: flex;
  }
}

.navigation__link {
  position: relative;
  padding: var(--spacing-sm) var(--spacing-lg);
  font-size: var(--text-base);
  font-weight: var(--font-weight-semibold);
  color: var(--foreground);
  text-decoration: none;
  border-radius: var(--radius-md);
  transition: color 0.2s var(--ease-in-out), background-color 0.2s var(--ease-in-out);
}

.navigation__link:hover {
  color: var(--primary);
  background-color: var(--accent);
}

.navigation__link:focus-visible {
  outline: 2px solid var(--ring);
  outline-offset: 2px;
}

.navigation__link--active {
  color: var(--primary);
  background-color: var(--accent);
}

/* ===== Actions ===== */
.navigation__actions {
  display: flex;
  align-items: center;
  gap: var(--gap-xs);
}

.navigation__actions a {
  text-decoration: none;
}

.navigation__signout-form {
  margin: 0;
  display: inline-flex;
}

/* ===== Mobile Navigation ===== */
.navigation__mobile {
  display: block;
}

@media (min-width: 768px) {
  .navigation__mobile {
    display: none;
  }
}

/* Hamburger Button */
.navigation__hamburger {
  display: flex;
  flex-direction: column;
  justify-content: space-around;
  width: 2rem;
  height: 2rem;
  background: transparent;
  border: none;
  cursor: pointer;
  padding: 0;
  z-index: 60;
  border-radius: var(--radius-sm);
}

.navigation__hamburger:focus-visible {
  outline: 2px solid var(--ring);
  outline-offset: 2px;
}

.navigation__hamburger-line {
  width: 2rem;
  height: 0.25rem;
  background-color: var(--foreground);
  border-radius: 0.25rem;
  transition: all 0.3s ease;
  transform-origin: center;
}

.navigation__hamburger-line--open-1 {
  transform: rotate(45deg) translateY(0.5rem);
}

.navigation__hamburger-line--open-2 {
  opacity: 0;
}

.navigation__hamburger-line--open-3 {
  transform: rotate(-45deg) translateY(-0.5rem);
}

/* Backdrop */
.navigation__backdrop {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 55;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

/* Mobile Drawer */
.navigation__drawer {
  position: fixed;
  top: 0;
  right: -100%;
  width: 80%;
  max-width: 320px;
  height: 100%;
  background-color: var(--background);
  box-shadow: -2px 0 8px rgba(0, 0, 0, 0.1);
  z-index: 60;
  transition: right 0.3s ease;
  display: flex;
  flex-direction: column;
  overflow-y: auto;
}

.navigation__drawer--open {
  right: 0;
}

.navigation__drawer-nav {
  display: flex;
  flex-direction: column;
  padding: var(--spacing-3xl) var(--spacing-2xl);
  gap: var(--spacing-sm);
  flex: 1;
}

.navigation__drawer-link {
  padding: var(--spacing-md);
  font-size: var(--text-base);
  color: var(--foreground);
  text-decoration: none;
  border-radius: var(--radius-md);
  transition: background-color 0.2s ease;
}

.navigation__drawer-link:hover {
  background-color: var(--accent);
}

.navigation__drawer-link:focus-visible {
  outline: 2px solid var(--ring);
  outline-offset: 2px;
}

.navigation__drawer-actions {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
  padding: var(--spacing-2xl);
  border-top: 1px solid var(--border);
}

.navigation__drawer-button {
  padding: var(--spacing-md) var(--spacing-lg);
  font-size: var(--text-base);
  font-weight: var(--font-weight-medium);
  text-align: center;
  text-decoration: none;
  border-radius: var(--radius-md);
  border: none;
  cursor: pointer;
  transition: all 0.2s ease;
  width: 100%;
}

.navigation__drawer-button:focus-visible {
  outline: 2px solid var(--ring);
  outline-offset: 2px;
}

.navigation__drawer-button--primary {
  background-color: var(--primary);
  color: var(--primary-foreground);
}

.navigation__drawer-button--primary:hover {
  opacity: 0.9;
}

.navigation__drawer-button--secondary {
  background-color: transparent;
  color: var(--foreground);
  border: 1px solid var(--border);
}

.navigation__drawer-button--secondary:hover {
  background-color: var(--accent);
}

/* Show only cart and notifications on mobile (other actions shown in drawer) */
@media (max-width: 767px) {
  .navigation__actions {
    display: flex;
    gap: var(--gap-xs);
  }

  /* Hide everything except cart and notifications */
  .navigation__actions > *:not(.navigation__cart):not(.navigation__notifications) {
    display: none;
  }
}

/* ===== Cart Icon ===== */
.navigation__cart {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-sm);
  color: var(--muted-foreground);
  text-decoration: none;
  border-radius: var(--radius-md);
  transition: color 0.2s var(--ease-in-out), background-color 0.2s var(--ease-in-out);
}

.navigation__cart:hover {
  color: var(--foreground);
  background-color: var(--accent);
}

.navigation__cart:focus-visible {
  outline: 2px solid var(--ring);
  outline-offset: 2px;
}

.navigation__cart svg {
  width: 20px;
  height: 20px;
}

/* ===== Notifications Bell ===== */
.navigation__notifications {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-sm);
  color: var(--muted-foreground);
  text-decoration: none;
  border-radius: var(--radius-md);
  transition: color 0.2s var(--ease-in-out), background-color 0.2s var(--ease-in-out);
}

.navigation__notifications:hover {
  color: var(--foreground);
  background-color: var(--accent);
}

.navigation__notifications:focus-visible {
  outline: 2px solid var(--ring);
  outline-offset: 2px;
}

.navigation__notifications-icon {
  width: 20px;
  height: 20px;
}

.navigation__notifications-badge {
  position: absolute;
  top: 2px;
  right: 2px;
  min-width: 18px;
  height: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 var(--spacing-xs);
  font-size: var(--text-xs);
  font-weight: var(--font-weight-bold);
  color: var(--destructive-foreground);
  background-color: var(--destructive);
  border-radius: var(--radius-full);
  border: 2px solid var(--background);
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border-width: 0;
}
</style>
