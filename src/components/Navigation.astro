---
import Button from "./Button.astro";
import { setSession } from '@/lib/auth';

const currentPath = Astro.url.pathname;

// Check authentication via cookies
let isAuthenticated = false;
const accessToken = Astro.cookies.get("sb-access-token");
const refreshToken = Astro.cookies.get("sb-refresh-token");

if (accessToken && refreshToken) {
  try {
    const session = await setSession({
      refresh_token: refreshToken.value,
      access_token: accessToken.value,
    });
    if (!session.error && session.data.user) {
      isAuthenticated = true;
    }
  } catch (error) {
    // User not authenticated
  }
}
---

<nav class={`navigation`}>
  <div class="navigation__container">
    <a href="/" class="navigation__brand">
      <span class="navigation__logo"><h3>Game Loopers</h3></span>
    </a>

    <div class="navigation__menu">
      <a
        href="/documents"
        class={`navigation__link ${currentPath === '/documents' || currentPath.startsWith('/documents/') ? 'navigation__link--active' : ''}`}
      >
        <p>Documents</p>
      </a>
      <a
        href="/assets"
        class={`navigation__link ${currentPath === '/assets' || currentPath.startsWith('/assets/') ? 'navigation__link--active' : ''}`}
      >
        <p>Assets</p>
      </a>
      <a
        href="/products"
        class={`navigation__link ${currentPath === '/products' || currentPath.startsWith('/products/') ? 'navigation__link--active' : ''}`}
      >
        <p>Products</p>
      </a>
      <a
        href="/jams"
        class={`navigation__link ${currentPath === '/jams' || currentPath.startsWith('/jams/') ? 'navigation__link--active' : ''}`}
      >
        <p>Jams</p>
      </a>
    </div>

    <div class="navigation__actions">
      {isAuthenticated ? (
        <>
          <a href="/dashboard">
            <Button variant="ghost" size="sm">
              <span slot="text"><h3>Dashboard</h3></span>
            </Button>
          </a>
          <form action="/api/auth/sign-out" method="post" class="navigation__signout-form">
            <Button type="submit" variant="outline" size="sm">
              <span slot="text">Sign out</span>
            </Button>
          </form>
        </>
      ) : (
        <>
          <a href="/sign-in">
            <Button variant="ghost" size="sm">
              <span slot="text">Sign in</span>
            </Button>
          </a>
          <a href="/sign-up">
            <Button variant="primary" size="sm">
              <span slot="text">Sign up</span>
            </Button>
          </a>
        </>
      )}
    </div>
  </div>
</nav>

<style>
/* ===== Navigation Base ===== */
.navigation {
  position: sticky;
  top: 0;
  z-index: 50;
  width: 100%;
  border-bottom: 1px solid var(--border);
  background-color: oklch(from var(--background) l c h / 0.8);
  backdrop-filter: blur(8px);
}

.navigation__container {
  max-width: var(--container-7xl);
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-xs)
  gap: 2rem;
}

/* ===== Brand ===== */
.navigation__brand {
  display: flex;
  align-items: center;
  gap: var(--gap-xs);
  text-decoration: none;
  color: var(--foreground);
}

.navigation__logo {
  font-size: var(--text-xl);
  font-weight: var(--font-weight-bold);
  color: var(--primary);
  margin-right: var(--spacing-lg)
}

/* ===== Menu ===== */
.navigation__menu {
  display: none;
  align-items: center;
  gap: 1rem;
  flex: 1;
}

@media (min-width: 768px) {
  .navigation__menu {
    display: flex;
  }
}

.navigation__link {
  position: relative;
  padding: var(--spacing-xs) 0.75rem;
  font-size: var(--text-sm);
  font-weight: var(--font-weight-medium);
  color: var(--muted-foreground);
  text-decoration: none;
  border-radius: var(--radius-md);
  transition: color 0.2s var(--ease-in-out), background-color 0.2s var(--ease-in-out);
}

.navigation__link:hover {
  color: var(--foreground);
  background-color: var(--accent);
}

.navigation__link--active {
  color: var(--foreground);
  background-color: var(--accent);
}

/* ===== Actions ===== */
.navigation__actions {
  display: flex;
  align-items: center;
  gap: var(--gap-xs);
}

.navigation__actions a {
  text-decoration: none;
}

.navigation__signout-form {
  margin: 0;
  display: inline-flex;
}
</style>
