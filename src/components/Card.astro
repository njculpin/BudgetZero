---
const { className = "" } = Astro.props;
---

<div class={`card ${className}`}>
  <slot />
</div>

<style>
/* ========== Base Card ========== */
.card {
  display: flex;
  flex-direction: column;
  background-color: var(--card);
  color: var(--card-foreground);
  border: var(--border-width-default) solid var(--border);
  border-radius: var(--radius-xl);
}
</style>
