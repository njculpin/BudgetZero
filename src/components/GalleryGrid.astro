---
export interface GalleryImage {
  url: string;
  alt?: string;
  href: string;
}

export interface Props {
  images: GalleryImage[];
  cols?: number;
  rows?: number;
  title: string
}

const { images, cols = 3, rows = 2, title } = Astro.props;
---
<div>
<h1>{title}</h1>
<div 
  class="gallery" 
  style={`grid-template-columns: repeat(${cols}, 1fr); grid-template-rows: repeat(${rows}, 1fr);`}
>
  {images.map((img) => (
    <div class="gallery__item">
      <a href={img.href}><img src={img.url} alt={img.alt || ''} class="gallery__image" loading="lazy" /></a>
    </div>
  ))}
</div>
</div>

<style>
  .gallery {
    display: grid;
    gap: var(--spacing-3xl);
  }

  .gallery__item {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1; /* Makes squares */
    overflow: hidden;
    border-radius: 0.5rem;
    background-color: #f5f5f5;
  }

  .gallery__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>
