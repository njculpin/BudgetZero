---
interface Props {
  message: string;
}

const { message } = Astro.props;
---

<div class="browse-cta">
  <p class="browse-cta__text">{message}</p>
  <div class="browse-cta__actions">
    <a href="/sign-in" class="button button--primary button--md">
      <span class="button__text">Sign In</span>
    </a>
    <a href="/sign-up" class="button button--ghost button--md">
      <span class="button__text">Sign Up</span>
    </a>
  </div>
</div>

<style>
.browse-cta {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--gap-xl);
  padding: var(--spacing-4xl) var(--spacing-2xl);
  text-align: center;
}

.browse-cta__text {
  font-size: var(--text-lg);
  color: var(--muted-foreground);
  margin: 0;
}

.browse-cta__actions {
  display: flex;
  gap: var(--gap-lg);
  flex-wrap: wrap;
  justify-content: center;
}

/* Responsive */
@media (max-width: 480px) {
  .browse-cta__actions {
    flex-direction: column;
    width: 100%;
  }

  .browse-cta__actions .button {
    width: 100%;
  }
}
</style>
