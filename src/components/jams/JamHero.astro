---
import type { Jam, User } from "@/types";

interface Props {
  jam: Jam;
  isCreator: boolean;
  creator: User | null;
  status: "upcoming" | "active" | "ended";
  startDate: Date;
  endDate: Date;
}

const { jam, isCreator, creator, status, startDate, endDate } =
  Astro.props;
---

<div
  class="jam-hero"
  style={jam.preview_image_url
    ? `background-image: url('${jam.preview_image_url}')`
    : ""}
>
  {jam.preview_image_url && <div class="jam-hero__overlay"></div>}

  <div class="jam-hero__content">
    <h1 class="jam-hero__title">{jam.title}</h1>
    <div class="jam-hero__meta">
      <span class={`jam-hero__status jam-hero__status--${status}`}>
        {status.toUpperCase()}
      </span>
      <span class="jam-hero__dates">
        {startDate.toLocaleDateString()} - {endDate.toLocaleDateString()}
      </span>
    </div>
    {
      creator && (
        <p class="jam-hero__creator">
          Hosted by{" "}
          <a
            href={`/users/${creator.handle}`}
            class="jam-hero__creator-link"
          >
            {creator.name || creator.handle}
          </a>
        </p>
      )
    }
  </div>
</div>

<style>
  /* Jam Hero Section */
  .jam-hero {
    position: relative;
    min-height: 300px;
    background-color: var(--primary);
    background-size: cover;
    background-position: center;
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-bottom: var(--spacing-4xl);
  }

  .jam-hero__overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.4),
      rgba(0, 0, 0, 0.7)
    );
    z-index: 0;
  }

  .jam-hero__content {
    position: relative;
    z-index: 1;
    padding: var(--spacing-5xl) var(--spacing-4xl);
    display: flex;
    flex-direction: column;
    gap: var(--gap-lg);
  }

  .jam-hero__title {
    margin: 0;
    font-size: var(--text-4xl);
    font-weight: var(--font-weight-bold);
    color: var(--accent);
    line-height: var(--leading-tight);
  }

  .jam-hero__meta {
    display: flex;
    align-items: center;
    gap: var(--gap-lg);
    flex-wrap: wrap;
  }

  .jam-hero__status {
    display: inline-block;
    padding: var(--spacing-xs) var(--spacing-lg);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .jam-hero__status--upcoming {
    background-color: rgba(59, 130, 246, 0.2);
    color: #60a5fa;
  }

  .jam-hero__status--active {
    background-color: rgba(34, 197, 94, 0.2);
    color: #4ade80;
  }

  .jam-hero__status--ended {
    background-color: rgba(156, 163, 175, 0.2);
    color: #9ca3af;
  }

  .jam-hero__dates {
    font-size: var(--text-base);
    color: var(--accent-foreground);
  }

  .jam-hero__creator {
    margin: 0;
    font-size: var(--text-base);
    color: var(--accent-foreground);
  }

  .jam-hero__creator-link {
    color: var(--accent);
    text-decoration: none;
    font-weight: var(--font-weight-semibold);
  }

  .jam-hero__creator-link:hover {
    text-decoration: underline;
  }

  /* Mode Toggle */
  .jam-hero__mode-toggle {
    position: absolute;
    top: var(--spacing-2xl);
    right: var(--spacing-2xl);
    z-index: 10;
    display: flex;
    align-items: center;
    gap: var(--gap-md);
    padding: var(--spacing-md) var(--spacing-lg);
    background-color: oklch(from var(--background) l c h / 0.95);
    backdrop-filter: blur(8px);
    border-radius: var(--radius-full);
    border: var(--border-width-default) solid var(--border);
    box-shadow: var(--shadow-lg);
  }

  .mode-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-xs);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: var(--spacing-xs) var(--spacing-md);
    border-radius: var(--radius-full);
  }

  .mode-badge--edit {
    background-color: oklch(from var(--primary) l c h / 0.1);
    color: var(--primary);
  }

  .mode-badge--preview {
    background-color: oklch(from var(--accent) l c h / 0.1);
    color: var(--accent);
  }

  .mode-toggle-link {
    text-decoration: none;
  }

  .mode-toggle-link:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .jam-hero {
      min-height: 250px;
    }

    .jam-hero__content {
      padding: var(--spacing-3xl) var(--spacing-2xl);
    }

    .jam-hero__title {
      font-size: var(--text-3xl);
    }

    .jam-hero__meta {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--gap-sm);
    }

    .jam-hero__mode-toggle {
      top: var(--spacing-md);
      right: var(--spacing-md);
      padding: var(--spacing-sm) var(--spacing-md);
      gap: var(--gap-sm);
    }

    .mode-badge {
      font-size: var(--text-xs);
      padding: var(--spacing-xs) var(--spacing-sm);
    }
  }
</style>
