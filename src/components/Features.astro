---
interface Feature {
  title: string;
  description: string;
}

interface Props {
  features: Feature[];
}

const { features }: Props = Astro.props;
---

<div class="features">
{features.map((feature, idx) => (
    <div class={`features__item features__item--${idx + 1}`}>
        <h3 class="features__title">{feature.title}</h3>
        <p class="features__desc">{feature.description}</p>
    </div>
))}
</div>

<style>
.features {
  display: grid;
  gap: var(--spacing-3xl);
  grid-template-columns: repeat(12, 1fr);
  grid-auto-rows: minmax(150px, auto);
}

/* Example item variants */
.features__item {
  background: var(--primary);
  border-radius: 0.75rem;
  padding: 2rem;
  display: flex;
  flex-direction: column;
  align-items: start;
  text-align: left;
}

/* Positioning for each item: these can be tuned per design */
.features__item--1 {
  grid-column: 1 / span 6;
  grid-row: 1;
}
.features__item--2 {
  grid-column: 7 / span 6;
  grid-row: 1;
}
.features__item--3 {
  grid-column: 1 / span 4;
  grid-row: 2;
}
.features__item--4 {
  grid-column: 5 / span 4;
  grid-row: 2;
}
.features__item--5 {
  grid-column: 9 / span 4;
  grid-row: 2;
}

.features__title {
  font-size: var(--text-3xl);;
  margin-bottom: 0.5rem;
  color: var(--accent);
}

.features__desc {
  font-size: 1rem;
  line-height: 1.5;
  color: var(--accent-foreground);
}

/* Responsive tweaks */
@media (max-width: 768px) {
  .features {
    grid-template-columns: 1fr;
  }
  .features__item--1,
  .features__item--2,
  .features__item--3,
  .features__item--4,
  .features__item--5 {
    grid-column: 1;
  }
}

</style>