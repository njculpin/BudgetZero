---
export interface Props {
  title: string;
  status?: string;
  statusVariant?: 'draft' | 'pending' | 'published' | 'archived' | 'default';
  backgroundImage?: string | null;
  ownerName?: string | null;
  ownerHandle?: string | null;
  description?: string | null;
}

const {
  title,
  status,
  statusVariant = 'default',
  backgroundImage,
  ownerName,
  ownerHandle,
  description,
} = Astro.props;

const hasOwner = ownerName || ownerHandle;
const ownerDisplayName = ownerName || ownerHandle;
const ownerLink = ownerHandle ? `/users/${ownerHandle}` : null;
---

<div
  class="entity-hero"
  style={backgroundImage ? `background-image: url('${backgroundImage}')` : ''}
>
  {backgroundImage && <div class="entity-hero__overlay"></div>}

  <div class="entity-hero__content">
    <h1 class="entity-hero__title">{title}</h1>

    {(status || hasOwner) && (
      <div class="entity-hero__meta">
        {status && (
          <span class={`entity-hero__status entity-hero__status--${statusVariant}`}>
            {status.toUpperCase()}
          </span>
        )}
        {hasOwner && (
          <span class="entity-hero__author">
            by {ownerLink ? (
              <a href={ownerLink} class="entity-hero__author-link">
                {ownerDisplayName}
              </a>
            ) : (
              ownerDisplayName
            )}
          </span>
        )}
      </div>
    )}

    {description && (
      <p class="entity-hero__description">{description}</p>
    )}

    <slot />
  </div>
</div>

<style>
/* ===== Entity Hero Section ===== */
.entity-hero {
  position: relative;
  background-color: var(--primary);
  background-size: cover;
  background-position: center;
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-bottom: var(--spacing-4xl);
}

.entity-hero__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to bottom,
    oklch(from var(--primary) l c h / 0.85),
    oklch(from var(--primary) l c h / 0.95)
  );
}

.entity-hero__content {
  position: relative;
  padding: var(--spacing-4xl);
  display: flex;
  flex-direction: column;
  gap: var(--gap-md);
}

.entity-hero__title {
  margin: 0;
  font-size: var(--text-3xl);
  font-weight: var(--font-weight-bold);
  color: var(--primary-foreground);
  line-height: var(--leading-tight);
}

.entity-hero__meta {
  display: flex;
  align-items: center;
  gap: var(--gap-lg);
  flex-wrap: wrap;
}

.entity-hero__status {
  display: inline-block;
  padding: var(--spacing-xs) var(--spacing-lg);
  border-radius: var(--radius-full);
  font-size: var(--text-xs);
  font-weight: var(--font-weight-semibold);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  background-color: oklch(from var(--primary-foreground) l c h / 0.2);
  color: var(--primary-foreground);
}

.entity-hero__status--draft {
  background-color: oklch(from var(--warning, #f59e0b) l c h / 0.2);
  color: var(--warning, #f59e0b);
}

.entity-hero__status--pending {
  background-color: oklch(from var(--info, #3b82f6) l c h / 0.2);
  color: var(--info, #3b82f6);
}

.entity-hero__status--published {
  background-color: oklch(from var(--success, #22c55e) l c h / 0.2);
  color: var(--success, #22c55e);
}

.entity-hero__status--archived {
  background-color: oklch(from var(--muted-foreground) l c h / 0.2);
  color: var(--muted-foreground);
}

.entity-hero__author {
  font-size: var(--text-base);
  color: oklch(from var(--primary-foreground) l c h / 0.9);
}

.entity-hero__author-link {
  color: var(--primary-foreground);
  text-decoration: none;
  font-weight: var(--font-weight-semibold);
  border-bottom: 1px solid oklch(from var(--primary-foreground) l c h / 0.5);
}

.entity-hero__author-link:hover {
  border-bottom-color: var(--primary-foreground);
}

.entity-hero__author-link:focus-visible {
  outline: 2px solid var(--primary-foreground);
  outline-offset: 2px;
  border-radius: var(--radius-sm);
}

.entity-hero__description {
  margin: var(--spacing-md) 0 0;
  font-size: var(--text-base);
  color: oklch(from var(--primary-foreground) l c h / 0.85);
  line-height: var(--leading-relaxed);
  max-width: 600px;
}

/* ===== Responsive ===== */
@media (max-width: 768px) {
  .entity-hero__content {
    padding: var(--spacing-3xl) var(--spacing-2xl);
  }

  .entity-hero__title {
    font-size: var(--text-2xl);
  }

  .entity-hero__meta {
    flex-direction: column;
    align-items: flex-start;
    gap: var(--gap-sm);
  }
}
</style>
