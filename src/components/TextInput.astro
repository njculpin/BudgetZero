---
const { className = "", ...props } = Astro.props;
---

<textarea
  class={`textarea ${className}`}
  data-slot="textarea"
  {...props}
/>

<style>
/* ===== Base Textarea ===== */
.textarea {
  width: 100%;
  min-height: 4rem; /* ~min-h-16 */
  padding: 0.5rem 0.75rem; /* ~py-2 px-3 */
  border-radius: 0.375rem; /* rounded-md */
  border: 1px solid var(--color-border, #d1d5db);
  background-color: transparent;
  color: var(--color-text, #111);
  font-size: 1rem; /* text-base */
  line-height: 1.5;
  box-shadow: 0 1px 2px rgb(0 0 0 / 0.05);
  transition: color 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  outline: none;
  resize: vertical; /* allow vertical resizing */
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* ===== Placeholder ===== */
.textarea::placeholder {
  color: var(--color-text-muted, #6b7280);
}

/* ===== Focus ===== */
.textarea:focus-visible {
  border-color: var(--color-ring, #2563eb);
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.5);
}

/* ===== Disabled ===== */
.textarea:disabled {
  cursor: not-allowed;
  opacity: 0.5;
}

/* ===== Invalid / aria-invalid ===== */
.textarea[aria-invalid="true"] {
  border-color: var(--color-destructive, #ef4444);
  box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.2);
}
</style>
