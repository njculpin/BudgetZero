---
const { className = "", type = "text", ...props } = Astro.props;
---

<input
  type={type}
  class={`input ${className}`}
  data-slot="input"
  {...props}
/>

<style>
/* ===== Base Input ===== */
.input {
  width: 100%;
  min-width: 0;
  height: 2.25rem; /* ~h-9 */
  padding: 0.25rem 0.75rem; /* ~py-1 px-3 */
  border-radius: 0.375rem; /* rounded-md */
  border: 1px solid var(--color-border, #d1d5db);
  background-color: transparent;
  color: var(--color-text, #111);
  font-size: 1rem; /* base text */
  line-height: 1.5;
  box-shadow: 0 1px 2px rgb(0 0 0 / 0.05);
  transition: color 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  outline: none;
}

.input::placeholder {
  color: var(--color-text-muted, #6b7280);
}

/* ===== Focus ===== */
.input:focus-visible {
  border-color: var(--color-ring, #2563eb);
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.5);
}

/* ===== Disabled ===== */
.input:disabled {
  pointer-events: none;
  cursor: not-allowed;
  opacity: 0.5;
}

/* ===== Invalid / aria-invalid ===== */
.input[aria-invalid="true"] {
  border-color: var(--color-destructive, #ef4444);
  box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.2);
}

/* ===== File input (if needed) ===== */
.input[type="file"] {
  color: var(--color-text, #111);
}

.input[type="file"]::file-selector-button {
  display: inline-flex;
  height: 1.75rem; /* ~h-7 */
  border: 0;
  background: transparent;
  font-size: 0.875rem; /* text-sm */
  font-weight: 500;
}
</style>
