---
const { className = "", type = "text", ...props } = Astro.props;
---

<input
  type={type}
  class={`input ${className}`}
  data-slot="input"
  {...props}
/>

<style>
/* ===== Base Input ===== */
.input {
  min-width: 0;
  height: var(--height-input-md);
  padding: var(--spacing-xxs) var(--spacing-lg);
  border-radius: var(--radius-md);
  border: var(--border-width-default) solid var(--input-border);
  background-color: transparent;
  color: var(--foreground);
  font-size: var(--text-base);
  line-height: var(--leading-normal);
  box-shadow: var(--shadow-xs);
  transition: color var(--duration-normal) var(--ease-in-out), box-shadow var(--duration-normal) var(--ease-in-out), border-color var(--duration-normal) var(--ease-in-out);
  outline: none;
}

.input::placeholder {
  color: var(--muted-foreground);
}

/* ===== Focus ===== */
.input:focus-visible {
  border-color: var(--ring);
  box-shadow: 0 0 0 3px oklch(from var(--ring) l c h / 0.2);
}

/* ===== Disabled ===== */
.input:disabled {
  pointer-events: none;
  cursor: not-allowed;
  opacity: var(--opacity-50);
}

/* ===== Invalid / aria-invalid ===== */
.input[aria-invalid="true"] {
  border-color: var(--destructive);
  box-shadow: 0 0 0 3px oklch(from var(--destructive) l c h / 0.2);
}

/* ===== File input (if needed) ===== */
.input[type="file"] {
  color: var(--foreground);
}

.input[type="file"]::file-selector-button {
  display: inline-flex;
  height: var(--height-input-sm);
  border: 0;
  background: transparent;
  font-size: var(--text-sm);
  font-weight: var(--font-weight-medium);
}
</style>
