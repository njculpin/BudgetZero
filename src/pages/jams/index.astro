---
import Button from "@/components/Button.astro";
import Card from "@/components/Card.astro";
import CardContent from "@/components/CardContent.astro";
import PageHeader from "@/components/PageHeader.astro";
import BrowseCTA from "@/components/home/BrowseCTA.astro";
import { getAllJams } from "@/lib/data-access/jams";
import { getUserById } from "@/lib/data-access/users";
import Layout from "@/layouts/Layout.astro";
import { setSession } from "@/lib/auth";
import EmptyState from "@/components/EmptyState.astro";
import { FormSubmitButton } from "@/components/interactive";

const { url } = Astro;
const searchParams = url.searchParams;

let currentUser = null;
const accessToken = Astro.cookies.get("sb-access-token");
const refreshToken = Astro.cookies.get("sb-refresh-token");

if (accessToken && refreshToken) {
  try {
    const session = await setSession({
      refresh_token: refreshToken.value,
      access_token: accessToken.value,
    });
    if (!session.error && session.data.user) {
      currentUser = session.data.user;
    }
  } catch (error) {
    // Continue as guest
  }
}

const searchQuery = searchParams.get('search') || '';
const tagFilter = searchParams.get('tag') || '';
const page = parseInt(searchParams.get('page') || '1');
const limit = 20;
const offset = (page - 1) * limit;

const tagArray = tagFilter ? [tagFilter] : undefined;
const allJams = await getAllJams(searchQuery, tagArray, limit, offset);

// Get owners for all jams
const allProductOwnerIds = [...new Set(allJams.map(p => p.user_id))];
const allProductOwners = await Promise.all(allProductOwnerIds.map(id => getUserById(id)));
const allOwnersMap = new Map(allProductOwners.filter(o => o).map(o => [o!.id, o]));

// Calculate jam statuses
const now = new Date();
const jamStatuses = new Map(allJams.map(jam => {
  const startDate = new Date(jam.start_date);
  const endDate = new Date(jam.end_date);
  const startTime = startDate.getTime();
  const endTime = endDate.getTime();
  const nowTime = now.getTime();

  const status = nowTime < startTime ? 'upcoming' : (nowTime >= startTime && nowTime <= endTime) ? 'active' : 'ended';
  return [jam.id, status];
}));
---

<Layout title="Jams - Game Loopers">
  <div class="page">
    <div class="page__container">
      <div class="page-header--with-action">
        <PageHeader
          title="Jams"
          description="Discover jams from the community"
        />
        {currentUser && (
          <FormSubmitButton
            client:load
            action="/api/jams/create-jam"
            method="post"
            variant="primary"
            size="lg"
          >
            Create Jam
          </FormSubmitButton>
        )}
      </div>

       <!-- All jams Section -->
      {allJams.length > 0 ? (
        <section class="browse-section">
          <div class="browse-grid">
            {allJams.map((jam) => {
              const owner = allOwnersMap.get(jam.user_id);
              const startDate = new Date(jam.start_date);
              const endDate = new Date(jam.end_date);
              const calculatedStatus = jamStatuses.get(jam.id) || 'upcoming';

              return (
                <a href={`/jams/${jam.handle}`} class="product-card">
                  <div class="product-card__image">
                    <img
                      src={jam.preview_image_url || 'https://placehold.co/600x400?text=Jam'}
                      alt={jam.title}
                      loading="lazy"
                    />
                  </div>
                  <div class="product-card__content">
                    <h3 class="product-card__title">{jam.title}</h3>
                    <p class="product-card__creator">
                      by {owner?.name || owner?.handle || 'Unknown'}
                    </p>
                    {jam.description && (
                      <p class="product-card__description">
                        {jam.description.substring(0, 100)}{jam.description.length > 100 ? '...' : ''}
                      </p>
                    )}
                    <div class="product-card__footer">
                      <span class={`jam-status jam-status--${calculatedStatus}`}>
                        {calculatedStatus.toUpperCase()}
                      </span>
                      <span class="jam-dates">
                        {startDate.toLocaleDateString()} - {endDate.toLocaleDateString()}
                      </span>
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      ) : allJams.length === 0 && (
        <Card>
          <CardContent>
            {searchQuery || tagFilter ? (
              <EmptyState
                icon="search"
                title="No jams found"
                description="Try adjusting your search or clearing filters to see more results."
                actionText="Clear filters"
                actionHref="/jams"
              />
            ) : currentUser ? (
              <div class="empty-state">
                <div class="empty-state__icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                </div>
                <h3 class="empty-state__title">No jams yet</h3>
                <p class="empty-state__description">Be the first to create a game jam and bring the community together.</p>
                <div class="empty-state__action">
                  <FormSubmitButton
                    client:load
                    action="/api/jams/create-jam"
                    method="post"
                    variant="primary"
                    size="lg"
                  >
                    Create Jam
                  </FormSubmitButton>
                </div>
              </div>
            ) : (
              <EmptyState
                icon="jams"
                title="No jams yet"
                description="Be the first to create a game jam and bring the community together."
                actionText="Sign in to create"
                actionHref="/sign-in"
              />
            )}
          </CardContent>
        </Card>
      )}

      {allJams.length === limit && (
        <div class="browse-pagination">
          {page > 1 && (
            <a href={`/jams?page=${page - 1}${searchQuery ? `&search=${encodeURIComponent(searchQuery)}` : ''}${tagFilter ? `&tag=${encodeURIComponent(tagFilter)}` : ''}`}
               class="browse-pagination__link">← Previous</a>
          )}
          <span class="browse-pagination__current">Page {page}</span>
          <a href={`/jams?page=${page + 1}${searchQuery ? `&search=${encodeURIComponent(searchQuery)}` : ''}${tagFilter ? `&tag=${encodeURIComponent(tagFilter)}` : ''}`}
             class="browse-pagination__link">Next →</a>
        </div>
      )}
    </div>
  </div>
</Layout>

<style>
/* ===== Empty State ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: var(--spacing-6xl) var(--spacing-2xl);
  min-height: 400px;
}

.empty-state__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80px;
  height: 80px;
  margin-bottom: var(--spacing-xl);
  color: var(--muted-foreground);
  opacity: 0.4;
}

.empty-state__icon svg {
  width: 100%;
  height: 100%;
}

.empty-state__title {
  font-size: var(--text-2xl);
  font-weight: var(--font-weight-bold);
  color: var(--foreground);
  margin: 0 0 var(--spacing-md) 0;
}

.empty-state__description {
  font-size: var(--text-base);
  color: var(--muted-foreground);
  margin: 0 0 var(--spacing-2xl) 0;
  max-width: 400px;
  line-height: 1.6;
}

.empty-state__action {
  margin-top: var(--spacing-md);
}

/* ===== Jam-specific Status Badges ===== */
.jam-status {
  font-size: var(--text-xs);
  font-weight: var(--font-weight-semibold);
  padding: var(--spacing-xs) var(--spacing-md);
  border-radius: var(--radius-full);
  text-transform: uppercase;
  letter-spacing: 0.025em;
}

.jam-status--upcoming {
  background-color: rgba(254, 243, 199, 0.9);
  color: #92400e;
}

.jam-status--active {
  background-color: rgba(209, 250, 229, 0.9);
  color: #065f46;
}

.jam-status--ended {
  background-color: rgba(229, 231, 235, 0.9);
  color: #374151;
}

.jam-dates {
  font-size: var(--text-xs);
  color: var(--muted-foreground);
}
</style>
