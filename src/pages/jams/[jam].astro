---
import Layout from "@/layouts/Layout.astro";
import Card from "@/components/Card.astro";
import CardContent from "@/components/CardContent.astro";
import Button from "@/components/Button.astro";
import { getJamByHandle, getJamProducts, getJamProductRatings } from "@/lib/data-access/jams";
import { getUserById } from "@/lib/data-access/users";
import { setSession } from "@/lib/auth";
import { serverClient } from "@/lib/data-access/client";

const { jam: jamHandle } = Astro.params;

if (!jamHandle) {
  return Astro.redirect('/jams');
}

const jam = await getJamByHandle(jamHandle);

if (!jam) {
  return Astro.redirect('/jams');
}

// Get current user
let currentUser = null;
const accessToken = Astro.cookies.get("sb-access-token");
const refreshToken = Astro.cookies.get("sb-refresh-token");

if (accessToken && refreshToken) {
  try {
    const session = await setSession({
      refresh_token: refreshToken.value,
      access_token: accessToken.value,
    });
    if (!session.error && session.data.user) {
      currentUser = session.data.user;
    }
  } catch (error) {
    // Continue as guest
  }
}

const creator = await getUserById(jam.user_id);
const products = await getJamProducts(jam.id);
const productRatings = await getJamProductRatings(jam.id);

// Sort products by rating (highest first)
const sortedProducts = products.sort((a, b) => {
  const ratingA = productRatings.get(a.id)?.averageRating || 0;
  const ratingB = productRatings.get(b.id)?.averageRating || 0;
  return ratingB - ratingA;
});

// Get user's products if authenticated
let userProducts = [];
if (currentUser) {
  const { data: userProductsData } = await serverClient
    .from("products")
    .select("*")
    .eq("user_id", currentUser.id)
    .eq("deleted", false)
    .eq("status", "published");

  if (userProductsData) {
    userProducts = userProductsData;
  }
}

const startDate = new Date(jam.start_date);
const endDate = new Date(jam.end_date);
const now = new Date();
const isActive = jam.status === 'active';
const isUpcoming = jam.status === 'upcoming';
const isEnded = jam.status === 'ended';

// Check if current user is the jam creator
const isCreator = currentUser?.id === jam.user_id;

// Mode management (similar to assets pattern)
const mode = Astro.url.searchParams.get("mode") || "view";
const isEditMode = mode === "edit" && isCreator;
const isViewMode = !isEditMode;

// Get error and success messages from query params
const errorMessage = Astro.url.searchParams.get("error");
const successMessage = Astro.url.searchParams.get("success");
---

<Layout title={`${jam.title} - Game Loopers`}>
  <div class="page">
    <div class="page__container">
      <div class="page-columns__column">
      <!-- Hero Section with Background Image -->
      <div
        class="jam-hero"
        style={jam.preview_image_url ? `background-image: url('${jam.preview_image_url}')` : ''}
      >
        {jam.preview_image_url && <div class="jam-hero__overlay"></div>}
        <div class="jam-hero__content">
          <h1 class="jam-hero__title">{jam.title}</h1>
          <div class="jam-hero__meta">
            <span class="jam-hero__status jam-hero__status--{jam.status}">
              {jam.status.toUpperCase()}
            </span>
            <span class="jam-hero__dates">
              {startDate.toLocaleDateString()} - {endDate.toLocaleDateString()}
            </span>
          </div>
          {creator && (
            <p class="jam-hero__creator">
              Hosted by <a href={`/users/${creator.handle}`} class="jam-hero__creator-link">{creator.name || creator.handle}</a>
            </p>
          )}
        </div>
      </div>

      <!-- Edit Mode Toggle (Creator Only) -->
      {isCreator && (
        <Card>
          <CardContent>
            <div class="view-mode">
              <div class="view-mode__current">
                <span class={`view-mode__badge view-mode__badge--${isEditMode ? 'edit' : 'view'}`}>
                  {isEditMode ? '✏ Edit Mode' : '👁 View Mode'}
                </span>
                <p class="view-mode__description">
                  {isEditMode
                    ? 'Editing jam details and settings'
                    : 'Viewing as users see this jam'}
                </p>
              </div>
              <a
                href={`/jams/${jam.handle}${isEditMode ? '' : '?mode=edit'}`}
                class="view-mode__toggle"
              >
                <Button variant="outline" size="sm">
                  <span slot="text">
                    Switch to {isEditMode ? 'View' : 'Edit'}
                  </span>
                </Button>
              </a>
            </div>
          </CardContent>
        </Card>
      )}

      <!-- Edit Form (Edit Mode Only) -->
      {isEditMode && (
        <Card>
          <CardContent>
            {errorMessage && (
              <div class="alert alert--error">
                <p class="alert__message">{errorMessage}</p>
              </div>
            )}
            {successMessage && (
              <div class="alert alert--success">
                <p class="alert__message">Jam updated successfully!</p>
              </div>
            )}
            <form method="post" action="/api/jams/update-jam" class="edit-form">
              <input type="hidden" name="jamId" value={jam.id} />
              <input type="hidden" name="handle" value={jam.handle} />

              <div class="edit-form__field">
                <label for="title" class="edit-form__label">
                  Title
                </label>
                <input
                  type="text"
                  id="title"
                  name="title"
                  class="edit-form__input"
                  value={jam.title}
                  required
                />
              </div>

              <div class="edit-form__field">
                <label for="description" class="edit-form__label">
                  Description
                </label>
                <textarea
                  id="description"
                  name="description"
                  class="edit-form__textarea"
                  placeholder="Tell participants about your jam..."
                >{jam.description || ''}</textarea>
              </div>

              <div class="edit-form__field">
                <label for="rules" class="edit-form__label">
                  Rules
                </label>
                <textarea
                  id="rules"
                  name="rules"
                  class="edit-form__textarea"
                  placeholder="Set the rules for your jam..."
                >{jam.rules || ''}</textarea>
              </div>

              <div class="edit-form__date-group">
                <div class="edit-form__field">
                  <label for="start_date" class="edit-form__label">
                    Start Date (Monday)
                  </label>
                  <input
                    type="date"
                    id="start_date"
                    name="start_date"
                    class="edit-form__input"
                    value={jam.start_date.split('T')[0]}
                    required
                  />
                  <p class="edit-form__hint">Must be a Monday</p>
                </div>

                <div class="edit-form__field">
                  <label for="end_date" class="edit-form__label">
                    End Date (Sunday)
                  </label>
                  <input
                    type="date"
                    id="end_date"
                    name="end_date"
                    class="edit-form__input"
                    value={jam.end_date.split('T')[0]}
                    required
                  />
                  <p class="edit-form__hint">Must be a Sunday</p>
                </div>
              </div>

              <div class="edit-form__actions">
                <Button variant="primary" size="md">
                  <span slot="text">Save Changes</span>
                </Button>
                <a href={`/jams/${jam.handle}`}>
                  <Button variant="ghost" size="md">
                    <span slot="text">Cancel</span>
                  </Button>
                </a>
              </div>
            </form>
          </CardContent>
        </Card>
      )}

      <!-- Description Section -->
      {isViewMode && jam.description && (
        <Card>
          <CardContent>
            <div class="jam-section">
              <h2 class="jam-section__title">About This Jam</h2>
              <p class="jam-section__text">{jam.description}</p>
            </div>
          </CardContent>
        </Card>
      )}

      <!-- Rules Section -->
      {isViewMode && jam.rules && (
        <Card>
          <CardContent>
            <div class="jam-section">
              <h2 class="jam-section__title">Rules</h2>
              <p class="jam-section__text">{jam.rules}</p>
            </div>
          </CardContent>
        </Card>
      )}

      <!-- Submissions Section -->
      <Card>
        <CardContent>
          <div class="jam-section">
            <div class="jam-section__header">
              <h2 class="jam-section__title">Submissions ({products.length})</h2>
              {currentUser && isActive && userProducts.length > 0 && (
                <div class="submit-product">
                  <form method="post" action="/api/jams/add-product" class="submit-product__form">
                    <input type="hidden" name="jam_id" value={jam.id} />
                    <select name="product_id" class="submit-product__select" required>
                      <option value="">Select a product...</option>
                      {userProducts.map((product) => (
                        <option value={product.id}>{product.title}</option>
                      ))}
                    </select>
                    <Button variant="primary" size="md">
                      <span slot="text">Submit Product</span>
                    </Button>
                  </form>
                </div>
              )}
              {currentUser && isActive && userProducts.length === 0 && (
                <p class="submit-product__message">
                  You don't have any published products to submit.
                </p>
              )}
              {currentUser && !isActive && (
                <p class="submit-product__message">
                  Submissions are closed for this jam.
                </p>
              )}
              {!currentUser && isActive && (
                <p class="submit-product__message">
                  <a href="/sign-in" class="submit-product__link">Sign in</a> to submit your products.
                </p>
              )}
            </div>
            {sortedProducts.length === 0 ? (
              <p class="jam-section__text">No submissions yet.</p>
            ) : (
              <div class="submissions-grid">
                {sortedProducts.map((product, index) => {
                  const rating = productRatings.get(product.id);
                  return (
                    <div class="submission-card-wrapper">
                      <a href={`/products/${product.handle}`} class="submission-card">
                        {index === 0 && isEnded && rating && rating.averageRating > 0 && (
                          <div class="submission-card__badge">Winner</div>
                        )}
                        {product.cover_image_url && (
                          <div
                            class="submission-card__image"
                            style={`background-image: url('${product.cover_image_url}')`}
                          ></div>
                        )}
                        <div class="submission-card__content">
                          <h3 class="submission-card__title">{product.title}</h3>
                          {product.description && (
                            <p class="submission-card__description">
                              {product.description.substring(0, 100)}{product.description.length > 100 ? '...' : ''}
                            </p>
                          )}
                          {rating && (
                            <div class="submission-card__rating">
                              <span class="submission-card__stars">
                                {'★'.repeat(Math.round(rating.averageRating))}{'☆'.repeat(5 - Math.round(rating.averageRating))}
                              </span>
                              <span class="submission-card__rating-text">
                                {rating.averageRating.toFixed(1)} ({rating.reviewCount} {rating.reviewCount === 1 ? 'review' : 'reviews'})
                              </span>
                            </div>
                          )}
                        </div>
                      </a>
                      {currentUser && (
                        <div class="submission-card__actions">
                          <details class="review-form">
                            <summary class="review-form__toggle">
                              {rating ? 'Update Review' : 'Write Review'}
                            </summary>
                            <form method="post" action="/api/jams/add-review" class="review-form__form">
                              <input type="hidden" name="jam_id" value={jam.id} />
                              <input type="hidden" name="product_id" value={product.id} />
                              <div class="review-form__field">
                                <label class="review-form__label">Rating</label>
                                <select name="rating" class="review-form__select" required>
                                  <option value="">Select rating...</option>
                                  <option value="5">5 - Excellent</option>
                                  <option value="4">4 - Good</option>
                                  <option value="3">3 - Average</option>
                                  <option value="2">2 - Poor</option>
                                  <option value="1">1 - Terrible</option>
                                </select>
                              </div>
                              <div class="review-form__field">
                                <label class="review-form__label">Review</label>
                                <textarea
                                  name="review_text"
                                  class="review-form__textarea"
                                  rows="3"
                                  required
                                  placeholder="Share your thoughts about this product..."
                                ></textarea>
                              </div>
                              <Button variant="primary" size="sm">
                                <span slot="text">Submit Review</span>
                              </Button>
                            </form>
                          </details>
                        </div>
                      )}
                    </div>
                  );
                })}
              </div>
            )}
          </div>
        </CardContent>
      </Card>
      </div>
    </div>
  </div>
</Layout>

<style>
  /* Jam Hero Section */
  .jam-hero {
    position: relative;
    min-height: 300px;
    background-color: var(--primary);
    background-size: cover;
    background-position: center;
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-bottom: var(--spacing-4xl);
  }

  .jam-hero__overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.7));
    z-index: 0;
  }

  .jam-hero__content {
    position: relative;
    z-index: 1;
    padding: var(--spacing-5xl) var(--spacing-4xl);
    display: flex;
    flex-direction: column;
    gap: var(--gap-lg);
  }

  .jam-hero__title {
    margin: 0;
    font-size: var(--text-4xl);
    font-weight: var(--font-weight-bold);
    color: var(--accent);
    line-height: var(--leading-tight);
  }

  .jam-hero__meta {
    display: flex;
    align-items: center;
    gap: var(--gap-lg);
    flex-wrap: wrap;
  }

  .jam-hero__status {
    display: inline-block;
    padding: var(--spacing-xs) var(--spacing-lg);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .jam-hero__status--upcoming {
    background-color: rgba(59, 130, 246, 0.2);
    color: #60a5fa;
  }

  .jam-hero__status--active {
    background-color: rgba(34, 197, 94, 0.2);
    color: #4ade80;
  }

  .jam-hero__status--ended {
    background-color: rgba(156, 163, 175, 0.2);
    color: #9ca3af;
  }

  .jam-hero__dates {
    font-size: var(--text-base);
    color: var(--accent-foreground);
  }

  .jam-hero__creator {
    margin: 0;
    font-size: var(--text-base);
    color: var(--accent-foreground);
  }

  .jam-hero__creator-link {
    color: var(--accent);
    text-decoration: none;
    font-weight: var(--font-weight-semibold);
  }

  .jam-hero__creator-link:hover {
    text-decoration: underline;
  }

  /* Jam Section */
  .jam-section {
    padding: var(--spacing-lg) 0;
  }

  .jam-section__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--gap-xl);
    margin-bottom: var(--spacing-2xl);
    flex-wrap: wrap;
  }

  .jam-section__title {
    margin: 0;
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-bold);
    color: var(--foreground);
  }

  /* Submit Product Form */
  .submit-product__form {
    display: flex;
    gap: var(--gap-md);
    align-items: center;
  }

  .submit-product__select {
    padding: var(--spacing-sm) var(--spacing-lg);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background-color: var(--background);
    color: var(--foreground);
    font-size: var(--text-sm);
    min-width: 200px;
  }

  .submit-product__message {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--muted-foreground);
  }

  .submit-product__link {
    color: var(--primary);
    text-decoration: none;
    font-weight: var(--font-weight-medium);
  }

  .submit-product__link:hover {
    text-decoration: underline;
  }

  .jam-section__text {
    margin: 0;
    font-size: var(--text-base);
    color: var(--foreground);
    line-height: var(--leading-relaxed);
    white-space: pre-wrap;
  }

  /* Submissions Grid */
  .submissions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: var(--gap-xl);
  }

  .submission-card {
    display: block;
    background-color: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
    transition: all var(--duration-normal) var(--ease-in-out);
  }

  .submission-card:hover {
    border-color: var(--primary);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .submission-card__image {
    width: 100%;
    height: 180px;
    background-size: cover;
    background-position: center;
    background-color: var(--muted);
  }

  .submission-card__content {
    padding: var(--spacing-2xl);
  }

  .submission-card__title {
    margin: 0 0 var(--spacing-sm) 0;
    font-size: var(--text-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--foreground);
  }

  .submission-card__description {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--muted-foreground);
    line-height: var(--leading-normal);
  }

  .submission-card__badge {
    position: absolute;
    top: var(--spacing-lg);
    right: var(--spacing-lg);
    background-color: #fbbf24;
    color: #78350f;
    padding: var(--spacing-xs) var(--spacing-lg);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    z-index: 2;
  }

  .submission-card__rating {
    display: flex;
    align-items: center;
    gap: var(--gap-sm);
    margin-top: var(--spacing-sm);
  }

  .submission-card__stars {
    color: #fbbf24;
    font-size: var(--text-base);
  }

  .submission-card__rating-text {
    font-size: var(--text-xs);
    color: var(--muted-foreground);
  }

  .submission-card-wrapper {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
  }

  .submission-card__actions {
    padding: var(--spacing-md);
    background-color: var(--muted);
    border-radius: var(--radius-md);
  }

  /* Review Form */
  .review-form {
    width: 100%;
  }

  .review-form__toggle {
    cursor: pointer;
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--primary);
    user-select: none;
  }

  .review-form__toggle:hover {
    text-decoration: underline;
  }

  .review-form__form {
    margin-top: var(--spacing-lg);
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
  }

  .review-form__field {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs);
  }

  .review-form__label {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--foreground);
  }

  .review-form__select,
  .review-form__textarea {
    padding: var(--spacing-sm) var(--spacing-md);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background-color: var(--background);
    color: var(--foreground);
    font-size: var(--text-sm);
    font-family: inherit;
  }

  .review-form__textarea {
    resize: vertical;
    min-height: 80px;
  }

  /* ===== View Mode Toggle ===== */
  .view-mode {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--gap-xl);
  }

  .view-mode__current {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs);
  }

  .view-mode__badge {
    display: inline-block;
    padding: var(--spacing-xs) var(--spacing-lg);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    width: fit-content;
  }

  .view-mode__badge--edit {
    background-color: rgba(59, 130, 246, 0.2);
    color: #2563eb;
  }

  .view-mode__badge--view {
    background-color: rgba(34, 197, 94, 0.2);
    color: #16a34a;
  }

  .view-mode__description {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--muted-foreground);
  }

  .view-mode__toggle {
    text-decoration: none;
  }

  /* ===== Edit Form ===== */
  .edit-form {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xl);
  }

  .edit-form__field {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs);
  }

  .edit-form__label {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--foreground);
  }

  .edit-form__input,
  .edit-form__textarea {
    padding: var(--spacing-sm) var(--spacing-md);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background-color: var(--background);
    color: var(--foreground);
    font-size: var(--text-sm);
    font-family: inherit;
    transition: border-color var(--duration-fast) var(--ease-in-out);
  }

  .edit-form__input:focus,
  .edit-form__textarea:focus {
    outline: none;
    border-color: var(--ring);
    box-shadow: 0 0 0 3px oklch(from var(--ring) l c h / 0.2);
  }

  .edit-form__textarea {
    resize: vertical;
    min-height: 100px;
  }

  .edit-form__date-group {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gap-md);
  }

  .edit-form__hint {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--muted-foreground);
  }

  .edit-form__actions {
    display: flex;
    gap: var(--gap-md);
    padding-top: var(--spacing-lg);
    border-top: 1px solid var(--border);
  }

  /* ===== Alert Messages ===== */
  .alert {
    padding: var(--spacing-lg) var(--spacing-2xl);
    border-radius: var(--radius-md);
    margin-bottom: var(--spacing-2xl);
  }

  .alert--error {
    background-color: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.3);
  }

  .alert--success {
    background-color: rgba(34, 197, 94, 0.1);
    border: 1px solid rgba(34, 197, 94, 0.3);
  }

  .alert__message {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--foreground);
  }

  .alert--error .alert__message {
    color: #dc2626;
  }

  .alert--success .alert__message {
    color: #16a34a;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .jam-hero {
      min-height: 250px;
    }

    .jam-hero__content {
      padding: var(--spacing-3xl) var(--spacing-2xl);
    }

    .jam-hero__title {
      font-size: var(--text-3xl);
    }

    .jam-hero__meta {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--gap-sm);
    }

    .submissions-grid {
      grid-template-columns: 1fr;
