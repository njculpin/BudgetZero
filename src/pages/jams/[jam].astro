<script>
  // Client-side date validation for jam dates
  const startDateInput = document.getElementById('start_date') as HTMLInputElement;
  const endDateInput = document.getElementById('end_date') as HTMLInputElement;

  if (startDateInput && endDateInput) {
    const validateDates = () => {
      const startDate = new Date(startDateInput.value);
      const endDate = new Date(endDateInput.value);

      // Check if start date is Monday (1)
      if (startDate.getDay() !== 1) {
        startDateInput.setCustomValidity('Start date must be a Monday');
      } else {
        startDateInput.setCustomValidity('');
      }

      // Check if end date is Sunday (0)
      if (endDate.getDay() !== 0) {
        endDateInput.setCustomValidity('End date must be a Sunday');
      } else {
        endDateInput.setCustomValidity('');
      }

      // Check if they're exactly 6 days apart
      const daysDiff = Math.floor((endDate.getTime() - startDate.getTime()) / (1000 * 60 * 60 * 24));
      if (daysDiff !== 6) {
        endDateInput.setCustomValidity('Jam must run for exactly one week (Monday to Sunday)');
      } else if (endDate.getDay() === 0) {
        endDateInput.setCustomValidity('');
      }
    };

    startDateInput.addEventListener('change', validateDates);
    endDateInput.addEventListener('change', validateDates);

    // Validate on page load if dates are present
    if (startDateInput.value && endDateInput.value) {
      validateDates();
    }
  }
</script>