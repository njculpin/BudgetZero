---
import type { JamCategory, CategoryVotingResult } from "@/types";
import Layout from "@/layouts/Layout.astro";
import Card from "@/components/Card.astro";
import CardContent from "@/components/CardContent.astro";
import Button from "@/components/Button.astro";
import {
  getJamByHandle,
  getJamProducts,
  getJamProductRatings,
  calculateVotingPhase,
  getJamCategories,
  getUserVotes,
  hasUserVoted,
  getAllCategoryResults,
} from "@/lib/data-access/jams";
import { getUserById } from "@/lib/data-access/users";
import { getProductImages } from "@/lib/data-access/products";
import { setSession } from "@/lib/auth";
import { serverClient } from "@/lib/data-access/client";
import JamVoting from "@/components/islands/JamVoting";
import JamResults from "@/components/JamResults.astro";
import JamHero from "@/components/JamHero.astro";
import JamContentSection from "@/components/JamContentSection.astro";
import AlertMessage from "@/components/AlertMessage.astro";
import RatingStars from "@/components/RatingStars.astro";

const { jam: jamHandle } = Astro.params;

if (!jamHandle) {
  return Astro.redirect('/jams');
}

const jam = await getJamByHandle(jamHandle);

if (!jam) {
  return Astro.redirect('/jams');
}

// Get current user
let currentUser = null;
const accessToken = Astro.cookies.get("sb-access-token");
const refreshToken = Astro.cookies.get("sb-refresh-token");

if (accessToken && refreshToken) {
  try {
    const session = await setSession({
      refresh_token: refreshToken.value,
      access_token: accessToken.value,
    });
    if (!session.error && session.data.user) {
      currentUser = session.data.user;
    }
  } catch (error) {
    // Continue as guest
  }
}

const creator = await getUserById(jam.user_id);
const products = await getJamProducts(jam.id);
const productRatings = await getJamProductRatings(jam.id);

// Sort products by rating (highest first)
const sortedProducts = products.sort((a, b) => {
  const ratingA = productRatings.get(a.id)?.averageRating || 0;
  const ratingB = productRatings.get(b.id)?.averageRating || 0;
  return ratingB - ratingA;
});

// Fetch product images for all products
const productImagesMap = new Map();
await Promise.all(
  sortedProducts.map(async (product) => {
    const images = await getProductImages(product.id);
    const coverImage = images[0]?.file_url || null;
    productImagesMap.set(product.id, coverImage);
  })
);

// Get user's products if authenticated
let userProducts = [];
if (currentUser) {
  const { data: userProductsData } = await serverClient
    .from("products")
    .select("*")
    .eq("user_id", currentUser.id)
    .eq("deleted", false)
    .eq("status", "published");

  if (userProductsData) {
    userProducts = userProductsData;
  }
}

const startDate = new Date(jam.start_date);
const endDate = new Date(jam.end_date);
const now = new Date();

// Calculate jam state based on dates (not manual status field)
const nowTime = now.getTime();
const startTime = startDate.getTime();
const endTime = endDate.getTime();

const isUpcoming = nowTime < startTime;
const isActive = nowTime >= startTime && nowTime <= endTime;
const isEnded = nowTime > endTime;

// Check if current user is the jam creator
const isCreator = currentUser?.id === jam.user_id;

// Mode management - creators always in edit mode
const isEditMode = isCreator;
const isPreviewMode = !isEditMode;

// Get error and success messages from query params
const errorMessage = Astro.url.searchParams.get("error");
const successMessage = Astro.url.searchParams.get("success");
const votingSuccess = Astro.url.searchParams.get("voting_success");

// Calculate voting phase
const votingPhase = calculateVotingPhase(jam);
const isVoting = votingPhase === "voting";
const isResultsPending = votingPhase === "results_pending";
const isCompleted = votingPhase === "completed";

// Fetch voting-related data
let categories: JamCategory[] = [];
let userVotes: Record<string, string[]> = {};
let userHasVoted = false;
let votingResults: CategoryVotingResult[] = [];

if (jam.voting_end_date) {
  categories = await getJamCategories(jam.id);

  if (isVoting && currentUser) {
    const votes = await getUserVotes(jam.id, currentUser.id);
    userHasVoted = await hasUserVoted(jam.id, currentUser.id);

    votes.forEach((vote) => {
      if (!userVotes[vote.category_id]) {
        userVotes[vote.category_id] = [];
      }
      if (!userVotes[vote.category_id].includes(vote.product_id)) {
        userVotes[vote.category_id].push(vote.product_id);
      }
    });
  }

  if (isCompleted || (isResultsPending && jam.results_reveal_date && now >= new Date(jam.results_reveal_date))) {
    votingResults = await getAllCategoryResults(jam.id);
  }
}

const productsMap = new Map(sortedProducts.map((p) => [p.id, p]));
---

<Layout title={`${jam.title} - Game Loopers`}>
  <div class="page">
    <div class="page__container">
      <div class="page-columns__column">
      <!-- Hero Section -->
      <JamHero
        jam={jam}
        isCreator={isCreator}
        creator={creator}
        status={isUpcoming ? "upcoming" : isActive ? "active" : "ended"}
        startDate={startDate}
        endDate={endDate}
      />

      <!-- Edit Form (Edit Mode Only) -->
      {isEditMode && (
        <Card>
          <CardContent>
            {errorMessage && <AlertMessage variant="error" message={errorMessage} />}
            {successMessage && <AlertMessage variant="success" message="Jam updated successfully!" />}
            <form method="post" action="/api/jams/update-jam" class="edit-form" enctype="multipart/form-data">
              <input type="hidden" name="jamId" value={jam.id} />
              <input type="hidden" name="handle" value={jam.handle} />

              <div class="edit-form__field">
                <label for="title" class="edit-form__label">
                  Title
                </label>
                <input
                  type="text"
                  id="title"
                  name="title"
                  class="edit-form__input"
                  value={jam.title}
                  required
                />
              </div>

              <div class="edit-form__field">
                <label for="description" class="edit-form__label">
                  Description
                </label>
                <textarea
                  id="description"
                  name="description"
                  class="edit-form__textarea"
                  placeholder="Tell participants about your jam..."
                >{jam.description || ''}</textarea>
              </div>

              <div class="edit-form__field">
                <label for="rules" class="edit-form__label">
                  Rules
                </label>
                <textarea
                  id="rules"
                  name="rules"
                  class="edit-form__textarea"
                  placeholder="Set the rules for your jam..."
                >{jam.rules || ''}</textarea>
              </div>

              <div class="edit-form__field">
                <label for="cover_image" class="edit-form__label">
                  Cover Image
                </label>
                {jam.preview_image_url && (
                  <div class="edit-form__image-preview">
                    <img
                      src={jam.preview_image_url}
                      alt={jam.title}
                      class="edit-form__preview-image"
                    />
                  </div>
                )}
                <input
                  type="file"
                  id="cover_image"
                  name="cover_image"
                  class="edit-form__input"
                  accept="image/*"
                />
                <p class="edit-form__hint">Upload a cover image for your jam (max 5MB)</p>
              </div>

              <div class="edit-form__date-group">
                <div class="edit-form__field">
                  <label for="start_date" class="edit-form__label">
                    Start Date
                  </label>
                  <input
                    type="date"
                    id="start_date"
                    name="start_date"
                    class="edit-form__input"
                    value={jam.start_date.split('T')[0]}
                  />
                </div>

                <div class="edit-form__field">
                  <label for="end_date" class="edit-form__label">
                    End Date
                  </label>
                  <input
                    type="date"
                    id="end_date"
                    name="end_date"
                    class="edit-form__input"
                    value={jam.end_date.split('T')[0]}
                  />
                </div>
              </div>

              <div class="edit-form__actions">
                <Button variant="primary" size="md">
                  <span slot="text">Save Changes</span>
                </Button>
                <a href={`/jams/${jam.handle}`}>
                  <Button variant="ghost" size="md">
                    <span slot="text">Cancel</span>
                  </Button>
                </a>
              </div>
            </form>
          </CardContent>
        </Card>
      )}

      <!-- Description & Rules Sections -->
      {isPreviewMode && (
        <>
          <JamContentSection title="About This Jam" content={jam.description} />
          <JamContentSection title="Rules" content={jam.rules} />
        </>
      )}

      <!-- Voting Section -->
      {isPreviewMode && isVoting && categories.length > 0 && currentUser && !userHasVoted && (
        <Card>
          <CardContent>
            <div class="jam-section">
              <h2 class="jam-section__title">Vote Now!</h2>
              {votingSuccess && <AlertMessage variant="success" message="Your votes have been submitted successfully!" />}
              <p class="jam-section__text">
                Select up to 3 products per category. Voting closes on{" "}
                {jam.voting_end_date && new Date(jam.voting_end_date).toLocaleDateString()}.
              </p>
              <JamVoting
                client:load
                jamId={jam.id}
                categories={categories}
                products={sortedProducts}
                existingVotes={userVotes}
              />
            </div>
          </CardContent>
        </Card>
      )}

      <!-- Already Voted Message -->
      {isPreviewMode && isVoting && currentUser && userHasVoted && (
        <Card>
          <CardContent>
            <div class="jam-section">
              <h2 class="jam-section__title">Voting</h2>
              <AlertMessage
                variant="success"
                message={`✓ You've already voted in this jam. Results will be revealed on ${jam.results_reveal_date && new Date(jam.results_reveal_date).toLocaleDateString()}.`}
              />
            </div>
          </CardContent>
        </Card>
      )}

      <!-- Sign In to Vote -->
      {isPreviewMode && isVoting && !currentUser && categories.length > 0 && (
        <Card>
          <CardContent>
            <div class="jam-section">
              <h2 class="jam-section__title">Voting is Open!</h2>
              <p class="jam-section__text">
                <a href="/sign-in" class="submit-product__link">Sign in</a> to vote for your favorite submissions.
              </p>
            </div>
          </CardContent>
        </Card>
      )}

      <!-- Results Section -->
      {isPreviewMode && votingResults.length > 0 && (
        <div>
          <h2 class="jam-section__title" style="margin-bottom: var(--spacing-2xl);">Results</h2>
          <JamResults results={votingResults} productsMap={productsMap} />
        </div>
      )}

      <!-- Submissions Section -->
      <Card>
        <CardContent>
          {errorMessage && <AlertMessage variant="error" message={errorMessage} />}
          {successMessage && <AlertMessage variant="success" message="Product submitted successfully!" />}
          <div class="jam-section">
            <div class="jam-section__header">
              <h2 class="jam-section__title">Submissions ({products.length})</h2>
              {currentUser && isActive && userProducts.length > 0 && (
                <div class="submit-product">
                  <p class="submit-product__message submit-product__message--info">
                    💡 To submit a product, click on one of your products below:
                  </p>
                  <div class="submit-product__list">
                    {userProducts.map((product) => (
                      <a href={`/products/${product.handle}?jam=${jam.id}`} class="submit-product__link">
                        {product.title}
                      </a>
                    ))}
                  </div>
                </div>
              )}
              {currentUser && isActive && userProducts.length === 0 && (
                <p class="submit-product__message">
                  You don't have any published products to submit.
                </p>
              )}
              {currentUser && isUpcoming && (
                <p class="submit-product__message">
                  Submissions open on {startDate.toLocaleDateString()}.
                </p>
              )}
              {currentUser && isEnded && (
                <p class="submit-product__message">
                  Submissions closed on {endDate.toLocaleDateString()}.
                </p>
              )}
              {!currentUser && isActive && (
                <p class="submit-product__message">
                  <a href="/sign-in" class="submit-product__link">Sign in</a> to submit your products.
                </p>
              )}
            </div>
            {sortedProducts.length === 0 ? (
              <p class="jam-section__text">No submissions yet.</p>
            ) : (
              <div class="submissions-grid">
                {sortedProducts.map((product, index) => {
                  const rating = productRatings.get(product.id);
                  const coverImage = productImagesMap.get(product.id);
                  const imageUrl = coverImage || `https://placehold.co/600x400?text=${encodeURIComponent(product.title)}`;
                  const productUrl = currentUser ? `/products/${product.handle}?jam=${jam.id}` : `/products/${product.handle}`;
                  const showRank = rating && rating.reviewCount > 0 && (isVoting || isResultsPending || isCompleted);
                  return (
                    <div class="submission-card-wrapper">
                      <a href={productUrl} class="submission-card">
                        {index === 0 && isEnded && rating && rating.averageRating > 0 && (
                          <div class="submission-card__badge submission-card__badge--winner">Winner</div>
                        )}
                        {showRank && (
                          <div class="submission-card__rank">#{index + 1}</div>
                        )}
                        <div class="submission-card__image-wrapper">
                          <img
                            src={imageUrl}
                            alt={product.title}
                            class="submission-card__image"
                            loading="lazy"
                          />
                        </div>
                        <div class="submission-card__content">
                          <h3 class="submission-card__title">{product.title}</h3>
                          {product.description && (
                            <p class="submission-card__description">
                              {product.description.substring(0, 100)}{product.description.length > 100 ? '...' : ''}
                            </p>
                          )}
                          {rating && (
                            <div class="submission-card__rating">
                              <RatingStars
                                rating={rating.averageRating}
                                count={rating.reviewCount}
                                showCount={true}
                                size="sm"
                              />
                            </div>
                          )}
                        </div>
                      </a>
                    </div>
                  );
                })}
              </div>
            )}
          </div>
        </CardContent>
      </Card>
      </div>
    </div>
  </div>
</Layout>

<style>
  /* Jam Section */
  .jam-section {
    padding: var(--spacing-lg) 0;
  }

  .jam-section__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--gap-xl);
    margin-bottom: var(--spacing-2xl);
    flex-wrap: wrap;
  }

  .jam-section__title {
    margin: 0;
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-bold);
    color: var(--foreground);
  }

  /* Submit Product Form */
  .submit-product__form {
    display: flex;
    gap: var(--gap-md);
    align-items: center;
  }

  .submit-product__select {
    padding: var(--spacing-sm) var(--spacing-lg);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background-color: var(--background);
    color: var(--foreground);
    font-size: var(--text-sm);
    min-width: 200px;
  }

  .submit-product__message {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--muted-foreground);
  }

  .submit-product__link {
    color: var(--primary);
    text-decoration: none;
    font-weight: var(--font-weight-medium);
  }

  .submit-product__link:hover {
    text-decoration: underline;
  }

  .jam-section__text {
    margin: 0;
    font-size: var(--text-base);
    color: var(--foreground);
    line-height: var(--leading-relaxed);
    white-space: pre-wrap;
  }

  /* Submissions Grid */
  .submissions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: var(--gap-xl);
  }

  .submission-card {
    position: relative;
    display: block;
    background-color: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
    transition: all var(--duration-normal) var(--ease-in-out);
  }

  .submission-card:hover {
    border-color: var(--primary);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .submission-card__image-wrapper {
    width: 100%;
    height: 180px;
    overflow: hidden;
    background-color: var(--muted);
  }

  .submission-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .submission-card__content {
    padding: var(--spacing-2xl);
  }

  .submission-card__title {
    margin: 0 0 var(--spacing-sm) 0;
    font-size: var(--text-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--foreground);
  }

  .submission-card__description {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--muted-foreground);
    line-height: var(--leading-normal);
  }

  .submission-card__badge {
    position: absolute;
    top: var(--spacing-lg);
    right: var(--spacing-lg);
    padding: var(--spacing-xs) var(--spacing-lg);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    z-index: 2;
  }

  .submission-card__badge--winner {
    background-color: #fbbf24;
    color: #78350f;
  }

  .submission-card__rank {
    position: absolute;
    top: var(--spacing-lg);
    left: var(--spacing-lg);
    background-color: var(--primary);
    color: var(--primary-foreground);
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-sm);
    font-weight: var(--font-weight-bold);
    z-index: 2;
    box-shadow: var(--shadow-sm);
  }

  .submission-card__rating {
    display: flex;
    align-items: center;
    gap: var(--gap-sm);
    margin-top: var(--spacing-sm);
  }

  .submission-card__stars {
    color: #fbbf24;
    font-size: var(--text-base);
  }

  .submission-card__rating-text {
    font-size: var(--text-xs);
    color: var(--muted-foreground);
  }

  .submission-card-wrapper {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
  }

  .submission-card__actions {
    padding: var(--spacing-md);
    background-color: var(--muted);
    border-radius: var(--radius-md);
  }

  /* Review Form */
  .review-form {
    width: 100%;
  }

  .review-form__toggle {
    cursor: pointer;
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--primary);
    user-select: none;
  }

  .review-form__toggle:hover {
    text-decoration: underline;
  }

  .review-form__form {
    margin-top: var(--spacing-lg);
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
  }

  .review-form__field {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs);
  }

  .review-form__label {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--foreground);
  }

  .review-form__select,
  .review-form__textarea {
    padding: var(--spacing-sm) var(--spacing-md);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background-color: var(--background);
    color: var(--foreground);
    font-size: var(--text-sm);
    font-family: inherit;
  }

  .review-form__textarea {
    resize: vertical;
    min-height: 80px;
  }

  /* ===== Edit Form ===== */
  .edit-form {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xl);
  }

  .edit-form__field {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs);
  }

  .edit-form__label {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--foreground);
  }

  .edit-form__input,
  .edit-form__textarea {
    padding: var(--spacing-sm) var(--spacing-md);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background-color: var(--background);
    color: var(--foreground);
    font-size: var(--text-sm);
    font-family: inherit;
    transition: border-color var(--duration-fast) var(--ease-in-out);
  }

  .edit-form__input:focus,
  .edit-form__textarea:focus {
    outline: none;
    border-color: var(--ring);
    box-shadow: 0 0 0 3px oklch(from var(--ring) l c h / 0.2);
  }

  .edit-form__textarea {
    resize: vertical;
    min-height: 100px;
  }

  .edit-form__image-preview {
    margin-bottom: var(--spacing-md);
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--border);
  }

  .edit-form__preview-image {
    width: 100%;
    max-height: 300px;
    object-fit: cover;
    display: block;
  }

  .edit-form__hint {
    font-size: var(--text-xs);
    color: var(--muted-foreground);
    margin: 0;
  }

  .edit-form__date-group {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gap-md);
  }

  .edit-form__actions {
    display: flex;
    gap: var(--gap-md);
    padding-top: var(--spacing-lg);
    border-top: 1px solid var(--border);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .submissions-grid {
      grid-template-columns: 1fr;
    }

    .edit-form__date-group {
      grid-template-columns: 1fr;
    }

    .edit-form__actions {
      flex-direction: column;
    }

    .edit-form__actions a {
      width: 100%;
    }

    .edit-form__actions a button {
      width: 100%;
    }
  }
</style>