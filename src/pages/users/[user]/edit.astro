---
import Layout from "@/layouts/Layout.astro";
import UserEditForm from "@/components/islands/UserEditForm";
import { getUserByHandle } from "@/lib/data-access/users";
import { setSession } from "@/lib/auth";

const { user } = Astro.params;

if (!user) {
  return Astro.redirect('/404');
}

// Check authentication
const accessToken = Astro.cookies.get("sb-access-token");
const refreshToken = Astro.cookies.get("sb-refresh-token");

if (!accessToken || !refreshToken) {
  return Astro.redirect('/sign-in');
}

let session;
try {
  session = await setSession({
    refresh_token: refreshToken.value,
    access_token: accessToken.value,
  });
  if (session.error || !session.data.user) {
    return Astro.redirect('/sign-in');
  }
} catch (error) {
  return Astro.redirect('/sign-in');
}

const currentUser = session.data.user;

// Fetch the profile
const profileUser = await getUserByHandle(user);

if (!profileUser) {
  return Astro.redirect('/404');
}

// Verify user owns this profile
if (currentUser.id !== profileUser.id) {
  return Astro.redirect(`/users/${user}`);
}
---

<Layout title="Edit Profile - Game Loopers">
  <div class="page">
    <div class="page__container">
      <UserEditForm
        client:load
        handle={profileUser.handle}
        name={profileUser.name || ""}
        bio={profileUser.bio || ""}
        avatarUrl={profileUser.avatar_url || ""}
        userHandle={user}
      />
    </div>
  </div>
</Layout>
