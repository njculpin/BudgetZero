---
import Layout from "@/layouts/Layout.astro";
import Card from "@/components/Card.astro";
import CardHeader from "@/components/CardHeader.astro";
import CardTitle from "@/components/CardTitle.astro";
import CardContent from "@/components/CardContent.astro";
import PageHeader from "@/components/PageHeader.astro";
import { getUserByHandle, getUserTags } from "@/lib/data-access/users";
import { getUserProducts, getProductImages } from "@/lib/data-access/products";
import { setSession } from "@/lib/auth";

const { user } = Astro.params;

if (!user) {
  return Astro.redirect('/404');
}

// Fetch the profile user
const profileUser = await getUserByHandle(user);

if (!profileUser) {
  return Astro.redirect('/404');
}

// Check if viewing own profile
let currentUser = null;
const accessToken = Astro.cookies.get("sb-access-token");
const refreshToken = Astro.cookies.get("sb-refresh-token");

if (accessToken && refreshToken) {
  try {
    const session = await setSession({
      refresh_token: refreshToken.value,
      access_token: accessToken.value,
    });
    if (!session.error && session.data.user) {
      currentUser = session.data.user;
    }
  } catch (error) {
    // User not authenticated, continue as guest
  }
}

// Fetch user's products (public only for public profile)
const userProducts = await getUserProducts(profileUser.id);

// Fetch user tags
const userTags = await getUserTags(profileUser.id);

// Check if viewing own profile
const canEdit = currentUser?.id === profileUser.id;

// Filter for public only
const publicProducts = userProducts.filter(product => product.status === 'public');

// Create product content array with images
type ContentItem = {
  id: string;
  handle: string;
  title: string;
  imageUrl: string;
  createdAt: string;
};

const contentItems: ContentItem[] = await Promise.all(
  publicProducts.map(async (product) => {
    const images = await getProductImages(product.id);
    const coverImage = images.length > 0
      ? images.sort((a, b) => a.position - b.position)[0]
      : null;
    return {
      id: product.id,
      handle: product.handle,
      title: product.title,
      imageUrl: coverImage?.file_url || 'https://placehold.co/400x400?text=Product',
      createdAt: product.created_at,
    };
  })
);

// Sort by creation date (newest first)
contentItems.sort((a, b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime());
---

<Layout
  title={`${profileUser.name || profileUser.handle} - Game Loopers`}
>
  <div class="page">
    <div class="page__container">
      <!-- Public Profile Card -->
      <Card>
        <CardHeader>
          <div class="profile-header">
            <div class="profile-header__avatar">
              {profileUser.avatar_url ? (
                <img
                  src={profileUser.avatar_url}
                  alt={profileUser.name || profileUser.handle}
                  class="profile-header__avatar-img"
                />
              ) : (
                <div class="profile-header__avatar-placeholder">
                  {(profileUser.name || profileUser.handle).charAt(0).toUpperCase()}
                </div>
              )}
            </div>
            <div class="profile-header__info">
              <div class="profile-header__title-row">
                <CardTitle>
                  {profileUser.name || profileUser.handle}
                </CardTitle>
                {canEdit && (
                  <a href="/settings" class="profile-edit-button">
                    Edit Profile
                  </a>
                )}
              </div>
              <p class="profile-header__handle">@{profileUser.handle}</p>
              {profileUser.bio && (
                <p class="profile-header__bio">{profileUser.bio}</p>
              )}

              <!-- Creator Tags -->
              {userTags.length > 0 && (
                <div class="profile-tags">
                  {userTags.map((tag) => (
                    <span class="profile-tag">{tag}</span>
                  ))}
                </div>
              )}

              <!-- Profile Stats -->
              <div class="profile-stats">
                <div class="profile-stat">
                  <span class="profile-stat__value">{publicProducts.length}</span>
                  <span class="profile-stat__label">{publicProducts.length === 1 ? 'Product' : 'Products'}</span>
                </div>
                <div class="profile-stat">
                  <span class="profile-stat__value">
                    {new Date(profileUser.created_at).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
                  </span>
                  <span class="profile-stat__label">Member since</span>
                </div>
              </div>
            </div>
          </div>
        </CardHeader>
      </Card>

      <!-- Content Grid -->
      <div style="margin-top: var(--spacing-4xl);">
      {contentItems.length > 0 ? (
        <div class="profile-content-grid">
          {contentItems.map((item) => (
            <a
              href={`/products/${item.handle}`}
              class="profile-content-item"
              title={item.title}
            >
              <img
                src={item.imageUrl}
                alt={item.title}
                class="profile-content-item__image"
              />
              <div class="profile-content-item__overlay">
                <svg class="profile-content-item__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="9" cy="21" r="1"></circle>
                  <circle cx="20" cy="21" r="1"></circle>
                  <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                </svg>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <Card>
          <CardContent>
            <div class="profile-empty">
              <svg class="profile-empty__icon" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                <circle cx="8.5" cy="8.5" r="1.5"/>
                <polyline points="21 15 16 10 5 21"/>
              </svg>
              <p class="profile-empty__text">
                {profileUser.name || profileUser.handle} hasn't public any products yet.
              </p>
            </div>
          </CardContent>
        </Card>
      )}
      </div>
    </div>
  </div>
</Layout>

<style>
/* ===== Profile Header ===== */
.profile-header {
  display: flex;
  gap: var(--gap-xl);
  align-items: flex-start;
}

.profile-header__avatar {
  flex-shrink: 0;
}

.profile-header__avatar-img {
  width: 96px;
  height: 96px;
  border-radius: 50%;
  object-fit: cover;
}

.profile-header__avatar-placeholder {
  width: 96px;
  height: 96px;
  border-radius: 50%;
  background-color: var(--color-primary, #0070f3);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--text-4xl);
  font-weight: var(--font-weight-semibold);
}

.profile-header__info {
  flex: 1;
}

.profile-header__title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--gap-md);
}

.profile-edit-button {
  padding: var(--spacing-xs) var(--spacing-lg);
  font-size: var(--text-sm);
  font-weight: var(--font-weight-medium);
  color: var(--foreground);
  background-color: var(--background);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  text-decoration: none;
  transition: all var(--duration-fast) var(--ease-in-out);
  white-space: nowrap;
}

.profile-edit-button:hover {
  border-color: var(--primary);
  background-color: oklch(from var(--primary) l c h / 0.05);
}

.profile-header__handle {
  color: var(--muted-foreground);
  font-size: var(--text-sm);
  margin: var(--spacing-xxs) 0 var(--spacing-lg);
}

.profile-header__bio {
  color: var(--color-text, #111);
  font-size: var(--text-base);
  line-height: var(--leading-normal);
  margin: 0 0 var(--spacing-lg) 0;
}

.profile-header__actions {
  flex-shrink: 0;
}

/* ===== Profile Tags ===== */
.profile-tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--gap-xs);
  margin: var(--spacing-md) 0;
}

.profile-tag {
  display: inline-block;
  padding: var(--spacing-xxs) var(--spacing-sm);
  font-size: var(--text-xs);
  font-weight: var(--font-weight-medium);
  color: var(--primary);
  background-color: oklch(from var(--primary) l c h / 0.1);
  border: 1px solid var(--primary);
  border-radius: var(--radius-full);
}

/* ===== Profile Stats ===== */
.profile-stats {
  display: flex;
  gap: var(--gap-2xl);
  margin-top: var(--spacing-lg);
}

.profile-stat {
  display: flex;
  flex-direction: column;
  gap: var(--gap-xs);
}

.profile-stat__value {
  font-size: var(--text-xl);
  font-weight: var(--font-weight-bold);
  color: var(--foreground);
}

.profile-stat__label {
  font-size: var(--text-sm);
  color: var(--muted-foreground);
}

/* ===== Content Grid (Instagram-style) ===== */
.profile-content-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: var(--gap-md);
}

@media (min-width: 640px) {
  .profile-content-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

.profile-content-item {
  position: relative;
  aspect-ratio: 1 / 1;
  overflow: hidden;
  border-radius: var(--radius-md);
  text-decoration: none;
  background-color: var(--muted);
  transition: transform var(--duration-normal) var(--ease-in-out);
}

.profile-content-item:hover {
  transform: scale(1.02);
}

.profile-content-item__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.profile-content-item__overlay {
  position: absolute;
  bottom: var(--spacing-lg);
  right: var(--spacing-lg);
  background-color: rgba(0, 0, 0, 0.7);
  border-radius: var(--radius-sm);
  padding: var(--spacing-sm);
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile-content-item__icon {
  color: white;
  width: 20px;
  height: 20px;
}

/* ===== Empty State ===== */
.profile-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-6xl) var(--spacing-4xl);
  text-align: center;
}

.profile-empty__icon {
  color: var(--muted-foreground);
  margin-bottom: var(--spacing-lg);
  opacity: 0.5;
}

.profile-empty__title {
  font-size: var(--text-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--foreground);
  margin: 0 0 var(--spacing-md) 0;
}

.profile-empty__text {
  color: var(--muted-foreground);
  font-size: var(--text-base);
  max-width: 32rem;
  margin: 0 0 var(--spacing-xl) 0;
}


/* ===== Responsive ===== */
@media (max-width: 640px) {
  .profile-header {
    flex-direction: column;
    text-align: center;
  }

  .profile-header__avatar {
    align-self: center;
  }

  .profile-header__actions {
    align-self: center;
  }

  .profile-stats {
    justify-content: center;
  }
}
</style>

