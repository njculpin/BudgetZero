---
import ProfileLayout from "@/layouts/ProfileLayout.astro";
import Card from "@/components/Card.astro";
import CardHeader from "@/components/CardHeader.astro";
import CardTitle from "@/components/CardTitle.astro";
import CardContent from "@/components/CardContent.astro";
import Button from "@/components/Button.astro";
import { getUserByHandle } from "@/lib/data-access/users";
import { getUserAssets } from "@/lib/data-access/assets";
import { setSession } from "@/lib/auth";

const { user } = Astro.params;

if (!user) {
  return Astro.redirect('/404');
}

// Fetch the profile user
const profileUser = await getUserByHandle(user);

if (!profileUser) {
  return Astro.redirect('/404');
}

// Fetch user's assets (show published assets for non-owners, all for owners)
let userAssets = await getUserAssets(profileUser.id);

// Check if viewing own profile
let currentUser = null;
const accessToken = Astro.cookies.get("sb-access-token");
const refreshToken = Astro.cookies.get("sb-refresh-token");

if (accessToken && refreshToken) {
  try {
    const session = await setSession({
      refresh_token: refreshToken.value,
      access_token: accessToken.value,
    });
    if (!session.error && session.data.user) {
      currentUser = session.data.user;
    }
  } catch (error) {
    // User not authenticated, continue as guest
  }
}

const isPreview = Astro.url.searchParams.get("preview") === 'true' ? true : false
const isOwnProfile = currentUser?.id === profileUser.id;
const isNotPreviewAndIsOwn = !isPreview && isOwnProfile

// Filter assets based on ownership
if (!isOwnProfile) {
  userAssets = userAssets.filter(asset => asset.status === 'published');
}
---

<ProfileLayout
  title={`${profileUser.name || profileUser.handle} - Game Loopers`}
  showCTA={!currentUser}
>
  <div class="page">
    <div class="page__container">
      <div class="page-columns__column">
      <!-- Profile Header -->
      <Card className="profile-card">
        <CardHeader>
          <div class="profile-header">
            <div class="profile-header__avatar">
              {profileUser.avatar_url ? (
                <img
                  src={profileUser.avatar_url}
                  alt={profileUser.name || profileUser.handle}
                  class="profile-header__avatar-img"
                />
              ) : (
                <div class="profile-header__avatar-placeholder">
                  {(profileUser.name || profileUser.handle).charAt(0).toUpperCase()}
                </div>
              )}
            </div>
            <div class="profile-header__info">
              <CardTitle>
                {profileUser.name || profileUser.handle}
              </CardTitle>
              <p class="profile-header__handle">@{profileUser.handle}</p>
              {profileUser.bio && (
                <p class="profile-header__bio">{profileUser.bio}</p>
              )}
            </div>
            {isNotPreviewAndIsOwn ? 
              <a href={`/users/${user}?preview=true`}>
                <Button variant="outline" size="md">
                  <span slot="text">Profile</span>
                </Button>
              </a>
              :
              <a href={`/users/${user}`}>
                <Button variant="outline" size="md">
                  <span slot="text">Edit Profile</span>
                </Button>
              </a>
            }
          </div>
        </CardHeader>
      </Card>

      <!-- Content Tabs -->
      <Card class="content-card">
        <CardContent>
          <div class="profile-tabs">
            <button class="profile-tabs__tab" data-tab="assets">Assets</button>
            <button class="profile-tabs__tab" data-tab="products">Products</button>
          </div>

          <div class="profile-tab-content profile-tab-content--hidden" id="tab-assets">
            {userAssets.length > 0 ? (
              <div class="profile-asset-grid">
                {userAssets.map((asset) => (
                  <a href={`/assets/${asset.handle}`} class="profile-asset-card">
                    <div class="profile-asset-card__header">
                      <h3 class="profile-asset-card__title">{asset.title}</h3>
                      <span class={`profile-asset-card__status profile-asset-card__status--${asset.status}`}>
                        {asset.status}
                      </span>
                    </div>
                    {asset.description && (
                      <p class="profile-asset-card__description">
                        {asset.description.substring(0, 100)}{asset.description.length > 100 ? '...' : ''}
                      </p>
                    )}
                    <div class="profile-asset-card__meta">
                      <p>{asset.download_count} downloads</p>
                      <p>{asset.file_count} files</p>
                    </div>
                  </a>
                ))}
              </div>
            ) : (
              <div class="profile-empty">
                <p class="profile-empty__text">
                  {isOwnProfile
                    ? "You haven't created any assets yet."
                    : `${profileUser.name || profileUser.handle} hasn't created any assets yet.`
                  }
                </p>
              </div>
            )}
          </div>

          <div class="profile-tab-content profile-tab-content--hidden" id="tab-products">
            <div class="profile-empty">
              <p class="profile-empty__text">
                {isOwnProfile
                  ? "You haven't created any products yet."
                  : `${profileUser.name || profileUser.handle} hasn't created any products yet.`
                }
              </p>
            </div>
          </div>
        </CardContent>
      </Card>

      <!-- Activity Feed -->
      <Card className="activity-card">
        <CardHeader>
          <CardTitle>Recent Activity</CardTitle>
        </CardHeader>
        <CardContent>
          <div class="profile-empty">
            <p class="profile-empty__text">
              {isOwnProfile
                ? "No recent activity yet."
                : `${profileUser.name || profileUser.handle} hasn't had any recent activity.`
              }
            </p>
          </div>
        </CardContent>
      </Card>
      </div>
    </div>
  </div>
</ProfileLayout>

<style>
/* ===== Profile Page Layout ===== */
.profile-page {
  min-height: 100vh;
  background-color: var(--color-background, #f9fafb);
  padding: var(--spacing-4xl) var(--spacing-2xl);
}

.profile-page__container {
  max-width: 960px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: var(--spacing-3xl)
}

/* ===== Profile Card ===== */
.profile-card {
  margin-bottom: var(--spacing-4xl);
}

/* ===== Profile Header ===== */
.profile-header {
  display: flex;
  gap: var(--gap-xl);
  align-items: flex-start;
}

.profile-header__avatar {
  flex-shrink: 0;
}

.profile-header__avatar-img {
  width: 96px;
  height: 96px;
  border-radius: 50%;
  object-fit: cover;
}

.profile-header__avatar-placeholder {
  width: 96px;
  height: 96px;
  border-radius: 50%;
  background-color: var(--color-primary, #0070f3);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--text-4xl);
  font-weight: var(--font-weight-semibold);
}

.profile-header__info {
  flex: 1;
}

.profile-header__handle {
  color: var(--muted-foreground);
  font-size: var(--text-sm);
  margin: var(--spacing-xxs) 0 var(--spacing-lg);
}

.profile-header__bio {
  color: var(--color-text, #111);
  font-size: var(--text-base);
  line-height: var(--leading-normal);
  margin: 0;
}

.profile-header__actions {
  flex-shrink: 0;
}

/* ===== Profile Tabs ===== */
.content-card {
  margin-top: var(--spacing-4xl);
}

.profile-tabs {
  display: flex;
  border-bottom: 1px solid var(--color-border, #e5e7eb);
}

.profile-tabs__tab {
  flex: 1;
  padding: var(--spacing-2xl);
  background: none;
  border: none;
  border-bottom: 2px solid transparent;
  font-size: var(--text-sm);
  font-weight: var(--font-weight-medium);
  color: var(--muted-foreground);
  cursor: pointer;
  transition: all var(--duration-normal) var(--ease-in-out);
}

.profile-tabs__tab:hover {
  color: var(--color-text, #111);
  background-color: var(--color-background, #f9fafb);
}

.profile-tabs__tab--active {
  color: var(--color-primary, #0070f3);
  border-bottom-color: var(--color-primary, #0070f3);
}

/* ===== Tab Content ===== */
.profile-tab-content {
  display: block;
}

.profile-tab-content--hidden {
  display: none;
}

/* ===== Empty State ===== */
.profile-empty {
  padding: var(--spacing-5xl) var(--spacing-4xl);
  text-align: center;
}

.profile-empty__text {
  color: var(--muted-foreground);
  font-size: var(--text-base);
}

/* ===== Activity Card ===== */
.activity-card {
  margin-top: var(--spacing-4xl);
}

/* ===== Asset Grid ===== */
.profile-asset-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: var(--gap-xl);
  padding: var(--spacing-4xl);
}

.profile-asset-card {
  display: flex;
  flex-direction: column;
  gap: var(--gap-md);
  padding: var(--spacing-3xl);
  background-color: var(--color-surface, #fff);
  border: 1px solid var(--color-border, #e5e7eb);
  border-radius: var(--radius-md);
  text-decoration: none;
  transition: all var(--duration-normal) var(--ease-in-out);
}

.profile-asset-card:hover {
  border-color: var(--color-primary, #0070f3);
  box-shadow: var(--shadow-md);
  transform: translateY(-2px);
}

.profile-asset-card__header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--gap-md);
}

.profile-asset-card__title {
  margin: 0;
  font-size: var(--text-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text, #111);
}

.profile-asset-card__status {
  display: inline-block;
  padding: var(--spacing-xxs) var(--spacing-lg);
  font-size: var(--text-xs);
  font-weight: var(--font-weight-semibold);
  border-radius: var(--radius-full);
  text-transform: uppercase;
  flex-shrink: 0;
}

.profile-asset-card__status--draft {
  background-color: #fef3c7;
  color: #92400e;
}

.profile-asset-card__status--published {
  background-color: #d1fae5;
  color: #065f46;
}

.profile-asset-card__status--archived {
  background-color: #e5e7eb;
  color: #374151;
}

.profile-asset-card__description {
  margin: 0;
  font-size: var(--text-sm);
  color: var(--muted-foreground);
  line-height: var(--leading-normal);
}

.profile-asset-card__meta {
  display: flex;
  gap: var(--gap-lg);
  font-size: var(--text-sm);
  color: var(--muted-foreground);
}

/* ===== Responsive ===== */
@media (max-width: 640px) {
  .profile-header {
    flex-direction: column;
    text-align: center;
  }

  .profile-header__avatar {
    align-self: center;
  }

  .profile-header__actions {
    align-self: center;
  }

  .profile-stats {
    justify-content: center;
  }
}
</style>

<script>
  // Tab switching functionality
  const tabs = document.querySelectorAll('.profile-tabs__tab');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const tabName = tab.getAttribute('data-tab');

      // Remove active class from all tabs
      tabs.forEach(t => t.classList.remove('profile-tabs__tab--active'));

      // Add active class to clicked tab
      tab.classList.add('profile-tabs__tab--active');

      // Hide all tab content
      const allContent = document.querySelectorAll('.profile-tab-content');
      allContent.forEach(content => content.classList.add('profile-tab-content--hidden'));

      // Show selected tab content
      const selectedContent = document.getElementById(`tab-${tabName}`);
      if (selectedContent) {
        selectedContent.classList.remove('profile-tab-content--hidden');
      }
    });
  });
</script>
