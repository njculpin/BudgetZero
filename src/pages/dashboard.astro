---
import Layout from "@/layouts/Layout.astro";
import Card from "@/components/Card.astro";
import CardContent from "@/components/CardContent.astro";
import Button from "@/components/Button.astro";
import UserEditForm from "@/components/islands/UserEditForm";
import CardFooter from "@/components/CardFooter.astro";

import { setSession } from "../lib/auth";
import { getUserById } from "@/lib/data-access/users";
import { getUserProducts, getProductImages } from "@/lib/data-access/products";
import { getUserAssets, getAssetImages } from "@/lib/data-access/assets";

const accessToken = Astro.cookies.get("sb-access-token");
const refreshToken = Astro.cookies.get("sb-refresh-token");

if (!accessToken || !refreshToken) {
  return Astro.redirect("/sign-in");
}

let session;
try {
  session = await setSession({
    refresh_token: refreshToken.value,
    access_token: accessToken.value,
  });
  if (session.error) {
    Astro.cookies.delete("sb-access-token", {
      path: "/",
    });
    Astro.cookies.delete("sb-refresh-token", {
      path: "/",
    });
    return Astro.redirect("/sign-in");
  }
} catch (error) {
  Astro.cookies.delete("sb-access-token", {
    path: "/",
  });
  Astro.cookies.delete("sb-refresh-token", {
    path: "/",
  });
  return Astro.redirect("/sign-in");
}

const userId = session.data.user?.id;

// Get user profile to access handle
const userProfile = userId ? await getUserById(userId) : null;
const userHandle = userProfile?.handle;

// Fetch user's content
const userProducts = userId ? await getUserProducts(userId) : [];
const userAssets = userId ? await getUserAssets(userId) : [];

// Create unified content array with images
type ContentItem = {
  type: 'asset' | 'product';
  id: string;
  handle: string;
  title: string;
  imageUrl: string;
  createdAt: string;
  status: string;
};

const contentItems: ContentItem[] = await Promise.all([
  ...userAssets.map(async (asset) => {
    const images = await getAssetImages(asset.id);
    const coverImage = images.length > 0
      ? images.sort((a, b) => a.position - b.position)[0]
      : null;
    return {
      type: 'asset' as const,
      id: asset.id,
      handle: asset.handle,
      title: asset.title,
      imageUrl: coverImage?.file_url || 'https://placehold.co/400x400?text=Asset',
      createdAt: asset.created_at,
      status: asset.status,
    };
  }),
  ...userProducts.map(async (product) => {
    const images = await getProductImages(product.id);
    const coverImage = images.length > 0
      ? images.sort((a, b) => a.position - b.position)[0]
      : null;
    return {
      type: 'product' as const,
      id: product.id,
      handle: product.handle,
      title: product.title,
      imageUrl: coverImage?.file_url || 'https://placehold.co/400x400?text=Product',
      createdAt: product.created_at,
      status: product.status,
    };
  }),
]);

// Sort by creation date (newest first)
contentItems.sort((a, b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime());
---

<Layout title="Dashboard - Game Loopers">
  <main class="page">
    <div class="page__container">
      <div class="dashboard">
        <!-- Three Column Layout -->
        <div class="dashboard__grid">
          <!-- Left Column: Actions (1/4) -->
          <aside class="dashboard__actions-sidebar">
            <nav class="dashboard__actions-list">
              <form method="post" action="/api/documents/create-document">
                <Button variant="outline" size="md">
                  <span slot="text">Create Document</span>
                </Button>
              </form>
              <form method="post" action="/api/assets/create-asset">
                <Button variant="outline" size="md">
                  <span slot="text">Create Asset</span>
                </Button>
              </form>
              <form method="post" action="/api/products/create-product">
                <Button variant="outline" size="md">
                  <span slot="text">Create Product</span>
                </Button>
              </form>
              <form method="post" action="/api/jams/create-jam">
                <Button variant="outline" size="md">
                  <span slot="text">Create Jam</span>
                </Button>
              </form>
            </nav>
          </aside>

          <!-- Center Column: Content Grid (2/4) -->
          <div class="dashboard__main">

            <!-- Content Grid -->
            {contentItems.length > 0 ? (
              <div class="dashboard__content-grid">
                {contentItems.map((item) => (
                  <a
                    href={`/${item.type === 'asset' ? 'assets' : 'products'}/${item.handle}`}
                    class="dashboard__content-item"
                    title={item.title}
                  >
                    <img
                      src={item.imageUrl}
                      alt={item.title}
                      class="dashboard__content-image"
                    />
                    <div class="dashboard__content-overlay">
                      <span class={`dashboard__content-status dashboard__content-status--${item.status}`}>
                        {item.status}
                      </span>
                      {item.type === 'asset' ? (
                        <svg class="dashboard__content-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                          <polyline points="7 10 12 15 17 10"></polyline>
                          <line x1="12" y1="15" x2="12" y2="3"></line>
                        </svg>
                      ) : (
                        <svg class="dashboard__content-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <circle cx="9" cy="21" r="1"></circle>
                          <circle cx="20" cy="21" r="1"></circle>
                          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                        </svg>
                      )}
                    </div>
                  </a>
                ))}
              </div>
            ) : (
              <Card>
                <CardContent>
                  <div class="dashboard__empty">
                    <svg class="dashboard__empty-icon" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                      <circle cx="8.5" cy="8.5" r="1.5"/>
                      <polyline points="21 15 16 10 5 21"/>
                    </svg>
                    <p class="dashboard__empty-text">No content yet</p>
                    <p class="dashboard__empty-description">
                      Create your first product or upload an asset to get started
                    </p>
                  </div>
                </CardContent>
              </Card>
            )}
          </div>

          <!-- Right Column: Profile Editor (1/4) -->
          <aside class="dashboard__profile-sidebar">
            <Card>
              <CardContent>
                {userProfile && (
                  <UserEditForm
                    client:load
                    handle={userProfile.handle}
                    name={userProfile.name || ''}
                    bio={userProfile.bio || ''}
                    avatarUrl={userProfile.avatar_url || ''}
                    userHandle={userProfile.handle}
                  />
                )}
                <CardFooter>
                  <a href={`/users/${userHandle}`}>
                      <Button variant="outline" size="md">
                        <span slot="text">View Public Profile</span>
                      </Button>
                  </a>
                </CardFooter>
              </CardContent>
            </Card>
          </aside>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
/* ===== Dashboard Container ===== */
.dashboard {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-4xl);
}

/* ===== Three Column Grid (1-2-1) ===== */
.dashboard__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--spacing-4xl);
  align-items: start;
}

/* Mobile: Stack vertically */
@media (max-width: 1023px) {
  .dashboard__grid {
    grid-template-columns: 1fr;
  }
}

/* Desktop: 3 columns (1-2-1) */
@media (min-width: 1024px) {
  .dashboard__grid {
    grid-template-columns: 1fr 3fr 2fr;
    gap: var(--spacing-3xl);
  }
}

/* ===== Left Sidebar: Actions (1/4) ===== */
.dashboard__actions-sidebar {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-3xl);
}

.dashboard__section-title {
  font-size: var(--text-xl);
  font-weight: var(--font-weight-semibold);
  color: var(--foreground);
  margin: 0;
}

.dashboard__actions-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-2xl);
}

.dashboard__actions-list form {
  margin: 0;
  width: 100%;
}

/* Mobile: Horizontal scrolling */
@media (max-width: 1023px) {
  .dashboard__actions-list {
    flex-direction: row;
    overflow-x: auto;
    padding-bottom: var(--spacing-sm);
  }

  .dashboard__actions-list form {
    flex-shrink: 0;
    min-width: 140px;
  }
}

/* ===== Center Column: Content (2/4) ===== */
.dashboard__main {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-4xl);
}

/* ===== Content Grid (Instagram-style) ===== */
.dashboard__content-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: var(--gap-md);
}

@media (min-width: 640px) {
  .dashboard__content-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 1024px) {
  .dashboard__content-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 1440px) {
  .dashboard__content-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

.dashboard__content-item {
  position: relative;
  aspect-ratio: 1 / 1;
  overflow: hidden;
  border-radius: var(--radius-md);
  text-decoration: none;
  background-color: var(--muted);
  transition: transform var(--duration-normal) var(--ease-in-out);
}

.dashboard__content-item:hover {
  transform: scale(1.02);
}

.dashboard__content-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.dashboard__content-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.7) 0%, transparent 50%);
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: var(--spacing-lg);
  transition: opacity var(--duration-normal) var(--ease-in-out);
}

.dashboard__content-status {
  font-size: var(--text-xs);
  font-weight: var(--font-weight-semibold);
  padding: var(--spacing-xs) var(--spacing-lg);
  border-radius: var(--radius-full);
  text-transform: uppercase;
  letter-spacing: 0.025em;
}

.dashboard__content-status--draft {
  background-color: rgba(254, 243, 199, 0.9);
  color: #92400e;
}

.dashboard__content-status--published {
  background-color: rgba(209, 250, 229, 0.9);
  color: #065f46;
}

.dashboard__content-status--archived {
  background-color: rgba(229, 231, 235, 0.9);
  color: #374151;
}

.dashboard__content-icon {
  color: white;
  width: 20px;
  height: 20px;
  filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.3));
}

/* ===== Right Sidebar: Profile (1/4) ===== */
.dashboard__profile-sidebar {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-3xl);
  position: sticky;
  top: var(--spacing-4xl);
}

.dashboard__profile-actions {
  display: flex;
  justify-content: flex-end;
}

.dashboard__profile-actions a {
  text-decoration: none;
}

@media (max-width: 1023px) {
  .dashboard__profile-sidebar {
    position: static;
  }

  .dashboard__profile-actions {
    justify-content: center;
  }
}

/* ===== Empty State ===== */
.dashboard__empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: var(--spacing-5xl) var(--spacing-3xl);
  gap: var(--spacing-2xl);
}

.dashboard__empty-icon {
  color: var(--muted-foreground);
  opacity: 0.5;
  width: 64px;
  height: 64px;
}

.dashboard__empty-text {
  font-size: var(--text-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--foreground);
  margin: 0;
}

.dashboard__empty-description {
  font-size: var(--text-sm);
  color: var(--muted-foreground);
  max-width: 32rem;
  margin: 0;
}

</style>