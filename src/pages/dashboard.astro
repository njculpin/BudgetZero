---
import Layout from "@/layouts/Layout.astro";
import Card from "@/components/Card.astro";
import CardHeader from "@/components/CardHeader.astro";
import CardTitle from "@/components/CardTitle.astro";
import CardContent from "@/components/CardContent.astro";
import Button from "@/components/Button.astro";
import UserEditForm from "@/components/users/UserEditForm";
import CardFooter from "@/components/CardFooter.astro";
import DashboardContentFilter from "@/components/dashboard/DashboardContentFilter";
import FirstTimeUserOnboarding from "@/components/dashboard/FirstTimeUserOnboarding";
import { FormSubmitButton } from "@/components/interactive";

import { getUserById } from "@/lib/data-access/users";
import { getUserProducts, getProductImages } from "@/lib/data-access/products";
import { getUserEarningsSummary, getRoyaltyTransactionHistory } from "@/lib/data-access/royalties";
import { getAvailablePayoutBalance, getUserPayouts } from "@/lib/data-access/payouts";

// Auth is handled by middleware - user is guaranteed to exist on protected routes
const userId = Astro.locals.user?.id;

if (!userId) {
  // This should never happen due to middleware, but TypeScript needs this check
  return Astro.redirect("/sign-in");
}

// Get user profile to access handle
const userProfile = await getUserById(userId);
const userHandle = userProfile?.handle;

// Fetch user's content
const userProducts = await getUserProducts(userId);

// Fetch royalty earnings
const earningsSummary = await getUserEarningsSummary(userId);
const recentTransactions = await getRoyaltyTransactionHistory(userId);

// Fetch payout data
const availableBalance = await getAvailablePayoutBalance(userId);
const recentPayouts = await getUserPayouts(userId);

// Create unified content array with images
type ContentItem = {
  type: 'product';
  id: string;
  handle: string;
  title: string;
  imageUrl: string;
  createdAt: string;
  status: string;
};

const contentItems: ContentItem[] = await Promise.all([
  ...userProducts.map(async (product) => {
    const images = await getProductImages(product.id);
    const coverImage = images.length > 0
      ? images.sort((a, b) => a.position - b.position)[0]
      : null;
    return {
      type: 'product' as const,
      id: product.id,
      handle: product.handle,
      title: product.title,
      imageUrl: coverImage?.file_url || 'https://placehold.co/400x400?text=Product',
      createdAt: product.created_at,
      status: product.status,
    };
  }),
]);

// Sort by creation date (newest first)
contentItems.sort((a, b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime());
---

<Layout title="Dashboard - Game Loopers">
  {/* Show onboarding for users with no content */}
  {contentItems.length === 0 && (
    <FirstTimeUserOnboarding client:load />
  )}

  <main class="page">
    <div class="page__container">
      <div class="dashboard">
        <!-- Three Column Layout -->
        <div class="dashboard__grid">
          <!-- Left Column: Actions (1/4) -->
          <aside class="dashboard__actions-sidebar">
            <nav class="dashboard__actions-list">
              <FormSubmitButton
                client:load
                action="/api/documents/create-document"
                method="post"
                variant="outline"
                size="md"
              >
                Create Document
              </FormSubmitButton>
              <FormSubmitButton
                client:load
                action="/api/products/create-product"
                method="post"
                variant="outline"
                size="md"
              >
                Create Product
              </FormSubmitButton>
              <FormSubmitButton
                client:load
                action="/api/jams/create-jam"
                method="post"
                variant="outline"
                size="md"
              >
                Create Jam
              </FormSubmitButton>
            </nav>
          </aside>

          <!-- Center Column: Content Grid (2/4) -->
          <div class="dashboard__main">

            <!-- Royalty Earnings Section -->
            {earningsSummary && earningsSummary.transactionCount > 0 && (
              <Card>
                <CardHeader>
                  <CardTitle>Royalty Earnings</CardTitle>
                </CardHeader>
                <CardContent>
                  <div class="earnings-summary">
                    <div class="earnings-summary__grid">
                      <div class="earnings-summary__stat">
                        <span class="earnings-summary__label">Total Earnings</span>
                        <span class="earnings-summary__value">
                          ${(earningsSummary.totalEarnings / 100).toFixed(2)}
                        </span>
                      </div>
                      <div class="earnings-summary__stat">
                        <span class="earnings-summary__label">This Month</span>
                        <span class="earnings-summary__value">
                          ${(earningsSummary.thisMonthEarnings / 100).toFixed(2)}
                        </span>
                      </div>
                      <div class="earnings-summary__stat">
                        <span class="earnings-summary__label">Last Month</span>
                        <span class="earnings-summary__value">
                          ${(earningsSummary.lastMonthEarnings / 100).toFixed(2)}
                        </span>
                      </div>
                      <div class="earnings-summary__stat">
                        <span class="earnings-summary__label">Transactions</span>
                        <span class="earnings-summary__value">
                          {earningsSummary.transactionCount}
                        </span>
                      </div>
                    </div>

                    {recentTransactions.length > 0 && (
                      <div class="earnings-transactions">
                        <h3 class="earnings-transactions__title">Recent Transactions</h3>
                        <div class="earnings-transactions__list">
                          {recentTransactions.slice(0, 5).map((transaction) => (
                            <div class="transaction-item">
                              <div class="transaction-item__content">
                                <span class="transaction-item__title">
                                  {transaction.productTitle} - {transaction.variantTitle}
                                </span>
                                <span class="transaction-item__subtitle">
                                  {transaction.componentTitle || 'Product royalty'}
                                </span>
                                <span class="transaction-item__date">
                                  {new Date(transaction.createdAt).toLocaleDateString()}
                                </span>
                              </div>
                              <div class="transaction-item__amount">
                                <span class={`transaction-item__status transaction-item__status--${transaction.status}`}>
                                  {transaction.status}
                                </span>
                                <span class="transaction-item__value">
                                  ${(transaction.calculatedCents / 100).toFixed(2)}
                                </span>
                              </div>
                            </div>
                          ))}
                        </div>
                      </div>
                    )}
                  </div>
                </CardContent>
              </Card>
            )}

            <!-- Payout Section -->
            {!userProfile?.stripe_connect_onboarded ? (
              <Card>
                <CardHeader>
                  <CardTitle>Get Paid for Your Work</CardTitle>
                </CardHeader>
                <CardContent>
                  <div class="payout-setup">
                    <div class="payout-setup__info">
                      <p class="payout-setup__description">
                        Connect your bank account to receive royalty payouts when your products are purchased. Set up takes just a few minutes.
                      </p>
                      <div class="payout-setup__features">
                        <div class="payout-setup__feature">
                          <svg class="payout-setup__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                          </svg>
                          <span>Secure & powered by Stripe</span>
                        </div>
                        <div class="payout-setup__feature">
                          <svg class="payout-setup__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 16 14"></polyline>
                          </svg>
                          <span>Processed within 2-3 business days</span>
                        </div>
                        <div class="payout-setup__feature">
                          <svg class="payout-setup__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="12" y1="1" x2="12" y2="23"></line>
                            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                          </svg>
                          <span>Request payouts anytime from your dashboard</span>
                        </div>
                      </div>
                    </div>
                    <div class="payout-setup__actions">
                      <a href="/connect/onboarding">
                        <Button variant="primary" size="lg">
                          <span slot="text">Connect Bank Account</span>
                        </Button>
                      </a>
                    </div>
                  </div>
                </CardContent>
              </Card>
            ) : availableBalance.totalCents > 0 ? (
              <Card>
                <CardHeader>
                  <CardTitle>Available for Payout</CardTitle>
                </CardHeader>
                <CardContent>
                  <div class="payout-available">
                    <div class="payout-available__amount">
                      <span class="payout-available__label">Available Balance</span>
                      <span class="payout-available__value">
                        ${(availableBalance.totalCents / 100).toFixed(2)} USD
                      </span>
                    </div>

                    <div class="payout-available__actions">
                      <a href="/payouts">
                        <Button variant="primary" size="md">
                          <span slot="text">Request Payout</span>
                        </Button>
                      </a>
                      <p class="payout-available__note">
                        Payouts are typically processed within 2-3 business days
                      </p>
                    </div>
                  </div>

                  {recentPayouts.length > 0 && (
                    <div class="payout-history">
                      <h3 class="payout-history__title">Recent Payouts</h3>
                      <div class="payout-history__list">
                        {recentPayouts.slice(0, 5).map((payout) => (
                          <div class="payout-item">
                            <div class="payout-item__content">
                              <span class="payout-item__date">
                                {new Date(payout.requested_at).toLocaleDateString()}
                              </span>
                              <span class={`payout-item__status payout-item__status--${payout.status}`}>
                                {payout.status}
                              </span>
                            </div>
                            <div class="payout-item__amount">
                              ${(payout.amount_cents / 100).toFixed(2)}
                            </div>
                          </div>
                        ))}
                      </div>
                      <div class="payout-history__view-all">
                        <a href="/payouts" class="payout-history__link">
                          View All Payouts →
                        </a>
                      </div>
                    </div>
                  )}
                </CardContent>
              </Card>
            ) : recentPayouts.length > 0 && (
              <Card>
                <CardHeader>
                  <CardTitle>Payout History</CardTitle>
                </CardHeader>
                <CardContent>
                  <div class="payout-history">
                    <p class="payout-history__empty">No balance available for payout. You'll see new transactions here when your products generate royalties.</p>
                    <div class="payout-history__list">
                      {recentPayouts.slice(0, 5).map((payout) => (
                        <div class="payout-item">
                          <div class="payout-item__content">
                            <span class="payout-item__date">
                              {new Date(payout.requested_at).toLocaleDateString()}
                            </span>
                            <span class={`payout-item__status payout-item__status--${payout.status}`}>
                              {payout.status}
                            </span>
                          </div>
                          <div class="payout-item__amount">
                            ${(payout.amount_cents / 100).toFixed(2)}
                          </div>
                        </div>
                      ))}
                    </div>
                    <div class="payout-history__view-all">
                      <a href="/payouts" class="payout-history__link">
                        View All Payouts →
                      </a>
                    </div>
                  </div>
                </CardContent>
              </Card>
            )}

            <!-- Content Grid with Filters -->
            <DashboardContentFilter
              client:load
              items={contentItems}
            />
          </div>

          <!-- Right Column: Profile Editor (1/4) -->
          <aside class="dashboard__profile-sidebar">
            <Card>
              <CardContent>
                {userProfile && (
                  <UserEditForm
                    client:load
                    handle={userProfile.handle}
                    name={userProfile.name || ''}
                    bio={userProfile.bio || ''}
                    avatarUrl={userProfile.avatar_url || ''}
                    userHandle={userProfile.handle}
                  />
                )}
                <CardFooter>
                  <a href={`/users/${userHandle}`}>
                      <Button variant="outline" size="md">
                        <span slot="text">View Public Profile</span>
                      </Button>
                  </a>
                </CardFooter>
              </CardContent>
            </Card>
          </aside>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
/* ===== Dashboard Container ===== */
.dashboard {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-4xl);
}

/* ===== Three Column Grid (1-2-1) ===== */
.dashboard__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--spacing-4xl);
  align-items: start;
}

/* Mobile: Stack vertically */
@media (max-width: 1023px) {
  .dashboard__grid {
    grid-template-columns: 1fr;
  }
}

/* Desktop: 3 columns (1-2-1) */
@media (min-width: 1024px) {
  .dashboard__grid {
    grid-template-columns: 1fr 3fr 2fr;
    gap: var(--spacing-3xl);
  }
}

/* ===== Left Sidebar: Actions (1/4) ===== */
.dashboard__actions-sidebar {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-3xl);
}

.dashboard__section-title {
  font-size: var(--text-xl);
  font-weight: var(--font-weight-semibold);
  color: var(--foreground);
  margin: 0;
}

.dashboard__actions-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-2xl);
}

.dashboard__actions-list form {
  margin: 0;
  width: 100%;
}

/* Mobile: Horizontal scrolling */
@media (max-width: 1023px) {
  .dashboard__actions-list {
    flex-direction: row;
    overflow-x: auto;
    padding-bottom: var(--spacing-sm);
  }

  .dashboard__actions-list form {
    flex-shrink: 0;
    min-width: 140px;
  }
}

/* ===== Center Column: Content (2/4) ===== */
.dashboard__main {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-4xl);
}

/* ===== Content Grid (Instagram-style) ===== */
.dashboard__content-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: var(--gap-md);
}

@media (min-width: 640px) {
  .dashboard__content-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 1024px) {
  .dashboard__content-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 1440px) {
  .dashboard__content-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

.dashboard__content-item {
  position: relative;
  aspect-ratio: 1 / 1;
  overflow: hidden;
  border-radius: var(--radius-md);
  text-decoration: none;
  background-color: var(--muted);
  transition: transform var(--duration-normal) var(--ease-in-out);
}

.dashboard__content-item:hover {
  transform: scale(1.02);
}

.dashboard__content-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.dashboard__content-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.7) 0%, transparent 50%);
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: var(--spacing-lg);
  transition: opacity var(--duration-normal) var(--ease-in-out);
}

.dashboard__content-status {
  font-size: var(--text-xs);
  font-weight: var(--font-weight-semibold);
  padding: var(--spacing-xs) var(--spacing-lg);
  border-radius: var(--radius-full);
  text-transform: uppercase;
  letter-spacing: 0.025em;
}

.dashboard__content-status--draft {
  background-color: rgba(254, 243, 199, 0.9);
  color: #92400e;
}

.dashboard__content-status--public {
  background-color: rgba(209, 250, 229, 0.9);
  color: #065f46;
}

.dashboard__content-status--archived {
  background-color: rgba(229, 231, 235, 0.9);
  color: #374151;
}

.dashboard__content-icon {
  color: white;
  width: 20px;
  height: 20px;
  filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.3));
}

/* ===== Right Sidebar: Profile (1/4) ===== */
.dashboard__profile-sidebar {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-3xl);
  position: sticky;
  top: var(--spacing-4xl);
}

.dashboard__profile-actions {
  display: flex;
  justify-content: flex-end;
}

.dashboard__profile-actions a {
  text-decoration: none;
}

@media (max-width: 1023px) {
  .dashboard__profile-sidebar {
    position: static;
  }

  .dashboard__profile-actions {
    justify-content: center;
  }
}

/* ===== Empty State ===== */
.dashboard__empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: var(--spacing-5xl) var(--spacing-3xl);
  gap: var(--spacing-2xl);
}

.dashboard__empty-icon {
  color: var(--muted-foreground);
  opacity: 0.5;
  width: 64px;
  height: 64px;
}

.dashboard__empty-text {
  font-size: var(--text-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--foreground);
  margin: 0;
}

.dashboard__empty-description {
  font-size: var(--text-sm);
  color: var(--muted-foreground);
  max-width: 32rem;
  margin: 0;
}

/* ===== Earnings Summary ===== */
.earnings-summary {
  display: flex;
  flex-direction: column;
  gap: var(--gap-3xl);
}

.earnings-summary__grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--gap-2xl);
}

@media (min-width: 768px) {
  .earnings-summary__grid {
    grid-template-columns: repeat(4, 1fr);
  }
}

.earnings-summary__stat {
  display: flex;
  flex-direction: column;
  gap: var(--gap-sm);
}

.earnings-summary__label {
  font-size: var(--text-sm);
  font-weight: var(--font-weight-medium);
  color: var(--muted-foreground);
}

.earnings-summary__value {
  font-size: var(--text-2xl);
  font-weight: var(--font-weight-bold);
  color: var(--foreground);
}

/* ===== Earnings Transactions ===== */
.earnings-transactions {
  padding-top: var(--spacing-2xl);
  border-top: 1px solid var(--border);
}

.earnings-transactions__title {
  margin: 0 0 var(--spacing-lg) 0;
  font-size: var(--text-base);
  font-weight: var(--font-weight-semibold);
  color: var(--foreground);
}

.earnings-transactions__list {
  display: flex;
  flex-direction: column;
  gap: var(--gap-md);
}

.transaction-item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: var(--spacing-lg);
  background-color: var(--muted);
  border: var(--border-width-default) solid var(--border);
  border-radius: var(--radius-md);
  gap: var(--gap-lg);
}

.transaction-item__content {
  display: flex;
  flex-direction: column;
  gap: var(--gap-xs);
  flex: 1;
}

.transaction-item__title {
  font-size: var(--text-sm);
  font-weight: var(--font-weight-semibold);
  color: var(--foreground);
}

.transaction-item__subtitle {
  font-size: var(--text-xs);
  color: var(--muted-foreground);
}

.transaction-item__date {
  font-size: var(--text-xs);
  color: var(--muted-foreground);
}

.transaction-item__amount {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: var(--gap-xs);
}

.transaction-item__status {
  font-size: var(--text-xs);
  font-weight: var(--font-weight-medium);
  padding: var(--spacing-xs) var(--spacing-sm);
  border-radius: var(--radius-sm);
  text-transform: uppercase;
}

.transaction-item__status--pending {
  background-color: rgba(254, 243, 199, 0.9);
  color: #92400e;
}

.transaction-item__status--paid {
  background-color: rgba(209, 250, 229, 0.9);
  color: #065f46;
}

.transaction-item__status--ready_to_pay {
  background-color: rgba(191, 219, 254, 0.9);
  color: #1e40af;
}

.transaction-item__value {
  font-size: var(--text-lg);
  font-weight: var(--font-weight-bold);
  color: var(--foreground);
}

@media (max-width: 640px) {
  .transaction-item {
    flex-direction: column;
  }

  .transaction-item__amount {
    align-items: flex-start;
  }
}

/* ===== Payout Setup ===== */
.payout-setup {
  display: flex;
  flex-direction: column;
  gap: var(--gap-3xl);
  padding: var(--spacing-2xl);
}

.payout-setup__info {
  display: flex;
  flex-direction: column;
  gap: var(--gap-2xl);
}

.payout-setup__description {
  margin: 0;
  font-size: var(--text-base);
  color: var(--foreground);
  line-height: var(--leading-relaxed);
}

.payout-setup__features {
  display: flex;
  flex-direction: column;
  gap: var(--gap-lg);
}

.payout-setup__feature {
  display: flex;
  align-items: flex-start;
  gap: var(--gap-md);
  font-size: var(--text-sm);
  color: var(--muted-foreground);
  line-height: var(--leading-relaxed);
}

.payout-setup__icon {
  flex-shrink: 0;
  color: var(--primary);
  margin-top: 2px;
}

.payout-setup__actions {
  display: flex;
  justify-content: center;
  padding-top: var(--spacing-lg);
}

.payout-setup__actions a {
  text-decoration: none;
}

/* ===== Payout Available ===== */
.payout-available {
  display: flex;
  flex-direction: column;
  gap: var(--gap-3xl);
}

.payout-available__amount {
  display: flex;
  flex-direction: column;
  gap: var(--gap-sm);
  padding: var(--spacing-3xl);
  background-color: var(--muted);
  border: var(--border-width-default) solid var(--border);
  border-radius: var(--radius-md);
  text-align: center;
}

.payout-available__label {
  font-size: var(--text-sm);
  font-weight: var(--font-weight-medium);
  color: var(--muted-foreground);
}

.payout-available__value {
  font-size: var(--text-3xl);
  font-weight: var(--font-weight-bold);
  color: var(--foreground);
}

.payout-available__actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--gap-lg);
}

.payout-available__actions form {
  margin: 0;
}

.payout-available__actions a {
  text-decoration: none;
}

.payout-available__note {
  margin: 0;
  font-size: var(--text-sm);
  color: var(--muted-foreground);
  text-align: center;
}

.payout-connect {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--gap-lg);
  padding: var(--spacing-2xl);
  background-color: var(--muted);
  border: var(--border-width-default) solid var(--border);
  border-radius: var(--radius-md);
}

.payout-connect__message {
  margin: 0;
  font-size: var(--text-base);
  color: var(--muted-foreground);
  text-align: center;
}

.payout-connect a {
  text-decoration: none;
}

/* ===== Payout History ===== */
.payout-history {
  padding-top: var(--spacing-2xl);
  border-top: 1px solid var(--border);
}

.payout-history__title {
  margin: 0 0 var(--spacing-lg) 0;
  font-size: var(--text-base);
  font-weight: var(--font-weight-semibold);
  color: var(--foreground);
}

.payout-history__empty {
  margin: 0 0 var(--spacing-xl) 0;
