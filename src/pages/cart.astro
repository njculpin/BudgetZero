---
import Layout from "@/layouts/Layout.astro";
import Card from "@/components/Card.astro";
import CardHeader from "@/components/CardHeader.astro";
import CardTitle from "@/components/CardTitle.astro";
import CardContent from "@/components/CardContent.astro";
import Button from "@/components/Button.astro";
import CartItemRow from "@/components/cart/CartItemRow";
import CheckoutButton from "@/components/checkout/CheckoutButton";
import { setSession } from "@/lib/auth";
import Breadcrumb from "@/components/Breadcrumb.astro";
import EmptyState from "@/components/EmptyState.astro";
import { getOrCreateCart, getCartItems } from "@/lib/data-access/cart";
import { getProductById, getVariantById, getVariantPrices } from "@/lib/data-access/products";

const accessToken = Astro.cookies.get("sb-access-token");
const refreshToken = Astro.cookies.get("sb-refresh-token");

if (!accessToken || !refreshToken) {
  return Astro.redirect("/sign-in?redirect=/cart");
}

let session;
try {
  session = await setSession({
    refresh_token: refreshToken.value,
    access_token: accessToken.value,
  });
  if (session.error) {
    Astro.cookies.delete("sb-access-token", { path: "/" });
    Astro.cookies.delete("sb-refresh-token", { path: "/" });
    return Astro.redirect("/sign-in?redirect=/cart");
  }
} catch (error) {
  Astro.cookies.delete("sb-access-token", { path: "/" });
  Astro.cookies.delete("sb-refresh-token", { path: "/" });
  return Astro.redirect("/sign-in?redirect=/cart");
}

const userId = session.data.user?.id;

if (!userId) {
  return Astro.redirect("/sign-in?redirect=/cart");
}

// Get cart and items (cart operations now handled client-side)
const cart = await getOrCreateCart(userId);

const cartItems = cart ? await getCartItems(cart.id) : [];

// Fetch product and variant details for each cart item
const cartItemsWithDetails = await Promise.all(
  cartItems.map(async (item) => {
    const product = await getProductById(item.product_id);
    const variant = await getVariantById(item.variant_id);
    const prices = variant ? await getVariantPrices(variant.id) : [];
    const price = prices.length > 0 ? prices[0] : null; // Use first price for now

    return {
      ...item,
      product,
      variant,
      price,
    };
  })
);

// Calculate totals
const subtotal = cartItemsWithDetails.reduce((total, item) => {
  if (item.price) {
    return total + (item.price.unit_amount * item.quantity);
  }
  return total;
}, 0);

const showAddedMessage = Astro.url.searchParams.get('added') === 'true';
const showCancelledMessage = Astro.url.searchParams.get('cancelled') === 'true';
---

<Layout title="Shopping Cart - Game Loopers">
  <div class="page">
    <div class="page__container">
      <!-- Breadcrumb Navigation -->
      <Breadcrumb
        items={[
          { label: "Home", href: "/" },
        ]}
        currentPage="Shopping Cart"
      />

      <div class="page__header">
        <h1 class="page__title">Shopping Cart</h1>
      </div>

      {showAddedMessage && (
        <div class="cart-alert cart-alert--success">
          Item added to cart!
        </div>
      )}

      {showCancelledMessage && (
        <div class="cart-alert cart-alert--error">
          Checkout was cancelled. Your items are still in your cart.
        </div>
      )}

      {cartItemsWithDetails.length > 0 ? (
        <div class="cart-layout">
          <div class="cart-items">
            <Card>
              <CardContent>
                <div class="cart-items__list">
                  {cartItemsWithDetails.map((item) => (
                    <CartItemRow
                      client:load
                      item={item}
                      onUpdate={() => window.location.reload()}
                      onRemove={() => window.location.reload()}
                    />
                  ))}
                </div>
              </CardContent>
            </Card>
          </div>

          <div class="cart-summary">
            <Card>
              <CardHeader>
                <CardTitle>Order Summary</CardTitle>
              </CardHeader>
              <CardContent>
                <div class="cart-summary__content">
                  <div class="cart-summary__row">
                    <span class="cart-summary__label">Subtotal</span>
                    <span class="cart-summary__value">USD {(subtotal / 100).toFixed(2)}</span>
                  </div>
                  <div class="cart-summary__row cart-summary__row--total">
                    <span class="cart-summary__label">Total</span>
                    <span class="cart-summary__value">USD {(subtotal / 100).toFixed(2)}</span>
                  </div>

                  <div class="cart-summary__checkout">
                    <CheckoutButton client:load variant="primary" size="lg" />
                  </div>
                </div>
              </CardContent>
            </Card>

            <div class="cart-summary__continue">
              <a href="/products">
                <Button variant="outline" size="md">
                  <span slot="text">Continue Shopping</span>
                </Button>
              </a>
            </div>
          </div>
        </div>
      ) : (
        <Card>
          <CardContent>
            <EmptyState
              icon="cart"
              title="Your cart is empty"
              description="Start shopping and add products to your cart to see them here."
              actionText="Browse Products"
              actionHref="/products"
            />
          </CardContent>
        </Card>
      )}
    </div>
  </div>
</Layout>

<style>
.cart-alert {
  padding: var(--spacing-2xl);
  border-radius: var(--radius-md);
  margin-bottom: var(--spacing-2xl);
}

.cart-alert--success {
  background-color: var(--success-bg);
  color: var(--success-fg);
  border: var(--border-width-default) solid var(--success);
}

.cart-alert--error {
  background-color: var(--destructive-bg);
  color: var(--destructive-fg);
  border: var(--border-width-default) solid var(--destructive);
}

.cart-layout {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--gap-2xl);
}

@media (min-width: 1024px) {
  .cart-layout {
    grid-template-columns: 2fr 1fr;
  }
}

.cart-items__list {
  display: flex;
  flex-direction: column;
}

.cart-summary__content {
  display: flex;
  flex-direction: column;
  gap: var(--gap-lg);
}

.cart-summary__row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-md) 0;
}

.cart-summary__row--total {
  border-top: var(--border-width-thick) solid var(--border);
  padding-top: var(--spacing-2xl);
  margin-top: var(--spacing-md);
}

.cart-summary__label {
  font-size: var(--text-base);
  color: var(--muted-foreground);
}

.cart-summary__row--total .cart-summary__label {
  font-size: var(--text-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--foreground);
}

.cart-summary__value {
  font-size: var(--text-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--foreground);
}

.cart-summary__row--total .cart-summary__value {
  font-size: var(--text-2xl);
  font-weight: var(--font-weight-bold);
  color: var(--primary);
}

.cart-summary__checkout {
  width: 100%;
}

.cart-summary__continue {
  margin-top: var(--spacing-2xl);
}

.cart-summary__continue a {
  display: block;
  text-decoration: none;
}

.cart-summary__continue button {
  width: 100%;
}

.cart-empty {
  text-align: center;
  padding: var(--spacing-5xl) var(--spacing-3xl);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--gap-2xl);
}

.cart-empty__text {
  margin: 0;
  font-size: var(--text-lg);
  color: var(--muted-foreground);
}

.cart-empty a {
  text-decoration: none;
}
</style>
