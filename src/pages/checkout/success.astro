---
import Layout from "@/layouts/Layout.astro";
import Card from "@/components/Card.astro";
import CardContent from "@/components/CardContent.astro";
import Button from "@/components/Button.astro";
import { setSession } from "@/lib/auth";
import { getCheckoutSession } from "@/lib/payments";
import { getOrCreateCart, clearCart } from "@/lib/data-access/cart";
import { getSaleByStripeChargeId, getSaleById, getSaleItems } from "@/lib/data-access/sales";
import { getProductById, getProductFiles, getProductDocuments, getProductComponents } from "@/lib/data-access/products";
import type { Product, ProductFile } from "@/types";

const sessionId = Astro.url.searchParams.get('session_id');
const saleId = Astro.url.searchParams.get('sale_id');
const isMockCheckout = Astro.url.searchParams.get('mock') === 'true';

if (!sessionId && !saleId) {
  return Astro.redirect('/cart');
}

// Check authentication
const accessToken = Astro.cookies.get("sb-access-token");
const refreshToken = Astro.cookies.get("sb-refresh-token");

let currentUser = null;
if (accessToken && refreshToken) {
  try {
    const session = await setSession({
      refresh_token: refreshToken.value,
      access_token: accessToken.value,
    });
    if (!session.error && session.data.user) {
      currentUser = session.data.user;
    }
  } catch (error) {}
}

// Handle mock checkout vs Stripe checkout
let customerEmail: string | null = null;
let amountTotal = 0;
let currency = 'usd';
let sale = null;
let orderId: string;

if (isMockCheckout && saleId) {
  // Mock checkout - fetch sale directly
  sale = await getSaleById(saleId);

  if (!sale) {
    return Astro.redirect('/cart');
  }

  customerEmail = sale.user_email;
  amountTotal = sale.price_cents;
  currency = sale.currency;
  orderId = `mock_${sale.id}`;
} else if (sessionId) {
  // Stripe checkout - retrieve session
  let checkoutSession: Awaited<ReturnType<typeof getCheckoutSession>>;
  try {
    checkoutSession = await getCheckoutSession(sessionId);
  } catch (error) {
    console.error('Error retrieving checkout session:', error);
    return Astro.redirect('/cart');
  }

  customerEmail = checkoutSession.customer_email;
  amountTotal = checkoutSession.amount_total || 0;
  currency = checkoutSession.currency || 'usd';
  orderId = sessionId;

  // Get the sale by Stripe charge ID
  const paymentIntent = checkoutSession.payment_intent as string || sessionId;
  sale = await getSaleByStripeChargeId(paymentIntent);
} else {
  return Astro.redirect('/cart');
}

// If user is logged in, clear their cart (only for non-mock or first-time mock)
if (currentUser && accessToken && refreshToken) {
  const cart = await getOrCreateCart(currentUser.id);
  if (cart) {
    await clearCart(cart.id);
  }
}

// Get sale items for download links
const saleItems = sale ? await getSaleItems(sale.id) : [];

// Get product details, files, and documents for each sale item
const purchasedProducts: Array<{
  saleItem: Awaited<ReturnType<typeof getSaleItems>>[number];
  product: Product | null;
  files: Array<ProductFile & { is_document?: boolean; source_product_title?: string }>;
}> = await Promise.all(
  saleItems.map(async (saleItem) => {
    const product = await getProductById(saleItem.product_id);

    // Get files from main product
    const mainProductFiles = product ? await getProductFiles(product.id) : [];

    // Get documents from main product
    const mainProductDocuments = product ? await getProductDocuments(product.id) : [];
    const mainProductDocumentFiles = mainProductDocuments.map(doc => ({
        id: doc.id,
        document_id: doc.document_id,
        title: doc.document?.title || 'Document',
        description: doc.document?.description || '',
        file_url: doc.pdf_url || `/documents/${doc.document?.handle}`,
        storage_path: doc.pdf_storage_path || '',
        file_size_bytes: 0,
        mime_type: 'application/pdf',
        position: doc.position,
        price_cents: doc.price_cents,
        product_id: product!.id,
        created_at: doc.created_at,
        updated_at: doc.updated_at,
        deleted: false,
        deleted_at: null,
        source_product_title: product?.title || 'Unknown Product',
        is_document: true,
        has_pdf: !!doc.pdf_url,
      }));

    // Get embedded products and their files + documents
    const embeddedProducts = product ? await getProductComponents(product.id) : [];
    const embeddedFilesAndDocs = await Promise.all(
      embeddedProducts.map(async (component) => {
        const childProduct = await getProductById(component.child_product_id);
        const childFiles = childProduct ? await getProductFiles(childProduct.id) : [];
        const childDocuments = childProduct ? await getProductDocuments(childProduct.id) : [];

        const childDocumentFiles = childDocuments.map(doc => ({
            id: doc.id,
            document_id: doc.document_id,
            title: doc.document?.title || 'Document',
            description: doc.document?.description || '',
            file_url: doc.pdf_url || `/documents/${doc.document?.handle}`,
            storage_path: doc.pdf_storage_path || '',
            file_size_bytes: 0,
            mime_type: 'application/pdf',
            position: doc.position,
            price_cents: doc.price_cents,
            product_id: childProduct!.id,
            created_at: doc.created_at,
            updated_at: doc.updated_at,
            deleted: false,
            deleted_at: null,
            source_product_title: childProduct?.title || 'Unknown Product',
            is_document: true,
            has_pdf: !!doc.pdf_url,
          }));

        return [
          ...childFiles.map(file => ({
            ...file,
            source_product_title: childProduct?.title || 'Unknown Product',
            is_document: false,
          })),
          ...childDocumentFiles,
        ];
      })
    );

    // Flatten and combine all files and documents
    const allFiles = [
      ...mainProductFiles.map(file => ({
        ...file,
        source_product_title: product?.title || 'Unknown Product',
        is_document: false,
      })),
      ...mainProductDocumentFiles,
      ...embeddedFilesAndDocs.flat(),
    ];

    return {
      saleItem,
      product,
      files: allFiles,
    };
  })
);
---

<Layout title="Order Confirmed - Game Loopers">
  <div class="page">
    <div class="page__container">
      <Card>
        <CardContent>
          <div class="success-content">
            {isMockCheckout && (
              <div class="success-mock-badge">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="12" y1="8" x2="12" y2="12"></line>
                  <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <span>Mock Purchase - Development Mode</span>
              </div>
            )}

            <div class="success-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="m9 12 2 2 4-4"></path>
              </svg>
            </div>

            <h1 class="success-title">Order Confirmed!</h1>
            <p class="success-message">
              {isMockCheckout
                ? 'Mock purchase completed. In production, customers would receive a confirmation email.'
                : 'Thank you for your purchase. Your order has been confirmed and you\'ll receive a confirmation email shortly.'
              }
            </p>

            <div class="success-details">
              <div class="success-detail">
                <span class="success-detail__label">Order ID:</span>
                <span class="success-detail__value">{orderId}</span>
              </div>
              {customerEmail && (
                <div class="success-detail">
                  <span class="success-detail__label">Email:</span>
                  <span class="success-detail__value">{customerEmail}</span>
                </div>
              )}
              <div class="success-detail">
                <span class="success-detail__label">Total:</span>
                <span class="success-detail__value">{currency.toUpperCase()} {(amountTotal / 100).toFixed(2)}</span>
              </div>
            </div>

            <!-- Download Links Section -->
            {purchasedProducts.length > 0 && (
              <div class="success-downloads">
                <h2 class="success-downloads__title">Your Downloads</h2>
                <p class="success-downloads__description">
                  Click below to download your purchased files:
                </p>
                <div class="success-downloads__products">
                  {purchasedProducts.map(({ product, files }) => {
                    if (!product || files.length === 0) return null;

                    return (
                      <div class="download-product">
                        <h3 class="download-product__title">{product.title}</h3>
                        <div class="download-product__files">
                          {files.map((file) => (
                            <a
                              href={file.file_url}
                              download
                              class="download-file"
                              target="_blank"
                              rel="noopener noreferrer"
                            >
                              <svg
                                class="download-file__icon"
                                width="20"
                                height="20"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                              >
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                                <polyline points="7 10 12 15 17 10" />
                                <line x1="12" y1="15" x2="12" y2="3" />
                              </svg>
                              <div class="download-file__details">
                                <span class="download-file__name">
                                  {file.title}
                                  {file.is_document && <span class="download-file__badge">PDF</span>}
                                </span>
                                {file.source_product_title && file.source_product_title !== product.title && (
                                  <span class="download-file__source">From: {file.source_product_title}</span>
                                )}
                              </div>
                              {!file.is_document && file.file_size_bytes > 0 && (
                                <span class="download-file__size">
                                  {(file.file_size_bytes / 1024 / 1024).toFixed(2)} MB
                                </span>
                              )}
                            </a>
                          ))}
                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>
            )}

            <div class="success-actions">
              {currentUser ? (
                <>
                  <a href="/purchases" class="success-action">
                    <Button variant="primary" size="lg">
                      <span slot="text">View All My Purchases</span>
                    </Button>
                  </a>
                  <a href="/products" class="success-action">
                    <Button variant="outline" size="lg">
                      <span slot="text">Continue Shopping</span>
                    </Button>
                  </a>
                </>
              ) : (
                <a href="/products" class="success-action">
                  <Button variant="primary" size="lg">
                    <span slot="text">Continue Shopping</span>
                  </Button>
                </a>
              )}
            </div>

            {!isMockCheckout && (
              <p class="success-note">
                A confirmation email with your order details and download links has been sent to {customerEmail}.
              </p>
            )}
          </div>
        </CardContent>
      </Card>
    </div>
  </div>
</Layout>

<style>
.success-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: var(--spacing-4xl) var(--spacing-2xl);
}

.success-mock-badge {
  display: flex;
  align-items: center;
  gap: var(--gap-sm);
  padding: var(--spacing-sm) var(--spacing-lg);
  background-color: oklch(from var(--warning) l c h / 0.1);
  border: var(--border-width-default) solid var(--warning);
  border-radius: var(--radius-full);
  font-size: var(--text-xs);
  color: var(--warning-foreground);
  font-weight: var(--font-weight-semibold);
  text-transform: uppercase;
  letter-spacing: var(--tracking-wide);
  margin-bottom: var(--spacing-xl);
}

.success-mock-badge svg {
  flex-shrink: 0;
  color: var(--warning);
}

.success-icon {
  width: 64px;
  height: 64px;
  color: var(--success);
  margin-bottom: var(--spacing-3xl);
}

.success-title {
  margin: 0 0 var(--spacing-lg) 0;
  font-size: var(--text-3xl);
  font-weight: var(--font-weight-bold);
  color: var(--foreground);
}

.success-message {
  margin: 0 0 var(--spacing-3xl) 0;
  font-size: var(--text-base);
  color: var(--muted-foreground);
  line-height: var(--leading-relaxed);
}

.success-details {
  width: 100%;
  background-color: var(--muted);
  border: var(--border-width-default) solid var(--border);
  border-radius: var(--radius-md);
  padding: var(--spacing-3xl);
  margin-bottom: var(--spacing-3xl);
  display: flex;
  flex-direction: column;
  gap: var(--gap-lg);
}

.success-detail {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.success-detail__label {
  font-size: var(--text-sm);
  font-weight: var(--font-weight-medium);
  color: var(--muted-foreground);
}

.success-detail__value {
  font-size: var(--text-base);
  font-weight: var(--font-weight-semibold);
  color: var(--foreground);
  word-break: break-all;
}

.success-actions {
  margin-bottom: var(--spacing-3xl);
  display: flex;
  flex-direction: column;
  gap: var(--gap-md);
  width: 100%;
  max-width: 400px;
}

.success-action {
  text-decoration: none;
  width: 100%;
}

.success-note {
  margin: 0;
  font-size: var(--text-sm);
  color: var(--muted-foreground);
  line-height: var(--leading-relaxed);
}

/* Downloads Section */
.success-downloads {
  width: 100%;
  margin-bottom: var(--spacing-3xl);
  text-align: left;
}

.success-downloads__title {
  margin: 0 0 var(--spacing-md) 0;
  font-size: var(--text-xl);
  font-weight: var(--font-weight-bold);
  color: var(--foreground);
}

.success-downloads__description {
  margin: 0 0 var(--spacing-xl) 0;
  font-size: var(--text-sm);
  color: var(--muted-foreground);
}

.success-downloads__products {
  display: flex;
  flex-direction: column;
  gap: var(--gap-xl);
}

.download-product {
  background-color: var(--muted);
  border: var(--border-width-default) solid var(--border);
  border-radius: var(--radius-md);
  padding: var(--spacing-xl);
}

.download-product__title {
  margin: 0 0 var(--spacing-lg) 0;
  font-size: var(--text-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--foreground);
}

.download-product__files {
  display: flex;
  flex-direction: column;
  gap: var(--gap-sm);
}

.download-file {
  display: flex;
  align-items: center;
  gap: var(--gap-md);
  padding: var(--spacing-md) var(--spacing-lg);
  background-color: var(--background);
  border: var(--border-width-default) solid var(--border);
  border-radius: var(--radius-md);
  text-decoration: none;
  color: var(--foreground);
  transition: all var(--duration-fast) var(--ease-in-out);
}

.download-file:hover {
  border-color: var(--primary);
  background-color: oklch(from var(--primary) l c h / 0.05);
  transform: translateX(4px);
}

.download-file__icon {
  flex-shrink: 0;
  color: var(--primary);
}

.download-file__details {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: var(--gap-xs);
}

.download-file__name {
  font-size: var(--text-base);
  font-weight: var(--font-weight-medium);
  display: flex;
  align-items: center;
  gap: var(--gap-sm);
}

.download-file__badge {
  display: inline-flex;
  align-items: center;
  padding: var(--spacing-xxs) var(--spacing-sm);
  background-color: var(--primary);
  color: var(--primary-foreground);
  font-size: var(--text-xs);
  font-weight: var(--font-weight-semibold);
  border-radius: var(--radius-sm);
  text-transform: uppercase;
  letter-spacing: var(--tracking-wide);
}

.download-file__source {
  font-size: var(--text-xs);
  color: var(--primary);
  font-weight: var(--font-weight-medium);
  font-style: italic;
}

.download-file__size {
  flex-shrink: 0;
  font-size: var(--text-sm);
  color: var(--muted-foreground);
}

@media (max-width: 768px) {
  .download-file {
    flex-direction: column;
    align-items: flex-start;
    gap: var(--gap-sm);
  }

  .download-file__size {
    width: 100%;
    text-align: right;
  }
}
</style>
