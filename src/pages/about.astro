---
import Layout from "@/layouts/Layout.astro"
---

<Layout title="Game Loopers">
    <main class="about__main">
      <section class="about__hero">
        <div class="about__hero-content">
          <h1 class="about__title">About Our Company</h1>
          <p class="about__subtitle">
            We build digital experiences that delight users and empower businesses.
          </p>
        </div>
      </section>

      <section class="about__mission">
        <div class="about__container">
          <h2 class="about__heading">Our Mission</h2>
          <p class="about__text">
            Our mission is to innovate, inspire, and make technology accessible for everyone. 
            We believe in human-centered design and long-term impact.
          </p>
        </div>
      </section>

      <section class="about__team">
        <div class="about__container">
          <h2 class="about__heading">Meet the Team</h2>
          <div class="about__team-grid">
            <article class="about__member">
              <img src="/images/member1.jpg" alt="Jane Doe" class="about__member-photo" />
              <h3 class="about__member-name">Jane Doe</h3>
              <p class="about__member-role">CEO & Founder</p>
            </article>

            <article class="about__member">
              <img src="/images/member2.jpg" alt="John Smith" class="about__member-photo" />
              <h3 class="about__member-name">John Smith</h3>
              <p class="about__member-role">Lead Developer</p>
            </article>
          </div>
        </div>
      </section>

      <section class="about__cta">
        <div class="about__container">
          <h2 class="about__heading">Want to Work With Us?</h2>
          <p class="about__text">
            We're always looking for passionate people to join our journey.
          </p>
          <a href="/contact" class="about__button">Get in Touch</a>
        </div>
      </section>
    </main>
</Layout> 

<style>
    /* Base Block: about */
.about {
  font-family: system-ui, sans-serif;
  color: #333;
  background-color: #fff;
  line-height: 1.6;
}

/* Element: hero */
.about__hero {
  background: linear-gradient(135deg, #0078ff, #00d4ff);
  color: #fff;
  padding: 4rem 2rem;
  text-align: center;
}

.about__title {
  font-size: 2.5rem;
  margin-bottom: 1rem;
}

.about__subtitle {
  font-size: 1.2rem;
  max-width: 600px;
  margin: 0 auto;
}

/* Element: section containers */
.about__container {
  max-width: 960px;
  margin: 0 auto;
  padding: 3rem 1rem;
}

.about__heading {
  font-size: 2rem;
  margin-bottom: 1rem;
}

.about__text {
  max-width: 700px;
  margin-bottom: 2rem;
}

/* Team grid */
.about__team-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 2rem;
  margin-top: 2rem;
}

.about__member {
  text-align: center;
}

.about__member-photo {
  width: 150px;
  height: 150px;
  border-radius: 50%;
  object-fit: cover;
}

.about__member-name {
  margin-top: 1rem;
  font-size: 1.1rem;
  font-weight: 600;
}

.about__member-role {
  color: #666;
  font-size: 0.9rem;
}

/* Call to Action */
.about__cta {
  background-color: #f5f7fa;
  text-align: center;
  padding: 4rem 2rem;
}

.about__button {
  display: inline-block;
  padding: 0.75rem 1.5rem;
  background-color: #0078ff;
  color: #fff;
  border-radius: 0.5rem;
  text-decoration: none;
  transition: background 0.3s;
}

.about__button:hover {
  background-color: #005fcc;
}

</style>
