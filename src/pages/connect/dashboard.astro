---
import Layout from "@/layouts/Layout.astro";
import Card from "@/components/Card.astro";
import CardHeader from "@/components/CardHeader.astro";
import CardTitle from "@/components/CardTitle.astro";
import CardDescription from "@/components/CardDescription.astro";
import CardContent from "@/components/CardContent.astro";
import { setSession } from "@/lib/auth";
import { getUserById } from "@/lib/data-access/users";

// Check authentication
let currentUser = null;
const accessToken = Astro.cookies.get("sb-access-token");
const refreshToken = Astro.cookies.get("sb-refresh-token");

if (accessToken && refreshToken) {
  try {
    const session = await setSession({
      refresh_token: refreshToken.value,
      access_token: accessToken.value,
    });
    if (!session.error && session.data.user) {
      currentUser = session.data.user;
    }
  } catch (error) {
    // Continue as guest
  }
}

if (!currentUser) {
  return Astro.redirect("/sign-in?redirect=/connect/dashboard");
}

const user = await getUserById(currentUser.id);

if (!user) {
  return Astro.redirect("/products");
}
---

<Layout title="Payout Settings - Game Loopers">
  <div class="page">
    <div class="page__container">
      <div class="connect-dashboard">
        <h1 class="connect-dashboard__title">Payout Settings</h1>

        <div class="connect-dashboard__grid">
          {/* Status Card */}
          <Card>
            <CardHeader>
              <CardTitle>Account Status</CardTitle>
              <CardDescription>Your Stripe Connect account information</CardDescription>
            </CardHeader>
            <CardContent>
              <div id="status-content" class="status-content">
                <div class="status-loading">
                  <div class="status-loading__spinner"></div>
                  <p class="status-loading__text">Loading account status...</p>
                </div>
              </div>
            </CardContent>
          </Card>

          {/* Actions Card */}
          <Card>
            <CardHeader>
              <CardTitle>Quick Actions</CardTitle>
              <CardDescription>Manage your payout settings</CardDescription>
            </CardHeader>
            <CardContent>
              <div class="actions-list">
                <a
                  href="/payouts"
                  class="action-link"
                >
                  <div class="action-link__icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                      <line x1="2" y1="10" x2="22" y2="10"></line>
                    </svg>
                  </div>
                  <div class="action-link__content">
                    <div class="action-link__title">View Payouts</div>
                    <div class="action-link__description">See your payout history</div>
                  </div>
                </a>

                <button
                  id="view-stripe-dashboard"
                  class="action-link action-link--button"
                  type="button"
                  style="display: none;"
                >
                  <div class="action-link__icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <circle cx="12" cy="12" r="10"></circle>
                      <polyline points="12 16 16 12 12 8"></polyline>
                      <line x1="8" y1="12" x2="16" y2="12"></line>
                    </svg>
                  </div>
                  <div class="action-link__content">
                    <div class="action-link__title">Stripe Dashboard</div>
                    <div class="action-link__description">Manage your Stripe account</div>
                  </div>
                </button>

                <a
                  href="/products"
                  class="action-link"
                >
                  <div class="action-link__icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <line x1="19" y1="12" x2="5" y2="12"></line>
                      <polyline points="12 19 5 12 12 5"></polyline>
                    </svg>
                  </div>
                  <div class="action-link__content">
                    <div class="action-link__title">Back to Products</div>
                    <div class="action-link__description">Browse marketplace</div>
                  </div>
                </a>
              </div>
            </CardContent>
          </Card>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  let dashboardUrl: string | null = null;

  async function loadAccountStatus() {
    try {
      const response = await fetch('/api/connect/get-account-status');
      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.error || 'Failed to load account status');
      }

      const statusContent = document.getElementById('status-content');
      if (!statusContent) return;

      if (!data.hasAccount) {
        statusContent.innerHTML = `
          <div class="status-empty">
            <p class="status-empty__text">You haven't set up payouts yet.</p>
            <a href="/connect/onboarding" class="status-empty__button">Setup Payouts</a>
          </div>
        `;
        return;
      }

      const status = data.status;
      dashboardUrl = data.dashboardUrl;

      // Show Stripe dashboard button if available
      if (dashboardUrl) {
        const stripeDashboardButton = document.getElementById('view-stripe-dashboard');
        if (stripeDashboardButton) {
          stripeDashboardButton.style.display = 'flex';
        }
      }

      statusContent.innerHTML = `
        <div class="status-grid">
          <div class="status-item">
            <div class="status-item__label">Onboarding Status</div>
            <div class="status-item__value status-item__value--${status.onboarded ? 'success' : 'pending'}">
              ${status.onboarded ? '✓ Complete' : '⚠ Pending'}
            </div>
          </div>

          <div class="status-item">
            <div class="status-item__label">Details Submitted</div>
            <div class="status-item__value status-item__value--${status.detailsSubmitted ? 'success' : 'pending'}">
              ${status.detailsSubmitted ? '✓ Yes' : '⚠ No'}
            </div>
          </div>

          <div class="status-item">
            <div class="status-item__label">Charges Enabled</div>
            <div class="status-item__value status-item__value--${status.chargesEnabled ? 'success' : 'pending'}">
              ${status.chargesEnabled ? '✓ Yes' : '✗ No'}
            </div>
          </div>

          <div class="status-item">
            <div class="status-item__label">Payouts Enabled</div>
            <div class="status-item__value status-item__value--${status.payoutsEnabled ? 'success' : 'pending'}">
              ${status.payoutsEnabled ? '✓ Yes' : '✗ No'}
            </div>
          </div>
        </div>

        ${!status.onboarded ? `
          <div class="status-alert">
            <p class="status-alert__text">Complete your onboarding to enable payouts</p>
            <a href="/connect/onboarding" class="status-alert__button">Continue Setup</a>
          </div>
        ` : ''}
      `;
    } catch (error) {
      console.error('Error loading status:', error);
      const statusContent = document.getElementById('status-content');
      if (statusContent) {
        statusContent.innerHTML = `
          <div class="status-error">
            <p class="status-error__text">Failed to load account status</p>
            <button class="status-error__button" onclick="loadAccountStatus()">Retry</button>
          </div>
        `;
      }
    }
  }

  // View Stripe dashboard
  document.getElementById('view-stripe-dashboard')?.addEventListener('click', () => {
    if (dashboardUrl) {
      window.open(dashboardUrl, '_blank');
    }
  });

  // Load status on page load
  loadAccountStatus();
</script>

<style>
  .connect-dashboard {
    display: flex;
    flex-direction: column;
    gap: var(--gap-3xl);
  }

  .connect-dashboard__title {
    margin: 0;
    font-size: var(--text-3xl);
    font-weight: var(--font-weight-bold);
    color: var(--foreground);
  }

  .connect-dashboard__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
    gap: var(--gap-2xl);
  }

  /* Status Content */
  .status-content {
    min-height: 200px;
  }

  .status-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-4xl);
    gap: var(--gap-lg);
  }

  .status-loading__spinner {
    width: 40px;
    height: 40px;
    border: 4px solid var(--muted);
    border-top-color: var(--primary);
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .status-loading__text {
    margin: 0;
    color: var(--muted-foreground);
    font-size: var(--text-sm);
  }

  .status-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--gap-xl);
  }

  .status-item {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs);
  }

  .status-item__label {
    font-size: var(--text-sm);
    color: var(--muted-foreground);
  }

  .status-item__value {
    font-size: var(--text-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--foreground);
  }

  .status-item__value--success {
    color: #16a34a;
  }

  .status-item__value--pending {
    color: #f59e0b;
  }

  .status-alert {
    margin-top: var(--spacing-2xl);
    padding: var(--spacing-lg);
    background-color: rgba(251, 191, 36, 0.1);
    border: 1px solid rgba(251, 191, 36, 0.3);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-lg);
  }

  .status-alert__text {
    margin: 0;
    font-size: var(--text-sm);
    color: #d97706;
  }

  .status-alert__button {
    padding: var(--spacing-sm) var(--spacing-lg);
    background-color: #f59e0b;
    color: white;
    border-radius: var(--radius-md);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    white-space: nowrap;
  }

  .status-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-5xl);
    gap: var(--gap-lg);
    text-align: center;
  }

  .status-empty__text {
    margin: 0;
    color: var(--muted-foreground);
  }

  .status-empty__button {
    padding: var(--spacing-md) var(--spacing-2xl);
    background-color: var(--primary);
    color: var(--primary-foreground);
    border-radius: var(--radius-md);
    text-decoration: none;
    font-weight: var(--font-weight-semibold);
  }

  .status-error {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-4xl);
    gap: var(--gap-lg);
  }

  .status-error__text {
    margin: 0;
    color: #dc2626;
    font-size: var(--text-sm);
  }

  .status-error__button {
    padding: var(--spacing-sm) var(--spacing-lg);
    background-color: var(--primary);
    color: var(--primary-foreground);
    border: none;
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    cursor: pointer;
  }

  /* Actions */
  .actions-list {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
  }

  .action-link {
    display: flex;
    align-items: center;
    gap: var(--gap-lg);
    padding: var(--spacing-lg);
    background-color: var(--muted);
    border: none;
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all var(--duration-normal) var(--ease-in-out);
    width: 100%;
    text-align: left;
  }

  .action-link--button {
    cursor: pointer;
  }

  .action-link:hover {
    background-color: var(--accent);
  }

  .action-link__icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    background-color: var(--background);
    color: var(--primary);
  }

  .action-link__content {
    flex: 1;
  }

  .action-link__title {
    font-size: var(--text-base);
    font-weight: var(--font-weight-semibold);
    color: var(--foreground);
    margin-bottom: var(--spacing-xs);
  }

  .action-link__description {
    font-size: var(--text-sm);
    color: var(--muted-foreground);
  }

  @media (max-width: 768px) {
    .connect-dashboard__grid {
      grid-template-columns: 1fr;
    }

    .status-alert {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
