---
import Layout from "@/layouts/Layout.astro";
import Card from "@/components/Card.astro";
import CardHeader from "@/components/CardHeader.astro";
import CardTitle from "@/components/CardTitle.astro";
import CardContent from "@/components/CardContent.astro";
import Button from "@/components/Button.astro";
import { setSession } from "@/lib/auth";
import { getUserById } from "@/lib/data-access/users";

const accessToken = Astro.cookies.get("sb-access-token");
const refreshToken = Astro.cookies.get("sb-refresh-token");

if (!accessToken || !refreshToken) {
  return Astro.redirect("/sign-in");
}

let session;
try {
  session = await setSession({
    refresh_token: refreshToken.value,
    access_token: accessToken.value,
  });
  if (session.error || !session.data.user) {
    return Astro.redirect("/sign-in");
  }
} catch (error) {
  return Astro.redirect("/sign-in");
}

const userId = session.data.user.id;
const user = await getUserById(userId);

if (!user) {
  return Astro.redirect("/dashboard");
}

const isOnboarded = user.stripe_connect_onboarded || false;
const payoutsEnabled = user.stripe_connect_payouts_enabled || false;
---

<Layout title="Connect Your Bank Account - Game Loopers">
  <div class="page">
    <div class="page__container">
      <div class="connect-page">
        <Card>
          <CardHeader>
            <CardTitle>Connect Your Bank Account</CardTitle>
          </CardHeader>
          <CardContent>
            {isOnboarded && payoutsEnabled ? (
              <div class="connect-success">
                <svg class="connect-success__icon" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"></circle>
                  <path d="m9 12 2 2 4-4"></path>
                </svg>
                <h2 class="connect-success__title">Bank Account Connected!</h2>
                <p class="connect-success__message">
                  Your bank account is connected and ready to receive payouts. You can now request payouts from your dashboard.
                </p>
                <div class="connect-success__actions">
                  <a href="/dashboard">
                    <Button variant="primary" size="lg">
                      <span slot="text">Go to Dashboard</span>
                    </Button>
                  </a>
                </div>
              </div>
            ) : (
              <div class="connect-onboarding">
                <div class="connect-info">
                  <h2 class="connect-info__title">Start Receiving Payouts</h2>
                  <p class="connect-info__description">
                    To receive royalty payments, you'll need to connect your bank account through Stripe. This secure process takes just a few minutes.
                  </p>

                  <div class="connect-features">
                    <div class="connect-feature">
                      <svg class="connect-feature__icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                      </svg>
                      <div class="connect-feature__content">
                        <h3 class="connect-feature__title">Secure & Safe</h3>
                        <p class="connect-feature__text">Powered by Stripe, the industry standard for secure payments</p>
                      </div>
                    </div>

                    <div class="connect-feature">
                      <svg class="connect-feature__icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                      </svg>
                      <div class="connect-feature__content">
                        <h3 class="connect-feature__title">Fast Setup</h3>
                        <p class="connect-feature__text">Connect your bank account in just a few minutes</p>
                      </div>
                    </div>

                    <div class="connect-feature">
                      <svg class="connect-feature__icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="12" y1="1" x2="12" y2="23"></line>
                        <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                      </svg>
                      <div class="connect-feature__content">
                        <h3 class="connect-feature__title">Get Paid</h3>
                        <p class="connect-feature__text">Request payouts anytime from your dashboard</p>
                      </div>
                    </div>
                  </div>
                </div>

                <form id="connect-form" method="post" action="/api/connect/create-account">
                  <Button variant="primary" size="lg">
                    <span slot="text">Connect Bank Account</span>
                  </Button>
                </form>

                <p class="connect-note">
                  You'll be redirected to Stripe to securely connect your bank account. Your information is never stored on our servers.
                </p>
              </div>
            )}
          </CardContent>
        </Card>
      </div>
    </div>
  </div>
</Layout>

<script>
  const form = document.getElementById('connect-form');
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const button = form.querySelector('button');
      if (button) {
        button.setAttribute('disabled', 'true');
        button.textContent = 'Connecting...';
      }

      try {
        const response = await fetch('/api/connect/create-account', {
          method: 'POST',
        });

        const data = await response.json();

        if (data.url) {
          window.location.href = data.url;
        } else {
          alert('Failed to create Connect account. Please try again.');
          if (button) {
            button.removeAttribute('disabled');
            button.textContent = 'Connect Bank Account';
          }
        }
      } catch (error) {
        alert('An error occurred. Please try again.');
        if (button) {
          button.removeAttribute('disabled');
          button.textContent = 'Connect Bank Account';
        }
      }
    });
  }
</script>

<style>
/* ===== Connect Page ===== */
.connect-page {
  max-width: 48rem;
  margin: 0 auto;
}

/* ===== Connect Success ===== */
.connect-success {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: var(--spacing-4xl);
  gap: var(--gap-lg);
}

.connect-success__icon {
  color: var(--success);
  width: 64px;
  height: 64px;
}

.connect-success__title {
  margin: 0;
  font-size: var(--text-2xl);
  font-weight: var(--font-weight-bold);
  color: var(--foreground);
}

.connect-success__message {
  margin: 0;
  font-size: var(--text-base);
  color: var(--muted-foreground);
  line-height: var(--leading-relaxed);
}

.connect-success__actions {
  margin-top: var(--spacing-lg);
}

.connect-success__actions a {
  text-decoration: none;
}

/* ===== Connect Onboarding ===== */
.connect-onboarding {
  display: flex;
  flex-direction: column;
  gap: var(--gap-3xl);
  padding: var(--spacing-2xl);
}

.connect-info {
  display: flex;
  flex-direction: column;
  gap: var(--gap-2xl);
}

.connect-info__title {
  margin: 0;
  font-size: var(--text-2xl);
  font-weight: var(--font-weight-bold);
  color: var(--foreground);
}

.connect-info__description {
  margin: 0;
  font-size: var(--text-base);
  color: var(--muted-foreground);
  line-height: var(--leading-relaxed);
}

/* ===== Connect Features ===== */
.connect-features {
  display: flex;
  flex-direction: column;
  gap: var(--gap-2xl);
  margin-top: var(--spacing-2xl);
}

.connect-feature {
  display: flex;
  gap: var(--gap-lg);
  align-items: flex-start;
}

.connect-feature__icon {
  color: var(--primary);
  flex-shrink: 0;
}

.connect-feature__content {
  display: flex;
  flex-direction: column;
  gap: var(--gap-xs);
}

.connect-feature__title {
  margin: 0;
  font-size: var(--text-base);
  font-weight: var(--font-weight-semibold);
  color: var(--foreground);
}

.connect-feature__text {
  margin: 0;
  font-size: var(--text-sm);
  color: var(--muted-foreground);
  line-height: var(--leading-relaxed);
}

/* ===== Connect Form ===== */
#connect-form {
  display: flex;
  justify-content: center;
  padding: var(--spacing-2xl) 0;
}

.connect-note {
  margin: 0;
  font-size: var(--text-sm);
  color: var(--muted-foreground);
  text-align: center;
  line-height: var(--leading-relaxed);
}
</style>
