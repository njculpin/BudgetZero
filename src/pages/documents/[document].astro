---
import Layout from "@/layouts/Layout.astro";
import Card from "@/components/Card.astro";
import CardContent from "@/components/CardContent.astro";
import CardHeader from "@/components/CardHeader.astro";
import CardTitle from "@/components/CardTitle.astro";
import CardDescription from "@/components/CardDescription.astro";
import GalleryGrid from "@/components/GalleryGrid.astro";
import { setSession } from "@/lib/auth";
import {
  getDocumentByHandle,
  canUserViewDocument,
  canUserEditDocument,
  getDocumentCollaboratorUsers,
  getDocumentContent,
  getDocumentAttachments,
} from "@/lib/data-access/documents";
import { getUserById } from "@/lib/data-access/users";
import DocumentEditor from "@/components/documents/DocumentEditor";
import DocumentDeleteButton from "@/components/documents/DocumentDeleteButton";
import { DocumentAttachmentsForm } from "@/components/documents";
import Badge from "@/components/Badge.astro";

const { params, cookies } = Astro;
const documentHandle = params.document;

if (!documentHandle) {
  return Astro.redirect("/documents");
}

// Check authentication
let currentUser = null;
const accessToken = cookies.get("sb-access-token");
const refreshToken = cookies.get("sb-refresh-token");

if (accessToken && refreshToken) {
  try {
    const session = await setSession({
      refresh_token: refreshToken.value,
      access_token: accessToken.value,
    });
    if (!session.error && session.data.user) {
      currentUser = session.data.user;
    }
  } catch {}
}

// Fetch document
const document = await getDocumentByHandle(documentHandle);

if (!document) {
  return Astro.redirect("/documents");
}

// Check permissions
const canView = currentUser ? await canUserViewDocument(document.id, currentUser.id) : false;
const canEdit = currentUser ? await canUserEditDocument(document.id, currentUser.id) : false;
const isOwner = currentUser?.id === document.user_id;

// Documents are private - redirect if user can't view
if (!canView) {
  return Astro.redirect("/documents");
}

// Get document content
const content = await getDocumentContent(document.id);
const contentJson = content ? JSON.stringify(content) : null;

// Get owner info
const owner = await getUserById(document.user_id);

// Get current user details for presence
const currentUserDetails = currentUser ? await getUserById(currentUser.id) : null;

// Get collaborators
const collaborators = await getDocumentCollaboratorUsers(document.id);
const collaboratorImages = collaborators.map((user) => ({
  url: user.avatar_url,
  alt: user.name || user.handle,
  href: `/users/${user.handle}`,
}));

// Get attachments
const attachments = await getDocumentAttachments(document.id);

// Format date helper
const formatDate = (dateStr: string) => {
  return new Date(dateStr).toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  });
};
---

<Layout title={`${document.title} - Game Loopers`}>
  <div class="page">
    <div class="page__container">

      <!-- Page Header -->
      <header class="page-header">
        <div class="page-header__content">
          <h1 class="page-header__title">{document.title}</h1>
          <div class="page-header__meta">
            {owner && (
              <span class="page-header__author">
                by <a href={`/users/${owner.handle}`} class="page-header__author-link">
                  {owner.name || owner.handle}
                </a>
              </span>
            )}
            <span class="page-header__divider">•</span>
            <Badge variant="draft" size="sm">
              DRAFT
            </Badge>
            {canEdit && (
              <>
                <span class="page-header__divider">•</span>
                <Badge variant="primary" size="sm">
                  {isOwner ? "Owner • Changes auto-save" : "Collaborator • Changes auto-save"}
                </Badge>
              </>
            )}
          </div>
          {document.description && (
            <p class="page-header__description">{document.description}</p>
          )}
        </div>
      </header>

      <div class="page-columns">
        <!-- Main Content Column -->
        <div class="page-columns__column">
          <Card>
            <CardHeader>
              <CardTitle>Editor</CardTitle>
              <CardDescription>
                {canEdit
                  ? "Write your document content below. Changes are auto-saved."
                  : "View-only mode"}
              </CardDescription>
            </CardHeader>
            <CardContent>
              <DocumentEditor
                client:idle
                documentId={document.id}
                initialContent={contentJson}
                canEdit={canEdit}
                userId={currentUser?.id}
                userName={currentUserDetails?.name}
                userHandle={currentUserDetails?.handle}
              />
            </CardContent>
          </Card>
        </div>

        <!-- Sidebar Column -->
        <div class="page-columns__column">
          <!-- Contributors -->
          <Card>
            <CardHeader>
              <CardTitle>Contributors</CardTitle>
            </CardHeader>
            <CardContent>
              <GalleryGrid images={collaboratorImages} cols={5} borderRadius="circle" />
              {isOwner && collaborators.length === 1 && (
                <p class="contributors-hint">Only you can see and edit this document</p>
              )}
            </CardContent>
          </Card>

          <!-- Attachments (editors only) -->
          {canEdit && currentUser && (
            <Card>
              <CardContent>
                <DocumentAttachmentsForm
                  client:visible
                  documentId={document.id}
                  userId={currentUser.id}
                  existingAttachments={attachments}
                />
              </CardContent>
            </Card>
          )}

          <!-- Document Information -->
          <Card>
            <CardHeader>
              <CardTitle>Document Information</CardTitle>
            </CardHeader>
            <CardContent>
              <dl class="document-meta">
                <div class="document-meta__item">
                  <dt class="document-meta__label">Created</dt>
                  <dd class="document-meta__value">{formatDate(document.created_at)}</dd>
                </div>
                <div class="document-meta__item">
                  <dt class="document-meta__label">Last Updated</dt>
                  <dd class="document-meta__value">{formatDate(document.updated_at)}</dd>
                </div>
                <div class="document-meta__item">
                  <dt class="document-meta__label">Owner</dt>
                  <dd class="document-meta__value">{owner?.name || owner?.handle || "Unknown"}</dd>
                </div>
                <div class="document-meta__item">
                  <dt class="document-meta__label">Contributors</dt>
                  <dd class="document-meta__value">{collaborators.length}</dd>
                </div>
              </dl>
            </CardContent>
          </Card>

          <!-- Actions (owner only) -->
          {isOwner && (
            <Card>
              <CardHeader>
                <CardTitle>Actions</CardTitle>
              </CardHeader>
              <CardContent>
                <div class="document-actions">
                  <DocumentDeleteButton
                    client:load
                    documentId={document.id}
                    documentTitle={document.title}
                  />
                </div>
              </CardContent>
            </Card>
          )}
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
/* ===== Breadcrumb Navigation ===== */
.breadcrumb {
  margin-bottom: var(--spacing-2xl);
}

.breadcrumb__list {
  display: flex;
  align-items: center;
  gap: var(--gap-sm);
  list-style: none;
  padding: 0;
  margin: 0;
  flex-wrap: wrap;
}

.breadcrumb__item {
  display: flex;
  align-items: center;
  gap: var(--gap-sm);
  font-size: var(--text-sm);
  color: var(--muted-foreground);
}

.breadcrumb__item:not(:last-child)::after {
  content: "/";
  color: var(--border);
  margin-left: var(--gap-sm);
}

.breadcrumb__link {
  color: var(--muted-foreground);
  text-decoration: none;
  transition: color var(--duration-fast) var(--ease-in-out);
}

.breadcrumb__link:hover {
  color: var(--foreground);
  text-decoration: underline;
}

.breadcrumb__link:focus-visible {
  outline: 2px solid var(--ring);
  outline-offset: 2px;
  border-radius: var(--radius-sm);
}

.breadcrumb__current {
  color: var(--foreground);
  font-weight: var(--font-weight-medium);
}

/* ===== Page Header (Compact) ===== */
.page-header {
  padding: var(--spacing-2xl) 0;
  border-bottom: var(--border-width-default) solid var(--border);
  margin-bottom: var(--spacing-3xl);
}

.page-header__content {
  display: flex;
  flex-direction: column;
  gap: var(--gap-md);
}

.page-header__title {
  margin: 0;
  font-size: var(--text-3xl);
  font-weight: var(--font-weight-bold);
  line-height: var(--leading-tight);
  color: var(--foreground);
}

.page-header__meta {
  display: flex;
  align-items: center;
  gap: var(--gap-md);
  flex-wrap: wrap;
  font-size: var(--text-sm);
  color: var(--muted-foreground);
}

.page-header__author {
  color: var(--muted-foreground);
}

.page-header__author-link {
  color: var(--foreground);
  text-decoration: none;
  font-weight: var(--font-weight-medium);
  transition: color var(--duration-fast) var(--ease-in-out);
}

.page-header__author-link:hover {
  color: var(--primary);
  text-decoration: underline;
}

.page-header__author-link:focus-visible {
  outline: 2px solid var(--ring);
  outline-offset: 2px;
  border-radius: var(--radius-sm);
}

.page-header__divider {
  color: var(--muted-foreground);
}

.page-header__description {
  margin: var(--spacing-sm) 0 0;
  font-size: var(--text-base);
  color: var(--muted-foreground);
  line-height: var(--leading-relaxed);
  max-width: 600px;
}

/* ===== Document Meta Information ===== */
.document-meta {
  display: flex;
  flex-direction: column;
  gap: var(--gap-lg);
}

.document-meta__item {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding-bottom: var(--spacing-lg);
  border-bottom: 1px solid var(--border);
}

.document-meta__item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.document-meta__label {
  font-size: var(--text-sm);
  font-weight: var(--font-weight-medium);
  color: var(--muted-foreground);
  margin: 0;
}

.document-meta__value {
  font-size: var(--text-base);
  font-weight: var(--font-weight-semibold);
  color: var(--foreground);
  margin: 0;
}

/* ===== Contributors Hint ===== */
.contributors-hint {
  margin: var(--spacing-lg) 0 0;
  font-size: var(--text-sm);
  color: var(--muted-foreground);
  font-style: italic;
}

/* ===== Document Actions ===== */
.document-actions {
  display: flex;
  flex-direction: column;
  gap: var(--gap-lg);
}

.document-actions__divider {
  height: 1px;
  background-color: var(--border);
  margin: var(--spacing-sm) 0;
}

/* ===== Responsive ===== */
@media (max-width: 768px) {
  .page-header {
    padding: var(--spacing-xl) 0;
    margin-bottom: var(--spacing-2xl);
  }

  .page-header__title {
    font-size: var(--text-2xl);
  }

  .page-header__meta {
    flex-direction: column;
    align-items: flex-start;
    gap: var(--gap-sm);
  }

  .page-columns {
    grid-template-columns: 1fr;
  }
}
</style>
