---
import Layout from "@/layouts/Layout.astro";
import Card from "@/components/Card.astro";
import CardHeader from "@/components/CardHeader.astro";
import CardTitle from "@/components/CardTitle.astro";
import CardContent from "@/components/CardContent.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import { setSession } from "@/lib/auth";
import { getUserById, getUserTags } from "@/lib/data-access/users";
import { getNotificationSettings } from "@/lib/data-access/notifications";
import { UserEditForm } from "@/components/users";
import NotificationSettingsForm from "@/components/settings/NotificationSettingsForm";

const { cookies, redirect } = Astro;

// Check authentication
const accessToken = cookies.get("sb-access-token");
const refreshToken = cookies.get("sb-refresh-token");

if (!accessToken || !refreshToken) {
  return redirect("/sign-in");
}

const session = await setSession({
  refresh_token: refreshToken.value,
  access_token: accessToken.value,
});

if (!session || session.error || !session.data.user) {
  return redirect("/sign-in");
}

const currentUser = session.data.user;

// Fetch full user data
const user = await getUserById(currentUser.id);

if (!user) {
  return redirect("/sign-in");
}

// Fetch user tags
const userTags = await getUserTags(user.id);

// Fetch notification settings
const notificationSettings = await getNotificationSettings(currentUser.id);
---

<Layout title="Settings - Game Loopers">
  <div class="page">
    <div class="page__container page__container--narrow">
      <div class="settings-page">
        <header class="settings-page__header">
          <h1 class="settings-page__title">Settings</h1>
          <p class="settings-page__description">
            Manage your profile and notification preferences
          </p>
        </header>

        <!-- Profile Settings -->
        <Card>
          <CardHeader>
            <CardTitle>Profile Information</CardTitle>
          </CardHeader>
          <CardContent>
            <UserEditForm
              client:load
              handle={user.handle}
              name={user.name}
              bio={user.bio}
              avatarUrl={user.avatar_url}
              userHandle={user.handle}
              tags={userTags}
            />
          </CardContent>
        </Card>

        <!-- Notification Settings -->

      <Card>
        <CardHeader>
          <h2>Email Notifications</h2>
          <p>Choose which notifications you want to receive via email</p>
        </CardHeader>
        <CardContent>
          <NotificationSettingsForm
            client:load
            userId={currentUser.id}
            settings={notificationSettings}
          />
        </CardContent>
      </Card>

      <Card>
        <CardHeader>
          <h2>Notification Preferences</h2>
        </CardHeader>
        <CardContent>
          <div class="settings-info">
            <p class="settings-info__text">
              <strong>Asset Changes:</strong> Notifies you when assets used in your products are updated
            </p>
            <p class="settings-info__text">
              <strong>Product Conflicts:</strong> Alerts when asset changes cause pricing conflicts with your products
            </p>
            <p class="settings-info__text">
              <strong>Sales:</strong> Notifies you when someone purchases your products
            </p>
            <p class="settings-info__text">
              <strong>Royalty Payments:</strong> Alerts when you receive royalty payments from sales
            </p>
            <p class="settings-info__text">
              <strong>Document Shares:</strong> Notifies you when someone shares a document with you
            </p>
            <p class="settings-info__text">
              <strong>Jam Updates:</strong> Alerts for game jam submissions, reviews, and announcements
            </p>
          </div>
        </CardContent>
      </Card>
      </div>
    </div>
  </div>
</Layout>

<style>
.page__container--narrow {
  max-width: var(--container-4xl);
}

.settings-page {
  display: flex;
  flex-direction: column;
  gap: var(--gap-4xl);
}

.settings-page__header {
  display: flex;
  flex-direction: column;
  gap: var(--gap-md);
}

.settings-page__title {
  margin: 0;
  font-size: var(--text-4xl);
  font-weight: var(--font-weight-bold);
  color: var(--foreground);
}

.settings-page__description {
  margin: 0;
  font-size: var(--text-lg);
  color: var(--muted-foreground);
  line-height: var(--leading-relaxed);
}

.settings-info {
  display: flex;
  flex-direction: column;
  gap: var(--gap-md);
}

.settings-info__text {
  margin: 0;
  font-size: var(--text-sm);
  color: var(--muted-foreground);
  line-height: var(--leading-normal);
}

.settings-info__text strong {
  color: var(--foreground);
  font-weight: var(--font-weight-semibold);
}

@media (max-width: 768px) {
  .settings-page__title {
    font-size: var(--text-3xl);
  }

  .settings-page__description {
    font-size: var(--text-base);
  }
}
</style>
