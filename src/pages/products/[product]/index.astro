---
import Layout from "@/layouts/Layout.astro";
import Button from "@/components/Button.astro";
import { ProductContentViewer, AddToCartButton } from "@/components/products";
import ProductContributors from "@/components/products/ProductContributors.astro";
import ProductImageGallery from "@/components/products/ProductImageGallery.astro";
import { getProductByHandle, getProductTags, getProductImages, getProductFiles, getProductDocuments, getProductContributorsWithRoles, getProductComponentsWithDetails } from "@/lib/data-access/products";
import { getUserById } from "@/lib/data-access/users";
import { setSession } from "@/lib/auth";
import Card from "@/components/Card.astro";
import CardHeader from "@/components/CardHeader.astro";
import CardTitle from "@/components/CardTitle.astro";
import CardDescription from "@/components/CardDescription.astro";
import CardContent from "@/components/CardContent.astro";
import Avatar from "@/components/users/Avatar.astro";

const { product } = Astro.params;

if (!product) {
  return Astro.redirect('/404');
}

const productData = await getProductByHandle(product);

if (!productData) {
  return Astro.redirect('/404');
}

// Parallelize data fetching for better performance
const [owner, tags, productImages, productFiles, productDocuments, embeddedProductsWithCreators] = await Promise.all([
  getUserById(productData.user_id),
  getProductTags(productData.id),
  getProductImages(productData.id),
  getProductFiles(productData.id),
  getProductDocuments(productData.id),
  getProductComponentsWithDetails(productData.id),
]);

// Null guard: redirect if owner not found
if (!owner) {
  return Astro.redirect('/404');
}

let currentUser = null;
const accessToken = Astro.cookies.get("sb-access-token");
const refreshToken = Astro.cookies.get("sb-refresh-token");

if (accessToken && refreshToken) {
  try {
    const session = await setSession({
      refresh_token: refreshToken.value,
      access_token: accessToken.value,
    });
    if (!session.error && session.data.user) {
      currentUser = session.data.user;
    }
  } catch (error) {}
}

const isOwner = currentUser?.id === productData.user_id;

// Get product contributors with role information
const productContributorsWithRoles = await getProductContributorsWithRoles(productData.id);

// Helper: Check if we should show the content viewer (has content)
const shouldShowContentViewer = productFiles.length > 0 ||
  productDocuments.length > 0 ||
  embeddedProductsWithCreators.length > 0;

---

<Layout title={`${productData.title} - Game Loopers`}>
  <div class="page">
    <div class="page__container">
      <div class="page-columns">
        <!-- Main Content Column -->
        <div class="page-columns__column">
          <!-- Product Images -->
          {productImages.length > 0 && (
            <ProductImageGallery
              images={productImages.map(img => ({
                url: img.file_url,
                alt: img.title
              }))}
            />
          )}
        </div>

        <!-- Sidebar Column -->
        <div class="page-columns__column">
          <!-- Product Header -->
          <div class="product-page-header">
            <div class="product-page-header__top">
              <h1 class="product-page-header__title">{productData.title}</h1>
              {isOwner && (
                <a href={`/products/${product}/edit`} class="product-page-header__edit-link">
                  <Button variant="outline" size="sm">
                    <span slot="text">Edit</span>
                  </Button>
                </a>
              )}
            </div>
            {productData.description && (
              <p class="product-page-header__description">{productData.description}</p>
            )}
            {tags.length > 0 && (
              <div class="product-page-header__tags">
                {tags.map(tag => (
                  <a href={`/tags/${tag.value}`} class="product-tag">
                    {tag.value}
                  </a>
                ))}
              </div>
            )}
          </div>

          <!-- Add to Cart Button -->
          <Card>
            <CardContent>
              <AddToCartButton
                client:load
                productId={productData.id}
                productTitle={productData.title}
                priceCents={productData.price_cents}
                status={productData.status}
                isOwner={isOwner}
                isAuthenticated={!!currentUser}
              />
            </CardContent>
          </Card>

          <!-- Product Content Viewer -->
          {shouldShowContentViewer && (
            <Card>
              <CardHeader>
                <CardTitle>What's Included</CardTitle>
                <CardDescription>All files, documents, and embedded products included with purchase</CardDescription>
              </CardHeader>
              <CardContent>
                <ProductContentViewer
                  client:load
                  productId={productData.id}
                  productTitle={productData.title}
                  isAuthenticated={!!currentUser}
                  files={productFiles}
                  documents={productDocuments}
                  embeddedProducts={embeddedProductsWithCreators}
                />
              </CardContent>
            </Card>
          )}

        <!-- Creator & Contributors -->
        <Card>
          <CardHeader>
            <CardTitle>Created By</CardTitle>
          </CardHeader>
          <CardContent>
            <a href={`/users/${owner.handle}`} class="creator-profile">
              <Avatar
                src={owner.avatar_url}
                alt={owner.name || owner.handle || 'Creator'}
                size="lg"
              />
              <div class="creator-profile__info">
                <h3 class="creator-profile__name">{owner.name || owner.handle}</h3>
                <p class="creator-profile__handle">@{owner.handle}</p>
                {owner.bio && (
                  <p class="creator-profile__bio">{owner.bio}</p>
                )}
              </div>
            </a>
          </CardContent>
          {productContributorsWithRoles.length > 0 && (
            <>
              <CardHeader>
                <CardTitle>Contributors</CardTitle>
                <CardDescription>
                  Creators earning royalties from embedded content
                </CardDescription>
              </CardHeader>
              <CardContent>
                <ProductContributors contributorsWithRoles={productContributorsWithRoles} />
              </CardContent>
            </>
          )}
        </Card>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  /* ===== Product Page Header (View Mode) ===== */
  .product-page-header {
    margin-bottom: var(--spacing-3xl);
  }

  .product-page-header__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--gap-md);
    margin-bottom: var(--spacing-md);
  }

  .product-page-header__title {
    margin: 0;
    font-size: var(--text-4xl);
    font-weight: var(--font-weight-bold);
    line-height: var(--leading-tight);
    color: var(--foreground);
    flex: 1;
  }

  .product-page-header__edit-link {
    flex-shrink: 0;
    text-decoration: none;
  }

  .product-page-header__description {
    margin: 0 0 var(--spacing-lg);
    font-size: var(--text-lg);
    color: var(--muted-foreground);
    line-height: var(--leading-relaxed);
    max-width: 65ch;
  }

  .product-page-header__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-sm);
  }

  .product-tag {
    display: inline-flex;
    align-items: center;
    padding: var(--spacing-xs) var(--spacing-md);
    background-color: var(--muted);
    border: var(--border-width-default) solid var(--border);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--muted-foreground);
    text-decoration: none;
    transition: all var(--duration-fast) var(--ease-in-out);
  }

  .product-tag:hover {
    background-color: var(--primary);
    color: var(--primary-foreground);
    border-color: var(--primary);
  }

  @media (max-width: 48rem) {
    .product-page-header__title {
      font-size: var(--text-3xl);
    }

    .product-page-header__description {
      font-size: var(--text-base);
    }
  }

  /* ===== Creator Profile ===== */
  .creator-profile {
    display: flex;
    align-items: flex-start;
    gap: var(--gap-md);
    text-decoration: none;
    padding: var(--spacing-md);
    border-radius: var(--radius-md);
    transition: background-color var(--duration-fast) var(--ease-in-out);
  }

  .creator-profile:hover {
    background-color: var(--muted);
  }

  .creator-profile__info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs);
  }

  .creator-profile__name {
    margin: 0;
    font-size: var(--text-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--foreground);
  }

  .creator-profile__handle {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--muted-foreground);
  }

  .creator-profile__bio {
    margin: var(--spacing-sm) 0 0;
    font-size: var(--text-sm);
    color: var(--muted-foreground);
    line-height: var(--leading-relaxed);
  }
</style>
