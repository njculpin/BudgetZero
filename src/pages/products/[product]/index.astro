---
import Layout from "@/layouts/Layout.astro";
import Button from "@/components/Button.astro";
import { ProductContentViewer } from "@/components/products";
import ProductContributors from "@/components/products/ProductContributors.astro";
import ProductImageGallery from "@/components/products/ProductImageGallery.astro";
import { getProductByHandle, getProductTags, getProductImages, getProductFiles, getProductDocuments, getProductContributorsWithRoles, getProductComponentsWithDetails } from "@/lib/data-access/products";
import { getUserById } from "@/lib/data-access/users";
import { setSession } from "@/lib/auth";
import { getJamById, getJamProductReviews, isProductInJam } from "@/lib/data-access/jams";
import { JamReviewForm } from "@/components/jams";
import type { JamProductReview } from "@/types";
import Card from "@/components/Card.astro";
import CardHeader from "@/components/CardHeader.astro";
import CardTitle from "@/components/CardTitle.astro";
import CardDescription from "@/components/CardDescription.astro";
import CardContent from "@/components/CardContent.astro";
import CardFooter from "@/components/CardFooter.astro";
import ProductReviewList from "@/components/products/ProductReviewList.astro";
import Avatar from "@/components/users/Avatar.astro";
import WarningBox from "@/components/WarningBox.astro";

const { product } = Astro.params;

if (!product) {
  return Astro.redirect('/404');
}

const productData = await getProductByHandle(product);

if (!productData) {
  return Astro.redirect('/404');
}

// Parallelize data fetching for better performance
const [owner, tags, productImages, productFiles, productDocuments, embeddedProductsWithCreators] = await Promise.all([
  getUserById(productData.user_id),
  getProductTags(productData.id),
  getProductImages(productData.id),
  getProductFiles(productData.id),
  getProductDocuments(productData.id),
  getProductComponentsWithDetails(productData.id),
]);

// Null guard: redirect if owner not found
if (!owner) {
  return Astro.redirect('/404');
}

let currentUser = null;
const accessToken = Astro.cookies.get("sb-access-token");
const refreshToken = Astro.cookies.get("sb-refresh-token");

if (accessToken && refreshToken) {
  try {
    const session = await setSession({
      refresh_token: refreshToken.value,
      access_token: accessToken.value,
    });
    if (!session.error && session.data.user) {
      currentUser = session.data.user;
    }
  } catch (error) {}
}

const isOwner = currentUser?.id === productData.user_id;

// Get product contributors with role information
const productContributorsWithRoles = await getProductContributorsWithRoles(productData.id);

// Check for jam submission flow
const urlParams = new URL(Astro.request.url).searchParams;
const jamId = urlParams.get('jam');
let targetJam: Awaited<ReturnType<typeof getJamById>> = null;
let userReview: JamProductReview | null = null;
let productInJam = false;
let allJamReviews: JamProductReview[] = [];

if (jamId) {
  // Parallelize jam data fetching
  const [jam, inJam] = await Promise.all([
    getJamById(jamId),
    isProductInJam(jamId, productData.id),
  ]);

  targetJam = jam;
  productInJam = inJam;

  // Get jam reviews if product is in jam
  if (targetJam && productInJam) {
    allJamReviews = await getJamProductReviews(jamId, productData.id);

    // Get user's existing review if they're logged in and not the owner
    if (currentUser && !isOwner) {
      userReview = allJamReviews.find(r => r.user_id === currentUser.id) ?? null;
    }
  }
}

// Helper: Check if we should show the content viewer (has content)
const shouldShowContentViewer = productFiles.length > 0 ||
  productDocuments.length > 0 ||
  embeddedProductsWithCreators.length > 0;

---

<Layout title={`${productData.title} - Game Loopers`}>
  <div class="page">
    <div class="page__container">
      <!-- Jam Context Banner (minimal, at top) -->
      {targetJam && currentUser && !isOwner && productInJam && (
        <div class="jam-context-banner">
          <div class="jam-context-banner__content">
            <span class="jam-context-banner__emoji">🎮</span>
            <div class="jam-context-banner__text">
              <strong>Game Jam Review:</strong> You're reviewing this product for <strong>{targetJam.title}</strong>
            </div>
          </div>
        </div>
      )}

      <div class="page-columns">
        <!-- Main Content Column -->
        <div class="page-columns__column">
          <!-- Product Images -->
          {productImages.length > 0 && (
            <ProductImageGallery
              images={productImages.map(img => ({
                url: img.file_url,
                alt: img.title
              }))}
            />
          )}

          <!-- Reviews Section (Jam Context) -->
          {jamId && targetJam && productInJam && (
            <Card>
              <CardContent>
                <ProductReviewList
                  reviews={allJamReviews}
                  jam={targetJam}
                  jamHandle={targetJam.handle}
                  currentUserId={currentUser?.id}
                />
              </CardContent>
            </Card>
          )}
        </div>

        <!-- Sidebar Column -->
        <div class="page-columns__column">
          <!-- Product Header -->
          <div class="product-page-header">
            <div class="product-page-header__top">
              <h1 class="product-page-header__title">{productData.title}</h1>
              {isOwner && (
                <a href={`/products/${product}/edit`} class="product-page-header__edit-link">
                  <Button variant="outline" size="sm">
                    <span slot="text">Edit</span>
                  </Button>
                </a>
              )}
            </div>
            {productData.description && (
              <p class="product-page-header__description">{productData.description}</p>
            )}
            {tags.length > 0 && (
              <div class="product-page-header__tags">
                {tags.map(tag => (
                  <a href={`/tags/${tag.value}`} class="product-tag">
                    {tag.value}
                  </a>
                ))}
              </div>
            )}
          </div>

          <!-- Product Content Viewer -->
          {shouldShowContentViewer && (
            <Card>
              <CardHeader>
                <CardTitle>What's Included</CardTitle>
                <CardDescription>All files, documents, and embedded products included with purchase</CardDescription>
              </CardHeader>
              <CardContent>
                <ProductContentViewer
                  client:load
                  productId={productData.id}
                  productTitle={productData.title}
                  isAuthenticated={!!currentUser}
                  files={productFiles}
                  documents={productDocuments}
                  embeddedProducts={embeddedProductsWithCreators}
                />
              </CardContent>
            </Card>
          )}

        <!-- Creator & Contributors -->
        <Card>
          <CardHeader>
            <CardTitle>Created By</CardTitle>
          </CardHeader>
          <CardContent>
            <a href={`/users/${owner.handle}`} class="creator-profile">
              <Avatar
                src={owner.avatar_url}
                alt={owner.name || owner.handle || 'Creator'}
                size="lg"
              />
              <div class="creator-profile__info">
                <h3 class="creator-profile__name">{owner.name || owner.handle}</h3>
                <p class="creator-profile__handle">@{owner.handle}</p>
                {owner.bio && (
                  <p class="creator-profile__bio">{owner.bio}</p>
                )}
              </div>
            </a>
          </CardContent>
          {productContributorsWithRoles.length > 0 && (
            <>
              <CardHeader>
                <CardTitle>Contributors</CardTitle>
                <CardDescription>
                  Creators earning royalties from embedded content
                </CardDescription>
              </CardHeader>
              <CardContent>
                <ProductContributors contributorsWithRoles={productContributorsWithRoles} />
              </CardContent>
            </>
          )}
        </Card>

        <!-- Jam Review Form (for non-owners reviewing product in jam) -->
        {targetJam && currentUser && !isOwner && productInJam && (
          <Card>
            <CardHeader>
              <CardTitle>Submit Review</CardTitle>
              <CardDescription>
                Share your thoughts on this product for <strong>{targetJam.title}</strong>
              </CardDescription>
            </CardHeader>
            <CardContent>
              <JamReviewForm
                client:load
                jamId={targetJam.id}
                jamTitle={targetJam.title}
                productId={productData.id}
                existingReview={userReview}
              />
            </CardContent>
          </Card>
        )}

        <!-- Jam Submission Form (for owners submitting product to jam) -->
        {targetJam && isOwner && !productInJam && (
          <Card>
            <CardHeader>
              <CardTitle>Submit to {targetJam.title}</CardTitle>
              <CardDescription>
                Submit this product to compete in the game jam
              </CardDescription>
            </CardHeader>
            <CardContent>
              {productData.status !== 'public' && (
                <WarningBox>
                  <p>
                    Your product must be published before you can submit it to a jam.
                    Change the status to "Public" first.
                  </p>
                </WarningBox>
              )}

              {productData.status === 'public' && (
                <form method="POST" action="/api/jams/add-product" class="jam-submit-form">
                  <input type="hidden" name="jam_id" value={targetJam.id} />
                  <input type="hidden" name="product_id" value={productData.id} />

                  <p class="jam-submit-form__description">
                    By submitting this product, you agree to participate in <strong>{targetJam.title}</strong>
                    and allow community members to review and rate your work.
                  </p>

                  <Button type="submit" variant="primary" size="md">
                    <span slot="text">Submit to Jam</span>
                  </Button>
                </form>
              )}
            </CardContent>
          </Card>
        )}
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  /* ===== Product Page Header (View Mode) ===== */
  .product-page-header {
    margin-bottom: var(--spacing-3xl);
  }

  .product-page-header__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--gap-md);
    margin-bottom: var(--spacing-md);
  }

  .product-page-header__title {
    margin: 0;
    font-size: var(--text-4xl);
    font-weight: var(--font-weight-bold);
    line-height: var(--leading-tight);
    color: var(--foreground);
    flex: 1;
  }

  .product-page-header__edit-link {
    flex-shrink: 0;
    text-decoration: none;
  }

  .product-page-header__description {
    margin: 0 0 var(--spacing-lg);
    font-size: var(--text-lg);
    color: var(--muted-foreground);
    line-height: var(--leading-relaxed);
    max-width: 65ch;
  }

  .product-page-header__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-sm);
  }

  .product-tag {
    display: inline-flex;
    align-items: center;
    padding: var(--spacing-xs) var(--spacing-md);
    background-color: var(--muted);
    border: var(--border-width-default) solid var(--border);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--muted-foreground);
    text-decoration: none;
    transition: all var(--duration-fast) var(--ease-in-out);
  }

  .product-tag:hover {
    background-color: var(--primary);
    color: var(--primary-foreground);
    border-color: var(--primary);
  }

  @media (max-width: 48rem) {
    .product-page-header__title {
      font-size: var(--text-3xl);
    }

    .product-page-header__description {
      font-size: var(--text-base);
    }
  }

  /* ===== Creator Profile ===== */
  .creator-profile {
    display: flex;
    align-items: flex-start;
    gap: var(--gap-md);
    text-decoration: none;
    padding: var(--spacing-md);
    border-radius: var(--radius-md);
    transition: background-color var(--duration-fast) var(--ease-in-out);
  }

  .creator-profile:hover {
    background-color: var(--muted);
  }

  .creator-profile__info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs);
  }

  .creator-profile__name {
    margin: 0;
    font-size: var(--text-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--foreground);
  }

  .creator-profile__handle {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--muted-foreground);
  }

  .creator-profile__bio {
    margin: var(--spacing-sm) 0 0;
    font-size: var(--text-sm);
    color: var(--muted-foreground);
    line-height: var(--leading-relaxed);
  }

  /* ===== Jam Context Banner ===== */
  .jam-context-banner {
    padding: var(--spacing-xl) var(--spacing-2xl);
    margin-bottom: var(--spacing-3xl);
    background: linear-gradient(135deg, oklch(from var(--primary) l c h / 0.1) 0%, var(--background) 100%);
    border: var(--border-width-medium) solid var(--primary);
    border-radius: var(--radius-lg);
  }

  .jam-context-banner__content {
    display: flex;
    align-items: center;
    gap: var(--gap-md);
  }

  .jam-context-banner__emoji {
    font-size: var(--text-2xl);
    line-height: 1;
  }

  .jam-context-banner__text {
    font-size: var(--text-base);
    color: var(--foreground);
    line-height: var(--leading-relaxed);
  }

  /* ===== Jam Submit Form ===== */
  .jam-submit-form {
    display: flex;
    flex-direction: column;
    gap: var(--gap-lg);
  }

  .jam-submit-form__description {
    margin: 0;
    font-size: var(--text-base);
    color: var(--muted-foreground);
    line-height: var(--leading-relaxed);
  }
</style>
