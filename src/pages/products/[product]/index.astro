---
import Layout from "@/layouts/Layout.astro";
import Card from "@/components/Card.astro";
import CardHeader from "@/components/CardHeader.astro";
import CardTitle from "@/components/CardTitle.astro";
import CardContent from "@/components/CardContent.astro";
import Button from "@/components/Button.astro";
import Tag from "@/components/Tag.astro";
import TagList from "@/components/TagList.astro";
import AddToCartButton from "@/components/islands/AddToCartButton";
import ProductDeleteButton from "@/components/islands/ProductDeleteButton";
import { getProductByHandle, getProductTags, getProductVariants, getVariantPrices } from "@/lib/data-access/products";
import { getUserById } from "@/lib/data-access/users";
import { setSession } from "@/lib/auth";

const { product } = Astro.params;

if (!product) {
  return Astro.redirect('/404');
}

const productData = await getProductByHandle(product);

if (!productData) {
  return Astro.redirect('/404');
}

const owner = await getUserById(productData.user_id);
const tags = await getProductTags(productData.id);
const variants = await getProductVariants(productData.id);

const variantsWithPrices = await Promise.all(
  variants.map(async (variant) => {
    const prices = await getVariantPrices(variant.id);
    return { ...variant, prices };
  })
);

let currentUser = null;
const accessToken = Astro.cookies.get("sb-access-token");
const refreshToken = Astro.cookies.get("sb-refresh-token");

if (accessToken && refreshToken) {
  try {
    const session = await setSession({
      refresh_token: refreshToken.value,
      access_token: accessToken.value,
    });
    if (!session.error && session.data.user) {
      currentUser = session.data.user;
    }
  } catch (error) {}
}

const isOwner = currentUser?.id === productData.user_id;

if (productData.status !== 'published' && !isOwner) {
  return Astro.redirect('/404');
}
---

<Layout title={`${productData.title} - Game Loopers`}>
  <div class="page">
    <div class="page__container">
      <Card className="product-card">
        <CardHeader>
          <div class="product-header">
            <div class="product-header__info">
              <div class="product-header__title-row">
                <CardTitle>{productData.title}</CardTitle>
                {isOwner && (
                  <div class="product-header__actions">
                    <a href={`/products/${product}/edit`}>
                      <Button variant="outline" size="sm">
                        <span slot="text">Edit</span>
                      </Button>
                    </a>
                    <ProductDeleteButton
                      client:load
                      productId={productData.id}
                      productTitle={productData.title}
                      redirectUrl={`/users/${owner?.handle}`}
                    />
                  </div>
                )}
              </div>
              <div class="product-header__meta">
                <span class="product-header__author">
                  by <a href={`/users/${owner?.handle}`}>{owner?.name || owner?.handle || 'Unknown'}</a>
                </span>
                <span class={`product-header__status product-header__status--${productData.status}`}>
                  {productData.status}
                </span>
              </div>
              {productData.description && <p class="product-header__description">{productData.description}</p>}
              {tags.length > 0 && (
                <TagList className="product-tags">
                  {tags.map((tag) => <Tag>{tag.value}</Tag>)}
                </TagList>
              )}
            </div>
          </div>
        </CardHeader>
      </Card>

      {variantsWithPrices.length > 0 ? (
        <Card>
          <CardHeader><CardTitle>Variants & Pricing</CardTitle></CardHeader>
          <CardContent>
            <div class="product-variants">
              {variantsWithPrices.map((variant) => (
                <div class="variant-card">
                  <div class="variant-card__header">
                    <h3 class="variant-card__name">{variant.title}</h3>
                    <span class="variant-card__badge">{variant.is_digital ? 'Digital' : 'Physical'}</span>
                  </div>
                  {variant.description && <p class="variant-card__description">{variant.description}</p>}
                  {variant.prices && variant.prices.length > 0 ? (
                    <div class="variant-card__pricing">
                      {variant.prices.map((price, index) => (
                        <div class="variant-card__price">
                          <span class="variant-card__price-amount">
                            {price.unit_amount === 0 ? 'FREE' : `${price.currency.toUpperCase()} ${(price.unit_amount / 100).toFixed(2)}`}
                          </span>
                          {(price.min_quantity > 1 || price.max_quantity) && (
                            <span class="variant-card__price-quantity">
                              {price.min_quantity > 1 && `${price.min_quantity}+`}
                              {price.max_quantity && ` (max ${price.max_quantity})`}
                            </span>
                          )}
                        </div>
                      ))}
                      {!isOwner && currentUser && (
                        <div class="variant-card__add-to-cart">
                          <AddToCartButton
                            client:load
                            productId={productData.id}
                            variantId={variant.id}
                            quantity={1}
                            variant="primary"
                            size="md"
                          />
                        </div>
                      )}
                      {!isOwner && !currentUser && (
                        <div class="variant-card__add-to-cart">
                          <a href={`/sign-in?redirect=/products/${product}`}>
                            <Button variant="primary" size="md">
                              <span slot="text">Sign In to Add to Cart</span>
                            </Button>
                          </a>
                        </div>
                      )}
                    </div>
                  ) : (
                    isOwner && <p class="variant-card__no-price">No pricing set</p>
                  )}
                  <div class="variant-card__sku">SKU: <code>{variant.sku}</code></div>
                </div>
              ))}
            </div>
          </CardContent>
        </Card>
      ) : (
        <Card>
          <CardContent>
            <div class="product-empty">
              <p class="product-empty__text">
                {isOwner ? "No variants added yet." : "This product doesn't have any variants available yet."}
              </p>
              {isOwner && (
                <a href={`/products/${product}/edit`}>
                  <Button variant="primary" size="md"><span slot="text">Add Variants</span></Button>
                </a>
              )}
            </div>
          </CardContent>
        </Card>
      )}
    </div>
  </div>
</Layout>

<style>
.product-page {
  min-height: calc(100vh - 64px);
  background-color: var(--color-background, #f9fafb);
  padding: var(--spacing-4xl) var(--spacing-2xl);
}
.product-page__container {
  max-width: 960px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: var(--gap-xl);
}
.product-header { display: flex; gap: var(--gap-xl); align-items: flex-start; }
.product-header__info { flex: 1; }
.product-header__title-row { display: flex; justify-content: space-between; align-items: flex-start; gap: var(--gap-lg); }
.product-header__actions { display: flex; gap: var(--gap-sm); flex-shrink: 0; }
.product-header__actions a { text-decoration: none; }
.product-header__actions form { margin: 0; }
.product-header__meta { display: flex; align-items: center; gap: var(--gap-lg); margin-top: var(--spacing-sm); }
.product-header__author { font-size: var(--text-sm); color: var(--muted-foreground); }
.product-header__author a { color: var(--color-primary, #0070f3); text-decoration: none; font-weight: var(--font-weight-medium); }
.product-header__status { display: inline-block; padding: var(--spacing-xxs) var(--spacing-lg); font-size: var(--text-xs); font-weight: var(--font-weight-semibold); border-radius: var(--radius-full); text-transform: uppercase; }
.product-header__status--draft { background-color: #fef3c7; color: #92400e; }
.product-header__status--published { background-color: #d1fae5; color: #065f46; }
.product-header__status--archived { background-color: #e5e7eb; color: #374151; }
.product-header__description { margin: var(--spacing-2xl) 0 0 0; font-size: var(--text-base); line-height: var(--leading-relaxed); color: var(--foreground); }
.product-tags { margin-top: var(--spacing-2xl); }
.product-variants { display: flex; flex-direction: column; gap: var(--gap-lg); }
.variant-card { padding: var(--spacing-3xl); background-color: var(--color-background, #f9fafb); border: 1px solid var(--color-border, #e5e7eb); border-radius: var(--radius-md); }
.variant-card__header { display: flex; justify-content: space-between; align-items: flex-start; gap: var(--gap-md); margin-bottom: var(--spacing-md); }
.variant-card__name { margin: 0; font-size: var(--text-lg); font-weight: var(--font-weight-semibold); color: var(--foreground); }
.variant-card__badge { padding: var(--spacing-xxs) var(--spacing-md); font-size: var(--text-xs); font-weight: var(--font-weight-medium); background-color: var(--color-primary, #0070f3); color: white; border-radius: var(--radius-full); }
.variant-card__description { margin: 0 0 var(--spacing-md) 0; font-size: var(--text-sm); color: var(--muted-foreground); line-height: var(--leading-normal); }
.variant-card__pricing { margin: var(--spacing-2xl) 0; display: flex; flex-direction: column; gap: var(--gap-sm); }
.variant-card__price { display: flex; align-items: baseline; gap: var(--gap-md); }
.variant-card__price-amount { font-size: var(--text-2xl); font-weight: var(--font-weight-bold); color: var(--primary); }
.variant-card__price-quantity { font-size: var(--text-sm); color: var(--muted-foreground); }
.variant-card__no-price { margin: var(--spacing-2xl) 0; font-size: var(--text-sm); color: var(--muted-foreground); font-style: italic; }
.variant-card__add-to-cart { margin-top: var(--spacing-2xl); }
.variant-card__sku { font-size: var(--text-sm); color: var(--muted-foreground); margin-top: var(--spacing-md); }
.variant-card__sku code { padding: var(--spacing-xxs) var(--spacing-sm); background-color: var(--muted); border-radius: var(--radius-sm); font-family: monospace; font-size: var(--text-xs); }
.product-empty { text-align: center; padding: var(--spacing-5xl) var(--spacing-3xl); }
.product-empty__text { margin: 0 0 var(--spacing-3xl) 0; font-size: var(--text-base); color: var(--muted-foreground); }
</style>
