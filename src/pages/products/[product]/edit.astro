---
import Layout from "@/layouts/Layout.astro";
import Card from "@/components/Card.astro";
import CardHeader from "@/components/CardHeader.astro";
import CardTitle from "@/components/CardTitle.astro";
import CardContent from "@/components/CardContent.astro";
import Button from "@/components/Button.astro";
import Label from "@/components/Label.astro";
import Input from "@/components/Input.astro";
import TagInput from "@/components/islands/TagInput";
import {
  getProductByHandle,
  updateProduct,
  getProductTags,
  getProductVariants,
  createVariant,
  updateVariant,
  deleteVariant,
  linkAssetToVariant,
  unlinkAssetFromVariant,
  getVariantAssets,
  createVariantPrice,
  getVariantPrices
} from "@/lib/data-access/products";
import { getPublishedAssets } from "@/lib/data-access/assets";
import { setSession } from "@/lib/auth";
import { uploadProductCover } from "@/lib/storage/products";

const { product } = Astro.params;

if (!product) {
  return Astro.redirect('/404');
}

const productData = await getProductByHandle(product);

if (!productData) {
  return Astro.redirect('/404');
}

let currentUser = null;
const accessToken = Astro.cookies.get("sb-access-token");
const refreshToken = Astro.cookies.get("sb-refresh-token");

if (!accessToken || !refreshToken) {
  return Astro.redirect(`/sign-in?redirect=/products/${product}/edit`);
}

try {
  const session = await setSession({
    refresh_token: refreshToken.value,
    access_token: accessToken.value,
  });
  if (!session.error && session.data.user) {
    currentUser = session.data.user;
  }
} catch (error) {
  return Astro.redirect(`/sign-in?redirect=/products/${product}/edit`);
}

if (!currentUser || currentUser.id !== productData.user_id) {
  return Astro.redirect('/404');
}

const tags = await getProductTags(productData.id);
const variants = await getProductVariants(productData.id);
const availableAssets = await getPublishedAssets('', undefined, 100, 0);

let formError = '';
let formSuccess = '';

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const action = formData.get("action") as string;

  try {
    if (action === "update-product") {
      const title = formData.get("title") as string;
      const description = formData.get("description") as string;
      const status = formData.get("status") as string;
      const tagsJson = formData.get("tags") as string;
      const coverImageFile = formData.get("cover_image") as File;

      let coverImageUrl = productData.cover_image_url;

      if (coverImageFile && coverImageFile.size > 0) {
        const uploadResult = await uploadProductCover(
          coverImageFile,
          currentUser.id,
          productData.id
        );
        if (uploadResult) {
          coverImageUrl = uploadResult.url;
        }
      }

      const parsedTags = tagsJson ? JSON.parse(tagsJson) : [];

      const success = await updateProduct(
        productData.id,
        {
          title,
          description,
          status,
          coverImageUrl,
          tags: parsedTags,
        },
        {
          accessToken: accessToken.value,
          refreshToken: refreshToken.value,
        }
      );

      if (success) {
        formSuccess = "Product updated successfully!";
      } else {
        formError = "Failed to update product.";
      }
    } else if (action === "create-variant") {
      const name = formData.get("variant_name") as string;
      const description = formData.get("variant_description") as string;
      const sku = formData.get("variant_sku") as string;
      const isDigital = formData.get("variant_is_digital") === "true";

      const variant = await createVariant(
        productData.id,
        {
          name,
          description,
          sku,
          isDigital,
        },
        {
          accessToken: accessToken.value,
          refreshToken: refreshToken.value,
        }
      );

      if (variant) {
        formSuccess = "Variant created successfully!";
      } else {
        formError = "Failed to create variant.";
      }
    } else if (action === "update-variant") {
      const variantId = formData.get("variant_id") as string;
      const name = formData.get("variant_name") as string;
      const description = formData.get("variant_description") as string;
      const isDigital = formData.get("variant_is_digital") === "true";

      const success = await updateVariant(
        variantId,
        {
          name,
          description,
          isDigital,
        },
        {
          accessToken: accessToken.value,
          refreshToken: refreshToken.value,
        }
      );

      if (success) {
        formSuccess = "Variant updated successfully!";
      } else {
        formError = "Failed to update variant.";
      }
    } else if (action === "delete-variant") {
      const variantId = formData.get("variant_id") as string;

      const success = await deleteVariant(variantId, {
        accessToken: accessToken.value,
        refreshToken: refreshToken.value,
      });

      if (success) {
        formSuccess = "Variant deleted successfully!";
      } else {
        formError = "Failed to delete variant.";
      }
    } else if (action === "link-asset") {
      const variantId = formData.get("variant_id") as string;
      const assetId = formData.get("asset_id") as string;

      const success = await linkAssetToVariant(variantId, assetId, {
        accessToken: accessToken.value,
        refreshToken: refreshToken.value,
      });

      if (success) {
        formSuccess = "Asset linked successfully!";
      } else {
        formError = "Failed to link asset.";
      }
    } else if (action === "unlink-asset") {
      const variantId = formData.get("variant_id") as string;
      const assetId = formData.get("asset_id") as string;

      const success = await unlinkAssetFromVariant(variantId, assetId, {
        accessToken: accessToken.value,
        refreshToken: refreshToken.value,
      });

      if (success) {
        formSuccess = "Asset unlinked successfully!";
      } else {
        formError = "Failed to unlink asset.";
      }
    } else if (action === "create-price") {
      const variantId = formData.get("variant_id") as string;
      const currency = formData.get("currency") as string;
      const unitAmountDollars = parseFloat(formData.get("unit_amount") as string);
      const unitAmount = Math.round(unitAmountDollars * 100); // Convert to cents
      const minQuantity = parseInt(formData.get("min_quantity") as string);
      const maxQuantityStr = formData.get("max_quantity") as string;
      const maxQuantity = maxQuantityStr ? parseInt(maxQuantityStr) : undefined;

      const price = await createVariantPrice(
        variantId,
        {
          currency,
          unitAmount,
          minQuantity,
          maxQuantity,
        },
        {
          accessToken: accessToken.value,
          refreshToken: refreshToken.value,
        }
      );

      if (price) {
        formSuccess = "Price created successfully!";
      } else {
        formError = "Failed to create price.";
      }
    }
  } catch (error) {
    formError = "An unexpected error occurred.";
  }

  if (formSuccess || formError) {
    const params = new URLSearchParams();
    if (formSuccess) params.set('success', formSuccess);
    if (formError) params.set('error', formError);
    return Astro.redirect(`/products/${product}/edit?${params.toString()}`, 303);
  }
}

const variantsWithAssets = await Promise.all(
  variants.map(async (variant) => {
    const assets = await getVariantAssets(variant.id);
    const prices = await getVariantPrices(variant.id);
    return { ...variant, linkedAssets: assets, prices };
  })
);

const successMessage = Astro.url.searchParams.get('success');
const errorMessage = Astro.url.searchParams.get('error');
---

<Layout title={`Edit ${productData.title} - Game Loopers`}>
  <div class="page">
    <div class="page__container">
      <div class="page-header">
        <h1 class="page-header__title">Edit Product</h1>
        <a href={`/products/${product}`}>
          <Button variant="ghost" size="sm">
            <span slot="text">← Back to Product</span>
          </Button>
        </a>
      </div>

      {successMessage && (
        <div class="product-edit-alert product-edit-alert--success">
          {successMessage}
        </div>
      )}

      {errorMessage && (
        <div class="product-edit-alert product-edit-alert--error">
          {errorMessage}
        </div>
      )}

      <Card>
        <CardHeader>
          <CardTitle>Basic Information</CardTitle>
        </CardHeader>
        <CardContent>
          <form method="POST" enctype="multipart/form-data" class="product-edit-form">
            <input type="hidden" name="action" value="update-product" />

            <div class="product-edit-form__field">
              <Label for="title">Product Title *</Label>
              <Input type="text" name="title" id="title" value={productData.title} required />
            </div>

            <div class="product-edit-form__field">
              <Label for="description">Description</Label>
              <textarea
                name="description"
                id="description"
                rows="6"
                class="product-edit-form__textarea"
              >{productData.description || ''}</textarea>
            </div>

            <div class="product-edit-form__field">
              <Label for="cover_image">Cover Image</Label>
              {productData.cover_image_url && (
                <div class="product-edit-form__current-image">
                  <img src={productData.cover_image_url} alt="Current cover" />
                </div>
              )}
              <input
                type="file"
                name="cover_image"
                id="cover_image"
                accept="image/*"
                class="product-edit-form__file-input"
              />
            </div>

            <div class="product-edit-form__field">
              <Label for="tags">Tags</Label>
              <TagInput
                client:load
                name="tags"
                initialTags={tags.map(t => t.value)}
              />
            </div>

            <div class="product-edit-form__field">
              <Label for="status">Status</Label>
              <select name="status" id="status" class="product-edit-form__select">
                <option value="draft" selected={productData.status === 'draft'}>Draft</option>
                <option value="published" selected={productData.status === 'published'}>Published</option>
                <option value="archived" selected={productData.status === 'archived'}>Archived</option>
              </select>
            </div>

            <div class="product-edit-form__actions">
              <Button type="submit" variant="primary" size="md">
                <span slot="text">Save Changes</span>
              </Button>
            </div>
          </form>
        </CardContent>
      </Card>

      <Card>
        <CardHeader>
          <CardTitle>Variants & Pricing</CardTitle>
        </CardHeader>
        <CardContent>
          <div class="product-variants">
            {variantsWithAssets.length > 0 ? (
              variantsWithAssets.map((variant) => (
                <div class="variant-edit-card">
                  <div class="variant-edit-card__header">
                    <h3 class="variant-edit-card__name">{variant.title}</h3>
                    <p class="variant-edit-card__badge">
                      Digital
                    </p>
                  </div>

                  {variant.description && (
                    <p class="variant-edit-card__description">{variant.description}</p>
                  )}

                  <div class="variant-edit-card__sku">SKU: <code>{variant.sku}</code></div>

                  <div class="variant-edit-card__assets">
                    <h4 class="variant-edit-card__assets-title">Linked Assets ({variant.linkedAssets?.length || 0})</h4>
                    {variant.linkedAssets && variant.linkedAssets.length > 0 ? (
                      <ul class="variant-edit-card__assets-list">
                        {variant.linkedAssets.map((asset) => (
                          <li class="variant-edit-card__asset-item">
                            <span>{asset.title}</span>
                            <form method="POST" style="display: inline;">
                              <input type="hidden" name="action" value="unlink-asset" />
                              <input type="hidden" name="variant_id" value={variant.id} />
                              <input type="hidden" name="asset_id" value={asset.id} />
                              <Button type="submit" variant="ghost" size="xs">
                                <span slot="text">Remove</span>
                              </Button>
                            </form>
                          </li>
                        ))}
                      </ul>
                    ) : (
                      <p class="variant-edit-card__no-assets">No assets linked yet.</p>
                    )}

                    <form method="POST" class="variant-edit-card__asset-form">
                      <input type="hidden" name="action" value="link-asset" />
                      <input type="hidden" name="variant_id" value={variant.id} />
                      <div class="variant-edit-card__asset-select">
                        <select name="asset_id" class="variant-edit-card__select" required>
                          <option value="">Select an asset to link...</option>
                          {availableAssets.map((asset) => (
                            <option value={asset.id}>{asset.title}</option>
                          ))}
                        </select>
                        <Button type="submit" variant="outline" size="sm">
                          <span slot="text">Link Asset</span>
                        </Button>
                      </div>
                    </form>
                  </div>

                  <div class="variant-edit-card__pricing">
                    <h4 class="variant-edit-card__pricing-title">Pricing ({variant.prices?.length || 0})</h4>
                    {variant.prices && variant.prices.length > 0 ? (
                      <div class="variant-edit-card__pricing-list">
                        {variant.prices.map((price) => (
                          <div class="variant-edit-card__price-item">
                            {/* TODO: Update migration to account for price breaks */}
                            <p>{price.default_currency}</p>
                            {/* <div class="variant-edit-card__price-amount">
                              {price.currency.toUpperCase()} {(price.unit_amount / 100).toFixed(2)}
                            </div>
                            <div class="variant-edit-card__price-details">
                              {price.min_quantity > 1 && (
                                <span>Min qty: {price.min_quantity}</span>
                              )}
                              {price.max_quantity && (
                                <span>Max qty: {price.max_quantity}</span>
                              )}
                              {price.min_quantity === 1 && !price.max_quantity && (
                                <span>Standard price</span>
                              )}
                            </div> */}
                          </div>
                        ))}
                      </div>
                    ) : (
                      <p class="variant-edit-card__no-pricing">No pricing set yet.</p>
                    )}

                    <details class="variant-edit-card__pricing-add">
                      <summary class="variant-edit-card__pricing-add-summary">Add Price</summary>
                      <form method="POST" class="variant-edit-card__pricing-form">
                        <input type="hidden" name="action" value="create-price" />
                        <input type="hidden" name="variant_id" value={variant.id} />

                        <div class="variant-edit-card__pricing-row">
                          <div class="variant-edit-card__field">
                            <Label for={`price_amount_${variant.id}`}>Price *</Label>
                            <Input
                              type="number"
                              name="unit_amount"
                              id={`price_amount_${variant.id}`}
                              placeholder="0.00"
                              step="0.01"
                              min="0"
                              required
                            />
                            <p class="variant-edit-card__help-text">Enter price in dollars (e.g., 9.99 for $9.99). Use 0 for free.</p>
                          </div>

                          <div class="variant-edit-card__field">
                            <Label for={`price_currency_${variant.id}`}>Currency *</Label>
                            <select
                              name="currency"
                              id={`price_currency_${variant.id}`}
                              class="variant-edit-card__select"
                              required
                            >
                              <option value="usd">USD ($)</option>
                              <option value="eur">EUR (€)</option>
                              <option value="gbp">GBP (£)</option>
                              <option value="cad">CAD ($)</option>
                              <option value="aud">AUD ($)</option>
                            </select>
                          </div>
                        </div>

                        <div class="variant-edit-card__pricing-row">
                          <div class="variant-edit-card__field">
                            <Label for={`price_min_qty_${variant.id}`}>Min Quantity</Label>
                            <Input
                              type="number"
                              name="min_quantity"
                              id={`price_min_qty_${variant.id}`}
                              placeholder="1"
                              min="1"
                              value="1"
                            />
                            <p class="variant-edit-card__help-text">Minimum quantity for this price tier</p>
                          </div>

                          <div class="variant-edit-card__field">
                            <Label for={`price_max_qty_${variant.id}`}>Max Quantity</Label>
                            <Input
                              type="number"
                              name="max_quantity"
                              id={`price_max_qty_${variant.id}`}
                              placeholder="Optional"
                              min="1"
                            />
                            <p class="variant-edit-card__help-text">Leave empty for no max</p>
                          </div>
                        </div>

                        <div class="variant-edit-card__form-actions">
                          <Button type="submit" variant="primary" size="sm">
                            <span slot="text">Add Price</span>
                          </Button>
                        </div>
                      </form>
                    </details>
                  </div>

                  <div class="variant-edit-card__actions">
                    <details class="variant-edit-card__edit-details">
                      <summary class="variant-edit-card__edit-summary">Edit Variant</summary>
                      <form method="POST" class="variant-edit-card__edit-form">
                        <input type="hidden" name="action" value="update-variant" />
                        <input type="hidden" name="variant_id" value={variant.id} />

                        <div class="variant-edit-card__field">
                          <Label for={`variant_name_${variant.id}`}>Name</Label>
                          <Input
                            type="text"
                            name="variant_name"
                            id={`variant_name_${variant.id}`}
                            value={variant.title}
                            required
                          />
                        </div>

                        <div class="variant-edit-card__field">
                          <Label for={`variant_description_${variant.id}`}>Description</Label>
                          <textarea
                            name="variant_description"
                            id={`variant_description_${variant.id}`}
                            rows="3"
                            class="variant-edit-card__textarea"
                          >{variant.description || ''}</textarea>
                        </div>

                        <div class="variant-edit-card__form-actions">
                          <Button type="submit" variant="primary" size="sm">
                            <span slot="text">Update Variant</span>
                          </Button>
                        </div>
                      </form>
                    </details>

                    <form method="POST" class="variant-edit-card__delete-form">
                      <input type="hidden" name="action" value="delete-variant" />
                      <input type="hidden" name="variant_id" value={variant.id} />
                      <Button
                        type="button"
                        variant="destructive"
                        size="sm"
                        class="delete-variant-button"
                        data-variant-id={variant.id}
                      >
                        <span slot="text">Delete Variant</span>
                      </Button>
                    </form>
                  </div>
                </div>
              ))
            ) : (
              <p class="product-variants__empty">No variants yet. Create one below.</p>
            )}
          </div>

          <details class="product-variants__add" open>
            <summary class="product-variants__add-summary">Add New Variant</summary>
            <form method="POST" class="product-variants__add-form">
              <input type="hidden" name="action" value="create-variant" />

              <div class="product-variants__add-field">
                <Label for="variant_name">Variant Name *</Label>
                <Input type="text" name="variant_name" id="variant_name" placeholder="e.g., PDF Only, PDF + STL Files" required />
              </div>

              <div class="product-variants__add-field">
                <Label for="variant_sku">SKU *</Label>
                <Input type="text" name="variant_sku" id="variant_sku" placeholder="e.g., GAME-001-PDF" required />
              </div>

              <div class="product-variants__add-field">
                <Label for="variant_description">Description</Label>
                <textarea
                  name="variant_description"
                  id="variant_description"
                  rows="3"
                  class="product-variants__add-textarea"
                  placeholder="Describe what's included in this variant..."
                ></textarea>
              </div>

              <div class="product-variants__add-field">
                <label class="product-variants__add-checkbox-label">
                  <input type="checkbox" name="variant_is_digital" value="true" checked />
                  Digital Product
                </label>
              </div>

              <div class="product-variants__add-actions">
                <Button type="submit" variant="primary" size="md">
                  <span slot="text">Create Variant</span>
                </Button>
              </div>
            </form>
          </details>
        </CardContent>
      </Card>
    </div>
  </div>
</Layout>

<style>
.product-edit-page {
  min-height: calc(100vh - 64px);
  background-color: var(--color-background, #f9fafb);
  padding: var(--spacing-4xl) var(--spacing-2xl);
}
.product-edit-page__container {
  max-width: 960px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: var(--gap-xl);
}
.product-edit-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-2xl);
}
.product-edit-header__title {
  margin: 0;
  font-size: var(--text-3xl);
  font-weight: var(--font-weight-bold);
}
.product-edit-alert {
  padding: var(--spacing-2xl);
  border-radius: var(--radius-md);
  margin-bottom: var(--spacing-2xl);
}
.product-edit-alert--success {
  background-color: #d1fae5;
  color: #065f46;
  border: 1px solid #059669;
}
.product-edit-alert--error {
  background-color: #fee2e2;
  color: #991b1b;
  border: 1px solid #dc2626;
}
.product-edit-form {
  display: flex;
  flex-direction: column;
  gap: var(--gap-xl);
}
.product-edit-form__field {
  display: flex;
  flex-direction: column;
  gap: var(--gap-sm);
}
.product-edit-form__textarea {
  width: 100%;
  padding: var(--spacing-lg);
  font-size: var(--text-base);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  font-family: inherit;
  resize: vertical;
}
.product-edit-form__select {
  width: 100%;
  padding: var(--spacing-lg);
  font-size: var(--text-base);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  background-color: white;
}
.product-edit-form__file-input {
  padding: var(--spacing-lg);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
}
.product-edit-form__current-image {
  max-width: 300px;
  margin-bottom: var(--spacing-lg);
}
.product-edit-form__current-image img {
  width: 100%;
  height: auto;
  border-radius: var(--radius-md);
  border: 1px solid var(--border);
}
.product-edit-form__actions {
  display: flex;
  gap: var(--gap-md);
  justify-content: flex-end;
}
.product-variants {
  display: flex;
  flex-direction: column;
  gap: var(--gap-xl);
}
.product-variants__empty {
  text-align: center;
  color: var(--muted-foreground);
  padding: var(--spacing-4xl);
}
.variant-edit-card {
  padding: var(--spacing-3xl);
  background-color: var(--color-background, #f9fafb);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
}
.variant-edit-card__header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: var(--gap-md);
  margin-bottom: var(--spacing-md);
}
.variant-edit-card__name {
  margin: 0;
  font-size: var(--text-lg);
  font-weight: var(--font-weight-semibold);
}
.variant-edit-card__badge {
  padding: var(--spacing-xxs) var(--spacing-md);
  font-size: var(--text-xs);
  font-weight: var(--font-weight-medium);
  background-color: var(--primary);
  color: white;
  border-radius: var(--radius-full);
}
.variant-edit-card__description {
  margin: 0 0 var(--spacing-md) 0;
  font-size: var(--text-sm);
  color: var(--muted-foreground);
}
.variant-edit-card__sku {
  font-size: var(--text-sm);
  color: var(--muted-foreground);
  margin-bottom: var(--spacing-2xl);
}
.variant-edit-card__sku code {
  padding: var(--spacing-xxs) var(--spacing-sm);
  background-color: var(--muted);
  border-radius: var(--radius-sm);
  font-family: monospace;
  font-size: var(--text-xs);
}
.variant-edit-card__assets {
  margin: var(--spacing-2xl) 0;
  padding: var(--spacing-2xl);
  background-color: white;
  border-radius: var(--radius-md);
}
.variant-edit-card__assets-title {
  margin: 0 0 var(--spacing-lg) 0;
  font-size: var(--text-base);
  font-weight: var(--font-weight-semibold);
}
.variant-edit-card__assets-list {
  list-style: none;
  padding: 0;
  margin: 0 0 var(--spacing-2xl) 0;
  display: flex;
  flex-direction: column;
  gap: var(--gap-sm);
}
.variant-edit-card__asset-item {
