---
import Layout from "@/layouts/Layout.astro";
import Card from "@/components/Card.astro";
import CardContent from "@/components/CardContent.astro";
import PageHeader from "@/components/PageHeader.astro";
import { getAllProducts } from "@/lib/data-access/products";
import { getUserById } from "@/lib/data-access/users";
import { setSession } from "@/lib/auth";
import Button from "@/components/Button.astro";

const { url, cookies } = Astro;
const searchParams = url.searchParams;

// Check authentication - allow guests to browse
let currentUser = null;
const accessToken = Astro.cookies.get("sb-access-token");
const refreshToken = Astro.cookies.get("sb-refresh-token");

if (accessToken && refreshToken) {
  try {
    const session = await setSession({
      refresh_token: refreshToken.value,
      access_token: accessToken.value,
    });
    if (!session.error && session.data.user) {
      currentUser = session.data.user;
    }
  } catch (error) {
    // Continue as guest
  }
}

const userId = currentUser?.id;

const searchQuery = searchParams.get('search') || '';
const tagFilter = searchParams.get('tag') || '';
const page = parseInt(searchParams.get('page') || '1');
const limit = 20;
const offset = (page - 1) * limit;

const tagArray = tagFilter ? [tagFilter] : undefined;
const allProducts = await getAllProducts(searchQuery, tagArray, limit, offset);
console.log(allProducts)

// Get owners for all products
const allProductOwnerIds = [...new Set(allProducts.map(p => p.user_id))];
const allProductOwners = await Promise.all(allProductOwnerIds.map(id => getUserById(id)));
const allOwnersMap = new Map(allProductOwners.filter(o => o).map(o => [o!.id, o]));
---

<Layout title="Browse Products - Game Loopers">
  <div class="page">
    <div class="page__container">
      <div class="page-header-with-action">
        <PageHeader
          title="Browse Products"
          description="Discover tabletop games from the community"
        />
        {currentUser && (
          <form method="post" action="/api/products/create-product">
              <Button variant="primary" size="lg">
                  <span slot="text">Create Product</span>
              </Button>
          </form>
        )}
      </div>

      {!currentUser && (
        <Card>
          <CardContent>
            <div class="browse-cta">
              <p class="browse-cta__text">Sign in to create and sell your tabletop games</p>
              <div class="browse-cta__actions">
                <a href="/sign-in" class="browse-cta__link">
                  <button class="button button--primary button--md">
                    <span class="button__text">Sign In</span>
                  </button>
                </a>
                <a href="/sign-up" class="browse-cta__link">
                  <button class="button button--ghost button--md">
                    <span class="button__text">Sign Up</span>
                  </button>
                </a>
              </div>
            </div>
          </CardContent>
        </Card>
      )}

      <!-- All Products Section -->
      {allProducts.length > 0 ? (
        <section class="products-section">
          <div class="products-grid">
            {allProducts.map((product) => {
              const owner = allOwnersMap.get(product.user_id);
              return (
                <a href={`/products/${product.handle}`} class="product-card">
                  <div class="product-card__content">
                    {/* TODO: Images & Placeholder images */}
                    <img src={'https://placehold.co/600x600'} alt={''} class="gallery__image" loading="lazy" />
                    <h3 class="product-card__title">{product.title}</h3>
                    {product.description && (
                      <p class="product-card__description">
                        {product.description.substring(0, 100)}{product.description.length > 100 ? '...' : ''}
                      </p>
                    )}
                    <div class="product-card__meta">
                      <span class="product-card__author">by {owner?.name || owner?.handle || 'Unknown'}</span>
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      ) : allProducts.length === 0 && (
        <Card>
          <CardContent>
            <div class="products-empty">
              <p class="products-empty__text">
                {searchQuery || tagFilter ? "No products found." : "No products available yet."}
              </p>
              {(searchQuery || tagFilter) && (
                <a href="/products" class="products-empty__link">Clear filters</a>
              )}
            </div>
          </CardContent>
        </Card>
      )}

      {allProducts.length === limit && (
        <div class="products-pagination">
          {page > 1 && (
            <a href={`/products?page=${page - 1}${searchQuery ? `&search=${encodeURIComponent(searchQuery)}` : ''}${tagFilter ? `&tag=${encodeURIComponent(tagFilter)}` : ''}`}
               class="products-pagination__link">← Previous</a>
          )}
          <span class="products-pagination__current">Page {page}</span>
          <a href={`/products?page=${page + 1}${searchQuery ? `&search=${encodeURIComponent(searchQuery)}` : ''}${tagFilter ? `&tag=${encodeURIComponent(tagFilter)}` : ''}`}
             class="products-pagination__link">Next →</a>
        </div>
      )}
    </div>
  </div>
</Layout>

<style>
/* ===== Page Header ===== */
.page-header-with-action {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: var(--gap-xl);
  margin-bottom: var(--spacing-2xl);
}

.page-header-action {
  text-decoration: none;
  flex-shrink: 0;
}

/* ===== Browse CTA ===== */
.browse-cta {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--gap-lg);
  padding: var(--spacing-xl) 0;
  text-align: center;
}

.browse-cta__text {
  margin: 0;
  font-size: var(--text-base);
  color: var(--foreground);
}

.browse-cta__actions {
  display: flex;
  gap: var(--gap-md);
  flex-wrap: wrap;
  justify-content: center;
}

.browse-cta__link {
  text-decoration: none;
}

/* ===== Products Section ===== */
.products-section {
  margin-bottom: var(--spacing-6xl);
}

.products-section__title {
  margin: 0 0 var(--spacing-3xl) 0;
  font-size: var(--text-2xl);
  font-weight: var(--font-weight-bold);
  color: var(--foreground);
  line-height: var(--leading-tight);
}

/* ===== Products Grid ===== */
.products-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
  gap: var(--gap-xl);
}

.product-card {
  display: block;
  padding: var(--spacing-3xl);
  background-color: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  text-decoration: none;
  transition: all var(--duration-normal) var(--ease-in-out);
}

.product-card:hover {
  border-color: var(--primary);
  box-shadow: var(--shadow-md);
  transform: translateY(-2px);
}

.product-card__content {
  display: flex;
  flex-direction: column;
  gap: var(--gap-md);
}

.product-card__title {
  margin: 0;
  font-size: var(--text-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--foreground);
}

.product-card__description {
  margin: 0;
  font-size: var(--text-sm);
  color: var(--muted-foreground);
  line-height: var(--leading-normal);
}

.product-card__meta {
  display: flex;
  gap: var(--gap-sm);
}

.product-card__author {
  font-size: var(--text-sm);
  color: var(--muted-foreground);
}

/* ===== Empty State ===== */
.products-empty {
  text-align: center;
  padding: var(--spacing-5xl) var(--spacing-4xl);
}

.products-empty__text {
  margin: 0 0 var(--spacing-2xl);
  font-size: var(--text-base);
  color: var(--muted-foreground);
}

.products-empty__link {
  color: var(--primary);
  text-decoration: none;
  font-weight: var(--font-weight-medium);
}

/* ===== Pagination ===== */
.products-pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: var(--gap-xl);
  padding: var(--spacing-3xl) 0;
}

.products-pagination__link {
  color: var(--primary);
  text-decoration: none;
  font-weight: var(--font-weight-medium);
  padding: var(--spacing-sm) var(--spacing-2xl);
  border-radius: var(--radius-md);
  transition: background-color var(--duration-normal) var(--ease-in-out);
}

.products-pagination__link:hover {
  background-color: var(--muted);
}

.products-pagination__current {
  font-size: var(--text-sm);
  color: var(--muted-foreground);
}
</style>
