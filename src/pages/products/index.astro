---
import Layout from "@/layouts/Layout.astro";
import Card from "@/components/Card.astro";
import CardContent from "@/components/CardContent.astro";
import PageHeader from "@/components/PageHeader.astro";
import BrowseCTA from "@/components/home/BrowseCTA.astro";
import { getAllProducts, getProductImages } from "@/lib/data-access/products";
import { getUserById } from "@/lib/data-access/users";
import { getAllTags } from "@/lib/data-access/tags";
import { setSession } from "@/lib/auth";
import Button from "@/components/Button.astro";
import EmptyState from "@/components/EmptyState.astro";
import { FormSubmitButton } from "@/components/interactive";

const { url, cookies } = Astro;
const searchParams = url.searchParams;

// Check authentication - allow guests to browse
let currentUser = null;
const accessToken = Astro.cookies.get("sb-access-token");
const refreshToken = Astro.cookies.get("sb-refresh-token");

if (accessToken && refreshToken) {
  try {
    const session = await setSession({
      refresh_token: refreshToken.value,
      access_token: accessToken.value,
    });
    if (!session.error && session.data.user) {
      currentUser = session.data.user;
    }
  } catch (error) {
    // Continue as guest
  }
}

const userId = currentUser?.id;

const searchQuery = searchParams.get('search') || '';
const tagFilter = searchParams.get('tag') || '';
const page = parseInt(searchParams.get('page') || '1');
const limit = 20;
const offset = (page - 1) * limit;

const tagArray = tagFilter ? [tagFilter] : undefined;
const allProducts = await getAllProducts(searchQuery, tagArray, limit, offset);

// Fetch images for each product
const productsWithDetails = await Promise.all(
  allProducts.map(async (product) => {
    const images = await getProductImages(product.id);

    return {
      ...product,
      cover_image_url: images[0]?.file_url || null,
    };
  })
);

// Get owners for all products
const allProductOwnerIds = [...new Set(productsWithDetails.map(p => p.user_id))];
const allProductOwners = await Promise.all(allProductOwnerIds.map(id => getUserById(id)));
const allOwnersMap = new Map(allProductOwners.filter(o => o).map(o => [o!.id, o]));

// Get popular tags for filtering (show top 10 product tags)
const allTags = await getAllTags();
const productTags = allTags
  .filter(tag => tag.productCount > 0)
  .slice(0, 10);
---

<Layout title="Browse Products - Game Loopers">
  <div class="page">
    <div class="page__container">
      <div class="page-header--with-action">
        <PageHeader
          title="Products"
          description="Discover tabletop games from the community"
        />
        {currentUser && (
          <FormSubmitButton
            client:load
            action="/api/products/create-product"
            method="post"
            variant="primary"
            size="lg"
          >
            Create Product
          </FormSubmitButton>
        )}
      </div>

      <!-- Search Form -->
      <form method="get" action="/products" class="browse-search">
        <div class="browse-search__wrapper">
          <input
            type="text"
            name="search"
            value={searchQuery}
            placeholder="Search products..."
            class="browse-search__input"
            aria-label="Search products"
          />
          <button type="submit" class="browse-search__btn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="11" cy="11" r="8" />
              <line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
            <span>Search</span>
          </button>
        </div>
        {(searchQuery || tagFilter) && (
          <a href="/products" class="browse-search__clear">Clear filters</a>
        )}
      </form>

      <!-- Tag Filters -->
      {productTags.length > 0 && (
        <div class="browse-tags">
          <span class="browse-tags__label">Filter by tag:</span>
          <div class="browse-tags__list">
            {productTags.map((tag) => (
              <a
                href={tagFilter === tag.value
                  ? `/products${searchQuery ? `?search=${encodeURIComponent(searchQuery)}` : ''}`
                  : `/products?tag=${encodeURIComponent(tag.value)}${searchQuery ? `&search=${encodeURIComponent(searchQuery)}` : ''}`
                }
                class:list={[
                  "browse-tags__tag",
                  { "browse-tags__tag--active": tagFilter === tag.value }
                ]}
              >
                {tag.value}
                <span class="browse-tags__count">({tag.productCount})</span>
              </a>
            ))}
          </div>
        </div>
      )}

      {!currentUser && (
        <Card>
          <CardContent>
            <BrowseCTA message="Sign in to create and sell your tabletop games" />
          </CardContent>
        </Card>
      )}

      <!-- All Products Section -->
      {productsWithDetails.length > 0 ? (
        <section class="browse-section">
          <div class="browse-grid">
            {productsWithDetails.map((product) => {
              const owner = allOwnersMap.get(product.user_id);
              return (
                <a href={`/products/${product.handle}`} class="product-card">
                  <div class="product-card__image">
                    <img
                      src={product.cover_image_url || 'https://placehold.co/600x600'}
                      alt={product.title}
                      loading="lazy"
                    />
                  </div>
                  <div class="product-card__content">
                    <h3 class="product-card__title">{product.title}</h3>
                    <p class="product-card__creator">
                      by {owner?.name || owner?.handle || 'Unknown'}
                    </p>
                    {product.description && (
                      <p class="product-card__description">
                        {product.description}
                      </p>
                    )}
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      ) : productsWithDetails.length === 0 && (
        <Card>
          <CardContent>
            {searchQuery || tagFilter ? (
              <EmptyState
                icon="search"
                title="No products found"
                description="Try adjusting your search or clearing filters to see more results."
                actionText="Clear filters"
                actionHref="/products"
              />
            ) : currentUser ? (
              <div class="empty-state">
                <div class="empty-state__icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
                </div>
                <h3 class="empty-state__title">No products yet</h3>
                <p class="empty-state__description">Be the first to create a product and share it with the community.</p>
                <div class="empty-state__action">
                  <FormSubmitButton
                    client:load
                    action="/api/products/create-product"
                    method="post"
                    variant="primary"
                    size="lg"
                  >
                    Create Product
                  </FormSubmitButton>
                </div>
              </div>
            ) : (
              <EmptyState
                icon="products"
                title="No products yet"
                description="Be the first to create a product and share it with the community."
                actionText="Sign in to create"
                actionHref="/sign-in"
              />
            )}
          </CardContent>
        </Card>
      )}

      {productsWithDetails.length === limit && (
        <div class="browse-pagination">
          {page > 1 && (
            <a href={`/products?page=${page - 1}${searchQuery ? `&search=${encodeURIComponent(searchQuery)}` : ''}${tagFilter ? `&tag=${encodeURIComponent(tagFilter)}` : ''}`}
               class="browse-pagination__link">← Previous</a>
          )}
          <span class="browse-pagination__current">Page {page}</span>
          <a href={`/products?page=${page + 1}${searchQuery ? `&search=${encodeURIComponent(searchQuery)}` : ''}${tagFilter ? `&tag=${encodeURIComponent(tagFilter)}` : ''}`}
             class="browse-pagination__link">Next →</a>
        </div>
      )}
    </div>
  </div>
</Layout>

