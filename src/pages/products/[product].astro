---
import Layout from "@/layouts/Layout.astro";
import Badge from "@/components/Badge.astro";
import Button from "@/components/Button.astro";
import Tag from "@/components/Tag.astro";
import TagList from "@/components/TagList.astro";
import { ProductBasicInfoForm, ProductStatusEditor, ProductTagsForm, ProductImagesForm, ProductFilesForm, ProductChat, ProductEmbeddedProducts, ProductPriceBreakdown } from "@/components/products";
import { getProductByHandle, getProductTags, getProductImages, getProductFiles, getProductContributors } from "@/lib/data-access/products";
import { getUserById } from "@/lib/data-access/users";
import { setSession } from "@/lib/auth";
import { getJamById, getJamProductReviews } from "@/lib/data-access/jams";
import { serverClient } from "@/lib/data-access/client";
import type {  JamProductReview } from "@/types";
import Card from "@/components/Card.astro";
import CardHeader from "@/components/CardHeader.astro";
import CardTitle from "@/components/CardTitle.astro";
import CardDescription from "@/components/CardDescription.astro";
import CardContent from "@/components/CardContent.astro";
import CardFooter from "@/components/CardFooter.astro";
import GalleryGrid from "@/components/GalleryGrid.astro";
import ProductReviewList from "@/components/products/ProductReviewList.astro";
import { EditableBreadcrumb } from "@/components/interactive";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Avatar from "@/components/users/Avatar.astro";

const { product } = Astro.params;

if (!product) {
  return Astro.redirect('/404');
}

const productData = await getProductByHandle(product);

if (!productData) {
  return Astro.redirect('/404');
}

const owner = await getUserById(productData.user_id);
const tags = await getProductTags(productData.id);
const productImages = await getProductImages(productData.id);
const productFiles = await getProductFiles(productData.id);
const coverImage = productImages[0]?.file_url || null;

let currentUser = null;
const accessToken = Astro.cookies.get("sb-access-token");
const refreshToken = Astro.cookies.get("sb-refresh-token");

if (accessToken && refreshToken) {
  try {
    const session = await setSession({
      refresh_token: refreshToken.value,
      access_token: accessToken.value,
    });
    if (!session.error && session.data.user) {
      currentUser = session.data.user;
    }
  } catch (error) {}
}

const isOwner = currentUser?.id === productData.user_id;

// Get product contributors (users with royalties on attached assets)
const productContributors = await getProductContributors(productData.id);
const contributorIds = productContributors.map(c => c.id);
const isContributor = currentUser ? contributorIds.includes(currentUser.id) || isOwner : false;

if (productData.status !== 'public' && !isOwner) {
  return Astro.redirect('/404');
}

// Check if user is in edit mode
const isEditMode = isOwner;

// Check for jam submission flow
const urlParams = new URL(Astro.request.url).searchParams;
const jamId = urlParams.get('jam');
let targetJam = null;
let userReview: JamProductReview | null = null;
let isProductInJam = false;
let allJamReviews: JamProductReview[] = [];

if (jamId) {
  targetJam = await getJamById(jamId);

  // Check if product is already in the jam
  if (targetJam) {
    const { data: existingSubmission } = await serverClient
      .from("jam_products")
      .select("*")
      .eq("jam_id", jamId)
      .eq("product_id", productData.id)
      .eq("deleted", false)
      .single();

    isProductInJam = !!existingSubmission;
  }

  // Get jam reviews
  if (targetJam) {
    // Get all reviews for this product in this jam
    allJamReviews = await getJamProductReviews(jamId, productData.id);

    // Get user's existing review if they're logged in and not the owner
    if (currentUser && !isOwner) {
      userReview = allJamReviews.find(r => r.user_id === currentUser.id) ?? null;
    }
  }
}

---

<Layout title={`${productData.title} - Game Loopers`}>
  <div class="page">
    <div class="page__container">
      <!-- Jam Context Banner (minimal, at top) -->
      {targetJam && currentUser && !isOwner && isProductInJam && (
        <div class="jam-context-banner">
          <div class="jam-context-banner__content">
            <span class="jam-context-banner__emoji">🎮</span>
            <div class="jam-context-banner__text">
              <strong>Game Jam Review:</strong> You're reviewing this product for <strong>{targetJam.title}</strong>
            </div>
          </div>
        </div>
      )}

      <!-- Breadcrumb Navigation -->
      {isEditMode ? (
        <EditableBreadcrumb
          client:load
          entityId={productData.id}
          entityType="product"
          currentTitle={productData.title}
          breadcrumbItems={[
            { label: "Home", href: "/" },
            { label: "Products", href: "/products" },
          ]}
        />
      ) : (
        <Breadcrumb
          items={[
            { label: "Home", href: "/" },
            { label: "Products", href: "/products" },
          ]}
          currentPage={productData.title}
        />
      )}

      <!-- Hero Section -->
      <div
        class="product-hero"
        style={coverImage ? `background-image: url('${coverImage}')` : ''}
      >
        {coverImage && <div class="product-hero__overlay"></div>}

        <div class="product-hero__content">
          <div class="product-hero__title-group">
            <h1 class="product-hero__title">{productData.title}</h1>
            <div class="product-hero__meta">
              <span class="product-hero__author">
                by <a href={`/users/${owner?.handle}`} class="product-hero__author-link">
                  {owner?.name || owner?.handle || 'Unknown'}
                </a>
              </span>
              <span class="product-hero__divider">•</span>
              <Badge variant={productData.status as 'draft' | 'public' | 'archived'} size="sm">
                {productData.status}
              </Badge>
              {isOwner && (
                <>
                  <span class="product-hero__divider">•</span>
                  <Badge variant="primary" size="sm">
                    Owner • Changes auto-save
                  </Badge>
                </>
              )}
            </div>
          </div>

          {productData.description && (
            <div class="product-hero__description">
              <p>{productData.description}</p>
            </div>
          )}

          {tags.length > 0 && (
            <TagList className="product-hero__tags">
              {tags.map((tag) => <Tag>{tag.value}</Tag>)}
            </TagList>
          )}
        </div>
      </div>

      <div class="page-columns">
        <div class="page-columns__column">
          <!-- Description Section -->
          {!isEditMode && productData.description && (
            <Card>
              <CardHeader>
                <CardTitle>About This Product</CardTitle>
              </CardHeader>
              <CardContent>
                <p class="product-about-text">{productData.description}</p>
              </CardContent>
            </Card>
          )}

          {isEditMode && (
            <Card>
              <CardHeader>
                <CardTitle>About This Product</CardTitle>
                <CardDescription>Edit your product description</CardDescription>
              </CardHeader>
              <CardContent>
                <ProductBasicInfoForm
                  client:load
                  productId={productData.id}
                  initialData={{
                    title: productData.title,
                    description: productData.description,
                  }}
                />
              </CardContent>
            </Card>
          )}

          <!-- Images Section -->
          {(isEditMode || productImages.length > 0) && (
            <Card>
              <CardHeader>
                <CardTitle>Product Images</CardTitle>
                <CardDescription>
                  {isEditMode
                    ? 'Upload and manage product images (up to 9). First image is the cover.'
                    : 'Preview images of the product'}
                </CardDescription>
              </CardHeader>
              <CardContent>
                {isEditMode && (
                  <ProductImagesForm
                    client:load
                    productId={productData.id}
                    existingImages={productImages}
                  />
                )}
                {!isEditMode && productImages.length > 0 && (
                  <GalleryGrid images={productImages.map(img => ({
                    url: img.file_url,
                    alt: img.title,
                    href: img.file_url
                  }))} cols={3}/>
                )}
              </CardContent>
            </Card>
          )}

          <!-- Files Section -->
          {(isEditMode || productFiles.length > 0) && (
            <Card>
              <CardHeader>
                <CardTitle>Product Files</CardTitle>
                <CardDescription>
                  {isEditMode
                    ? 'Upload downloadable files (PDFs, ZIPs, STLs, etc.). Purchasers will receive all files.'
                    : `${productFiles.length} file(s) included with purchase`}
                </CardDescription>
              </CardHeader>
              <CardContent>
                {isEditMode && (
                  <ProductFilesForm
                    client:load
                    productId={productData.id}
                    existingFiles={productFiles}
                  />
                )}
                {!isEditMode && productFiles.length > 0 && (
                  <div class="product-files-list">
                    {productFiles.map((file) => (
                      <div class="product-file-item">
                        <span class="product-file-icon">📁</span>
                        <div class="product-file-info">
                          <div class="product-file-name">{file.title}</div>
                          {file.description && (
                            <div class="product-file-description">{file.description}</div>
                          )}
                        </div>
                      </div>
                    ))}
                  </div>
                )}
              </CardContent>
            </Card>
          )}

          <!-- Embedded Products Section -->
          {isEditMode && currentUser && (
            <Card>
              <CardHeader>
                <CardTitle>Embedded Products</CardTitle>
                <CardDescription>
                  Add products from other creators. Their price will be inherited and added to your product's total price.
                </CardDescription>
              </CardHeader>
              <CardContent>
                <ProductEmbeddedProducts
                  client:load
                  productId={productData.id}
                  userId={currentUser.id}
                />
              </CardContent>
            </Card>
          )}

        <!-- Reviews Section (Jam Context) -->
        {!isEditMode && jamId && targetJam && isProductInJam && (
          <Card>
            <CardContent>
              <ProductReviewList
                reviews={allJamReviews}
                jam={targetJam}
                jamHandle={targetJam.handle}
                currentUserId={currentUser?.id}
              />
            </CardContent>
          </Card>
        )}
        </div>

        <!-- Sidebar Column -->
        <div class="page-columns__column">

        <!-- Price Breakdown Card -->
        <Card>
          <CardHeader>
            <CardTitle>Pricing</CardTitle>
            <CardDescription>Complete price breakdown</CardDescription>
          </CardHeader>
          <CardContent>
            <ProductPriceBreakdown
              client:load
              productId={productData.id}
            />
          </CardContent>
        </Card>

        {isContributor && currentUser && (
          <Card>
            <CardHeader>
              <CardTitle>Chat</CardTitle>
              <CardDescription>Discussion between product contributors</CardDescription>
            </CardHeader>
            <CardContent>
              <ProductChat
                client:visible
                userId={currentUser?.id}
                productId={productData.id}
              />
            </CardContent>
          </Card>
        )}

        {isEditMode && (
          <>
            <!-- Quick Actions Card (Edit Mode) -->
            <Card>
              <CardHeader>
                <CardTitle>Quick Actions</CardTitle>
                <CardDescription>Common product management tasks</CardDescription>
              </CardHeader>
              <CardContent>
                <div class="quick-actions">
                  <form action="/api/documents/create-document" method="POST" class="quick-actions__form">
                    <input type="hidden" name="relatedProductId" value={productData.id} />
                    <Button type="submit" variant="outline" size="md">
                      <span slot="text">📝 Create Related Document</span>
                    </Button>
                  </form>
                </div>
              </CardContent>
            </Card>

            <!-- Status Card (Edit Mode) -->
            <Card>
              <CardHeader>
                <CardTitle>Publish Status</CardTitle>
                <CardDescription>Control who can see this product</CardDescription>
              </CardHeader>
              <CardContent>
                <ProductStatusEditor
                  client:load
                  productId={productData.id}
                  currentStatus={productData.status}
                />
              </CardContent>
            </Card>

            <!-- Tags Card (Edit Mode) -->
            <Card>
              <CardHeader>
                <CardTitle>Tags</CardTitle>
                <CardDescription>Add tags to help users find your product</CardDescription>
              </CardHeader>
              <CardContent>
                <ProductTagsForm
                  client:load
                  productId={productData.id}
                  initialTags={tags.map(t => t.value)}
                />
              </CardContent>
            </Card>
          </>
        )}

        <!-- Creator Card -->
        <Card>
          <CardHeader>
            <CardTitle>Creator</CardTitle>
            <CardDescription>
              <div class="creator-card__header">
                <Avatar
                  src={owner?.avatar_url}
                  alt={owner?.name || owner?.handle || 'Creator'}
                  size="lg"
                />
                <div class="creator-card__info">
                  <h3 class="creator-card__name">{owner?.name || owner?.handle}</h3>
                  <p class="creator-card__handle">@{owner?.handle}</p>
                </div>
              </div>
            </CardDescription>
          </CardHeader>
          <CardContent>
              <p class="creator-card__bio">{owner?.bio}</p>
          </CardContent>
          <CardFooter>
              <a href={`/users/${owner?.handle}`} class="creator-card__link">
                <Button variant="outline" size="md">
                  <span slot="text">View Profile</span>
                </Button>
              </a>
          </CardFooter>
        </Card>

        <!-- Jam Review Form (for non-owners reviewing product in jam) -->
        {targetJam && currentUser && !isOwner && isProductInJam && (
          <Card>
            <CardHeader>
              <CardTitle>{userReview ? 'Update Your Review' : 'Write a Review'}</CardTitle>
              <CardDescription>
                Share your thoughts on this product for <strong>{targetJam.title}</strong>
              </CardDescription>
            </CardHeader>
            <CardContent>
              <form method="POST" action="/api/jams/add-review" class="jam-review-form">
                <input type="hidden" name="jam_id" value={targetJam.id} />
                <input type="hidden" name="product_id" value={productData.id} />

                <div class="jam-review-form__field">
                  <label for="rating" class="jam-review-form__label">Rating</label>
                  <select
                    id="rating"
                    name="rating"
                    class="jam-review-form__select"
                    required
                  >
                    <option value="">Select a rating</option>
                    <option value="5" selected={userReview?.review_rating === 5}>⭐⭐⭐⭐⭐ Exceptional</option>
                    <option value="4" selected={userReview?.review_rating === 4}>⭐⭐⭐⭐ Great</option>
                    <option value="3" selected={userReview?.review_rating === 3}>⭐⭐⭐ Good</option>
                    <option value="2" selected={userReview?.review_rating === 2}>⭐⭐ Fair</option>
                    <option value="1" selected={userReview?.review_rating === 1}>⭐ Needs Improvement</option>
                  </select>
                </div>

                <div class="jam-review-form__field">
                  <label for="review_text" class="jam-review-form__label">Your Review</label>
                  <textarea
                    id="review_text"
                    name="review_text"
                    class="jam-review-form__textarea"
                    rows="6"
                    placeholder="What did you think about this product? How well does it fit the jam theme?"
                    required
                  >{userReview?.review_text || ''}</textarea>
                </div>

                <Button type="submit" variant="primary" size="md">
                  <span slot="text">{userReview ? 'Update Review' : 'Submit Review'}</span>
                </Button>
              </form>
            </CardContent>
          </Card>
        )}

        <!-- Jam Submission Form (for owners submitting product to jam) -->
        {targetJam && isOwner && !isProductInJam && (
          <Card>
            <CardHeader>
              <CardTitle>Submit to {targetJam.title}</CardTitle>
              <CardDescription>
                Submit this product to compete in the game jam
              </CardDescription>
            </CardHeader>
            <CardContent>
              {productData.status !== 'public' && (
                <div class="jam-submit-warning">
                  <svg class="jam-submit-warning__icon" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M10 6V10M10 14H10.01M19 10C19 14.9706 14.9706 19 10 19C5.02944 19 1 14.9706 1 10C1 5.02944 5.02944 1 10 1C14.9706 1 19 5.02944 19 10Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  <p class="jam-submit-warning__text">
                    Your product must be published before you can submit it to a jam.
                    Change the status to "Public" first.
                  </p>
                </div>
              )}

              {productData.status === 'public' && (
                <form method="POST" action="/api/jams/add-product" class="jam-submit-form">
                  <input type="hidden" name="jam_id" value={targetJam.id} />
                  <input type="hidden" name="product_id" value={productData.id} />

                  <p class="jam-submit-form__description">
                    By submitting this product, you agree to participate in <strong>{targetJam.title}</strong>
                    and allow community members to review and rate your work.
                  </p>

                  <Button type="submit" variant="primary" size="md">
                    <span slot="text">Submit to Jam</span>
                  </Button>
                </form>
              )}
            </CardContent>
          </Card>
        )}
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  /* ===== Breadcrumb Navigation ===== */
  .breadcrumb {
    margin-bottom: var(--spacing-2xl);
  }

  .breadcrumb__list {
    display: flex;
    align-items: center;
    gap: var(--gap-sm);
    list-style: none;
    padding: 0;
    margin: 0;
    flex-wrap: wrap;
  }

  .breadcrumb__item {
    display: flex;
    align-items: center;
    gap: var(--gap-sm);
    font-size: var(--text-sm);
    color: var(--muted-foreground);
  }

  .breadcrumb__item:not(:last-child)::after {
    content: '/';
    color: var(--border);
    margin-left: var(--gap-sm);
  }

  .breadcrumb__link {
    color: var(--muted-foreground);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-in-out);
  }

  .breadcrumb__link:hover {
    color: var(--foreground);
    text-decoration: underline;
  }

  .breadcrumb__link:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  .breadcrumb__current {
    color: var(--foreground);
    font-weight: var(--font-weight-medium);
  }

  /* ===== Product Hero Section ===== */
  .product-hero {
    position: relative;
    min-height: 300px;
    background-color: var(--primary);
    background-size: cover;
    background-position: center;
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-bottom: var(--spacing-4xl);
  }

  .product-hero__overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.7));
    z-index: 0;
  }

  .product-hero__content {
    position: relative;
    z-index: 1;
    padding: var(--spacing-5xl) var(--spacing-4xl);
    display: flex;
    flex-direction: column;
    gap: var(--gap-lg);
  }

  .product-hero__mode-toggle {
    position: absolute;
    top: var(--spacing-2xl);
    right: var(--spacing-2xl);
    z-index: 10;
    display: flex;
    align-items: center;
    gap: var(--gap-md);
    padding: var(--spacing-md) var(--spacing-lg);
    background-color: oklch(from var(--background) l c h / 0.95);
    backdrop-filter: blur(8px);
    border-radius: var(--radius-full);
    border: var(--border-width-default) solid var(--border);
    box-shadow: var(--shadow-lg);
  }

  .mode-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-xs);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: var(--spacing-xs) var(--spacing-md);
    border-radius: var(--radius-full);
  }

  .mode-badge--edit {
    background-color: oklch(from var(--primary) l c h / 0.1);
    color: var(--primary);
  }

  .mode-badge--preview {
    background-color: oklch(from var(--accent) l c h / 0.1);
    color: var(--accent);
  }

  .product-hero__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--gap-xl);
    margin-bottom: var(--spacing-2xl);
  }

  .product-hero__title-group {
    flex: 1;
    min-width: 0;
  }

  .product-hero__title {
    margin: 0 0 var(--spacing-md) 0;
    font-size: var(--text-4xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-white);
    line-height: var(--leading-tight);
    text-shadow: var(--text-shadow-md);
  }

  .product-hero__meta {
    display: flex;
    align-items: center;
    gap: var(--gap-lg);
    flex-wrap: wrap;
  }

  .product-hero__author {
    font-size: var(--text-base);
    color: rgba(255, 255, 255, 0.9);
  }

  .product-hero__author-link {
    color: var(--color-white);
    text-decoration: none;
    font-weight: var(--font-weight-semibold);
    border-bottom: 1px solid rgba(255, 255, 255, 0.5);
  }

  .product-hero__author-link:hover {
    border-bottom-color: var(--color-white);
  }

  .product-hero__divider {
    color: rgba(255, 255, 255, 0.7);
  }

  .product-hero__actions {
    display: flex;
    gap: var(--gap-md);
    flex-shrink: 0;
  }

  .product-hero__description {
    margin-bottom: var(--spacing-xl);
  }

  .product-hero__description p {
    margin: 0;
    font-size: var(--text-lg);
    color: rgba(255, 255, 255, 0.95);
    line-height: var(--leading-relaxed);
    text-shadow: var(--text-shadow-sm);
  }

  .product-hero__tags {
    margin-top: var(--spacing-xl);
  }

  /* ===== Product About Text ===== */
  .product-about-text {
    margin: 0;
    font-size: var(--text-base);
    color: var(--foreground);
    line-height: var(--leading-relaxed);
  }

  /* ===== Product Variants ===== */
  .product-variants__list {
    display: flex;
    flex-direction: column;
    gap: var(--gap-2xl);
  }

  .variant-item {
    padding: var(--spacing-2xl);
    background-color: var(--muted);
    border-radius: var(--radius-md);
    border: var(--border-width-default) solid var(--border);
  }

  .variant-item__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--gap-lg);
    margin-bottom: var(--spacing-lg);
  }

  .variant-item__title-group {
    display: flex;
    align-items: center;
    gap: var(--gap-md);
    flex-wrap: wrap;
  }

  .variant-item__title {
    margin: 0;
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-semibold);
    color: var(--foreground);
  }

  .variant-item__name {
    margin: 0;
    font-size: var(--text-xl);
    font-weight: var(--font-weight-semibold);
    color: var(--foreground);
  }

  .variant-item__sku {
    font-size: var(--text-sm);
    color: var(--muted-foreground);
  }

  .variant-item__sku code {
    background-color: var(--background);
    padding: var(--spacing-xs) var(--spacing-sm);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
  }

  .variant-item__description {
    margin: 0 0 var(--spacing-lg) 0;
    font-size: var(--text-base);
    color: var(--muted-foreground);
    line-height: var(--leading-relaxed);
  }

  .variant-item__assets {
    margin: var(--spacing-xl) 0;
    padding: var(--spacing-2xl);
    background-color: oklch(from var(--primary) l c h / 0.03);
    border-radius: var(--radius-lg);
    border: var(--border-width-default) solid var(--primary);
  }

  .variant-item__assets-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--spacing-xl);
    padding-bottom: var(--spacing-md);
    border-bottom: 1px solid var(--border);
  }

  .variant-item__assets-title {
    margin: 0;
    font-size: var(--text-lg);
