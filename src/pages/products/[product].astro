---
import Layout from "@/layouts/Layout.astro";
import Badge from "@/components/Badge.astro";
import Button from "@/components/Button.astro";
import Tag from "@/components/Tag.astro";
import TagList from "@/components/TagList.astro";
import AddToCartButton from "@/components/islands/AddToCartButton";
import ProductDeleteButton from "@/components/islands/ProductDeleteButton";
import PricingBreakdown from "@/components/islands/PricingBreakdown";
import ProductBasicInfoForm from "@/components/islands/ProductBasicInfoForm";
import ProductStatusEditor from "@/components/islands/ProductStatusEditor";
import ProductTagsForm from "@/components/islands/ProductTagsForm";
import ProductImagesForm from "@/components/islands/ProductImagesForm";
import { getProductByHandle, getProductTags, getProductVariants, getVariantPrices, getProductImages } from "@/lib/data-access/products";
import { getUserById } from "@/lib/data-access/users";
import { setSession } from "@/lib/auth";
import Card from "@/components/Card.astro";
import CardHeader from "@/components/CardHeader.astro";
import CardTitle from "@/components/CardTitle.astro";
import CardDescription from "@/components/CardDescription.astro";
import CardContent from "@/components/CardContent.astro";
import CardFooter from "@/components/CardFooter.astro";

const { product } = Astro.params;

if (!product) {
  return Astro.redirect('/404');
}

const productData = await getProductByHandle(product);

if (!productData) {
  return Astro.redirect('/404');
}

const owner = await getUserById(productData.user_id);
const tags = await getProductTags(productData.id);
const variants = await getProductVariants(productData.id);
const productImages = await getProductImages(productData.id);
const coverImage = productImages[0]?.file_url || null;

const variantsWithPrices = await Promise.all(
  variants.map(async (variant) => {
    const prices = await getVariantPrices(variant.id);
    return { ...variant, prices };
  })
);

let currentUser = null;
const accessToken = Astro.cookies.get("sb-access-token");
const refreshToken = Astro.cookies.get("sb-refresh-token");

if (accessToken && refreshToken) {
  try {
    const session = await setSession({
      refresh_token: refreshToken.value,
      access_token: accessToken.value,
    });
    if (!session.error && session.data.user) {
      currentUser = session.data.user;
    }
  } catch (error) {}
}

const isOwner = currentUser?.id === productData.user_id;

if (productData.status !== 'published' && !isOwner) {
  return Astro.redirect('/404');
}

// Check if user is in edit mode
const urlParams = new URL(Astro.request.url).searchParams;
const mode = urlParams.get('mode');
const isEditMode = isOwner && mode !== 'preview';

// Get first variant with pricing for display
const defaultVariant = variantsWithPrices.find(v => v.prices && v.prices.length > 0) || variantsWithPrices[0];
const defaultPrice = defaultVariant?.prices?.[0];
---

<Layout title={`${productData.title} - Game Loopers`}>
  <div class="page">
    <div class="page__container">
      <!-- Breadcrumb Navigation -->
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol class="breadcrumb__list">
          <li class="breadcrumb__item">
            <a href="/" class="breadcrumb__link">Home</a>
          </li>
          <li class="breadcrumb__item">
            <a href="/products" class="breadcrumb__link">Products</a>
          </li>
          <li class="breadcrumb__item breadcrumb__item--current">
            <span class="breadcrumb__current">{productData.title}</span>
          </li>
        </ol>
      </nav>

      <!-- Hero Section -->
      <div
        class="product-hero"
        style={coverImage ? `background-image: url('${coverImage}')` : ''}
      >
        {coverImage && <div class="product-hero__overlay"></div>}

        {isOwner && (
          <div class="product-hero__mode-toggle">
            <span class={`mode-badge mode-badge--${isEditMode ? 'edit' : 'preview'}`}>
              {isEditMode ? '✏️ Edit Mode' : '👁️ Preview Mode'}
            </span>
            <a href={`/products/${productData.handle}${isEditMode ? '?mode=preview' : ''}`}>
              <Button variant="ghost" size="sm">
                <span slot="text">Switch to {isEditMode ? 'Preview' : 'Edit'}</span>
              </Button>
            </a>
          </div>
        )}

        <div class="product-hero__content">
          <div class="product-hero__title-group">
            <h1 class="product-hero__title">{productData.title}</h1>
            <div class="product-hero__meta">
              <span class="product-hero__author">
                by <a href={`/users/${owner?.handle}`} class="product-hero__author-link">
                  {owner?.name || owner?.handle || 'Unknown'}
                </a>
              </span>
              <span class="product-hero__divider">•</span>
              <Badge variant={productData.status as 'draft' | 'published' | 'archived'} size="sm">
                {productData.status}
              </Badge>
            </div>
          </div>

          {productData.description && (
            <div class="product-hero__description">
              <p>{productData.description}</p>
            </div>
          )}

          {tags.length > 0 && (
            <TagList className="product-hero__tags">
              {tags.map((tag) => <Tag>{tag.value}</Tag>)}
            </TagList>
          )}
        </div>
      </div>

      <div class="page-columns">
        <div class="page-columns__column">
          <!-- Description Section -->
          {!isEditMode && productData.description && (
            <Card>
              <CardHeader>
                <CardTitle>About This Product</CardTitle>
              </CardHeader>
              <CardContent>
                <p class="product-about-text">{productData.description}</p>
              </CardContent>
            </Card>
          )}

          {isEditMode && (
            <Card>
              <CardHeader>
                <CardTitle>About This Product</CardTitle>
                <CardDescription>Edit your product description</CardDescription>
              </CardHeader>
              <CardContent>
                <ProductBasicInfoForm
                  client:load
                  productId={productData.id}
                  initialData={{
                    title: productData.title,
                    description: productData.description,
                  }}
                />
              </CardContent>
            </Card>
          )}

          <!-- Variants Section -->
        <Card>
          <CardHeader>
            <CardTitle>Product Variants</CardTitle>
            <CardDescription>
              {variantsWithPrices.length > 0
                ? `Manage ${variantsWithPrices.length} variant${variantsWithPrices.length === 1 ? '' : 's'}`
                : 'Add variants to define different options for this product'}
            </CardDescription>
          </CardHeader>
          <CardContent>
            {variantsWithPrices.length > 0 ? (
              <div class="product-variants__list">
              {variantsWithPrices.map((variant) => (
                <div class="variant-item">
                  <div class="variant-item__header">
                    <div class="variant-item__title-group">
                      <h3 class="variant-item__name">{variant.title}</h3>
                      <Badge
                        variant={variant.is_digital ? 'primary' : 'secondary'}
                        size="sm"
                      >
                        {variant.is_digital ? 'Digital' : 'Physical'}
                      </Badge>
                    </div>
                    {variant.sku && (
                      <span class="variant-item__sku">SKU: <code>{variant.sku}</code></span>
                    )}
                  </div>

                  {variant.description && (
                    <p class="variant-item__description">{variant.description}</p>
                  )}

                  {variant.prices && variant.prices.length > 0 ? (
                    <div class="variant-item__pricing">
                      <div class="variant-item__price-list">
                        {variant.prices.map((price) => (
                          <div class="variant-item__price">
                            <span class="variant-item__price-amount">
                              {price.unit_amount === 0
                                ? 'FREE'
                                : `${price.currency.toUpperCase()} ${(price.unit_amount / 100).toFixed(2)}`}
                            </span>
                            {(price.min_quantity > 1 || price.max_quantity) && (
                              <span class="variant-item__price-quantity">
                                {price.min_quantity > 1 && `${price.min_quantity}+ units`}
                                {price.max_quantity && ` (max ${price.max_quantity})`}
                              </span>
                            )}
                          </div>
                        ))}
                      </div>

                      <div class="variant-item__actions">
                        {!isOwner && currentUser && (
                          <AddToCartButton
                            client:load
                            productId={productData.id}
                            variantId={variant.id}
                            quantity={1}
                            variant="primary"
                            size="md"
                          />
                        )}
                        {!isOwner && !currentUser && (
                          <a href={`/sign-in?redirect=/products/${product}`}>
                            <Button variant="primary" size="md">
                              <span slot="text">Sign In to Purchase</span>
                            </Button>
                          </a>
                        )}
                      </div>
                    </div>
                  ) : (
                    isOwner && (
                      <p class="variant-item__no-price">No pricing configured for this variant</p>
                    )
                  )}

                  {isOwner && variant.prices && variant.prices.length > 0 && (
                    <div class="variant-item__breakdown">
                      <PricingBreakdown
                        client:load
                        variantId={variant.id}
                        variantTitle={variant.title}
                      />
                    </div>
                  )}
                </div>
              ))}
              </div>
            ) : (
              <div class="product-empty">
                <div class="product-empty__icon">📦</div>
                <p class="product-empty__text">
                  {isOwner
                    ? "No variants added yet. Variants let you offer different options (digital/physical) and pricing tiers."
                    : "This product doesn't have any variants available yet."}
                </p>
                {isOwner && (
                  <p class="product-empty__help">
                    Variants contain the actual downloadable assets or physical items that customers receive.
                  </p>
                )}
              </div>
            )}
          </CardContent>
          {isOwner && (
            <CardFooter>
              <div class="product-variants__actions">
                <p class="product-variants__note">
                  <strong>Note:</strong> Variant management coming soon. For now, variants are created through the API.
                </p>
              </div>
            </CardFooter>
          )}
        </Card>
        </div>

        <!-- Sidebar Column -->
        <div class="page-columns__column">
        {!isEditMode && variantsWithPrices.length > 0 && (
          <div class="sidebar-card sidebar-card--sticky">
            <div class="sidebar-card__stats">
              <div class="stat">
                <p class="stat__value">{variantsWithPrices.length}</p>
                <p class="stat__label">{variantsWithPrices.length === 1 ? 'Variant' : 'Variants'}</p>
              </div>
              <div class="stat">
                <p class="stat__value">
                  {variantsWithPrices.filter(v => v.is_digital).length}
                </p>
                <p class="stat__label">Digital</p>
              </div>
              <div class="stat">
                <p class="stat__value">
                  {variantsWithPrices.filter(v => !v.is_digital).length}
                </p>
                <p class="stat__label">Physical</p>
              </div>
            </div>

            {defaultPrice && (
              <div class="sidebar-card__price">
                <p class="sidebar-card__price-label">Starting at</p>
                <p class="sidebar-card__price-value">
                  {defaultPrice.unit_amount === 0
                    ? 'FREE'
                    : `${defaultPrice.currency.toUpperCase()} ${(defaultPrice.unit_amount / 100).toFixed(2)}`}
                </p>
              </div>
            )}

            {!isOwner && defaultVariant && (
              <div class="sidebar-card__cta">
                {currentUser ? (
                  <AddToCartButton
                    client:load
                    productId={productData.id}
                    variantId={defaultVariant.id}
                    quantity={1}
                    variant="primary"
                    size="lg"
                  />
                ) : (
                  <a href={`/sign-in?redirect=/products/${product}`} class="sidebar-card__cta-link">
                    <Button variant="primary" size="lg">
                      <span slot="text">Sign In to Purchase</span>
                    </Button>
                  </a>
                )}
              </div>
            )}

            {isOwner && (
              <div class="sidebar-card__owner">
                <p class="sidebar-card__owner-text">You own this product</p>
                <a href={`/products/${product}?mode=edit`} class="sidebar-card__owner-link">
                  <Button variant="outline" size="md">
                    <span slot="text">Edit Product</span>
                  </Button>
                </a>
              </div>
            )}
          </div>
        )}

        {isEditMode && (
          <>
            <!-- Status Card (Edit Mode) -->
            <Card>
              <CardHeader>
                <CardTitle>Publish Status</CardTitle>
                <CardDescription>Control who can see this product</CardDescription>
              </CardHeader>
              <CardContent>
                <ProductStatusEditor
                  client:load
                  productId={productData.id}
                  currentStatus={productData.status}
                  hasVariants={variantsWithPrices.length > 0}
                />
              </CardContent>
            </Card>

            <!-- Tags Card (Edit Mode) -->
            <Card>
              <CardHeader>
                <CardTitle>Tags</CardTitle>
                <CardDescription>Add tags to help users find your product</CardDescription>
              </CardHeader>
              <CardContent>
                <ProductTagsForm
                  client:load
                  productId={productData.id}
                  initialTags={tags.map(t => t.value)}
                />
              </CardContent>
            </Card>

            <!-- Images Card (Edit Mode) -->
            <Card>
              <CardHeader>
                <CardTitle>Cover Image</CardTitle>
                <CardDescription>Upload a cover image for your product</CardDescription>
              </CardHeader>
              <CardContent>
                <ProductImagesForm
                  client:load
                  productId={productData.id}
                  currentCoverImage={coverImage}
                />
              </CardContent>
            </Card>
          </>
        )}

        <!-- Creator Card -->
        <Card>
          <CardHeader>
            <CardTitle>Creator</CardTitle>
            <CardDescription>
              <div class="creator-card__avatar">
                {owner?.name ? owner.name[0].toUpperCase() : owner?.handle[0].toUpperCase()}
              </div>
              <div class="creator-card__info">
                <h3 class="creator-card__name">{owner?.name || owner?.handle}</h3>
                <p class="creator-card__handle">@{owner?.handle}</p>
              </div>
            </CardDescription>
          </CardHeader>
          <CardContent>
              <p class="creator-card__bio">{owner?.bio}</p>
          </CardContent>
          <CardFooter>
              <a href={`/users/${owner?.handle}`} class="creator-card__link">
                <Button variant="outline" size="md">
                  <span slot="text">View Profile</span>
                </Button>
              </a>
          </CardFooter>
        </Card>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  /* ===== Breadcrumb Navigation ===== */
  .breadcrumb {
    margin-bottom: var(--spacing-2xl);
  }

  .breadcrumb__list {
    display: flex;
    align-items: center;
    gap: var(--gap-sm);
    list-style: none;
    padding: 0;
    margin: 0;
    flex-wrap: wrap;
  }

  .breadcrumb__item {
    display: flex;
    align-items: center;
    gap: var(--gap-sm);
    font-size: var(--text-sm);
    color: var(--muted-foreground);
  }

  .breadcrumb__item:not(:last-child)::after {
    content: '/';
    color: var(--border);
    margin-left: var(--gap-sm);
  }

  .breadcrumb__link {
    color: var(--muted-foreground);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-in-out);
  }

  .breadcrumb__link:hover {
    color: var(--foreground);
    text-decoration: underline;
  }

  .breadcrumb__link:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  .breadcrumb__current {
    color: var(--foreground);
    font-weight: var(--font-weight-medium);
  }

  /* ===== Product Hero Section ===== */
  .product-hero {
    position: relative;
    min-height: 300px;
    background-color: var(--primary);
    background-size: cover;
    background-position: center;
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-bottom: var(--spacing-4xl);
  }

  .product-hero__overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.7));
    z-index: 0;
  }

  .product-hero__content {
    position: relative;
    z-index: 1;
    padding: var(--spacing-5xl) var(--spacing-4xl);
    display: flex;
    flex-direction: column;
    gap: var(--gap-lg);
  }

  .product-hero__mode-toggle {
    position: absolute;
    top: var(--spacing-2xl);
    right: var(--spacing-2xl);
    z-index: 10;
    display: flex;
    align-items: center;
    gap: var(--gap-md);
    padding: var(--spacing-md) var(--spacing-lg);
    background-color: oklch(from var(--background) l c h / 0.95);
    backdrop-filter: blur(8px);
    border-radius: var(--radius-full);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-lg);
  }

  .mode-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-xs);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: var(--spacing-xs) var(--spacing-md);
    border-radius: var(--radius-full);
  }

  .mode-badge--edit {
    background-color: oklch(from var(--primary) l c h / 0.1);
    color: var(--primary);
  }

  .mode-badge--preview {
    background-color: oklch(from var(--accent) l c h / 0.1);
    color: var(--accent);
  }

  .product-hero__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--gap-xl);
    margin-bottom: var(--spacing-2xl);
  }

  .product-hero__title-group {
    flex: 1;
    min-width: 0;
  }

  .product-hero__title {
    margin: 0 0 var(--spacing-md) 0;
    font-size: var(--text-4xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-white);
    line-height: var(--leading-tight);
    text-shadow: var(--text-shadow-md);
  }

  .product-hero__meta {
    display: flex;
    align-items: center;
    gap: var(--gap-lg);
    flex-wrap: wrap;
  }

  .product-hero__author {
    font-size: var(--text-base);
    color: rgba(255, 255, 255, 0.9);
  }

  .product-hero__author-link {
    color: var(--color-white);
    text-decoration: none;
    font-weight: var(--font-weight-semibold);
    border-bottom: 1px solid rgba(255, 255, 255, 0.5);
  }

  .product-hero__author-link:hover {
    border-bottom-color: var(--color-white);
  }

  .product-hero__divider {
    color: rgba(255, 255, 255, 0.7);
  }

  .product-hero__actions {
    display: flex;
    gap: var(--gap-md);
    flex-shrink: 0;
  }

  .product-hero__description {
    margin-bottom: var(--spacing-xl);
  }

  .product-hero__description p {
    margin: 0;
    font-size: var(--text-lg);
    color: rgba(255, 255, 255, 0.95);
    line-height: var(--leading-relaxed);
    text-shadow: var(--text-shadow-sm);
  }

  .product-hero__tags {
    margin-top: var(--spacing-xl);
  }

  /* ===== Product About Text ===== */
  .product-about-text {
    margin: 0;
    font-size: var(--text-base);
    color: var(--foreground);
    line-height: var(--leading-relaxed);
  }

  /* ===== Product Variants ===== */
  .product-variants__list {
    display: flex;
    flex-direction: column;
    gap: var(--gap-2xl);
  }

  .variant-item {
    padding: var(--spacing-2xl);
    background-color: var(--muted);
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
  }

  .variant-item__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--gap-lg);
    margin-bottom: var(--spacing-lg);
  }

  .variant-item__title-group {
    display: flex;
    align-items: center;
    gap: var(--gap-md);
    flex-wrap: wrap;
  }

  .variant-item__name {
    margin: 0;
    font-size: var(--text-xl);
    font-weight: var(--font-weight-semibold);
    color: var(--foreground);
  }

  .variant-item__sku {
    font-size: var(--text-sm);
    color: var(--muted-foreground);
  }

  .variant-item__sku code {
    background-color: var(--background);
    padding: var(--spacing-xs) var(--spacing-sm);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
  }

  .variant-item__description {
    margin: 0 0 var(--spacing-lg) 0;
    font-size: var(--text-base);
    color: var(--muted-foreground);
    line-height: var(--leading-relaxed);
  }

  .variant-item__pricing {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xl);
  }

  .variant-item__price-list {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
  }

  .variant-item__price {
    display: flex;
    align-items: baseline;
    gap: var(--gap-md);
  }

  .variant-item__price-amount {
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-bold);
    color: var(--foreground);
  }

  .variant-item__price-quantity {
    font-size: var(--text-sm);
    color: var(--muted-foreground);
  }

  .variant-item__actions {
    display: flex;
    gap: var(--gap-md);
  }

  .variant-item__no-price {
    margin: 0;
    padding: var(--spacing-lg);
    background-color: var(--background);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    color: var(--muted-foreground);
    text-align: center;
  }

  .variant-item__breakdown {
    margin-top: var(--spacing-lg);
  }

  /* ===== Product Empty State ===== */
  .product-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--gap-xl);
    padding: var(--spacing-5xl) var(--spacing-2xl);
    text-align: center;
  }

  .product-empty__icon {
    font-size: var(--text-5xl);
  }

  .product-empty__text {
    margin: 0;
    font-size: var(--text-lg);
    color: var(--muted-foreground);
    max-width: 40ch;
  }

  /* ===== Sidebar Card ===== */
  .sidebar-card {
    position: sticky;
    top: var(--spacing-2xl);
    padding: var(--spacing-2xl);
    background-color: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .sidebar-card__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--gap-lg);
    padding-bottom: var(--spacing-2xl);
    margin-bottom: var(--spacing-2xl);
    border-bottom: 1px solid var(--border);
  }

  .stat {
    text-align: center;
  }

  .stat__value {
    margin: 0 0 var(--spacing-xs) 0;
    font-size: var(--text-3xl);
    font-weight: var(--font-weight-bold);
    color: var(--foreground);
  }

  .stat__label {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--muted-foreground);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .sidebar-card__price {
    padding-bottom: var(--spacing-2xl);
    margin-bottom: var(--spacing-2xl);
    border-bottom: 1px solid var(--border);
    text-align: center;
  }

  .sidebar-card__price-label {
    margin: 0 0 var(--spacing-xs) 0;
    font-size: var(--text-sm);
    color: var(--muted-foreground);
  }

  .sidebar-card__price-value {
    margin: 0;
    font-size: var(--text-4xl);
    font-weight: var(--font-weight-bold);
    color: var(--foreground);
  }

  .sidebar-card__cta {
    display: flex;
