---
import Layout from "@/layouts/Layout.astro";
import Badge from "@/components/Badge.astro";
import Button from "@/components/Button.astro";
import Tag from "@/components/Tag.astro";
import TagList from "@/components/TagList.astro";
import AddToCartButton from "@/components/islands/AddToCartButton";
import ProductBasicInfoForm from "@/components/islands/ProductBasicInfoForm";
import ProductStatusEditor from "@/components/islands/ProductStatusEditor";
import ProductTagsForm from "@/components/islands/ProductTagsForm";
import ProductImagesForm from "@/components/islands/ProductImagesForm";
import ProductChat from "@/components/islands/ProductChat";
import ProductVariantManager from "@/components/islands/ProductVariantManager";
import ProductVariantEditor from "@/components/islands/ProductVariantEditor";
import ProductPriceManager from "@/components/islands/ProductPriceManager";
import VariantAssetPicker from "@/components/islands/VariantAssetPicker";
import ProductValueBreakdown from "@/components/islands/ProductValueBreakdown";
import ProductCostBreakdown from "@/components/islands/ProductCostBreakdown";
import VariantDeleteButton from "@/components/islands/VariantDeleteButton";
import { getProductByHandle, getProductTags, getProductVariants, getVariantPrices, getProductImages, getVariantAssets } from "@/lib/data-access/products";
import { getAssetImages } from "@/lib/data-access/assets";
import { getUserById } from "@/lib/data-access/users";
import { setSession } from "@/lib/auth";
import { getJamById, getJamProductReviews } from "@/lib/data-access/jams";
import { serverClient } from "@/lib/data-access/client";
import AlertMessage from "@/components/AlertMessage.astro";
import type { Asset } from "@/types";
import Card from "@/components/Card.astro";
import CardHeader from "@/components/CardHeader.astro";
import CardTitle from "@/components/CardTitle.astro";
import CardDescription from "@/components/CardDescription.astro";
import CardContent from "@/components/CardContent.astro";
import CardFooter from "@/components/CardFooter.astro";
import GalleryGrid from "@/components/GalleryGrid.astro";
import ProductReviewList from "@/components/ProductReviewList.astro";

const { product } = Astro.params;

if (!product) {
  return Astro.redirect('/404');
}

const productData = await getProductByHandle(product);

if (!productData) {
  return Astro.redirect('/404');
}

const owner = await getUserById(productData.user_id);
const tags = await getProductTags(productData.id);
const variants = await getProductVariants(productData.id);
const productImages = await getProductImages(productData.id);
const coverImage = productImages[0]?.file_url || null;

const variantsWithPrices = await Promise.all(
  variants.map(async (variant) => {
    const prices = await getVariantPrices(variant.id);
    const assets = await getVariantAssets(variant.id);
    return { ...variant, prices, assets };
  })
);

// Fetch asset images for all assets across all variants
const assetImagesMap = new Map();
const allAssets = variantsWithPrices.flatMap(v => v.assets || []);
await Promise.all(
  allAssets.map(async (asset) => {
    const images = await getAssetImages(asset.id);
    const coverImage = images[0]?.file_url || null;
    assetImagesMap.set(asset.id, coverImage);
  })
);

let currentUser = null;
const accessToken = Astro.cookies.get("sb-access-token");
const refreshToken = Astro.cookies.get("sb-refresh-token");

if (accessToken && refreshToken) {
  try {
    const session = await setSession({
      refresh_token: refreshToken.value,
      access_token: accessToken.value,
    });
    if (!session.error && session.data.user) {
      currentUser = session.data.user;
    }
  } catch (error) {}
}

const isOwner = currentUser?.id === productData.user_id;

if (productData.status !== 'published' && !isOwner) {
  return Astro.redirect('/404');
}

// Check if user is in edit mode
const isEditMode = isOwner;

// Check for jam submission flow
const urlParams = new URL(Astro.request.url).searchParams;
const jamId = urlParams.get('jam');
let targetJam = null;
let jamSubmissionError = null;
let jamSubmissionSuccess = urlParams.get('jam_success');
let reviewError = urlParams.get('error');
let reviewSuccess = urlParams.get('review_success');
let userReview = null;
let isProductInJam = false;
let allJamReviews = [];

if (jamId) {
  targetJam = await getJamById(jamId);

  // Check if product is already in the jam
  if (targetJam) {
    const { data: existingSubmission } = await serverClient
      .from("jam_products")
      .select("*")
      .eq("jam_id", jamId)
      .eq("product_id", productData.id)
      .eq("deleted", false)
      .single();

    isProductInJam = !!existingSubmission;
  }

  // Validate jam submission is possible
  if (targetJam) {
    const now = new Date();
    const startDate = new Date(targetJam.start_date);
    const endDate = new Date(targetJam.end_date);
    const isActive = now >= startDate && now <= endDate;

    if (isProductInJam && isOwner) {
      jamSubmissionError = "This product has already been submitted to this jam";
    } else if (!isActive) {
      const isUpcoming = now < startDate;
      jamSubmissionError = isUpcoming
        ? `Submissions for this jam open on ${startDate.toLocaleDateString()}`
        : `Submissions for this jam closed on ${endDate.toLocaleDateString()}`;
    } else if (productData.status !== 'published') {
      jamSubmissionError = "Only published products can be submitted to jams";
    } else if (!isOwner) {
      jamSubmissionError = "You must own this product to submit it to a jam";
    }

    // Get all reviews for this product in this jam
    allJamReviews = await getJamProductReviews(jamId, productData.id);

    // Get user's existing review if they're logged in and not the owner
    if (currentUser && !isOwner) {
      userReview = allJamReviews.find(r => r.user_id === currentUser.id);
    }
  }
}

// Get first variant with pricing for display
const defaultVariant = variantsWithPrices.find(v => v.prices && v.prices.length > 0) || variantsWithPrices[0];
const defaultPrice = defaultVariant?.prices?.[0];
---

<Layout title={`${productData.title} - Game Loopers`}>
  <div class="page">
    <div class="page__container">
      <!-- Jam Review Card - Top Priority (non-owners only) -->
      {targetJam && currentUser && !isOwner && isProductInJam && (
        <div class="jam-context-banner">
          <div class="jam-context-banner__content">
            <span class="jam-context-banner__emoji">🎮</span>
            <div class="jam-context-banner__text">
              <strong>Game Jam Review:</strong> You're reviewing this product for <strong>{targetJam.title}</strong>
            </div>
          </div>
        </div>
      )}

      {targetJam && currentUser && !isOwner && isProductInJam && (
        <Card>
          <CardHeader>
            <div class="jam-submission__header">
              <div>
                <CardTitle>{userReview ? 'Update Your Review' : 'Write a Review'}</CardTitle>
                <CardDescription>
                  Share your feedback about <strong>{productData.title}</strong> as part of {targetJam.title}
                </CardDescription>
              </div>
              <a href={`/jams/${targetJam.handle}`} class="jam-submission__back-link">
                ← Back to Jam
              </a>
            </div>
          </CardHeader>
          <CardContent>
            {reviewSuccess && (
              <AlertMessage
                variant="success"
                message={reviewSuccess}
              />
            )}
            {reviewError && (
              <AlertMessage
                variant="error"
                message={reviewError}
              />
            )}
            <form method="post" action="/api/jams/add-review" class="jam-review-form">
              <input type="hidden" name="jam_id" value={targetJam.id} />
              <input type="hidden" name="product_id" value={productData.id} />

              <div class="jam-review-form__field">
                <label for="rating" class="jam-review-form__label">
                  Rating *
                </label>
                <select
                  name="rating"
                  id="rating"
                  class="jam-review-form__select"
                  required
                >
                  <option value="">Select rating...</option>
                  <option value="5" selected={userReview?.rating === 5}>★★★★★ Excellent</option>
                  <option value="4" selected={userReview?.rating === 4}>★★★★ Very Good</option>
                  <option value="3" selected={userReview?.rating === 3}>★★★ Good</option>
                  <option value="2" selected={userReview?.rating === 2}>★★ Fair</option>
                  <option value="1" selected={userReview?.rating === 1}>★ Poor</option>
                </select>
              </div>

              <div class="jam-review-form__field">
                <label for="review_text" class="jam-review-form__label">
                  Review *
                </label>
                <textarea
                  name="review_text"
                  id="review_text"
                  class="jam-review-form__textarea"
                  rows={6}
                  required
                  placeholder="Share your thoughts about this product..."
                >{userReview?.review_text || ''}</textarea>
                <p class="jam-review-form__help-text">
                  Be constructive and helpful to other participants
                </p>
              </div>

              <div class="jam-review-form__actions">
                <a href={`/jams/${targetJam.handle}`}>
                  <Button variant="ghost" size="md">
                    <span slot="text">Back to Jam</span>
                  </Button>
                </a>
                <Button variant="primary" size="md">
                  <span slot="text">{userReview ? 'Update Review' : 'Submit Review'}</span>
                </Button>
              </div>
            </form>
          </CardContent>
        </Card>
      )}

      <!-- Jam Submission Card (for owners who haven't submitted yet) -->
      {targetJam && isOwner && !isProductInJam && (
        <Card>
          <CardHeader>
            <div class="jam-submission__header">
              <div>
                <CardTitle>Submit Product to {targetJam.title}</CardTitle>
                <CardDescription>
                  Review your product details and confirm submission to this game jam
                </CardDescription>
              </div>
              <a href={`/jams/${targetJam.handle}`} class="jam-submission__back-link">
                ← Back to Jam
              </a>
            </div>
          </CardHeader>
          <CardContent>
            {jamSubmissionSuccess && (
              <AlertMessage
                variant="success"
                message={jamSubmissionSuccess}
              />
            )}
            {jamSubmissionError ? (
              <AlertMessage
                variant="error"
                message={jamSubmissionError}
              />
            ) : (
              <div class="jam-submission__content">
                <div class="jam-submission__info">
                  <p class="jam-submission__text">
                    You're about to submit <strong>{productData.title}</strong> to <strong>{targetJam.title}</strong>.
                  </p>
                  <p class="jam-submission__text">
                    Jam ends: <strong>{new Date(targetJam.end_date).toLocaleDateString()}</strong>
                  </p>
                </div>
                <form method="post" action="/api/jams/add-product" class="jam-submission__form">
                  <input type="hidden" name="jam_id" value={targetJam.id} />
                  <input type="hidden" name="product_id" value={productData.id} />
                  <div class="jam-submission__actions">
                    <a href={`/jams/${targetJam.handle}`}>
                      <Button variant="ghost" size="md">
                        <span slot="text">Cancel</span>
                      </Button>
                    </a>
                    <Button variant="primary" size="md">
                      <span slot="text">Submit Product to Jam</span>
                    </Button>
                  </div>
                </form>
              </div>
            )}
          </CardContent>
        </Card>
      )}

      <!-- Breadcrumb Navigation -->
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol class="breadcrumb__list">
          <li class="breadcrumb__item">
            <a href="/" class="breadcrumb__link">Home</a>
          </li>
          <li class="breadcrumb__item">
            <a href="/products" class="breadcrumb__link">Products</a>
          </li>
          <li class="breadcrumb__item breadcrumb__item--current">
            <span class="breadcrumb__current">{productData.title}</span>
          </li>
        </ol>
      </nav>

      <!-- Hero Section -->
      <div
        class="product-hero"
        style={coverImage ? `background-image: url('${coverImage}')` : ''}
      >
        {coverImage && <div class="product-hero__overlay"></div>}

        <div class="product-hero__content">
          <div class="product-hero__title-group">
            <h1 class="product-hero__title">{productData.title}</h1>
            <div class="product-hero__meta">
              <span class="product-hero__author">
                by <a href={`/users/${owner?.handle}`} class="product-hero__author-link">
                  {owner?.name || owner?.handle || 'Unknown'}
                </a>
              </span>
              <span class="product-hero__divider">•</span>
              <Badge variant={productData.status as 'draft' | 'published' | 'archived'} size="sm">
                {productData.status}
              </Badge>
            </div>
          </div>

          {productData.description && (
            <div class="product-hero__description">
              <p>{productData.description}</p>
            </div>
          )}

          {tags.length > 0 && (
            <TagList className="product-hero__tags">
              {tags.map((tag) => <Tag>{tag.value}</Tag>)}
            </TagList>
          )}
        </div>
      </div>

      <div class="page-columns">
        <div class="page-columns__column">
          <!-- Description Section -->
          {!isEditMode && productData.description && (
            <Card>
              <CardHeader>
                <CardTitle>About This Product</CardTitle>
              </CardHeader>
              <CardContent>
                <p class="product-about-text">{productData.description}</p>
              </CardContent>
            </Card>
          )}

          {isEditMode && (
            <Card>
              <CardHeader>
                <CardTitle>About This Product</CardTitle>
                <CardDescription>Edit your product description</CardDescription>
              </CardHeader>
              <CardContent>
                <ProductBasicInfoForm
                  client:load
                  productId={productData.id}
                  initialData={{
                    title: productData.title,
                    description: productData.description,
                  }}
                />
              </CardContent>
            </Card>
          )}

          <!-- Images Section -->
          {(isEditMode || productImages.length > 0) && (
            <Card>
              <CardHeader>
                <CardTitle>Product Images</CardTitle>
                <CardDescription>
                  {isEditMode
                    ? 'Upload and manage product images (up to 9). First image is the cover.'
                    : 'Preview images of the product'}
                </CardDescription>
              </CardHeader>
              <CardContent>
                {isEditMode && (
                  <ProductImagesForm
                    client:load
                    productId={productData.id}
                    existingImages={productImages}
                  />
                )}
                {!isEditMode && productImages.length > 0 && (
                  <GalleryGrid images={productImages.map(img => ({
                    url: img.file_url,
                    alt: img.title,
                    href: img.file_url
                  }))} cols={3}/>
                )}
              </CardContent>
            </Card>
          )}

          <!-- Variants Section -->
        <Card>
          <CardHeader>
            <CardTitle>Product Variants</CardTitle>
          </CardHeader>
          <CardContent>
            {variantsWithPrices.length > 0 ? (
              <div class="product-variants__list">
              {variantsWithPrices.map((variant) => (
                <div class="variant-item">
                  {!isEditMode && (
                    <div class="variant-item__header">
                      <div class="variant-item__title-group">
                        <h4 class="variant-item__title">{variant.title}</h4>
                        {variant.sku && (
                          <span class="variant-item__sku">SKU: <code>{variant.sku}</code></span>
                        )}
                      </div>
                    </div>
                  )}

                  {!isEditMode && variant.description && (
                    <p class="variant-item__description">{variant.description}</p>
                  )}

                  {isEditMode && (
                    <ProductVariantEditor
                      client:load
                      variantId={variant.id}
                      initialTitle={variant.title}
                      initialDescription={variant.description}
                      initialSku={variant.sku}
                    />
                  )}

                  {isEditMode && currentUser && (
                    <VariantAssetPicker
                      client:load
                      variantId={variant.id}
                      userId={currentUser.id}
                    />
                  )}

                  {!isEditMode && variant.assets && variant.assets.length > 0 && (
                    <div class="variant-item__assets">
                      <div class="variant-item__assets-header">
                        <h5 class="variant-item__assets-title">What's Included</h5>
                        <span class="variant-item__assets-count">
                          {variant.assets.length} asset{variant.assets.length !== 1 ? 's' : ''}
                        </span>
                      </div>

                      {variant.prices && variant.prices.length > 0 && (
                        <ProductValueBreakdown
                          client:load
                          variantId={variant.id}
                          price={variant.prices[0].unit_amount}
                          assetCount={variant.assets.length}
                        />
                      )}

                      <div class="variant-item__assets-list">
                        {variant.assets.map((asset: Asset) => {
                          const assetCoverImage = assetImagesMap.get(asset.id);
                          return (
                            <a href={`/assets/${asset.handle}`} class="variant-item__asset-card">
                              <div class="variant-item__asset-image-container">
                                {assetCoverImage ? (
                                  <img
                                    src={assetCoverImage}
                                    alt={asset.title}
                                    class="variant-item__asset-image"
                                  />
                                ) : (
                                  <div class="variant-item__asset-image-placeholder">
                                    📦
                                  </div>
                                )}
                              </div>
                              <div class="variant-item__asset-info">
                                <h6 class="variant-item__asset-title">{asset.title}</h6>
                                <p class="variant-item__asset-handle">@{asset.handle}</p>
                              </div>
                            </a>
                          );
                        })}
                      </div>
                    </div>
                  )}

                  {!isEditMode && variant.prices && variant.prices.length > 0 && (
                    <div class="variant-item__pricing">
                      <div class="variant-item__price-list">
                        {variant.prices.map((price) => (
                          <div class="variant-item__price">
                            <span class="variant-item__price-amount">
                              {price.unit_amount === 0
                                ? 'FREE'
                                : `${price.currency.toUpperCase()} ${(price.unit_amount / 100).toFixed(2)}`}
                            </span>
                            {(price.min_quantity > 1 || price.max_quantity) && (
                              <span class="variant-item__price-quantity">
                                {price.min_quantity > 1 && `${price.min_quantity}+ units`}
                                {price.max_quantity && ` (max ${price.max_quantity})`}
                              </span>
                            )}
                          </div>
                        ))}
                      </div>

                      <div class="variant-item__actions">
                        {currentUser && (
                          <AddToCartButton
                            client:load
                            productId={productData.id}
                            variantId={variant.id}
                            quantity={1}
                            variant="primary"
                            size="md"
                          />
                        )}
                        {!currentUser && (
                          <a href={`/sign-in?redirect=/products/${product}`}>
                            <Button variant="primary" size="md">
                              <span slot="text">Sign In to Purchase</span>
                            </Button>
                          </a>
                        )}
                      </div>
                    </div>
                  )}

                  {isEditMode && (
                    <ProductPriceManager
                      client:load
                      variantId={variant.id}
                      variantTitle={variant.title}
                      existingPrices={variant.prices || []}
                    />
                  )}

                  {isEditMode && (
                    <ProductCostBreakdown
                      client:load
                      variantId={variant.id}
                      currentPrice={variant.prices && variant.prices.length > 0 ? variant.prices[0].unit_amount : 0}
                    />
                  )}

                  {isEditMode && (
                    <VariantDeleteButton
                      client:load
                      variantId={variant.id}
                      variantTitle={variant.title}
                    />
                  )}
                </div>
              ))}
              </div>
            ) : (
              <div class="product-empty">
                <div class="product-empty__icon">📦</div>
                <p class="product-empty__text">
                  {isEditMode
                    ? "No variants added yet. Variants let you offer different options (digital/physical) and pricing tiers."
                    : "This product doesn't have any variants available yet."}
                </p>
                {isEditMode && (
                  <p class="product-empty__help">
                    Variants contain the actual downloadable assets or physical items that customers receive.
                  </p>
                )}
              </div>
            )}
          </CardContent>
          {isEditMode && (
            <CardFooter>
              <ProductVariantManager client:load productId={productData.id} />
            </CardFooter>
          )}
        </Card>

        <!-- Reviews Section (Jam Context) -->
        {!isEditMode && jamId && targetJam && isProductInJam && (
          <Card>
            <CardContent>
              <ProductReviewList
                reviews={allJamReviews}
                jam={targetJam}
                jamHandle={targetJam.handle}
                currentUserId={currentUser?.id}
              />
            </CardContent>
          </Card>
        )}
        </div>

        <!-- Sidebar Column -->
        <div class="page-columns__column">
        {!isEditMode && variantsWithPrices.length > 0 && defaultPrice && (
          <Card>
            <CardContent>
              <div class="product-purchase">
                <div class="product-purchase__price">
                  <p class="product-purchase__price-label">Price</p>
                  <p class="product-purchase__price-value">
                    {defaultPrice.unit_amount === 0
                      ? 'FREE'
                      : `$${(defaultPrice.unit_amount / 100).toFixed(2)}`}
                  </p>
                  {variantsWithPrices.length > 1 && (
                    <p class="product-purchase__variant-note">
                      {variantsWithPrices.length} variants available
                    </p>
                  )}
                </div>

                {defaultVariant && (
                  <div class="product-purchase__actions">
                    {currentUser ? (
                      <AddToCartButton
                        client:load
                        productId={productData.id}
                        variantId={defaultVariant.id}
                        quantity={1}
                        variant="primary"
                        size="lg"
                      />
                    ) : (
                      <a href={`/sign-in?redirect=/products/${product}`} class="product-purchase__cta-link">
                        <Button variant="primary" size="lg">
                          <span slot="text">Sign In to Purchase</span>
                        </Button>
                      </a>
                    )}
                  </div>
                )}

                <p class="product-purchase__note">
                  Instant access after purchase • Digital download
                </p>
              </div>
            </CardContent>
          </Card>
        )}

        {isEditMode && currentUser && (
          <Card>
            <CardHeader>
              <CardTitle>Chat</CardTitle>
              <CardDescription>Discussion between product contributors</CardDescription>
            </CardHeader>
            <CardContent>
              <ProductChat
                client:load
                userId={currentUser.id}
                productId={productData.id}
              />
            </CardContent>
          </Card>
        )}

        {isEditMode && (
          <>
            <!-- Status Card (Edit Mode) -->
            <Card>
              <CardHeader>
                <CardTitle>Publish Status</CardTitle>
                <CardDescription>Control who can see this product</CardDescription>
              </CardHeader>
              <CardContent>
                <ProductStatusEditor
                  client:load
                  productId={productData.id}
                  currentStatus={productData.status}
                  hasVariants={variantsWithPrices.length > 0}
                />
              </CardContent>
            </Card>

            <!-- Tags Card (Edit Mode) -->
            <Card>
              <CardHeader>
                <CardTitle>Tags</CardTitle>
                <CardDescription>Add tags to help users find your product</CardDescription>
              </CardHeader>
              <CardContent>
                <ProductTagsForm
                  client:load
                  productId={productData.id}
                  initialTags={tags.map(t => t.value)}
                />
              </CardContent>
            </Card>
          </>
        )}

        <!-- Creator Card -->
        <Card>
          <CardHeader>
            <CardTitle>Creator</CardTitle>
            <CardDescription>
              <div class="creator-card__avatar">
                {owner?.name ? owner.name[0].toUpperCase() : owner?.handle[0].toUpperCase()}
              </div>
              <div class="creator-card__info">
                <h3 class="creator-card__name">{owner?.name || owner?.handle}</h3>
                <p class="creator-card__handle">@{owner?.handle}</p>
              </div>
            </CardDescription>
          </CardHeader>
          <CardContent>
              <p class="creator-card__bio">{owner?.bio}</p>
          </CardContent>
          <CardFooter>
              <a href={`/users/${owner?.handle}`} class="creator-card__link">
                <Button variant="outline" size="md">
                  <span slot="text">View Profile</span>
                </Button>
              </a>
          </CardFooter>
        </Card>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  /* ===== Breadcrumb Navigation ===== */
  .breadcrumb {
    margin-bottom: var(--spacing-2xl);
  }

  .breadcrumb__list {
    display: flex;
    align-items: center;
    gap: var(--gap-sm);
    list-style: none;
    padding: 0;
    margin: 0;
    flex-wrap: wrap;
  }

  .breadcrumb__item {
    display: flex;
    align-items: center;
    gap: var(--gap-sm);
    font-size: var(--text-sm);
    color: var(--muted-foreground);
  }

  .breadcrumb__item:not(:last-child)::after {
    content: '/';
    color: var(--border);
    margin-left: var(--gap-sm);
  }

  .breadcrumb__link {
    color: var(--muted-foreground);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-in-out);
  }

  .breadcrumb__link:hover {
    color: var(--foreground);
    text-decoration: underline;
  }

  .breadcrumb__link:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
