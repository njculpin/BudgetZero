---
import Layout from "@/layouts/Layout.astro";
import Badge from "@/components/Badge.astro";
import Button from "@/components/Button.astro";
import Tag from "@/components/Tag.astro";
import TagList from "@/components/TagList.astro";
import { ProductBasicInfoForm, ProductStatusEditor, ProductEmbeddableToggle, ProductTagsForm, ProductImagesForm, ProductFilesForm, ProductDocumentsForm, ProductChat, ProductEmbeddedProducts, ProductRevenuePreview, AddToCartButton, ProductDeleteButton } from "@/components/products";
import ProductContributors from "@/components/products/ProductContributors.astro";
import ProductPriceBreakdownSSR from "@/components/products/ProductPriceBreakdownSSR.astro";
import ProductRoyaltyBreakdownSSR from "@/components/products/ProductRoyaltyBreakdownSSR.astro";
import { getProductByHandle, getProductTags, getProductImages, getProductFiles, getProductDocuments, getProductContributors, getProductContributorsWithRoles, getProductComponents, getProductById } from "@/lib/data-access/products";
import { getUserById } from "@/lib/data-access/users";
import { setSession } from "@/lib/auth";
import { getJamById, getJamProductReviews } from "@/lib/data-access/jams";
import { serverClient } from "@/lib/data-access/client";
import type {  JamProductReview } from "@/types";
import Card from "@/components/Card.astro";
import CardHeader from "@/components/CardHeader.astro";
import CardTitle from "@/components/CardTitle.astro";
import CardDescription from "@/components/CardDescription.astro";
import CardContent from "@/components/CardContent.astro";
import CardFooter from "@/components/CardFooter.astro";
import GalleryGrid from "@/components/GalleryGrid.astro";
import ProductReviewList from "@/components/products/ProductReviewList.astro";
import Avatar from "@/components/users/Avatar.astro";

const { product } = Astro.params;

if (!product) {
  return Astro.redirect('/404');
}

const productData = await getProductByHandle(product);

if (!productData) {
  return Astro.redirect('/404');
}

const owner = await getUserById(productData.user_id);
const tags = await getProductTags(productData.id);
const productImages = await getProductImages(productData.id);
const productFiles = await getProductFiles(productData.id);
const productDocuments = await getProductDocuments(productData.id);
const productComponents = await getProductComponents(productData.id);

let currentUser = null;
const accessToken = Astro.cookies.get("sb-access-token");
const refreshToken = Astro.cookies.get("sb-refresh-token");

if (accessToken && refreshToken) {
  try {
    const session = await setSession({
      refresh_token: refreshToken.value,
      access_token: accessToken.value,
    });
    if (!session.error && session.data.user) {
      currentUser = session.data.user;
    }
  } catch (error) {}
}

const isOwner = currentUser?.id === productData.user_id;

// Get product contributors with role information (users with royalties on embedded products)
const productContributorsWithRoles = await getProductContributorsWithRoles(productData.id);
const contributorIds = productContributorsWithRoles.map(c => c.user.id);
const isContributor = currentUser ? contributorIds.includes(currentUser.id) || isOwner : false;

// Prepare embedded products with creator names for SSR price breakdown
const embeddedProductsWithCreators = await Promise.all(
  productComponents.map(async (component) => {
    const childProduct = await getProductById(component.child_product_id);
    const childOwner = childProduct ? await getUserById(childProduct.user_id) : null;

    return {
      id: component.child_product_id,
      title: childProduct?.title || "Unknown Product",
      handle: childProduct?.handle || "",
      inherited_price_cents: component.inherited_price_cents,
      creator_name: childOwner?.full_name || childOwner?.handle || "Unknown",
    };
  })
);

// Products are publicly viewable regardless of status
// Editing is only available to owners/contributors when logged in
const isEditMode = isOwner;

// Check for jam submission flow
const urlParams = new URL(Astro.request.url).searchParams;
const jamId = urlParams.get('jam');
let targetJam = null;
let userReview: JamProductReview | null = null;
let isProductInJam = false;
let allJamReviews: JamProductReview[] = [];

if (jamId) {
  targetJam = await getJamById(jamId);

  // Check if product is already in the jam
  // TODO: Move to data access layer
  if (targetJam) {
    const { data: existingSubmission } = await serverClient
      .from("jam_products")
      .select("*")
      .eq("jam_id", jamId)
      .eq("product_id", productData.id)
      .eq("deleted", false)
      .single();

    isProductInJam = !!existingSubmission;
  }

  // Get jam reviews
  if (targetJam) {
    // Get all reviews for this product in this jam
    allJamReviews = await getJamProductReviews(jamId, productData.id);

    // Get user's existing review if they're logged in and not the owner
    if (currentUser && !isOwner) {
      userReview = allJamReviews.find(r => r.user_id === currentUser.id) ?? null;
    }
  }
}

---

<Layout title={`${productData.title} - Game Loopers`}>
  <div class="page">
    <div class="page__container">
      <!-- Jam Context Banner (minimal, at top) -->
      {targetJam && currentUser && !isOwner && isProductInJam && (
        <div class="jam-context-banner">
          <div class="jam-context-banner__content">
            <span class="jam-context-banner__emoji">🎮</span>
            <div class="jam-context-banner__text">
              <strong>Game Jam Review:</strong> You're reviewing this product for <strong>{targetJam.title}</strong>
            </div>
          </div>
        </div>
      )}

      <div class="page-columns">
        <div class="page-columns__column">
          <!-- Description Section -->
          {!isEditMode && productData.description && (
            <Card>
              <CardHeader>
                <CardTitle>{productData.title}</CardTitle>
              </CardHeader>
              <CardContent>
                <p class="product-about-text">{productData.description}</p>
              </CardContent>
            </Card>
          )}

          {isEditMode && (
            <Card>
              <CardContent>
                <ProductBasicInfoForm
                  client:load
                  productId={productData.id}
                  initialData={{
                    title: productData.title,
                    description: productData.description,
                  }}
                />
              </CardContent>
            </Card>
          )}

          <!-- Images Section -->
          {(isEditMode || productImages.length > 0) && (
            <Card>
              <CardHeader>
                <CardTitle>Product Images</CardTitle>
                <CardDescription>
                  {isEditMode
                    ? 'Upload and manage product images (up to 9). First image is the cover.'
                    : 'Preview images of the product'}
                </CardDescription>
              </CardHeader>
              <CardContent>
                {isEditMode && (
                  <ProductImagesForm
                    client:load
                    productId={productData.id}
                    existingImages={productImages}
                  />
                )}
                {!isEditMode && productImages.length > 0 && (
                  <GalleryGrid images={productImages.map(img => ({
                    url: img.file_url,
                    alt: img.title,
                    href: img.file_url
                  }))} cols={3}/>
                )}
              </CardContent>
            </Card>
          )}

          <!-- Files Section -->
          {(isEditMode || productFiles.length > 0) && (
            <Card>
              <CardHeader>
                <CardTitle>Product Files</CardTitle>
                <CardDescription>
                  {isEditMode
                    ? 'Upload downloadable files (PDFs, ZIPs, STLs, etc.). Purchasers will receive all files.'
                    : `${productFiles.length} file(s) included with purchase`}
                </CardDescription>
              </CardHeader>
              <CardContent>
                {isEditMode && (
                  <ProductFilesForm
                    client:load
                    productId={productData.id}
                    existingFiles={productFiles}
                  />
                )}
                {!isEditMode && productFiles.length > 0 && (
                  <div class="product-files-list">
                    {productFiles.map((file) => (
                      <div class="product-file-item">
                        <span class="product-file-icon">📁</span>
                        <div class="product-file-info">
                          <div class="product-file-name">{file.title}</div>
                          {file.description && (
                            <div class="product-file-description">{file.description}</div>
                          )}
                        </div>
                      </div>
                    ))}
                  </div>
                )}
              </CardContent>
            </Card>
          )}

          <!-- Product Documents Section -->
          {(isEditMode || productDocuments.length > 0) && (
            <Card>
              <CardHeader>
                <CardTitle>Product Documents</CardTitle>
                <CardDescription>
                  {isEditMode
                    ? 'Attach documents to this product. Documents can be edited and priced separately.'
                    : `${productDocuments.length} document(s) included with purchase`}
                </CardDescription>
              </CardHeader>
              <CardContent>
                {isEditMode && currentUser && (
                  <ProductDocumentsForm
                    client:load
                    productId={productData.id}
                    userId={currentUser.id}
                    existingDocuments={productDocuments}
                  />
                )}
                {!isEditMode && productDocuments.length > 0 && (
                  <div class="product-documents-list">
                    {productDocuments.map((doc) => (
                      <div class="product-document-item">
                        <span class="product-document-icon">📄</span>
                        <div class="product-document-info">
                          <div class="product-document-name">
                            <a href={`/documents/${doc.document.handle}`}>{doc.document.title}</a>
                          </div>
                          {doc.document.description && (
                            <div class="product-document-description">{doc.document.description}</div>
                          )}
                        </div>
                      </div>
                    ))}
                  </div>
                )}
              </CardContent>
            </Card>
          )}

          <!-- Embedded Products Section -->
          {isEditMode && currentUser && (
            <Card>
              <CardHeader>
                <CardTitle>Embedded Products</CardTitle>
                <CardDescription>
                  Add products from other creators. Their price will be inherited and added to your product's total price.
                </CardDescription>
              </CardHeader>
              <CardContent>
                <ProductEmbeddedProducts
                  client:load
                  productId={productData.id}
                  userId={currentUser.id}
                />
              </CardContent>
            </Card>
          )}

          <!-- Revenue Preview Section (Edit Mode) -->
          {isEditMode && currentUser && (
            <Card>
              <CardHeader>
                <CardTitle>Revenue Preview</CardTitle>
                <CardDescription>
                  See how revenue will be distributed when someone purchases this product.
                </CardDescription>
              </CardHeader>
              <CardContent>
                <ProductRevenuePreview
                  client:load
                  productId={productData.id}
                  productOwnerId={productData.user_id}
                  productOwnerHandle={owner?.handle}
                  productOwnerName={owner?.full_name || owner?.handle}
                />
              </CardContent>
            </Card>
          )}

        <!-- Reviews Section (Jam Context) -->
        {!isEditMode && jamId && targetJam && isProductInJam && (
          <Card>
            <CardContent>
              <ProductReviewList
                reviews={allJamReviews}
                jam={targetJam}
                jamHandle={targetJam.handle}
                currentUserId={currentUser?.id}
              />
            </CardContent>
          </Card>
        )}
        </div>

        <!-- Sidebar Column -->
        <div class="page-columns__column">

        <!-- Price Breakdown Card -->
        <Card>
          <CardHeader>
            <CardTitle>Pricing</CardTitle>
            <CardDescription>Complete price breakdown</CardDescription>
          </CardHeader>
          <CardContent>
            <ProductPriceBreakdownSSR
              files={productFiles}
              documents={productDocuments}
              embeddedProducts={embeddedProductsWithCreators}
            />
          </CardContent>
        </Card>

        <!-- Contributors Card (Moved to position #2 for better visibility) -->
        {productContributorsWithRoles.length > 0 && (
          <Card>
            <CardHeader>
              <CardTitle>Contributors</CardTitle>
              <CardDescription>Talented creators who made this possible</CardDescription>
            </CardHeader>
            <CardContent>
              <ProductContributors contributorsWithRoles={productContributorsWithRoles} />
            </CardContent>
          </Card>
        )}

        <!-- Royalty Breakdown Card -->
        <Card>
          <CardHeader>
            <CardTitle>Support Creators</CardTitle>
            <CardDescription>Your purchase supports all contributors</CardDescription>
          </CardHeader>
          <CardContent>
            <ProductRoyaltyBreakdownSSR
              productId={productData.id}
              productOwnerId={productData.user_id}
              productOwnerHandle={owner?.handle}
              productOwnerName={owner?.full_name || owner?.handle}
            />
          </CardContent>
        </Card>

        <!-- Add to Cart Button -->
        <Card>
          <CardContent>
            <AddToCartButton
              client:load
              productId={productData.id}
              productTitle={productData.title}
              isAuthenticated={!!currentUser}
            />
          </CardContent>
        </Card>

        {isContributor && currentUser && (
          <Card>
            <CardHeader>
              <CardTitle>Chat</CardTitle>
              <CardDescription>Discussion between product contributors</CardDescription>
            </CardHeader>
            <CardContent>
              <ProductChat
                client:visible
                userId={currentUser?.id}
                productId={productData.id}
              />
            </CardContent>
          </Card>
        )}

        {isEditMode && (
          <>
            <!-- Status Card (Edit Mode) -->
            <Card>
              <CardHeader>
                <CardTitle>Publish Status</CardTitle>
                <CardDescription>Control who can see this product</CardDescription>
              </CardHeader>
              <CardContent>
                <ProductStatusEditor
                  client:load
                  productId={productData.id}
                  currentStatus={productData.status}
                />
              </CardContent>
            </Card>

            <!-- Embeddable Toggle Card (Edit Mode) -->
            <Card>
              <CardHeader>
                <CardTitle>Embedding Settings</CardTitle>
                <CardDescription>Control whether others can use this product in their products</CardDescription>
              </CardHeader>
              <CardContent>
                <ProductEmbeddableToggle
                  client:load
                  productId={productData.id}
                  isEmbeddable={productData.is_embeddable || false}
                  productStatus={productData.status}
                />
              </CardContent>
            </Card>

            <!-- Tags Card (Edit Mode) -->
            <Card>
              <CardHeader>
                <CardTitle>Tags</CardTitle>
                <CardDescription>Add tags to help users find your product</CardDescription>
              </CardHeader>
              <CardContent>
                <ProductTagsForm
                  client:load
                  productId={productData.id}
                  initialTags={tags.map(t => t.value)}
                />
              </CardContent>
            </Card>

            <!-- Delete Product Card (Edit Mode) -->
            <Card>
              <CardHeader>
                <CardTitle>Delete Product</CardTitle>
                <CardDescription>Permanently remove this product and all associated data</CardDescription>
              </CardHeader>
              <CardContent>
                <ProductDeleteButton
                  client:load
                  productId={productData.id}
                  productTitle={productData.title}
                />
              </CardContent>
            </Card>
          </>
        )}

        <!-- Creator Card -->
        <Card>
          <CardHeader>
            <CardTitle>Creator</CardTitle>
            <CardDescription>
              <div class="creator-card__header">
                <Avatar
                  src={owner?.avatar_url}
                  alt={owner?.name || owner?.handle || 'Creator'}
                  size="lg"
                />
                <div class="creator-card__info">
                  <h3 class="creator-card__name">{owner?.name || owner?.handle}</h3>
                  <p class="creator-card__handle">@{owner?.handle}</p>
                </div>
              </div>
            </CardDescription>
          </CardHeader>
          <CardContent>
              <p class="creator-card__bio">{owner?.bio}</p>
          </CardContent>
          <CardFooter>
              <a href={`/users/${owner?.handle}`} class="creator-card__link">
                <Button variant="outline" size="md">
                  <span slot="text">View Profile</span>
                </Button>
              </a>
          </CardFooter>
        </Card>

        <!-- Jam Review Form (for non-owners reviewing product in jam) -->
        {targetJam && currentUser && !isOwner && isProductInJam && (
          <Card>
            <CardHeader>
              <CardTitle>{userReview ? 'Update Your Review' : 'Write a Review'}</CardTitle>
              <CardDescription>
                Share your thoughts on this product for <strong>{targetJam.title}</strong>
              </CardDescription>
            </CardHeader>
            <CardContent>
              <form method="POST" action="/api/jams/add-review" class="jam-review-form">
                <input type="hidden" name="jam_id" value={targetJam.id} />
                <input type="hidden" name="product_id" value={productData.id} />

                <div class="jam-review-form__field">
                  <label for="rating" class="jam-review-form__label">Rating</label>
                  <select
                    id="rating"
                    name="rating"
                    class="jam-review-form__select"
                    required
                  >
                    <option value="">Select a rating</option>
                    <option value="5" selected={userReview?.review_rating === 5}>⭐⭐⭐⭐⭐ Exceptional</option>
                    <option value="4" selected={userReview?.review_rating === 4}>⭐⭐⭐⭐ Great</option>
                    <option value="3" selected={userReview?.review_rating === 3}>⭐⭐⭐ Good</option>
                    <option value="2" selected={userReview?.review_rating === 2}>⭐⭐ Fair</option>
                    <option value="1" selected={userReview?.review_rating === 1}>⭐ Needs Improvement</option>
                  </select>
                </div>

                <div class="jam-review-form__field">
                  <label for="review_text" class="jam-review-form__label">Your Review</label>
                  <textarea
                    id="review_text"
                    name="review_text"
                    class="jam-review-form__textarea"
                    rows="6"
                    placeholder="What did you think about this product? How well does it fit the jam theme?"
                    required
                  >{userReview?.review_text || ''}</textarea>
                </div>

                <Button type="submit" variant="primary" size="md">
                  <span slot="text">{userReview ? 'Update Review' : 'Submit Review'}</span>
                </Button>
              </form>
            </CardContent>
          </Card>
        )}

        <!-- Jam Submission Form (for owners submitting product to jam) -->
        {targetJam && isOwner && !isProductInJam && (
          <Card>
            <CardHeader>
              <CardTitle>Submit to {targetJam.title}</CardTitle>
              <CardDescription>
                Submit this product to compete in the game jam
              </CardDescription>
            </CardHeader>
            <CardContent>
              {productData.status !== 'public' && (
                <div class="jam-submit-warning">
                  <svg class="jam-submit-warning__icon" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M10 6V10M10 14H10.01M19 10C19 14.9706 14.9706 19 10 19C5.02944 19 1 14.9706 1 10C1 5.02944 5.02944 1 10 1C14.9706 1 19 5.02944 19 10Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  <p class="jam-submit-warning__text">
                    Your product must be published before you can submit it to a jam.
                    Change the status to "Public" first.
                  </p>
                </div>
              )}

              {productData.status === 'public' && (
                <form method="POST" action="/api/jams/add-product" class="jam-submit-form">
                  <input type="hidden" name="jam_id" value={targetJam.id} />
                  <input type="hidden" name="product_id" value={productData.id} />

                  <p class="jam-submit-form__description">
                    By submitting this product, you agree to participate in <strong>{targetJam.title}</strong>
                    and allow community members to review and rate your work.
                  </p>

                  <Button type="submit" variant="primary" size="md">
                    <span slot="text">Submit to Jam</span>
                  </Button>
                </form>
              )}
            </CardContent>
          </Card>
        )}
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  /* ===== Page Header (Compact) ===== */
  .page-header {
    padding: var(--spacing-2xl) 0;
    border-bottom: var(--border-width-default) solid var(--border);
    margin-bottom: var(--spacing-3xl);
  }

  .page-header__content {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
  }

  .page-header__title {
    margin: 0;
    font-size: var(--text-3xl);
    font-weight: var(--font-weight-bold);
    line-height: var(--leading-tight);
    color: var(--foreground);
  }

  .page-header__meta {
    display: flex;
    align-items: center;
    gap: var(--gap-md);
    flex-wrap: wrap;
  }

  .page-header__author {
    font-size: var(--text-sm);
    color: var(--muted-foreground);
  }

  .page-header__author-link {
    color: var(--foreground);
    text-decoration: none;
    font-weight: var(--font-weight-medium);
  }

  .page-header__author-link:hover {
    color: var(--primary);
    text-decoration: underline;
  }

  .page-header__divider {
    color: var(--muted-foreground);
  }

  .page-header__tags {
    margin-top: var(--spacing-sm);
  }

  @media (max-width: 768px) {
    .page-header {
      padding: var(--spacing-xl) 0;
      margin-bottom: var(--spacing-2xl);
    }

    .page-header__title {
      font-size: var(--text-2xl);
    }
  }

  /* ===== Product About Text ===== */
  .product-about-text {
    margin: 0;
    font-size: var(--text-base);
    color: var(--foreground);
    line-height: var(--leading-relaxed);
  }

  /* ===== Product Variants ===== */
  .product-variants__list {
    display: flex;
    flex-direction: column;
    gap: var(--gap-2xl);
  }

  .variant-item {
    padding: var(--spacing-2xl);
    background-color: var(--muted);
    border-radius: var(--radius-md);
    border: var(--border-width-default) solid var(--border);
  }

  .variant-item__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--gap-lg);
    margin-bottom: var(--spacing-lg);
  }

  .variant-item__title-group {
    display: flex;
    align-items: center;
    gap: var(--gap-md);
    flex-wrap: wrap;
  }

  .variant-item__title {
    margin: 0;
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-semibold);
    color: var(--foreground);
  }

  .variant-item__name {
    margin: 0;
    font-size: var(--text-xl);
    font-weight: var(--font-weight-semibold);
    color: var(--foreground);
  }

  .variant-item__sku {
    font-size: var(--text-sm);
    color: var(--muted-foreground);
  }

  .variant-item__sku code {
    background-color: var(--background);
    padding: var(--spacing-xs) var(--spacing-sm);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
  }

  .variant-item__description {
    margin: 0 0 var(--spacing-lg) 0;
    font-size: var(--text-base);
    color: var(--muted-foreground);
    line-height: var(--leading-relaxed);
  }

  .variant-item__assets {
    margin: var(--spacing-xl) 0;
    padding: var(--spacing-2xl);
    background-color: oklch(from var(--primary) l c h / 0.03);
    border-radius: var(--radius-lg);
    border: var(--border-width-default) solid var(--primary);
  }

  .variant-item__assets-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--spacing-xl);
    padding-bottom: var(--spacing-md);
    border-bottom: 1px solid var(--border);
  }

  .variant-item__assets-title {
    margin: 0;
    font-size: var(--text-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--foreground);
    display: flex;
    align-items: center;
    gap: var(--gap-md);
  }

  .variant-item__assets-title::before {
    content: "📦";
    font-size: var(--text-xl);
  }

  .variant-item__assets-count {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--primary-foreground);
    padding: var(--spacing-xs) var(--spacing-lg);
    background-color: var(--primary);
    border-radius: var(--radius-full);
  }

  .variant-item__assets-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--gap-lg);
  }

  .variant-item__asset-card {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
    padding: var(--spacing-lg);
    background-color: var(--card);
    border: var(--border-width-thick) solid var(--border);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: border-color var(--duration-fast) var(--ease-in-out);
  }

  .variant-item__asset-card:hover {
    border-color: var(--primary);
  }

  .variant-item__asset-image-container {
    width: 100%;
    aspect-ratio: 16/9;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background-color: var(--muted);
  }

  .variant-item__asset-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .variant-item__asset-image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
