---
import Layout from "@/layouts/Layout.astro";
import Card from "@/components/Card.astro";
import CardHeader from "@/components/CardHeader.astro";
import CardTitle from "@/components/CardTitle.astro";
import CardDescription from "@/components/CardDescription.astro";
import CardContent from "@/components/CardContent.astro";
import AssetBasicInfoForm from "@/components/islands/AssetBasicInfoForm";
import AssetStatusForm from "@/components/islands/AssetStatusForm";
import AssetTagsForm from "@/components/islands/AssetTagsForm";
import AssetFileForm from "@/components/islands/AssetFileForm";
import AssetImagesForm from "@/components/islands/AssetImagesForm";
import AssetLicensingForm from "@/components/islands/AssetLicensingForm";
import RoyaltyManagementForm from "@/components/islands/RoyaltyManagementForm";
import AssetDeleteButton from "@/components/islands/AssetDeleteButton";
import { setSession } from "@/lib/auth";
import {
  getAssetByHandle,
  getAssetTags,
  getAssetFiles,
  getAssetImages,
} from "@/lib/data-access/assets";
import { getAssetRoyalties, createAssetRoyalty } from "@/lib/data-access/royalties";
import { getUserById } from "@/lib/data-access/users";

const { cookies, redirect } = Astro;
const { asset: assetHandle } = Astro.params;

if (!assetHandle) {
  return redirect('/404');
}

// Check authentication
const accessToken = cookies.get("sb-access-token");
const refreshToken = cookies.get("sb-refresh-token");

if (!accessToken || !refreshToken) {
  return redirect("/sign-in");
}

let session;
try {
  session = await setSession({
    refresh_token: refreshToken.value,
    access_token: accessToken.value,
  });
  if (session.error) {
    cookies.delete("sb-access-token", { path: "/" });
    cookies.delete("sb-refresh-token", { path: "/" });
    return redirect("/sign-in");
  }
} catch (error) {
  cookies.delete("sb-access-token", { path: "/" });
  cookies.delete("sb-refresh-token", { path: "/" });
  return redirect("/sign-in");
}

const userId = session.data.user?.id;

if (!userId) {
  return redirect("/sign-in");
}

// Fetch the asset
const assetData = await getAssetByHandle(assetHandle);

if (!assetData) {
  return redirect('/404');
}

// Check if user is the owner
if (assetData.user_id !== userId) {
  return redirect(`/assets/${assetHandle}`);
}
// Fetch existing tags, files, images, and royalties
const existingTags = await getAssetTags(assetData.id);
const existingFiles = await getAssetFiles(assetData.id);
const existingImages = await getAssetImages(assetData.id);
let existingRoyalties = await getAssetRoyalties(assetData.id);

// Ensure owner has a default royalty (100% percentage)
const ownerHasRoyalty = existingRoyalties.some(r => r.user_id === assetData.user_id);

if (!ownerHasRoyalty) {
  // Create default 100% royalty for owner
  await createAssetRoyalty(
    {
      assetId: assetData.id,
      userId: assetData.user_id,
      royaltyValue: 100,
    }
  );

  // Re-fetch royalties to include the newly created one
  existingRoyalties = await getAssetRoyalties(assetData.id);
}

// Fetch user details for royalties
const royaltiesWithUsers = await Promise.all(
  existingRoyalties.map(async (royalty) => {
    const user = await getUserById(royalty.user_id);
    return { ...royalty, user };
  })
);
---

<Layout title={`Edit ${assetData.title} - Game Loopers`}>
  <div class="page">
    <div class="page__container">

      <Card>
        <CardHeader>
          <CardTitle>Basic Information</CardTitle>
          <CardDescription>Set the title and description for your asset</CardDescription>
        </CardHeader>
        <CardContent>
          <AssetBasicInfoForm
            client:load
            assetId={assetData.id}
            initialData={{
              title: assetData.title,
              description: assetData.description,
            }}
          />
        </CardContent>
      </Card>

      <Card>
        <CardHeader>
          <CardTitle>Publication Status</CardTitle>
          <CardDescription>Control the visibility of your asset</CardDescription>
        </CardHeader>
        <CardContent>
          <AssetStatusForm
            client:load
            assetId={assetData.id}
            initialStatus={assetData.status}
          />
        </CardContent>
      </Card>

      <Card>
        <CardHeader>
          <CardTitle>Tags</CardTitle>
          <CardDescription>Add tags to help users discover your asset</CardDescription>
        </CardHeader>
        <CardContent>
          <AssetTagsForm
            client:load
            assetId={assetData.id}
            initialTags={existingTags.map(t => t.value)}
          />
        </CardContent>
      </Card>

      <Card>
        <CardHeader>
          <CardTitle>Asset File</CardTitle>
          <CardDescription>Upload the main downloadable file for this asset</CardDescription>
        </CardHeader>
        <CardContent>
          <AssetFileForm
            client:load
            assetId={assetData.id}
            existingFile={existingFiles.length > 0 ? {
              id: existingFiles[0].id,
              title: existingFiles[0].title,
              file_size_bytes: existingFiles[0].file_size_bytes,
              file_url: existingFiles[0].file_url,
            } : null}
          />
        </CardContent>
      </Card>

      <Card>
        <CardHeader>
          <CardTitle>Cover Images</CardTitle>
          <CardDescription>Upload and reorder preview images for your asset</CardDescription>
        </CardHeader>
        <CardContent>
          <AssetImagesForm
            client:load
            assetId={assetData.id}
            existingImages={existingImages.map(i => ({
              id: i.id,
              title: i.title,
              file_url: i.file_url,
            }))}
          />
        </CardContent>
      </Card>

      <Card>
        <CardHeader>
          <CardTitle>Licensing</CardTitle>
          <CardDescription>Define how buyers can use this asset</CardDescription>
        </CardHeader>
        <CardContent>
          <AssetLicensingForm
            client:load
            assetId={assetData.id}
            initialData={{
              licenseType: "standard",
              commercialUse: true,
              attribution: false,
              customTerms: "",
            }}
          />
        </CardContent>
      </Card>

      <Card>
        <CardHeader>
          <CardTitle>Royalty Management</CardTitle>
          <CardDescription>Manage royalty splits for contributors. The total sum is the cost of the asset per purchase inside a product.</CardDescription>
        </CardHeader>
        <CardContent>
          <RoyaltyManagementForm
            client:load
            assetId={assetData.id}
            ownerId={assetData.user_id}
            initialRoyalties={royaltiesWithUsers}
            onUpdate={() => window.location.reload()}
          />
        </CardContent>
      </Card>

      <Card className="danger-zone">
        <CardHeader>
          <CardTitle>Danger Zone</CardTitle>
          <CardDescription>Permanently delete this asset. This action cannot be undone.</CardDescription>
        </CardHeader>
        <CardContent>
          <AssetDeleteButton
            client:load
            assetId={assetData.id}
            assetTitle={assetData.title}
            redirectUrl="/assets"
          />
        </CardContent>
      </Card>
    </div>
  </div>
</Layout>

<style>
/* ===== Page Layout ===== */
.asset-edit-page {
  min-height: 100vh;
  padding: var(--spacing-4xl) var(--spacing-2xl);
  background-color: var(--background);
}

.asset-edit-container {
  max-width: 48rem;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: var(--gap-2xl);
}

/* ===== Welcome Banner ===== */
.welcome-banner {
  background: linear-gradient(135deg, var(--accent) 0%, oklch(0.55 0.15 290) 100%);
  border-radius: var(--radius-lg);
  padding: var(--spacing-4xl);
  color: var(--color-white);
  box-shadow: var(--shadow-lg);
}

.welcome-banner__content {
  max-width: 100%;
}

.welcome-banner__title {
  font-size: var(--text-2xl);
  font-weight: var(--font-weight-bold);
  line-height: var(--leading-tight);
  margin: 0 0 var(--spacing-lg) 0;
  color: var(--color-white);
}

.welcome-banner__text {
  font-size: var(--text-base);
  font-weight: var(--font-weight-normal);
  line-height: var(--leading-relaxed);
  margin: 0;
  color: oklch(from var(--color-white) l c h / 0.95);
}

@media (max-width: 640px) {
  .welcome-banner {
    padding: var(--spacing-3xl);
  }

  .welcome-banner__title {
    font-size: var(--text-xl);
  }
}

.asset-edit-header {
  display: flex;
  flex-direction: column;
  gap: var(--gap-sm);
}

/* ===== Form Styles ===== */
.asset-edit-form,
.royalty-management__form {
  display: flex;
  flex-direction: column;
  gap: var(--gap-xl);
}

.asset-edit-form__actions,
.royalty-management__form-actions {
  display: flex;
  gap: var(--gap-md);
  justify-content: flex-end;
  padding-top: var(--spacing-2xl);
}

.asset-edit-form__actions a {
  text-decoration: none;
}

/* ===== Existing Content Display ===== */
.asset-edit-form__existing-tags,
.asset-edit-form__existing-files,
.asset-edit-form__existing-images {
  padding: var(--spacing-2xl);
  background-color: var(--muted);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  margin-bottom: var(--spacing-sm);
}

.asset-edit-form__label {
  margin: 0 0 var(--spacing-sm) 0;
  font-size: var(--text-sm);
  font-weight: var(--font-weight-semibold);
  color: var(--foreground);
  line-height: var(--leading-normal);
}

.asset-edit-form__tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--gap-sm);
  margin-top: var(--spacing-sm);
}

.asset-edit-form__tag {
  padding: var(--spacing-xs) var(--spacing-md);
  font-size: var(--text-sm);
  font-weight: var(--font-weight-medium);
  line-height: var(--leading-tight);
  background-color: var(--primary);
  color: var(--primary-foreground);
  border-radius: var(--radius-full);
}

.asset-edit-form__file-list {
  list-style: none;
  padding: 0;
  margin: var(--spacing-sm) 0 0 0;
}

.asset-edit-form__file-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-lg);
  border-bottom: 1px solid var(--border);
  font-size: var(--text-sm);
  font-weight: var(--font-weight-normal);
  line-height: var(--leading-normal);
}

.asset-edit-form__file-item:last-child {
  border-bottom: none;
}

.asset-edit-form__file-size {
  color: var(--muted-foreground);
  font-size: var(--text-sm);
  font-weight: var(--font-weight-normal);
  line-height: var(--leading-normal);
}

.asset-edit-form__image-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(8rem, 1fr));
  gap: var(--gap-md);
  margin-top: var(--spacing-sm);
}

.asset-edit-form__image-item {
  aspect-ratio: 1;
  border-radius: var(--radius-md);
  overflow: hidden;
  border: 1px solid var(--border);
}

.asset-edit-form__image-item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* ===== Royalty Management ===== */
:global(.royalty-management) {
  display: flex;
  flex-direction: column;
  gap: var(--gap-2xl);
}

:global(.royalty-management__empty) {
  margin: 0;
  font-size: var(--text-sm);
  color: var(--muted-foreground);
  text-align: center;
  padding: var(--spacing-4xl);
}

:global(.royalty-management__warning) {
  display: flex;
  gap: var(--gap-md);
  padding: var(--spacing-2xl);
  background-color: oklch(0.97 0.03 85);
  border: 1px solid oklch(0.65 0.15 70);
  border-radius: var(--radius-md);
  margin-bottom: var(--spacing-2xl);
}

:global(.royalty-management__warning-icon) {
  font-size: var(--text-xl);
  flex-shrink: 0;
}

:global(.royalty-management__warning-content) {
  flex: 1;
}

:global(.royalty-management__warning-content strong) {
  display: block;
  font-size: var(--text-sm);
  font-weight: var(--font-weight-semibold);
  color: oklch(0.35 0.08 75);
  line-height: var(--leading-normal);
  margin-bottom: var(--spacing-xs);
}

:global(.royalty-management__warning-content p) {
  margin: 0;
  font-size: var(--text-sm);
  font-weight: var(--font-weight-normal);
  color: oklch(0.35 0.08 75);
  line-height: var(--leading-relaxed);
}

:global(.royalty-management__list) {
  display: flex;
  flex-direction: column;
  gap: var(--gap-md);
}

:global(.royalty-item) {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-2xl);
  background-color: var(--muted);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
}

:global(.royalty-item--owner) {
  background-color: oklch(0.95 0.02 250);
  border-color: var(--primary);
  border-width: 2px;
}

:global(.royalty-item__info) {
  display: flex;
  flex-direction: column;
  gap: var(--gap-sm);
}

:global(.royalty-item__user) {
  margin: 0;
  font-size: var(--text-base);
  font-weight: var(--font-weight-semibold);
  color: var(--foreground);
  line-height: var(--leading-normal);
  display: flex;
  align-items: center;
  gap: var(--gap-sm);
}

:global(.royalty-item__badge) {
  display: inline-block;
  padding: var(--spacing-xxs) var(--spacing-sm);
  font-size: var(--text-xs);
  font-weight: var(--font-weight-medium);
  line-height: var(--leading-tight);
  background-color: var(--primary);
  color: var(--primary-foreground);
  border-radius: var(--radius-full);
  margin-left: var(--spacing-xs);
}

:global(.royalty-item__value) {
  font-size: var(--text-lg);
  font-weight: var(--font-weight-bold);
  color: var(--primary);
}

:global(.royalty-item__type) {
  margin-left: var(--spacing-xs);
  font-size: var(--text-sm);
  font-weight: var(--font-weight-normal);
  color: var(--muted-foreground);
}

:global(.royalty-management__total) {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-2xl);
  border-top: 2px solid var(--border);
  font-weight: var(--font-weight-semibold);
}

:global(.royalty-management__total--warning) {
  border-top-color: oklch(0.65 0.15 70);
  background-color: oklch(0.97 0.03 85);
}

:global(.royalty-management__total-label) {
  margin: 0;
  font-size: var(--text-base);
  font-weight: var(--font-weight-semibold);
  color: var(--foreground);
  line-height: var(--leading-normal);
}

:global(.royalty-management__total-value) {
  margin: 0;
  font-size: var(--text-xl);
  font-weight: var(--font-weight-bold);
  color: var(--primary);
  line-height: var(--leading-tight);
}

:global(.royalty-management__total-value--warning) {
  color: var(--destructive);
}

:global(.royalty-management__add) {
  margin-top: var(--spacing-2xl);
}

:global(.royalty-management__toggle-button) {
  padding: var(--spacing-md);
  background-color: var(--muted);
  border: none;
  border-radius: var(--radius-md);
  font-weight: var(--font-weight-medium);
  font-size: var(--text-sm);
  cursor: pointer;
  width: 100%;
  text-align: left;
}

:global(.royalty-management__toggle-button:hover) {
  background-color: oklch(from var(--muted) calc(l * 0.96) c h);
}

:global(.royalty-management__form) {
  display: flex;
  flex-direction: column;
  gap: var(--gap-xl);
}

:global(.royalty-management__form-actions) {
  display: flex;
  gap: var(--gap-md);
  justify-content: flex-end;
  padding-top: var(--spacing-2xl);
}

/* ===== Form Field Styles ===== */
.form-field {
  display: flex;
  flex-direction: column;
  gap: var(--gap-sm);
}

.form-field__label {
  font-size: var(--text-sm);
  font-weight: var(--font-weight-medium);
  color: var(--foreground);
}

.form-field__file-input {
  padding: var(--spacing-lg);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
}

.form-field__help-text {
  margin: var(--spacing-xs) 0 0 0;
  font-size: var(--text-xs);
  color: var(--muted-foreground);
}

/* ===== Danger Zone ===== */
.danger-zone {
  border: 2px solid var(--destructive);
  background-color: oklch(0.98 0.02 25);
}

.danger-zone :global(.card__header) {
  border-bottom-color: oklch(0.95 0.03 25);
}

.danger-zone :global(.card__title) {
  color: oklch(0.35 0.15 25);
}

.danger-zone :global(.card__description) {
  color: oklch(0.35 0.15 25);
}

/* ===== User Search ===== */
:global(.user-search) {
  position: relative;
}

:global(.user-search__input) {
  width: 100%;
  padding: var(--spacing-md);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  font-size: var(--text-sm);
  background-color: var(--background);
  color: var(--foreground);
}

:global(.user-search__input:focus) {
  outline: none;
  border-color: var(--primary);
  box-shadow: 0 0 0 3px rgba(var(--primary-rgb, 0, 112, 243), 0.1);
}

:global(.user-search__loading) {
  padding: var(--spacing-md);
  font-size: var(--text-sm);
  color: var(--muted-foreground);
}

:global(.user-search__results) {
  position: absolute;
  top: calc(100% + 4px);
  left: 0;
  right: 0;
  background-color: var(--background);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  max-height: 16rem;
  overflow-y: auto;
  z-index: 10;
}

:global(.user-search__result-item) {
  width: 100%;
  padding: var(--spacing-md);
  border: none;
  background: none;
  text-align: left;
  cursor: pointer;
  border-bottom: 1px solid var(--border);
  transition: background-color 0.15s;
}

:global(.user-search__result-item:last-child) {
  border-bottom: none;
}

:global(.user-search__result-item:hover) {
  background-color: var(--muted);
}

:global(.user-search__result-info) {
  display: flex;
  flex-direction: column;
  gap: var(--gap-xxs);
}

:global(.user-search__result-name) {
  font-size: var(--text-sm);
  font-weight: var(--font-weight-medium);
  color: var(--foreground);
}

:global(.user-search__result-handle) {
  font-size: var(--text-xs);
  color: var(--muted-foreground);
}

:global(.user-search__no-results) {
  padding: var(--spacing-md);
  font-size: var(--text-sm);
  color: var(--muted-foreground);
  text-align: center;
}

:global(.user-search__selected) {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-md);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  background-color: var(--muted);
}

:global(.user-search__selected-info) {
  display: flex;
  flex-direction: column;
  gap: var(--gap-xxs);
}

:global(.user-search__selected-name) {
  font-size: var(--text-sm);
  font-weight: var(--font-weight-medium);
  color: var(--foreground);
}

:global(.user-search__clear-button) {
  padding: var(--spacing-xs) var(--spacing-md);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  background-color: var(--background);
  color: var(--foreground);
  font-size: var(--text-sm);
  cursor: pointer;
  transition: background-color 0.15s;
}

:global(.user-search__clear-button:hover) {
  background-color: var(--muted);
}

:global(.user-search__clear-button:disabled) {
  opacity: 0.5;
  cursor: not-allowed;
}

/* ===== Asset Form Styles ===== */
:global(.asset-form) {
  display: flex;
  flex-direction: column;
  gap: var(--gap-2xl);
}

:global(.asset-form__actions) {
  display: flex;
  gap: var(--gap-md);
  justify-content: flex-end;
}

/* ===== Asset Tags Form ===== */
:global(.asset-tags-form__existing-tags) {
  margin-bottom: var(--spacing-2xl);
}

:global(.asset-tags-form__label) {
  margin: 0 0 var(--spacing-md) 0;
  font-size: var(--text-sm);
  font-weight: var(--font-weight-medium);
  color: var(--muted-foreground);
}

:global(.asset-tags-form__tag-list) {
  display: flex;
  flex-wrap: wrap;
  gap: var(--gap-sm);
}

:global(.asset-tags-form__tag) {
  padding: var(--spacing-xs) var(--spacing-md);
  background-color: var(--muted);
  border-radius: var(--radius-full);
  font-size: var(--text-sm);
  color: var(--foreground);
}

/* ===== Asset File Form ===== */
:global(.asset-file-form__existing) {
  margin-bottom: var(--spacing-2xl);
  padding: var(--spacing-2xl);
  background-color: var(--muted);
  border-radius: var(--radius-md);
}

:global(.asset-file-form__existing-header) {
  margin-bottom: var(--spacing-md);
}

:global(.asset-file-form__existing-title) {
  margin: 0;
  font-size: var(--text-base);
  font-weight: var(--font-weight-semibold);
  color: var(--foreground);
}

:global(.asset-file-form__file-card) {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-2xl);
  background-color: var(--background);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  margin-bottom: var(--spacing-md);
}

:global(.asset-file-form__file-info) {
  display: flex;
  flex-direction: column;
  gap: var(--gap-xs);
}

:global(.asset-file-form__file-name) {
  font-size: var(--text-base);
  font-weight: var(--font-weight-medium);
  color: var(--foreground);
}

:global(.asset-file-form__file-size) {
  font-size: var(--text-sm);
  color: var(--muted-foreground);
}

:global(.asset-file-form__replace-note) {
  margin: 0;
  font-size: var(--text-sm);
  color: var(--muted-foreground);
  font-style: italic;
}

:global(.asset-file-form__selected) {
  margin: var(--spacing-md) 0 0 0;
  padding: var(--spacing-md);
  background-color: var(--muted);
  border-radius: var(--radius-md);
  font-size: var(--text-sm);
  color: var(--foreground);
}

/* ===== Asset Images Form ===== */
:global(.asset-images-form__existing) {
  margin-bottom: var(--spacing-2xl);
}

:global(.asset-images-form__existing-title) {
  margin: 0 0 var(--spacing-md) 0;
  font-size: var(--text-base);
  font-weight: var(--font-weight-semibold);
  color: var(--foreground);
}

