---
import Layout from "@/layouts/Layout.astro";
import Card from "@/components/Card.astro";
import CardHeader from "@/components/CardHeader.astro";
import CardTitle from "@/components/CardTitle.astro";
import CardDescription from "@/components/CardDescription.astro";
import CardContent from "@/components/CardContent.astro";
import Button from "@/components/Button.astro";
import Tag from "@/components/Tag.astro";
import TagList from "@/components/TagList.astro";
import AddToProductForm from "@/components/islands/AddToProductForm";
import { getAssetByHandle, getAssetFiles, getAssetImages, getAssetTags } from "@/lib/data-access/assets";
import { getUserById } from "@/lib/data-access/users";
import { getAssetRoyalties } from "@/lib/data-access/royalties";
import { getProductsUsingAsset } from "@/lib/data-access/products";
import { setSession } from "@/lib/auth";

const { asset } = Astro.params;

if (!asset) {
  return Astro.redirect('/404');
}

// Check authentication first
const accessToken = Astro.cookies.get("sb-access-token");
const refreshToken = Astro.cookies.get("sb-refresh-token");

// Fetch the asset
const assetData = await getAssetByHandle(asset);

console.log("Fetched asset data:", assetData);

if (!assetData) {
  return Astro.redirect('/404');
}

// Fetch the asset owner
const owner = await getUserById(assetData.user_id);

// Fetch asset files, images, tags, and royalties
const files = await getAssetFiles(assetData.id);
const images = await getAssetImages(assetData.id);
const tags = await getAssetTags(assetData.id);
const royalties = await getAssetRoyalties(assetData.id);

// Fetch user information for each royalty
const royaltiesWithUsers = await Promise.all(
  royalties.map(async (royalty) => {
    const user = await getUserById(royalty.user_id);
    return { ...royalty, user };
  })
);

// Fetch products using this asset
const productsUsingAsset = await getProductsUsingAsset(assetData.id, 5);

// Get current user for ownership check
let currentUser = null;
if (accessToken && refreshToken) {
  try {
    const session = await setSession({
      refresh_token: refreshToken.value,
      access_token: accessToken.value,
    });
    if (!session.error && session.data.user) {
      currentUser = session.data.user;
    }
  } catch (error) {
    // User not authenticated, continue as guest
  }
}

const isOwner = currentUser?.id === assetData.user_id;

---

<Layout title={`${assetData.title} - Game Loopers`}>
  <div class="page">
    <div class="page__container">
      <!-- Asset Header -->
      <Card className="asset-card">
        <CardHeader>
          <div class="asset-header">
            <div class="asset-header__info">
              <div class="asset-header__title-row">
                <CardTitle>{assetData.title}</CardTitle>
                {isOwner && (
                  <div class="asset-header__actions">
                    <a href={`/assets/${asset}/edit`} class="asset-header__edit-button">
                      <Button variant="outline" size="sm">
                        <span slot="text">Edit</span>
                      </Button>
                    </a>
                  </div>
                )}
              </div>
              <div class="asset-header__meta">
                <span class="asset-header__author">
                  by <a href={`/users/${owner?.handle}`} class="asset-header__author-link">
                    {owner?.name || owner?.handle}
                  </a>
                </span>
                <span class="asset-header__status asset-header__status--{assetData.status}">
                  {assetData.status}
                </span>
              </div>
              {assetData.description && (
                <CardDescription>{assetData.description}</CardDescription>
              )}
              {tags.length > 0 && (
                <TagList className="asset-tags">
                  {tags.map((tag) => (
                    <Tag>{tag.value}</Tag>
                  ))}
                </TagList>
              )}
            </div>
          </div>
        </CardHeader>

        <CardContent>
          <div class="asset-stats">
            <div class="asset-stats__item">
              <p class="asset-stats__value">{assetData.download_count}</p>
              <p class="asset-stats__label">Downloads</p>
            </div>
            <div class="asset-stats__item">
              <p class="asset-stats__value">{files.length}</p>
              <p class="asset-stats__label">Files</p>
            </div>
            <div class="asset-stats__item">
              <p class="asset-stats__value">{images.length}</p>
              <p class="asset-stats__label">Images</p>
            </div>
          </div>
        </CardContent>
      </Card>

      <!-- Asset Images -->
      {images.length > 0 && (
        <Card>
          <CardHeader>
            <CardTitle>Images</CardTitle>
          </CardHeader>
          <CardContent>
            <div class="asset-images">
              {images.map((image) => (
                <div class="asset-image">
                  <img
                    src={image.file_url}
                    alt={image.title}
                    class="asset-image__img"
                  />
                  <p class="asset-image__title">{image.title}</p>
                </div>
              ))}
            </div>
          </CardContent>
        </Card>
      )}

      <!-- Asset Files -->
      {files.length > 0 && (
        <Card>
          <CardHeader>
            <CardTitle>Files</CardTitle>
          </CardHeader>
          <CardContent>
            <div class="asset-files">
              {files.map((file) => (
                <div class="asset-file">
                  <div class="asset-file__info">
                    <p class="asset-file__title">{file.title}</p>
                    {file.description && (
                      <p class="asset-file__description">{file.description}</p>
                    )}
                    <p class="asset-file__meta">
                      {(file.file_size_bytes / 1024 / 1024).toFixed(2)} MB
                      {file.mime_type && ` • ${file.mime_type}`}
                    </p>
                  </div>
                  <a
                    href={file.file_url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="asset-file__download"
                  >
                    <Button variant="outline" size="sm">
                      <span slot="text">Download</span>
                    </Button>
                  </a>
                </div>
              ))}
            </div>
          </CardContent>
        </Card>
      )}

      <!-- Licensing (Read-only) -->
      <Card>
        <CardHeader>
          <CardTitle>Licensing</CardTitle>
          <CardDescription>
            The license terms that will apply when this asset is added to a product
          </CardDescription>
        </CardHeader>
        <CardContent>
          <div class="license-info">
            <h3 class="license-info__title">License Terms</h3>
            <p class="license-info__text">
              Standard License - Personal & Commercial Use
            </p>
            <a href="/licenses/standard">
                <Button variant="ghost" size="sm">
                <span slot="text"><p>Read License</p></span>
                </Button>
            </a>
          </div>
        </CardContent>
      </Card>

      <!-- Royalties (Read-only) -->
      <Card>
        <CardHeader>
          <CardTitle>Royalty Distribution</CardTitle>
          <CardDescription>
            How revenue will be split when this asset is added to a product
          </CardDescription>
        </CardHeader>
        <CardContent>
          {royaltiesWithUsers.length > 0 ? (
            <div class="royalty-info">
              <div class="royalty-list">
                {royaltiesWithUsers.map((royalty) => (
                  <div class={`royalty-item ${royalty.user_id === assetData.user_id ? 'royalty-item--owner' : ''}`}>
                    <div class="royalty-item__info">
                      <p class="royalty-item__user">
                        {royalty.user?.name || royalty.user?.handle || "Unknown User"}
                        {royalty.user_id === assetData.user_id && (
                          <span class="royalty-item__badge">Owner</span>
                        )}
                      </p>
                    </div>
                    <div class="royalty-item__value">
                      <p>{`$${(royalty.royalty_value / 100).toFixed(2)}`}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          ) : (
            <p class="royalty-info__empty">
              No royalty splits configured. Edit this asset to add royalty recipients.
            </p>
          )}
        </CardContent>
      </Card>

      <!-- Add to Product (Owner only) -->
      {isOwner && (
        <Card>
          <CardHeader>
            <CardTitle>Add to Product</CardTitle>
            <CardDescription>
              Link this asset to an existing product or create a new one. The product will automatically inherit this asset's licensing and royalties.
            </CardDescription>
          </CardHeader>
          <CardContent>
            <AddToProductForm client:load assetId={assetData.id} />
          </CardContent>
        </Card>
      )}

      <!-- Products Using This Asset -->
      {productsUsingAsset.length > 0 && (
        <Card>
          <CardHeader>
            <CardTitle>Products Using This Asset</CardTitle>
            <CardDescription>
              This asset is currently used in {productsUsingAsset.length} {productsUsingAsset.length === 1 ? 'product' : 'products'}
            </CardDescription>
          </CardHeader>
          <CardContent>
            <div class="products-list">
              {productsUsingAsset.map((product) => (
                <a href={`/products/${product.handle}`} class="product-card">
                  <div class="product-card__info">
                    <h3 class="product-card__title">{product.title}</h3>
                    <p class="product-card__handle">/{product.handle}</p>
                  </div>
                  <div class="product-card__status">
                    <span class={`product-card__badge product-card__badge--${product.status}`}>
                      {product.status}
                    </span>
                  </div>
                </a>
              ))}
            </div>
          </CardContent>
        </Card>
      )}

      <!-- Empty State -->
      {files.length === 0 && images.length === 0 && (
        <Card>
          <CardContent>
            <div class="asset-empty">
              <p class="asset-empty__text">
                {isOwner
                  ? "No files or images uploaded yet."
                  : "This asset doesn't have any files or images yet."
                }
              </p>
            </div>
          </CardContent>
        </Card>
      )}
    </div>
  </div>
</Layout>

<style>
/* ===== Asset Page Layout ===== */
.asset-page {
  min-height: calc(100vh - 64px);
  background-color: var(--background);
  padding: var(--spacing-4xl) var(--spacing-2xl);
}

.asset-page__container {
  max-width: 960px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: var(--gap-xl);
}

/* ===== Asset Header ===== */
.asset-header {
  display: flex;
  gap: var(--gap-xl);
  align-items: flex-start;
}

.asset-header__info {
  flex: 1;
}

.asset-header__title-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: var(--gap-lg);
}

.asset-header__actions {
  display: flex;
  gap: var(--gap-sm);
  flex-shrink: 0;
}

.asset-header__edit-button {
  text-decoration: none;
}

.asset-header__meta {
  display: flex;
  align-items: center;
  gap: var(--gap-lg);
  margin-top: var(--spacing-sm);
}

.asset-header__author {
  font-size: var(--text-sm);
  color: var(--muted-foreground);
}

.asset-header__author-link {
  color: var(--primary);
  text-decoration: none;
  font-weight: var(--font-weight-medium);
}

.asset-header__author-link:hover {
  text-decoration: underline;
}

.asset-header__status {
  display: inline-block;
  padding: var(--spacing-xxs) var(--spacing-lg);
  font-size: var(--text-xs);
  font-weight: var(--font-weight-semibold);
  border-radius: var(--radius-full);
  text-transform: uppercase;
}

.asset-header__status--draft {
  background-color: oklch(0.95 0.05 85);
  color: oklch(0.35 0.08 75);
}

.asset-header__status--published {
  background-color: oklch(0.95 0.05 150);
  color: oklch(0.35 0.08 160);
}

.asset-header__status--archived {
  background-color: var(--muted);
  color: var(--muted-foreground);
}

/* ===== Asset Stats ===== */
.asset-stats {
  display: flex;
  gap: var(--spacing-4xl);
  padding: var(--spacing-2xl) 0;
}

.asset-stats__item {
  display: flex;
  flex-direction: column;
  gap: var(--gap-xxs);
}

.asset-stats__value {
  margin: 0;
  font-size: var(--text-2xl);
  font-weight: var(--font-weight-semibold);
  color: var(--foreground);
  line-height: var(--leading-tight);
}

.asset-stats__label {
  margin: 0;
  font-size: var(--text-sm);
  color: var(--muted-foreground);
  line-height: var(--leading-normal);
}

/* ===== Asset Images ===== */
.asset-images {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: var(--gap-lg);
}

.asset-image {
  display: flex;
  flex-direction: column;
  gap: var(--gap-sm);
}

.asset-image__img {
  width: 100%;
  height: 200px;
  object-fit: cover;
  border-radius: var(--radius-md);
  border: 1px solid var(--border);
}

.asset-image__title {
  margin: 0;
  font-size: var(--text-sm);
  font-weight: var(--font-weight-normal);
  color: var(--foreground);
  line-height: var(--leading-normal);
}

/* ===== Asset Files ===== */
.asset-files {
  display: flex;
  flex-direction: column;
  gap: var(--gap-lg);
}

.asset-file {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--gap-lg);
  padding: var(--spacing-2xl);
  background-color: var(--muted);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
}

.asset-file__info {
  flex: 1;
}

.asset-file__title {
  margin: 0 0 var(--spacing-xxs);
  font-size: var(--text-base);
  font-weight: var(--font-weight-medium);
  color: var(--foreground);
  line-height: var(--leading-normal);
}

.asset-file__description {
  margin: 0 0 var(--spacing-xxs);
  font-size: var(--text-sm);
  color: var(--muted-foreground);
}

.asset-file__meta {
  margin: 0;
  font-size: var(--text-sm);
  color: var(--muted-foreground);
}

.asset-file__download a {
  text-decoration: none;
}

/* ===== Empty State ===== */
.asset-empty {
  text-align: center;
  padding: var(--spacing-5xl) var(--spacing-3xl);
}

.asset-empty__text {
  margin: 0;
  font-size: var(--text-base);
  color: var(--muted-foreground);
}

/* ===== Asset Tags ===== */
.asset-tags {
  margin-top: var(--spacing-2xl);
}

/* ===== License Info ===== */
.license-info {
  padding: var(--spacing-2xl);
  background-color: var(--muted);
  border-radius: var(--radius-md);
}

.license-info__title {
  margin: 0 0 var(--spacing-md) 0;
  font-size: var(--text-base);
  font-weight: var(--font-weight-semibold);
  color: var(--foreground);
}

.license-info__text {
  margin: 0 0 var(--spacing-sm) 0;
  font-size: var(--text-sm);
  color: var(--foreground);
}

.license-info__note {
  margin: 0;
  font-size: var(--text-sm);
  color: var(--muted-foreground);
  font-style: italic;
}

/* ===== Royalty Info ===== */
.royalty-info {
  display: flex;
  flex-direction: column;
  gap: var(--gap-xl);
}

.royalty-info__empty {
  margin: 0;
  padding: var(--spacing-4xl);
  font-size: var(--text-sm);
  color: var(--muted-foreground);
  text-align: center;
}

/* ===== Royalty List (read-only) ===== */
.royalty-list {
  display: flex;
  flex-direction: column;
  gap: var(--gap-md);
}

.royalty-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-2xl);
  background-color: var(--muted);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
}

.royalty-item--owner {
  background-color: oklch(0.95 0.02 250);
  border-color: var(--primary);
  border-width: 2px;
}

.royalty-item__info {
  display: flex;
  flex-direction: column;
  gap: var(--gap-sm);
}

.royalty-item__user {
  margin: 0;
  font-size: var(--text-base);
  font-weight: var(--font-weight-semibold);
  color: var(--foreground);
  display: flex;
  align-items: center;
  gap: var(--gap-sm);
}

.royalty-item__badge {
  display: inline-block;
  padding: var(--spacing-xxs) var(--spacing-sm);
  font-size: var(--text-xs);
  font-weight: var(--font-weight-medium);
  line-height: var(--leading-tight);
  background-color: var(--primary);
  color: var(--primary-foreground);
  border-radius: var(--radius-full);
}

.royalty-item__value {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: var(--gap-xs);
  font-size: var(--text-lg);
  font-weight: var(--font-weight-bold);
  color: var(--primary);
}

.royalty-item__type {
  font-size: var(--text-sm);
  font-weight: var(--font-weight-normal);
  color: var(--muted-foreground);
}

.royalty-total {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-2xl);
  border-top: 2px solid var(--border);
  margin-top: var(--spacing-md);
}

.royalty-total--warning {
  border-top-color: oklch(0.65 0.15 70);
  background-color: oklch(0.97 0.03 85);
}

.royalty-total__label {
  margin: 0;
  font-size: var(--text-base);
  font-weight: var(--font-weight-semibold);
  color: var(--foreground);
  line-height: var(--leading-normal);
}

.royalty-total__value {
  margin: 0;
  font-size: var(--text-xl);
  font-weight: var(--font-weight-bold);
  color: var(--primary);
  line-height: var(--leading-tight);
}

.royalty-total__value--warning {
  color: var(--destructive);
}

.royalty-warning {
  display: flex;
  gap: var(--gap-md);
  padding: var(--spacing-2xl);
  background-color: oklch(0.97 0.03 85);
  border: 1px solid oklch(0.65 0.15 70);
  border-radius: var(--radius-md);
}

.royalty-warning__icon {
  font-size: var(--text-xl);
  flex-shrink: 0;
}

.royalty-warning__content {
  flex: 1;
}

.royalty-warning__content strong {
  display: block;
  font-size: var(--text-sm);
  font-weight: var(--font-weight-semibold);
  color: oklch(0.35 0.08 75);
  line-height: var(--leading-normal);
  margin-bottom: var(--spacing-xs);
}

.royalty-warning__content p {
  margin: 0;
  font-size: var(--text-sm);
  font-weight: var(--font-weight-normal);
  color: oklch(0.35 0.08 75);
  line-height: var(--leading-relaxed);
}

/* ===== Add to Product Form Styles ===== */
:global(.asset-form__field) {
  display: flex;
  flex-direction: column;
  gap: var(--gap-sm);
}

:global(.asset-form__label) {
  font-size: var(--text-sm);
  font-weight: var(--font-weight-medium);
  color: var(--foreground);
  margin-bottom: var(--spacing-xs);
}

:global(.asset-form__radio-group) {
  display: flex;
  flex-direction: column;
  gap: var(--gap-md);
}

:global(.asset-form__radio) {
  display: flex;
  align-items: center;
  gap: var(--gap-sm);
  padding: var(--spacing-md);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  cursor: pointer;
  transition: background-color var(--duration-fast) var(--ease-in-out),
    border-color var(--duration-fast) var(--ease-in-out);
}

:global(.asset-form__radio:hover) {
  background-color: var(--muted);
}

:global(.asset-form__radio input[type="radio"]) {
  width: 18px;
  height: 18px;
  cursor: pointer;
}

:global(.asset-form__radio span) {
  font-size: var(--text-sm);
  font-weight: var(--font-weight-normal);
  color: var(--foreground);
  line-height: var(--leading-normal);
}

:global(.asset-form__search-status) {
  padding: var(--spacing-md);
  font-size: var(--text-sm);
  color: var(--muted-foreground);
  text-align: center;
}

:global(.asset-form__search-results) {
  display: flex;
  flex-direction: column;
  gap: var(--gap-sm);
  margin-top: var(--spacing-md);
  padding: var(--spacing-md);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  max-height: 20rem;
  overflow-y: auto;
}

:global(.asset-form__search-result) {
  display: flex;
  align-items: flex-start;
  gap: var(--gap-md);
  padding: var(--spacing-md);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  cursor: pointer;
  transition: background-color var(--duration-fast) var(--ease-in-out),
    border-color var(--duration-fast) var(--ease-in-out);
}

:global(.asset-form__search-result:hover) {
  background-color: var(--muted);
  border-color: var(--primary);
}

:global(.asset-form__search-result input[type="radio"]) {
  width: 18px;
  height: 18px;
  margin-top: 2px;
  cursor: pointer;
  flex-shrink: 0;
}

:global(.asset-form__search-result-info) {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: var(--gap-xs);
}

:global(.asset-form__search-result-title) {
  font-size: var(--text-base);
  font-weight: var(--font-weight-medium);
  color: var(--foreground);
  line-height: var(--leading-normal);
}

:global(.asset-form__search-result-meta) {
  font-size: var(--text-sm);
  color: var(--muted-foreground);
  line-height: var(--leading-normal);
}

:global(.asset-form__no-results) {
  padding: var(--spacing-2xl);
  font-size: var(--text-sm);
  color: var(--muted-foreground);
  text-align: center;
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  margin-top: var(--spacing-md);
}

/* ===== Products List ===== */
.products-list {
  display: flex;
  flex-direction: column;
  gap: var(--gap-md);
}

.product-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-2xl);
  background-color: var(--muted);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  text-decoration: none;
  transition: background-color var(--duration-fast) var(--ease-in-out),
    border-color var(--duration-fast) var(--ease-in-out),
    box-shadow var(--duration-fast) var(--ease-in-out);
}

.product-card:hover {
  background-color: oklch(from var(--muted) calc(l * 0.98) c h);
  border-color: var(--primary);
  box-shadow: var(--shadow-sm);
}

.product-card__info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: var(--gap-xs);
}

.product-card__title {
  margin: 0;
  font-size: var(--text-base);
  font-weight: var(--font-weight-semibold);
  color: var(--foreground);
  line-height: var(--leading-normal);
}

.product-card__handle {
  margin: 0;
  font-size: var(--text-sm);
  font-weight: var(--font-weight-normal);
  color: var(--muted-foreground);
  line-height: var(--leading-normal);
