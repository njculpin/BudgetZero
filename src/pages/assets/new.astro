---
import Layout from "@/layouts/Layout.astro";
import Card from "@/components/Card.astro";
import CardContent from "@/components/CardContent.astro";
import Label from "@/components/Label.astro";
import Input from "@/components/Input.astro";
import Button from "@/components/Button.astro";
import { setSession } from "@/lib/auth";

import PageHeader from "@/components/PageHeader.astro";

const { cookies, redirect, request } = Astro;

// Check authentication
const accessToken = cookies.get("sb-access-token");
const refreshToken = cookies.get("sb-refresh-token");

if (!accessToken || !refreshToken) {
  return redirect("/sign-in");
}

let session;
try {
  session = await setSession({
    refresh_token: refreshToken.value,
    access_token: accessToken.value,
  });
  if (session.error) {
    cookies.delete("sb-access-token", { path: "/" });
    cookies.delete("sb-refresh-token", { path: "/" });
    return redirect("/sign-in");
  }
} catch (error) {
  cookies.delete("sb-access-token", { path: "/" });
  cookies.delete("sb-refresh-token", { path: "/" });
  return redirect("/sign-in");
}

const userId = session.data.user?.id;

if (!userId) {
  return redirect("/sign-in");
}

---

<Layout title="Create Asset - Game Loopers">
  <div class="page">
    <div class="page__container">
      
      <PageHeader title="Create Asset" description="Upload digital files, 3D models, PDFs, or artwork to share with the community"/>

      <Card className="asset-create-card">
        <CardContent>
          <form method="post" enctype="multipart/form-data" class="asset-form">
            <div class="asset-form__field">
              <Label for="title"><p>Title *</p></Label>
              <Input
                type="text"
                name="title"
                id="title"
                placeholder="My Awesome Asset"
                required
              />
            </div>

            <div class="asset-form__field">
              <Label for="description"><p>Description</p></Label>
              <textarea
                name="description"
                id="description"
                placeholder="Describe your asset..."
                rows="4"
                class="asset-form__textarea"
              ></textarea>
            </div>

            <div class="asset-form__field">
              <Label for="tags"><p>Tags</p></Label>
              <!-- <TagInput name="tags" /> -->
            </div>

            <div class="asset-form__field">
              <Label for="file"><p>Asset Files</p></Label>
              <input
                type="file"
                name="files"
                id="files"
                multiple
                class="asset-form__file-input"
              />
              <p class="asset-form__help-text">
                Upload your asset files (PDF, STL, OBJ, ZIP, etc.) - you can select multiple files
              </p>
            </div>

            <div class="asset-form__field">
              <Label for="images"><p>Cover Images</p></Label>
              <input
                type="file"
                name="images"
                id="images"
                accept="image/*"
                multiple
                class="asset-form__file-input"
              />
              <p class="asset-form__help-text">
                Upload cover images for your asset - you can select multiple images
              </p>
            </div>

            <div class="asset-form__field">
              <Label for="status"><p>Status</p></Label>
              <select name="status" id="status" class="asset-form__select">
                <option value="draft">Draft</option>
                <option value="published">Published</option>
              </select>
              <p class="asset-form__help-text">
                Published assets are visible to everyone
              </p>
            </div>

            <div class="asset-form__actions">
              <a href="/dashboard">
                <Button type="button" variant="ghost" size="md">
                  <p slot="text">Cancel</p>
                </Button>
              </a>
              <Button type="submit" variant="primary" size="md">
                <p slot="text">Create Asset</p>
              </Button>
            </div>
          </form>
        </CardContent>
      </Card>
    </div>
  </div>
</Layout>

<style>
.asset-create-page__error {
  padding: var(--spacing-2xl);
  background-color: #fee2e2;
  border: 1px solid #ef4444;
  border-radius: var(--radius-md);
  color: #dc2626;
  margin-bottom: var(--spacing-3xl);
}

.asset-create-page__success {
  padding: var(--spacing-2xl);
  background-color: #d1fae5;
  border: 1px solid #10b981;
  border-radius: var(--radius-md);
  color: #059669;
  margin-bottom: var(--spacing-3xl);
}

/* ===== Asset Form ===== */
.asset-form {
  display: flex;
  flex-direction: column;
  gap: var(--gap-xl);
}

.asset-form__field {
  display: flex;
  flex-direction: column;
  gap: var(--gap-xs);
}

.asset-form__textarea {
  padding: var(--spacing-md) var(--spacing-xl);
  font-size: var(--text-base);
  font-family: inherit;
  line-height: var(--leading-normal);
  color: var(--foreground);
  background-color: var(--background);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  transition: border-color var(--duration-normal) var(--ease-in-out), box-shadow var(--duration-normal) var(--ease-in-out);
  resize: vertical;
}

.asset-form__textarea:focus {
  outline: none;
  border-color: var(--ring);
  box-shadow: 0 0 0 3px oklch(from var(--ring) l c h / 0.2);
}

.asset-form__file-input {
  padding: var(--spacing-md) var(--spacing-xl);
  font-size: var(--text-base);
  font-family: inherit;
  color: var(--foreground);
  background-color: var(--background);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  transition: border-color var(--duration-normal) var(--ease-in-out);
}

.asset-form__file-input:focus {
  outline: none;
  border-color: var(--ring);
}

.asset-form__select {
  padding: var(--spacing-md) var(--spacing-xl);
  font-size: var(--text-base);
  font-family: inherit;
  color: var(--foreground);
  background-color: var(--background);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  transition: border-color var(--duration-normal) var(--ease-in-out);
}

.asset-form__select:focus {
  outline: none;
  border-color: var(--ring);
}

.asset-form__help-text {
  margin: 0;
  font-size: var(--text-sm);
  color: var(--muted-foreground);
}

.asset-form__actions {
  display: flex;
  gap: var(--gap-lg);
  justify-content: flex-end;
  padding-top: var(--spacing-2xl);
}

.asset-form__actions a {
  text-decoration: none;
}

</style>
