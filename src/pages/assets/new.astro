---
import Layout from "@/layouts/Layout.astro";
import Card from "@/components/Card.astro";
import CardHeader from "@/components/CardHeader.astro";
import CardTitle from "@/components/CardTitle.astro";
import CardDescription from "@/components/CardDescription.astro";
import CardContent from "@/components/CardContent.astro";
import Label from "@/components/Label.astro";
import Input from "@/components/Input.astro";
import Button from "@/components/Button.astro";
import TagInput from "@/components/islands/TagInput";
import { setSession } from "@/lib/auth";
import { createAsset, createAssetFile, createAssetImage, createAssetTag } from "@/lib/data-access/assets";
import { uploadAssetFile, uploadAssetImage } from "@/lib/storage";

const { cookies, redirect, request } = Astro;

// Check authentication
const accessToken = cookies.get("sb-access-token");
const refreshToken = cookies.get("sb-refresh-token");

if (!accessToken || !refreshToken) {
  return redirect("/sign-in");
}

let session;
try {
  session = await setSession({
    refresh_token: refreshToken.value,
    access_token: accessToken.value,
  });
  if (session.error) {
    cookies.delete("sb-access-token", { path: "/" });
    cookies.delete("sb-refresh-token", { path: "/" });
    return redirect("/sign-in");
  }
} catch (error) {
  cookies.delete("sb-access-token", { path: "/" });
  cookies.delete("sb-refresh-token", { path: "/" });
  return redirect("/sign-in");
}

const userId = session.data.user?.id;

if (!userId) {
  return redirect("/sign-in");
}

// Handle form submission
let errorMessage = "";
let successMessage = "";

if (request.method === "POST") {
  try {
    const formData = await request.formData();
    const title = formData.get("title") as string;
    const description = formData.get("description") as string;
    const status = formData.get("status") as "draft" | "published";
    const files = formData.getAll("files") as File[];
    const images = formData.getAll("images") as File[];
    const tagsString = formData.get("tags") as string;

    if (!title) {
      errorMessage = "Title is required";
    } else {
      // Create the asset
      const asset = await createAsset(
        userId,
        {
          title,
          description,
          status: status || "draft",
        },
        {
          accessToken: accessToken.value,
          refreshToken: refreshToken.value,
        }
      );

      if (!asset) {
        errorMessage = "Failed to create asset";
      } else {
        // Create tags if provided
        if (tagsString) {
          const tags = JSON.parse(tagsString) as string[];
          for (const tag of tags) {
            await createAssetTag(
              asset.id,
              tag,
              {
                accessToken: accessToken.value,
                refreshToken: refreshToken.value,
              }
            );
          }
        }

        // Upload files if provided
        if (files && files.length > 0) {
          for (const file of files) {
            if (file.size > 0) {
              const fileUpload = await uploadAssetFile(file, userId, asset.id);
              if (fileUpload) {
                await createAssetFile(
                  asset.id,
                  {
                    title: file.name,
                    description: `Uploaded file: ${file.name}`,
                    file_url: fileUpload.url,
                    storage_path: fileUpload.path,
                    file_size_bytes: fileUpload.size,
                    mime_type: file.type,
                  },
                  {
                    accessToken: accessToken.value,
                    refreshToken: refreshToken.value,
                  }
                );
              }
            }
          }
        }

        // Upload images if provided
        if (images && images.length > 0) {
          for (const image of images) {
            if (image.size > 0) {
              const imageUpload = await uploadAssetImage(image, userId, asset.id);
              if (imageUpload) {
                await createAssetImage(
                  asset.id,
                  {
                    title: image.name,
                    description: `Cover image: ${image.name}`,
                    file_url: imageUpload.url,
                    storage_path: imageUpload.path,
                    file_size_bytes: imageUpload.size,
                    mime_type: image.type,
                  },
                  {
                    accessToken: accessToken.value,
                    refreshToken: refreshToken.value,
                  }
                );
              }
            }
          }
        }

        // Redirect to the asset detail page
        return redirect(`/assets/${asset.handle}`);
      }
    }
  } catch (error) {
    console.error("Error creating asset:", error);
    errorMessage = error instanceof Error ? error.message : "An error occurred";
  }
}
---

<Layout title="Create Asset - Game Loopers">
  <div class="asset-create-page">
    <div class="asset-create-page__container">
      <Card className="asset-create-card">
        <CardHeader>
          <CardTitle>Create New Asset</CardTitle>
          <CardDescription>
            Upload digital files, 3D models, PDFs, or artwork to share with the community
          </CardDescription>
        </CardHeader>

        <CardContent>
          {errorMessage && (
            <div class="asset-create-page__error">
              {errorMessage}
            </div>
          )}

          {successMessage && (
            <div class="asset-create-page__success">
              {successMessage}
            </div>
          )}

          <form method="post" enctype="multipart/form-data" class="asset-form">
            <div class="asset-form__field">
              <Label for="title">Title *</Label>
              <Input
                type="text"
                name="title"
                id="title"
                placeholder="My Awesome Asset"
                required
              />
            </div>

            <div class="asset-form__field">
              <Label for="description">Description</Label>
              <textarea
                name="description"
                id="description"
                placeholder="Describe your asset..."
                rows="4"
                class="asset-form__textarea"
              ></textarea>
            </div>

            <div class="asset-form__field">
              <Label for="tags">Tags</Label>
              <TagInput name="tags" />
            </div>

            <div class="asset-form__field">
              <Label for="file">Asset Files</Label>
              <input
                type="file"
                name="files"
                id="files"
                multiple
                class="asset-form__file-input"
              />
              <p class="asset-form__help-text">
                Upload your asset files (PDF, STL, OBJ, ZIP, etc.) - you can select multiple files
              </p>
            </div>

            <div class="asset-form__field">
              <Label for="images">Cover Images</Label>
              <input
                type="file"
                name="images"
                id="images"
                accept="image/*"
                multiple
                class="asset-form__file-input"
              />
              <p class="asset-form__help-text">
                Upload cover images for your asset - you can select multiple images
              </p>
            </div>

            <div class="asset-form__field">
              <Label for="status">Status</Label>
              <select name="status" id="status" class="asset-form__select">
                <option value="draft">Draft</option>
                <option value="published">Published</option>
              </select>
              <p class="asset-form__help-text">
                Published assets are visible to everyone
              </p>
            </div>

            <div class="asset-form__actions">
              <a href="/dashboard">
                <Button type="button" variant="ghost" size="md">
                  <span slot="text">Cancel</span>
                </Button>
              </a>
              <Button type="submit" variant="primary" size="md">
                <span slot="text">Create Asset</span>
              </Button>
            </div>
          </form>
        </CardContent>
      </Card>
    </div>
  </div>
</Layout>

<style>
/* ===== Asset Create Page ===== */
.asset-create-page {
  min-height: calc(100vh - 64px);
  background-color: var(--color-background, #f9fafb);
  padding: var(--spacing-4xl) var(--spacing-2xl);
}

.asset-create-page__container {
  max-width: 720px;
  margin: 0 auto;
}

.asset-create-page__error {
  padding: var(--spacing-2xl);
  background-color: #fee2e2;
  border: 1px solid #ef4444;
  border-radius: var(--radius-md);
  color: #dc2626;
  margin-bottom: var(--spacing-3xl);
}

.asset-create-page__success {
  padding: var(--spacing-2xl);
  background-color: #d1fae5;
  border: 1px solid #10b981;
  border-radius: var(--radius-md);
  color: #059669;
  margin-bottom: var(--spacing-3xl);
}

/* ===== Asset Form ===== */
.asset-form {
  display: flex;
  flex-direction: column;
  gap: var(--gap-xl);
}

.asset-form__field {
  display: flex;
  flex-direction: column;
  gap: var(--gap-xs);
}

.asset-form__textarea {
  width: 100%;
  padding: var(--spacing-md) var(--spacing-xl);
  font-size: var(--text-base);
  font-family: inherit;
  line-height: var(--leading-normal);
  color: var(--foreground);
  background-color: var(--background);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  transition: border-color var(--duration-normal) var(--ease-in-out), box-shadow var(--duration-normal) var(--ease-in-out);
  resize: vertical;
}

.asset-form__textarea:focus {
  outline: none;
  border-color: var(--ring);
  box-shadow: 0 0 0 3px oklch(from var(--ring) l c h / 0.2);
}

.asset-form__file-input {
  width: 100%;
  padding: var(--spacing-md) var(--spacing-xl);
  font-size: var(--text-base);
  font-family: inherit;
  color: var(--foreground);
  background-color: var(--background);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  transition: border-color var(--duration-normal) var(--ease-in-out);
}

.asset-form__file-input:focus {
  outline: none;
  border-color: var(--ring);
}

.asset-form__select {
  width: 100%;
  padding: var(--spacing-md) var(--spacing-xl);
  font-size: var(--text-base);
  font-family: inherit;
  color: var(--foreground);
  background-color: var(--background);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  transition: border-color var(--duration-normal) var(--ease-in-out);
}

.asset-form__select:focus {
  outline: none;
  border-color: var(--ring);
}

.asset-form__help-text {
  margin: 0;
  font-size: var(--text-sm);
  color: var(--muted-foreground);
}

.asset-form__actions {
  display: flex;
  gap: var(--gap-lg);
  justify-content: flex-end;
  padding-top: var(--spacing-2xl);
}

.asset-form__actions a {
  text-decoration: none;
}

</style>
