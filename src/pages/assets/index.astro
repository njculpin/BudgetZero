---
import Layout from "@/layouts/Layout.astro";
import Card from "@/components/Card.astro";
import CardContent from "@/components/CardContent.astro";
import { getAssets, getUserAssets } from "@/lib/data-access/assets";
import { getUserById } from "@/lib/data-access/users";
import PageHeader from "@/components/PageHeader.astro";
import { setSession } from "@/lib/auth";
import AssetCreateButton from "@/components/AssetCreateButton.astro";

const { url, cookies } = Astro;
const searchParams = url.searchParams;

// Check authentication
let currentUser = null;
const accessToken = cookies.get("sb-access-token");
const refreshToken = cookies.get("sb-refresh-token");

if (accessToken && refreshToken) {
  try {
    const session = await setSession({
      refresh_token: refreshToken.value,
      access_token: accessToken.value,
    });
    if (!session.error && session.data.user) {
      currentUser = session.data.user;
    }
  } catch (error) {}
}

// Get search and filter parameters
const searchQuery = searchParams.get('search') || '';
const tagFilter = searchParams.get('tag') || '';
const page = parseInt(searchParams.get('page') || '1');
const limit = 20;
const offset = (page - 1) * limit;

// Prepare auth tokens
const authTokens = currentUser && accessToken && refreshToken
  ? { accessToken: accessToken.value, refreshToken: refreshToken.value }
  : undefined;

// Fetch user's assets if logged in
const userAssets = currentUser
  ? await getUserAssets(currentUser.id, undefined, authTokens)
  : [];

// Fetch all assets with filters
const tagArray = tagFilter ? [tagFilter] : undefined;
const allAssetsFetched = await getAssets(searchQuery, tagArray, limit, offset, authTokens);

// Filter out current user's assets from "All Assets" (they're shown in "Your Assets")
const allAssets = currentUser
  ? allAssetsFetched.filter(asset => asset.user_id !== currentUser.id)
  : allAssetsFetched;

// Fetch asset owners (batch fetch to avoid N+1 queries)
const allAssetsList = [...userAssets, ...allAssets];
const ownerIds = [...new Set(allAssetsList.map(a => a.user_id))];
const owners = await Promise.all(ownerIds.map(id => getUserById(id)));
const ownersMap = new Map(owners.filter(o => o).map(o => [o!.id, o]));
---

<Layout title="Browse Assets - Game Loopers">
  <div class="page">
    <div class="page__container">
      <!-- Page Header -->
      <div class="page-header-with-action">
        <PageHeader title="Assets" description="Browse digital assets for tabletop games."/>
        {currentUser && (
          <AssetCreateButton />
        )}
      </div>

      <!-- Your Assets Section -->
      {currentUser && userAssets.length > 0 && (
        <div class="assets-section">
          <h2 class="assets-section__title">Your Assets</h2>
          <div class="assets-grid">
            {userAssets.map((asset) => {
              return (
                <a href={`/assets/${asset.handle}`} class="asset-card">
                  <div class="asset-card__content">
                    <h3 class="asset-card__title">{asset.title}</h3>
                    {asset.description && (
                      <p class="asset-card__description">
                        {asset.description.substring(0, 100)}{asset.description.length > 100 ? '...' : ''}
                      </p>
                    )}
                    <div class="asset-card__meta">
                      <span class="asset-card__status asset-card__status--{asset.status}">
                        {asset.status}
                      </span>
                    </div>
                    <div class="asset-card__stats">
                      <span class="asset-card__stat">
                        {asset.file_count} file{asset.file_count !== 1 ? 's' : ''}
                      </span>
                      <span class="asset-card__stat">
                        {asset.download_count} download{asset.download_count !== 1 ? 's' : ''}
                      </span>
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      )}

      <!-- All Assets Section -->
      <div class="assets-section">
        <h2 class="assets-section__title">All Assets</h2>
        {allAssets.length > 0 ? (
          <div class="assets-grid">
            {allAssets.map((asset) => {
              const owner = ownersMap.get(asset.user_id);
              return (
                <a href={`/assets/${asset.handle}`} class="asset-card">
                  <div class="asset-card__content">
                    <h3 class="asset-card__title">{asset.title}</h3>
                    {asset.description && (
                      <p class="asset-card__description">
                        {asset.description.substring(0, 100)}{asset.description.length > 100 ? '...' : ''}
                      </p>
                    )}
                    <div class="asset-card__meta">
                      <span class="asset-card__author">
                        by {owner?.name || owner?.handle || 'Unknown'}
                      </span>
                    </div>
                    <div class="asset-card__stats">
                      <span class="asset-card__stat">
                        {asset.file_count} file{asset.file_count !== 1 ? 's' : ''}
                      </span>
                      <span class="asset-card__stat">
                        {asset.download_count} download{asset.download_count !== 1 ? 's' : ''}
                      </span>
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        ) : (
          <Card>
            <CardContent>
              <div class="assets-empty">
                <p class="assets-empty__text">
                  {searchQuery || tagFilter
                    ? "No assets found matching your search criteria."
                    : "No assets available yet."}
                </p>
                {(searchQuery || tagFilter) && (
                  <a href="/assets" class="assets-empty__link">Clear filters</a>
                )}
              </div>
            </CardContent>
          </Card>
        )}
      </div>

      <!-- Pagination -->
      {allAssets.length === limit && (
        <div class="assets-pagination">
          {page > 1 && (
            <a
              href={`/assets?page=${page - 1}${searchQuery ? `&search=${encodeURIComponent(searchQuery)}` : ''}${tagFilter ? `&tag=${encodeURIComponent(tagFilter)}` : ''}`}
              class="assets-pagination__link"
            >
              ← Previous
            </a>
          )}
          <span class="assets-pagination__current">Page {page}</span>
          <a
            href={`/assets?page=${page + 1}${searchQuery ? `&search=${encodeURIComponent(searchQuery)}` : ''}${tagFilter ? `&tag=${encodeURIComponent(tagFilter)}` : ''}`}
            class="assets-pagination__link"
          >
            Next →
          </a>
        </div>
      )}
    </div>
  </div>
</Layout>

<style>
/* ===== Page Header with Action ===== */
.page-header-with-action {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: var(--gap-xl);
  margin-bottom: var(--spacing-2xl);
}

.page-header-action {
  text-decoration: none;
  flex-shrink: 0;
}

/* ===== Assets Section ===== */
.assets-section {
  margin-bottom: var(--spacing-4xl);
}

.assets-section__title {
  font-size: var(--text-xl);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text, #111827);
  margin: 0 0 var(--spacing-2xl);
}

/* ===== Filters ===== */
.assets-filters {
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: var(--gap-xl);
}

.assets-filters__search {
  width: 100%;
}

.assets-filters__label {
  margin: 0 0 var(--spacing-sm);
  font-size: var(--text-sm);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text, #111);
}

.assets-filters__tags {
  display: flex;
  flex-direction: column;
  gap: var(--gap-sm);
}

.assets-filters__tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--gap-sm);
}

.assets-filters__tag-link {
  text-decoration: none;
}

.assets-filters__tag-link--active {
  font-weight: 600;
}

.assets-filters__no-tags {
  margin: 0;
  font-size: var(--text-sm);
  color: var(--color-text-muted, #6b7280);
}

.assets-filters__active {
  padding-top: var(--spacing-2xl);
  border-top: 1px solid var(--color-border, #e5e7eb);
}

.assets-filters__active-list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--gap-sm);
}

.assets-filters__active-item {
  display: inline-flex;
  align-items: center;
  gap: var(--gap-sm);
  padding: var(--spacing-xs) var(--spacing-lg);
  background-color: var(--color-primary, #0070f3);
  color: white;
  border-radius: var(--radius-full);
  font-size: var(--text-sm);
  font-weight: var(--font-weight-medium);
}

.assets-filters__clear {
  color: white;
  text-decoration: none;
  font-size: var(--text-lg);
  line-height: 1;
  cursor: pointer;
}

.assets-filters__clear:hover {
  opacity: 0.8;
}

/* ===== Assets Grid ===== */
.assets-grid {
  width: "100%";
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
  gap: var(--gap-xl);
}

.asset-card {
  display: block;
  padding: var(--spacing-3xl);
  background-color: white;
  border: 1px solid var(--color-border, #e5e7eb);
  border-radius: var(--radius-lg);
  text-decoration: none;
  transition: all var(--duration-normal) var(--ease-in-out);
}

.asset-card:hover {
  border-color: var(--color-primary, #0070f3);
  box-shadow: var(--shadow-md);
  transform: translateY(-2px);
}

.asset-card__content {
  display: flex;
  flex-direction: column;
  gap: var(--gap-md);
}

.asset-card__title {
  margin: 0;
  font-size: var(--text-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text, #111);
}

.asset-card__description {
  margin: 0;
  font-size: var(--text-sm);
  color: var(--color-text-muted, #6b7280);
  line-height: var(--leading-normal);
}

.asset-card__meta {
  display: flex;
  align-items: center;
  gap: var(--gap-sm);
}

.asset-card__author {
  font-size: var(--text-sm);
  color: var(--color-text-muted, #6b7280);
}

.asset-card__stats {
  display: flex;
  gap: var(--gap-lg);
  padding-top: var(--spacing-lg);
  border-top: 1px solid var(--color-border, #e5e7eb);
}

.asset-card__stat {
  font-size: var(--text-sm);
  color: var(--color-text-muted, #6b7280);
}

.asset-card__status {
  display: inline-block;
  padding: var(--spacing-xxs) var(--spacing-lg);
  font-size: var(--text-xs);
  font-weight: var(--font-weight-semibold);
  border-radius: var(--radius-full);
  text-transform: uppercase;
}

.asset-card__status--draft {
  background-color: #fef3c7;
  color: #92400e;
}

.asset-card__status--published {
  background-color: #d1fae5;
  color: #065f46;
}

.asset-card__status--archived {
  background-color: #e5e7eb;
  color: #374151;
}

/* ===== Empty State ===== */
.assets-empty {
  text-align: center;
  padding: var(--spacing-5xl) var(--spacing-3xl);
}

.assets-empty__text {
  margin: 0 0 var(--spacing-2xl);
  font-size: var(--text-base);
  color: var(--color-text-muted, #6b7280);
}

.assets-empty__link {
  display: inline-block;
  color: var(--color-primary, #0070f3);
  text-decoration: none;
  font-weight: var(--font-weight-medium);
}

.assets-empty__link:hover {
  text-decoration: underline;
}

/* ===== Pagination ===== */
.assets-pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: var(--gap-xl);
  padding: var(--spacing-3xl) 0;
}

.assets-pagination__link {
  color: var(--color-primary, #0070f3);
  text-decoration: none;
  font-weight: var(--font-weight-medium);
  padding: var(--spacing-sm) var(--spacing-2xl);
  border-radius: var(--radius-md);
  transition: background-color var(--duration-normal) var(--ease-in-out);
}

.assets-pagination__link:hover {
  background-color: var(--color-background, #f9fafb);
}

.assets-pagination__current {
  font-size: var(--text-sm);
  color: var(--color-text-muted, #6b7280);
}
</style>
