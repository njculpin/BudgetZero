---
import Layout from "@/layouts/Layout.astro";
import Card from "@/components/Card.astro";
import CardContent from "@/components/CardContent.astro";
import BrowseCTA from "@/components/home/BrowseCTA.astro";
import { getAssets, getAssetImages, getAssetFiles } from "@/lib/data-access/assets";
import { getUserById } from "@/lib/data-access/users";
import { getAllTags } from "@/lib/data-access/tags";
import PageHeader from "@/components/PageHeader.astro";
import { setSession } from "@/lib/auth";
import Button from "@/components/Button.astro";
import EmptyState from "@/components/EmptyState.astro";
import { FormSubmitButton } from "@/components/interactive";

const { url, cookies } = Astro;
const searchParams = url.searchParams;

// Check authentication
let currentUser = null;
const accessToken = cookies.get("sb-access-token");
const refreshToken = cookies.get("sb-refresh-token");

if (accessToken && refreshToken) {
  try {
    const session = await setSession({
      refresh_token: refreshToken.value,
      access_token: accessToken.value,
    });
    if (!session.error && session.data.user) {
      currentUser = session.data.user;
    }
  } catch (error) {}
}

// Get search and filter parameters
const searchQuery = searchParams.get('search') || '';
const tagFilter = searchParams.get('tag') || '';
const page = parseInt(searchParams.get('page') || '1');
const limit = 20;
const offset = (page - 1) * limit;

// Fetch all assets with filters
const tagArray = tagFilter ? [tagFilter] : undefined;
const allAssets = await getAssets(searchQuery, tagArray, limit, offset);

// Fetch first image and files for each asset
const assetsWithDetails = await Promise.all(
  allAssets.map(async (asset) => {
    const images = await getAssetImages(asset.id);
    const files = await getAssetFiles(asset.id);
    return {
      ...asset,
      cover_image_url: images[0]?.file_url || null,
      files: files
    };
  })
);

// Fetch asset owners (batch fetch to avoid N+1 queries)
const ownerIds = [...new Set(assetsWithDetails.map(a => a.user_id))];
const owners = await Promise.all(ownerIds.map(id => getUserById(id)));
const ownersMap = new Map(owners.filter(o => o).map(o => [o!.id, o]));

// Get popular tags for filtering (show top 10 asset tags)
const allTags = await getAllTags();
const assetTags = allTags
  .filter(tag => tag.assetCount > 0)
  .slice(0, 10);
---

<Layout title="Browse Assets - Game Loopers">
  <div class="page">
    <div class="page__container">
      <!-- Page Header -->
      <div class="page-header-with-action">
        <PageHeader title="Assets" description="Browse digital assets for tabletop games."/>
        {currentUser && (
          <FormSubmitButton
            client:load
            action="/api/assets/create-asset"
            method="post"
            variant="primary"
            size="lg"
          >
            Create Asset
          </FormSubmitButton>
        )}
      </div>

      <!-- Search Form -->
      <form method="get" action="/assets" class="browse-search">
        <div class="browse-search__wrapper">
          <input
            type="text"
            name="search"
            value={searchQuery}
            placeholder="Search assets..."
            class="browse-search__input"
            aria-label="Search assets"
          />
          <button type="submit" class="browse-search__btn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="11" cy="11" r="8" />
              <line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
            <span>Search</span>
          </button>
        </div>
        {(searchQuery || tagFilter) && (
          <a href="/assets" class="browse-search__clear">Clear filters</a>
        )}
      </form>

      <!-- Tag Filters -->
      {assetTags.length > 0 && (
        <div class="browse-tags">
          <span class="browse-tags__label">Filter by tag:</span>
          <div class="browse-tags__list">
            {assetTags.map((tag) => (
              <a
                href={tagFilter === tag.value
                  ? `/assets${searchQuery ? `?search=${encodeURIComponent(searchQuery)}` : ''}`
                  : `/assets?tag=${encodeURIComponent(tag.value)}${searchQuery ? `&search=${encodeURIComponent(searchQuery)}` : ''}`
                }
                class:list={[
                  "browse-tags__tag",
                  { "browse-tags__tag--active": tagFilter === tag.value }
                ]}
              >
                {tag.value}
                <span class="browse-tags__count">({tag.assetCount})</span>
              </a>
            ))}
          </div>
        </div>
      )}

      {!currentUser && (
        <Card>
          <CardContent>
            <BrowseCTA message="Sign in to create and sell your digital assets" />
          </CardContent>
        </Card>
      )}

      <!-- All Assets Section -->
      <section class="browse-section">
        {assetsWithDetails.length > 0 ? (
          <div class="browse-grid">
            {assetsWithDetails.map((asset) => {
              const owner = ownersMap.get(asset.user_id);
              return (
                <a href={`/assets/${asset.handle}`} class="browse-card">
                  <div class="browse-card__content">
                    <img
                      src={asset.cover_image_url || 'https://placehold.co/600x600'}
                      alt={asset.title}
                      class="browse-card__image"
                      loading="lazy"
                    />
                    <h3 class="browse-card__title">{asset.title}</h3>
                    {asset.description && (
                      <p class="browse-card__description">
                        {asset.description.substring(0, 100)}{asset.description.length > 100 ? '...' : ''}
                      </p>
                    )}
                    {asset.files && asset.files.length > 0 && (
                      <div class="browse-card__files">
                        <span class="browse-card__files-label">Includes:</span>
                        <ul class="browse-card__files-list">
                          {asset.files.slice(0, 3).map((file) => {
                            // Extract file extension from mime_type or title
                            const extension = file.mime_type.split('/')[1]?.toUpperCase() ||
                                            file.title.split('.').pop()?.toUpperCase() ||
                                            'FILE';
                            return (
                              <li class="browse-card__file-item">
                                <span class="browse-card__file-type">{extension}</span>
                                <span class="browse-card__file-name">{file.title}</span>
                              </li>
                            );
                          })}
                          {asset.files.length > 3 && (
                            <li class="browse-card__file-item browse-card__file-item--more">
                              +{asset.files.length - 3} more file{asset.files.length - 3 > 1 ? 's' : ''}
                            </li>
                          )}
                        </ul>
                      </div>
                    )}
                    <div class="browse-card__meta">
                      <span class="browse-card__author">
                        by {owner?.name || owner?.handle || 'Unknown'}
                      </span>
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        ) : (
          <Card>
            <CardContent>
              {searchQuery || tagFilter ? (
                <EmptyState
                  icon="search"
                  title="No assets found"
                  description="Try adjusting your search or clearing filters to see more results."
                  actionText="Clear filters"
                  actionHref="/assets"
                />
              ) : (
                <EmptyState
                  icon="assets"
                  title="No assets yet"
                  description="Be the first to upload an asset and share your creative work with the community."
                  actionText={currentUser ? "Create Asset" : "Sign in to create"}
                  actionHref={currentUser ? "/api/assets/create-asset" : "/sign-in"}
                />
              )}
            </CardContent>
          </Card>
        )}
      </section>

      <!-- Pagination -->
      {assetsWithDetails.length === limit && (
        <div class="browse-pagination">
          {page > 1 && (
            <a
              href={`/assets?page=${page - 1}${searchQuery ? `&search=${encodeURIComponent(searchQuery)}` : ''}${tagFilter ? `&tag=${encodeURIComponent(tagFilter)}` : ''}`}
              class="browse-pagination__link"
            >
              ← Previous
            </a>
          )}
          <span class="browse-pagination__current">Page {page}</span>
          <a
            href={`/assets?page=${page + 1}${searchQuery ? `&search=${encodeURIComponent(searchQuery)}` : ''}${tagFilter ? `&tag=${encodeURIComponent(tagFilter)}` : ''}`}
            class="browse-pagination__link"
          >
            Next →
          </a>
        </div>
      )}
    </div>
  </div>
</Layout>

