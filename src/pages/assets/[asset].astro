---
import Layout from "@/layouts/Layout.astro";
import Button from "@/components/Button.astro";
import Tag from "@/components/Tag.astro";
import { getAssetByHandle, getAssetFiles, getAssetImages, getAssetTags, getAssetContributors } from "@/lib/data-access/assets";
import { getUserById } from "@/lib/data-access/users";
import { getAssetRoyalties } from "@/lib/data-access/royalties";
import { setSession } from "@/lib/auth";
import CardTitle from "@/components/CardTitle.astro";
import AssetChat from "@/components/islands/AssetChat";
import Card from "@/components/Card.astro";
import CardDescription from "@/components/CardDescription.astro";
import CardContent from "@/components/CardContent.astro";
import CardHeader from "@/components/CardHeader.astro";
import CardFooter from "@/components/CardFooter.astro";
import GalleryGrid from "@/components/GalleryGrid.astro";
import AssetTagsForm from "@/components/islands/AssetTagsForm";
import AssetFileForm from "@/components/islands/AssetFileForm";
import AssetImagesForm from "@/components/islands/AssetImagesForm";
import AssetBasicInfoForm from "@/components/islands/AssetBasicInfoForm";
import AssetStatusEditor from "@/components/islands/AssetStatusEditor";
import AssetProductPicker from "@/components/islands/AssetProductPicker";
import AssetRoyaltyManager from "@/components/islands/AssetRoyaltyManager";
import EditableBreadcrumb from "@/components/islands/EditableBreadcrumb";

const { asset } = Astro.params;

if (!asset) {
  return Astro.redirect('/404');
}

const accessToken = Astro.cookies.get("sb-access-token");
const refreshToken = Astro.cookies.get("sb-refresh-token");

const assetData = await getAssetByHandle(asset);

if (!assetData) {
  return Astro.redirect('/404');
}

const owner = await getUserById(assetData.user_id);
const files = await getAssetFiles(assetData.id);
const imagesData = await getAssetImages(assetData.id);
const contributorData = await getAssetContributors(assetData.id)
const contributorIds = contributorData.map(x => x.id)
const contributorImages = contributorData.map(function(x) {return {
  url: x.avatar_url,
  alt: x.name,
  href: `/users/${x.handle}`
}})
const images = imagesData.map(function(x){return {
  url: x.file_url,
  alt: x.title,
  href: x.file_url
}})
// Use first image as hero background
const heroImage = imagesData[0]?.file_url || null;
const tags = await getAssetTags(assetData.id);
const royalties = await getAssetRoyalties(assetData.id);

const royaltiesWithUsers = await Promise.all(
  royalties.map(async (royalty) => {
    const user = await getUserById(royalty.user_id);
    return { ...royalty, user };
  })
);

let currentUser = null;
if (accessToken && refreshToken) {
  try {
    const session = await setSession({
      refresh_token: refreshToken.value,
      access_token: accessToken.value,
    });
    if (!session.error && session.data.user) {
      currentUser = session.data.user;
    }
  } catch (error) {}
}

const curredUserId = `${currentUser?.id}`
const isOwner = curredUserId === assetData.user_id;
const totalRoyalty = royalties.reduce((sum, r) => sum + r.royalty_value, 0);

// State Management: Contributors see edit mode, non-contributors see shop mode
const isContributor = contributorIds.includes(curredUserId)
const isEditMode = isContributor;
const isShopMode = !isContributor;
---

<Layout title={`${assetData.title} - Game Loopers`}>
  <div class="page">
    <div class="page__container">
      <!-- Breadcrumb Navigation -->
      {isEditMode ? (
        <EditableBreadcrumb
          client:load
          entityId={assetData.id}
          entityType="asset"
          currentTitle={assetData.title}
          breadcrumbItems={[
            { label: "Home", href: "/" },
            { label: "Assets", href: "/assets" },
          ]}
        />
      ) : (
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <ol class="breadcrumb__list">
            <li class="breadcrumb__item">
              <a href="/" class="breadcrumb__link">Home</a>
            </li>
            <li class="breadcrumb__item">
              <a href="/assets" class="breadcrumb__link">Assets</a>
            </li>
            <li class="breadcrumb__item breadcrumb__item--current" aria-current="page">
              <span class="breadcrumb__current">{assetData.title}</span>
            </li>
          </ol>
        </nav>
      )}

      <!-- Hero Section -->
      <div
        class="asset-hero"
        style={heroImage ? `background-image: url('${heroImage}')` : ''}
      >
        {heroImage && <div class="asset-hero__overlay"></div>}

        <div class="asset-hero__content">
          <h1 class="asset-hero__title">{assetData.title}</h1>
          <div class="asset-hero__meta">
            <span class={`asset-hero__status asset-hero__status--${assetData.status}`}>
              {assetData.status.toUpperCase()}
            </span>
            {owner && (
              <span class="asset-hero__author">
                by <a href={`/users/${owner.handle}`} class="asset-hero__author-link">
                  {owner.name || owner.handle}
                </a>
              </span>
            )}
          </div>
        </div>
      </div>

      <div class="page-columns">
        <div class="page-columns__column">
          {assetData.description && (
            <Card>
              <CardHeader>
                <CardTitle>About This Asset</CardTitle>
              </CardHeader>
              <CardContent>
                {!isEditMode && (
                  <p class="asset-about-text">{assetData.description}</p>
                )}
                {isEditMode && (
                  <AssetBasicInfoForm
                    client:load
                    assetId={assetData.id}
                    initialData={{title: assetData.title, description: assetData.description}}
                  />
                )}
              </CardContent>
            </Card>
          )}

          {!assetData.description && isEditMode && (
            <Card>
              <CardHeader>
                <CardTitle>About This Asset</CardTitle>
                <CardDescription>Add a description to help others understand your asset</CardDescription>
              </CardHeader>
              <CardContent>
                <AssetBasicInfoForm
                  client:load
                  assetId={assetData.id}
                  initialData={{title: assetData.title, description: assetData.description}}
                />
              </CardContent>
            </Card>
          )}

          {(isEditMode || images.length > 0) && (
            <Card>
              <CardHeader>
                <CardTitle>Images</CardTitle>
                <CardDescription>
                  {isEditMode
                    ? 'Upload preview images to showcase your asset'
                    : 'Preview images of the asset'}
                </CardDescription>
              </CardHeader>
              <CardContent>
                {isEditMode &&
                    <AssetImagesForm
                    client:load
                    assetId={assetData.id}
                    existingImages={imagesData.map(i => ({
                      id: i.id,
                      title: i.title,
                      file_url: i.file_url,
                    }))}
                  />
                  }
                  {!isEditMode && images.length > 0 &&
                  <GalleryGrid images={images} cols={3}/>
                  }
                </CardContent>
            </Card>
          )}

          {(isEditMode || files.length > 0) && (
            <Card>
              <CardHeader>
                <CardTitle>Files Included</CardTitle>
                <CardDescription>
                  {isEditMode
                    ? 'Upload files that will be included when this asset is purchased'
                    : 'A list of files included in this asset'}
                </CardDescription>
              </CardHeader>
              <CardContent>
                {isEditMode &&
                  <AssetFileForm
                    client:load
                    assetId={assetData.id}
                    existingFiles={files.map(f => ({
                      id: f.id,
                      title: f.title,
                      file_size_bytes: f.file_size_bytes,
                      file_url: f.file_url,
                    }))}
                  />
                  }
                  {!isEditMode && files.map((file) => (
                  <div class="file-item">
                    <div class="file-item__icon" aria-hidden="true">
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M13 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V9z"/>
                      </svg>
                    </div>
                    <div class="file-item__info">
                      <p class="file-item__name">{file.title}</p>
                      {file.description && (
                        <p class="file-item__description">{file.description}</p>
                      )}
                      <p class="file-item__meta">
                        {(file.file_size_bytes / 1024 / 1024).toFixed(2)} MB
                        {file.mime_type && ` • ${file.mime_type.split('/').pop()?.toUpperCase()}`}
                      </p>
                    </div>
                    <a
                      href={file.file_url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="file-item__download"
                      aria-label={`Download ${file.title}`}
                    >
                      <Button variant="ghost" size="sm">
                        <span slot="text">Download</span>
                      </Button>
                    </a>
                  </div>
                  ))}
              </CardContent>
            </Card>
          )}

          <Card>
            <CardHeader>
              <CardTitle>
                Costs & Royalties
              </CardTitle>
              {isEditMode && (
                <CardDescription>
                  Revenue splits are visible to all users to promote transparency
                </CardDescription>
              )}
            </CardHeader>
            <CardContent>
              {isEditMode ? (
                <AssetRoyaltyManager
                  client:load
                  assetId={assetData.id}
                  existingRoyalties={royaltiesWithUsers.map((r) => ({
                    id: r.id,
                    user_id: r.user_id,
                    user_name: r.user?.name,
                    user_handle: r.user?.handle,
                    royalty_value: r.royalty_value,
                  }))}
                  totalRoyalty={totalRoyalty}
                />
              ) : (
                <div class="royalties-section">
                  <div class="royalties-section__price">
                    <p class="royalties-section__price-label">Cost per use in product</p>
                    <p class="royalties-section__price-value">${(totalRoyalty / 100).toFixed(2)}</p>
                  </div>

                  <div>
                    <h4 class="royalties-section__split-title">Revenue Split</h4>
                    <div class="royalty-list">
                      {royaltiesWithUsers.map((royalty) => (
                        <div class="royalty-item">
                          <div class="royalty-item__info">
                            <span class="royalty-item__name">
                              {royalty.user?.name || royalty.user?.handle || "Unknown"}
                            </span>
                            {royalty.user_id === assetData.user_id && (
                              <span class="royalty-item__badge">Creator</span>
                            )}
                          </div>
                          <span class="royalty-item__amount">
                            ${(royalty.royalty_value / 100).toFixed(2)}
                          </span>
                        </div>
                      ))}
                    </div>
                  </div>

                  {isContributor && currentUser && (
                    <div class="royalties-section__actions">
                      <AssetProductPicker
                        client:load
                        assetId={assetData.id}
                        userId={currentUser.id}
                      />
                    </div>
                  )}
                </div>
              )}
            </CardContent>
          </Card>

          <Card>
            <CardHeader>
              <CardTitle>
                License Agreement
              </CardTitle>
              <CardDescription>
                This asset can be used for both personal and commercial projects that are distributed through gameloopers.com exclusively.
              <!-- TODO: Select, Create, Modify other License Options -->
              </CardDescription>
            </CardHeader>
            <CardFooter>
                <a href="/licenses/standard" class="license-card__link">
                  Read Full License Terms →
                </a>
            </CardFooter>
          </Card>
        </div>

        <div class="page-columns__column">
          {isEditMode && 
          <Card>
            <CardHeader>
              <CardTitle>
                Chat
              </CardTitle>
              <CardDescription>
                Discussion between asset contributors
              </CardDescription>
            </CardHeader>
            <CardContent>
                <AssetChat client:load userId={currentUser?.id} assetId={assetData.id} />
            </CardContent>
          </Card>
          }

          <Card>
            <CardHeader>
              <CardTitle>
                Contributors
              </CardTitle>
            </CardHeader>
            <CardContent>
              <GalleryGrid images={contributorImages} cols={5} borderRadius="circle"/>
                <!-- TODO: Add Contributor By User Handle -->
              {isOwner && <p>Only Owner Can Invite Contributors</p>}
            </CardContent>
          </Card>


          {isEditMode && (
            <Card>
              <CardHeader>
                <CardTitle>Publish Status</CardTitle>
                <CardDescription>
                  Control who can see this asset
                </CardDescription>
              </CardHeader>
              <CardContent>
                <AssetStatusEditor
                  client:load
                  assetId={assetData.id}
                  currentStatus={assetData.status}
                  hasImages={imagesData.length > 0}
                  hasFiles={files.length > 0}
                />
              </CardContent>
            </Card>
          )}

          {isEditMode && (
            <Card>
              <CardHeader>
                <CardTitle>Asset Information</CardTitle>
              </CardHeader>
              <CardContent>
                <dl class="asset-meta">
                  <div class="asset-meta__item">
                    <dt class="asset-meta__label">Created</dt>
                    <dd class="asset-meta__value">
                      {new Date(assetData.created_at).toLocaleDateString('en-US', {
                        month: 'short',
                        day: 'numeric',
                        year: 'numeric'
                      })}
                    </dd>
                  </div>

                  <div class="asset-meta__item">
                    <dt class="asset-meta__label">Last Updated</dt>
                    <dd class="asset-meta__value">
                      {new Date(assetData.updated_at).toLocaleDateString('en-US', {
                        month: 'short',
                        day: 'numeric',
                        year: 'numeric'
                      })}
                    </dd>
                  </div>

                  <div class="asset-meta__item">
                    <dt class="asset-meta__label">Total Files</dt>
                    <dd class="asset-meta__value">{assetData.file_count}</dd>
                  </div>

                  <div class="asset-meta__item">
                    <dt class="asset-meta__label">Downloads</dt>
                    <dd class="asset-meta__value">{assetData.download_count.toLocaleString()}</dd>
                  </div>
                </dl>
              </CardContent>
            </Card>
          )}

          {(isEditMode || tags.length > 0) && (
            <Card>
              <CardHeader>
                <CardTitle>Tags</CardTitle>
                <CardDescription>
                  {isEditMode
                    ? 'Add tags to help others discover your asset'
                    : 'Tags associated with this asset'}
                </CardDescription>
              </CardHeader>
              <CardContent>
                {isEditMode &&
                <AssetTagsForm
                    client:load
                    assetId={assetData.id}
                    initialTags={tags.map(t => t.value)}
                  />
                }
                {!isEditMode && tags.length > 0 &&
                  tags.map((tag) => (
                    <a href={`/assets?tag=${tag.value}`} class="asset-tags__link">
                      <Tag>{tag.value}</Tag>
                    </a>
                  ))
                }
              </CardContent>
            </Card>
          )}

        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  /* ===== Breadcrumb Navigation ===== */
  .breadcrumb {
    margin-bottom: var(--spacing-2xl);
  }

  .breadcrumb__list {
    display: flex;
    align-items: center;
    gap: var(--gap-sm);
    list-style: none;
    padding: 0;
    margin: 0;
    flex-wrap: wrap;
  }

  .breadcrumb__item {
    display: flex;
    align-items: center;
    gap: var(--gap-sm);
    font-size: var(--text-sm);
    color: var(--muted-foreground);
  }

  .breadcrumb__item:not(:last-child)::after {
    content: '/';
    color: var(--border);
    margin-left: var(--gap-sm);
  }

  .breadcrumb__link {
    color: var(--muted-foreground);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-in-out);
  }

  .breadcrumb__link:hover {
    color: var(--foreground);
    text-decoration: underline;
  }

  .breadcrumb__link:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  .breadcrumb__current {
    color: var(--foreground);
    font-weight: var(--font-weight-medium);
  }

  /* ===== Asset Hero Section ===== */
  .asset-hero {
    position: relative;
    min-height: 300px;
    background-color: var(--primary);
    background-size: cover;
    background-position: center;
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-bottom: var(--spacing-4xl);
  }

  .asset-hero__overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.7));
    z-index: 0;
  }

  .asset-hero__content {
    position: relative;
    z-index: 1;
    padding: var(--spacing-5xl) var(--spacing-4xl);
    display: flex;
    flex-direction: column;
    gap: var(--gap-lg);
  }

  .asset-hero__title {
    margin: 0;
    font-size: var(--text-4xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-white);
    line-height: var(--leading-tight);
    text-shadow: var(--text-shadow-md);
  }

  .asset-hero__meta {
    display: flex;
    align-items: center;
    gap: var(--gap-lg);
    flex-wrap: wrap;
  }

  .asset-hero__status {
    display: inline-block;
    padding: var(--spacing-xs) var(--spacing-lg);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .asset-hero__status--published {
    background-color: var(--success-bg);
    color: var(--success-fg);
  }

  .asset-hero__status--draft {
    background-color: oklch(from var(--primary) l c h / 0.1);
    color: var(--primary);
  }

  .asset-hero__status--archived {
    background-color: var(--muted);
    color: var(--muted-foreground);
  }

  .asset-hero__author {
    font-size: var(--text-base);
    color: oklch(1 0 0 / 0.9);
  }

  .asset-hero__author-link {
    color: var(--color-white);
    text-decoration: none;
    font-weight: var(--font-weight-semibold);
    border-bottom: 1px solid rgba(255, 255, 255, 0.5);
  }

  .asset-hero__author-link:hover {
    border-bottom-color: var(--color-white);
  }

  .asset-hero__author-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  /* ===== Mode Toggle in Hero ===== */
  .asset-hero__mode-toggle {
    position: absolute;
    top: var(--spacing-2xl);
    right: var(--spacing-2xl);
    z-index: 10;
    display: flex;
    align-items: center;
    gap: var(--gap-md);
    padding: var(--spacing-md) var(--spacing-lg);
    background-color: oklch(from var(--background) l c h / 0.95);
    backdrop-filter: blur(8px);
    border-radius: var(--radius-full);
    border: var(--border-width-default) solid var(--border);
    box-shadow: var(--shadow-lg);
  }

  .mode-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-xs);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: var(--spacing-xs) var(--spacing-md);
    border-radius: var(--radius-full);
  }

  .mode-badge--edit {
    background-color: oklch(from var(--primary) l c h / 0.1);
    color: var(--primary);
  }

  .mode-badge--preview {
    background-color: oklch(from var(--accent) l c h / 0.1);
    color: var(--accent);
  }

  .mode-toggle-link {
    text-decoration: none;
  }

  .mode-toggle-link:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  /* View Mode Toggle (Legacy - Remove if unused) */
  .view-mode {
    display: flex;
    flex-direction: column;
    gap: var(--gap-lg);
    padding: var(--spacing-lg) 0;
  }

  .view-mode__current {
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm);
  }

  .view-mode__badge {
    display: inline-block;
    align-self: flex-start;
    padding: var(--spacing-xs) var(--spacing-lg);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .view-mode__badge--edit {
    background-color: oklch(from var(--primary) l c h / 0.1);
    color: var(--primary);
  }

  .view-mode__badge--preview {
    background-color: oklch(from var(--accent) l c h / 0.1);
    color: var(--accent);
  }

  .view-mode__description {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--muted-foreground);
  }

  .view-mode__toggle {
    text-decoration: none;
  }

  .view-mode__toggle:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
    border-radius: var(--radius-md);
  }

  /* File List */
  .file-item {
    display: flex;
    align-items: center;
    gap: var(--gap-lg);
    padding: var(--spacing-2xl);
    background-color: var(--muted);
    border-radius: var(--radius-md);
    margin-bottom: var(--spacing-md);
  }

  .file-item__icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--muted-foreground);
  }

  .file-item__info {
    flex: 1;
    min-width: 0;
  }

  .file-item__name {
    margin: 0 0 var(--spacing-xs) 0;
    font-size: var(--text-base);
    font-weight: var(--font-weight-semibold);
    color: var(--foreground);
  }

  .file-item__description {
    margin: 0 0 var(--spacing-xs) 0;
    font-size: var(--text-sm);
    color: var(--muted-foreground);
    line-height: var(--leading-normal);
  }

  .file-item__meta {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--muted-foreground);
  }

  .file-item__download {
    flex-shrink: 0;
    text-decoration: none;
  }

  /* Royalties Section */
  .royalties-section {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xl);
  }

  .royalties-section__price {
    padding: var(--spacing-3xl);
    background-color: var(--muted);
    border-radius: var(--radius-lg);
    text-align: center;
  }

  .royalties-section__price-label {
    margin: 0 0 var(--spacing-md) 0;
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--muted-foreground);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .royalties-section__price-value {
    margin: 0;
    font-size: var(--text-4xl);
    font-weight: var(--font-weight-bold);
    color: var(--foreground);
  }

  .royalties-section__split-title {
    margin: 0 0 var(--spacing-2xl) 0;
    font-size: var(--text-base);
    font-weight: var(--font-weight-semibold);
    color: var(--foreground);
  }

  .royalties-section__actions {
    padding-top: var(--spacing-xl);
    border-top: 1px solid var(--border);
  }

  .royalty-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
  }

  .royalty-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--spacing-lg);
    background-color: var(--muted);
    border-radius: var(--radius-md);
    gap: var(--gap-md);
  }

  .royalty-item__info {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs);
    flex: 1;
    min-width: 0;
  }

  .royalty-item__name {
    font-size: var(--text-sm);
