---
import Layout from "@/layouts/Layout.astro";
import Button from "@/components/Button.astro";
import Tag from "@/components/Tag.astro";
import { getAssetByHandle, getAssetFiles, getAssetImages, getAssetTags, getAssetContributors } from "@/lib/data-access/assets";
import { getUserById } from "@/lib/data-access/users";
import { getAssetRoyalties } from "@/lib/data-access/royalties";
import { setSession } from "@/lib/auth";
import CardTitle from "@/components/CardTitle.astro";
import AssetChat from "@/components/islands/AssetChat";
import Card from "@/components/Card.astro";
import CardDescription from "@/components/CardDescription.astro";
import CardContent from "@/components/CardContent.astro";
import CardHeader from "@/components/CardHeader.astro";
import CardFooter from "@/components/CardFooter.astro";
import GalleryGrid from "@/components/GalleryGrid.astro";
import AssetTagsForm from "@/components/islands/AssetTagsForm";
import AssetFileForm from "@/components/islands/AssetFileForm";
import AssetImagesForm from "@/components/islands/AssetImagesForm";
import AssetBasicInfoForm from "@/components/islands/AssetBasicInfoForm";

const { asset } = Astro.params;

if (!asset) {
  return Astro.redirect('/404');
}

const accessToken = Astro.cookies.get("sb-access-token");
const refreshToken = Astro.cookies.get("sb-refresh-token");

const assetData = await getAssetByHandle(asset);

if (!assetData) {
  return Astro.redirect('/404');
}

const owner = await getUserById(assetData.user_id);
const files = await getAssetFiles(assetData.id);
const imagesData = await getAssetImages(assetData.id);
const contributorData = await getAssetContributors(assetData.id)
const contributorIds = contributorData.map(x => x.id)
const contributorImages = contributorData.map(function(x) {return {
  url: x.avatar_url,
  alt: x.name,
  href: `/users/${x.handle}`
}})
const images = imagesData.map(function(x){return {
  url: x.file_url,
  alt: x.title,
  href: x.file_url
}})
const tags = await getAssetTags(assetData.id);
const royalties = await getAssetRoyalties(assetData.id);

const royaltiesWithUsers = await Promise.all(
  royalties.map(async (royalty) => {
    const user = await getUserById(royalty.user_id);
    return { ...royalty, user };
  })
);

let currentUser = null;
if (accessToken && refreshToken) {
  try {
    const session = await setSession({
      refresh_token: refreshToken.value,
      access_token: accessToken.value,
    });
    if (!session.error && session.data.user) {
      currentUser = session.data.user;
    }
  } catch (error) {}
}

const curredUserId = `${currentUser?.id}`
const isOwner = curredUserId === assetData.user_id;
const totalRoyalty = royalties.reduce((sum, r) => sum + r.royalty_value, 0);

// State Management: Three mutually exclusive states
const isContributor = contributorIds.includes(curredUserId)
const mode = Astro.url.searchParams.get("mode") || (isContributor ? "edit" : "shop");

const isEditMode = mode === "edit" && isContributor;
const isPreviewMode = mode === "preview" && isContributor;
const isShopMode = !isContributor || mode === "shop";
---

<Layout title={`${assetData.title} - Game Loopers`}>
  <div class="page">
    <div class="page__container">
      <!-- Hero Section -->
      <div
        class="asset-hero"
        style={assetData.cover_image_url ? `background-image: url('${assetData.cover_image_url}')` : ''}
      >
        {assetData.cover_image_url && <div class="asset-hero__overlay"></div>}
        <div class="asset-hero__content">
          <h1 class="asset-hero__title">{assetData.title}</h1>
          <div class="asset-hero__meta">
            <span class={`asset-hero__status asset-hero__status--${assetData.status}`}>
              {assetData.status.toUpperCase()}
            </span>
            {owner && (
              <span class="asset-hero__author">
                by <a href={`/users/${owner.handle}`} class="asset-hero__author-link">
                  {owner.name || owner.handle}
                </a>
              </span>
            )}
          </div>
        </div>
      </div>

      <div class="page-columns">
        <div class="page-columns__column">
          {assetData.description && (
            <Card>
              <CardHeader>
                <CardTitle>About This Asset</CardTitle>
              </CardHeader>
              <CardContent>
                {(isPreviewMode || isShopMode) && (
                  <p class="asset-about-text">{assetData.description}</p>
                )}
                {isEditMode && (
                  <AssetBasicInfoForm
                    client:load
                    assetId={assetData.id}
                    initialData={{title: assetData.title, description: assetData.description}}
                  />
                )}
              </CardContent>
            </Card>
          )}

          {!assetData.description && isEditMode && (
            <Card>
              <CardHeader>
                <CardTitle>About This Asset</CardTitle>
                <CardDescription>Add a description to help others understand your asset</CardDescription>
              </CardHeader>
              <CardContent>
                <AssetBasicInfoForm
                  client:load
                  assetId={assetData.id}
                  initialData={{title: assetData.title, description: assetData.description}}
                />
              </CardContent>
            </Card>
          )}

          <Card>
            <CardHeader>
              <CardTitle>Images</CardTitle>
              <CardDescription>Preview Images of the asset</CardDescription>
            </CardHeader>
            <CardContent>
              {isEditMode &&
                  <AssetImagesForm
                  client:load
                  assetId={assetData.id}
                  existingImages={imagesData.map(i => ({
                    id: i.id,
                    title: i.title,
                    file_url: i.file_url,
                  }))}
                />
                }
                {(isPreviewMode || isShopMode) &&
                <GalleryGrid images={images} cols={5}/>
                }
              </CardContent>
          </Card>

          <Card>
            <CardHeader>
              <CardTitle>Files Included</CardTitle>
              <CardDescription>A List of files included in this asset</CardDescription>
            </CardHeader>
            <CardContent>
              {isEditMode &&
                <AssetFileForm
                  client:load
                  assetId={assetData.id}
                  existingFiles={files.map(f => ({
                    id: f.id,
                    title: f.title,
                    file_size_bytes: f.file_size_bytes,
                    file_url: f.file_url,
                  }))}
                />
                }
                {(isPreviewMode || isShopMode) && files.map((file) => (
                  <div class="file-item">
                    <div class="file-item__icon">
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M13 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V9z"/>
                      </svg>
                    </div>
                    <div class="file-item__info">
                      <p class="file-item__name">{file.title}</p>
                      {file.description && (
                        <p class="file-item__description">{file.description}</p>
                      )}
                      <p class="file-item__meta">
                        {(file.file_size_bytes / 1024 / 1024).toFixed(2)} MB
                        {file.mime_type && ` • ${file.mime_type.split('/').pop()?.toUpperCase()}`}
                      </p>
                    </div>
                    <a
                      href={file.file_url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="file-item__download"
                    >
                      <Button variant="ghost" size="sm">
                        <span slot="text">Download</span>
                      </Button>
                    </a>
                  </div>
                ))}
            </CardContent>
          </Card>

          <Card>
            <CardHeader>
              <CardTitle>
                Costs & Royalties
              </CardTitle>
            </CardHeader>
            <CardContent>
                  <div class="sidebar-card__price">
                    <p class="sidebar-card__price-label">Cost per use in product</p>
                    <p class="sidebar-card__price-value">${(totalRoyalty / 100).toFixed(2)}</p>
                  </div>
                  <div class="sidebar-card__royalties">
                    <h4 class="sidebar-card__royalties-title">Revenue Split</h4>
                    <div class="royalty-list">
                      {royaltiesWithUsers.map((royalty) => (
                        <div class="royalty-item">
                          <span class="royalty-item__name">
                            {royalty.user?.name || royalty.user?.handle || "Unknown"}
                            {royalty.user_id === assetData.user_id && (
                              <span class="royalty-item__badge">Creator</span>
                            )}
                          </span>
                          <span class="royalty-item__amount">
                            ${(royalty.royalty_value / 100).toFixed(2)}
                          </span>
                        </div>
                      ))}
                    </div>
                  </div>
                  <div>
                    <!-- TODO: add to existing or new product, search for existing product -->
                    <a href={`/assets/${assetData?.handle}`} class="creator-card__link">
                      <Button variant="outline" size="md">
                        <span slot="text">Add to Product</span>
                      </Button>
                    </a>
                  </div>
              </CardContent>
          </Card>

          <Card>
            <CardHeader>
              <CardTitle>
                License Agreement
              </CardTitle>
              <CardDescription>
                This asset can be used for both personal and commercial projects that are distributed through gameloopers.com exclusively.
              <!-- TODO: Select, Create, Modify other License Options -->
              </CardDescription>
            </CardHeader>
            <CardFooter>
                <a href="/licenses/standard" class="license-card__link">
                  Read Full License Terms →
                </a>
            </CardFooter>
          </Card>
        </div>

        <div class="page-columns__column">
          {isContributor && (
            <Card>
              <CardContent>
                <div class="view-mode">
                  <div class="view-mode__current">
                    <span class={`view-mode__badge view-mode__badge--${isEditMode ? 'edit' : 'preview'}`}>
                      {isEditMode ? '✏ Edit Mode' : '👁 Preview Mode'}
                    </span>
                    <p class="view-mode__description">
                      {isEditMode
                        ? 'Editing asset details and settings'
                        : 'Viewing as customers see this asset'}
                    </p>
                  </div>
                  <a
                    href={`/assets/${assetData.handle}${isEditMode ? '?mode=preview' : ''}`}
                    class="view-mode__toggle"
                  >
                    <Button variant="outline" size="sm">
                      <span slot="text">
                        Switch to {isEditMode ? 'Preview' : 'Edit'}
                      </span>
                    </Button>
                  </a>
                </div>
              </CardContent>
            </Card>
          )}

          {isEditMode && 
          <Card>
            <CardHeader>
              <CardTitle>
                Chat
              </CardTitle>
              <CardDescription>
                Discussion between asset contributors
              </CardDescription>
            </CardHeader>
            <CardContent>
                <AssetChat client:load userId={currentUser?.id} assetId={assetData.id} />
            </CardContent>
          </Card>
          }

          <Card>
            <CardHeader>
              <CardTitle>
                Contributors
              </CardTitle>
            </CardHeader>
            <CardContent>
              <GalleryGrid images={contributorImages} cols={5} borderRadius="circle"/>
                <!-- TODO: Add Contributor By User Handle -->
              {isOwner && <p>Only Owner Can Invite Contributors</p>}
            </CardContent>
          </Card>


          {isEditMode && (
            <Card>
              <CardHeader>
                <CardTitle>Asset Information</CardTitle>
              </CardHeader>
              <CardContent>
                <dl class="asset-meta">
                  <div class="asset-meta__item">
                    <dt class="asset-meta__label">Status</dt>
                    <dd class="asset-meta__value">
                      <span class={`asset-status-badge asset-status-badge--${assetData.status}`}>
                        {assetData.status === 'published' ? 'Published' :
                         assetData.status === 'draft' ? 'Draft' :
                         'Archived'}
                      </span>
                    </dd>
                  </div>

                  <div class="asset-meta__item">
                    <dt class="asset-meta__label">Last Updated</dt>
                    <dd class="asset-meta__value">
                      {new Date(assetData.updated_at).toLocaleDateString('en-US', {
                        month: 'short',
                        day: 'numeric',
                        year: 'numeric'
                      })}
                    </dd>
                  </div>

                  <div class="asset-meta__item">
                    <dt class="asset-meta__label">Created</dt>
                    <dd class="asset-meta__value">
                      {new Date(assetData.created_at).toLocaleDateString('en-US', {
                        month: 'short',
                        day: 'numeric',
                        year: 'numeric'
                      })}
                    </dd>
                  </div>

                  <div class="asset-meta__item">
                    <dt class="asset-meta__label">Total Files</dt>
                    <dd class="asset-meta__value">{assetData.file_count}</dd>
                  </div>

                  <div class="asset-meta__item">
                    <dt class="asset-meta__label">Downloads</dt>
                    <dd class="asset-meta__value">{assetData.download_count.toLocaleString()}</dd>
                  </div>
                </dl>
              </CardContent>
            </Card>
          )}

          <Card>
            <CardHeader>
              <CardTitle>Tags</CardTitle>
              <CardDescription>A list of tags associated with this asset</CardDescription>
            </CardHeader>
            <CardContent>
              {isEditMode &&
              <AssetTagsForm
                  client:load
                  assetId={assetData.id}
                  initialTags={tags.map(t => t.value)}
                />
              }
              {(isPreviewMode || isShopMode) && 
                tags.map((tag) => (
                  <a href={`/assets?tag=${tag.value}`} class="asset-tags__link">
                    <Tag>{tag.value}</Tag>
                  </a>
                ))
              }
            </CardContent>
          </Card>

        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  /* Asset Hero Section */
  .asset-hero {
    position: relative;
    min-height: 300px;
    background-color: var(--primary);
    background-size: cover;
    background-position: center;
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-bottom: var(--spacing-4xl);
  }

  .asset-hero__overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.7));
    z-index: 0;
  }

  .asset-hero__content {
    position: relative;
    z-index: 1;
    padding: var(--spacing-5xl) var(--spacing-4xl);
    display: flex;
    flex-direction: column;
    gap: var(--gap-lg);
  }

  .asset-hero__title {
    margin: 0;
    font-size: var(--text-4xl);
    font-weight: var(--font-weight-bold);
    color: var(--accent);
    line-height: var(--leading-tight);
  }

  .asset-hero__meta {
    display: flex;
    align-items: center;
    gap: var(--gap-lg);
    flex-wrap: wrap;
  }

  .asset-hero__status {
    display: inline-block;
    padding: var(--spacing-xs) var(--spacing-lg);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .asset-hero__status--published {
    background-color: rgba(34, 197, 94, 0.2);
    color: #4ade80;
  }

  .asset-hero__status--draft {
    background-color: rgba(59, 130, 246, 0.2);
    color: #60a5fa;
  }

  .asset-hero__status--archived {
    background-color: rgba(156, 163, 175, 0.2);
    color: #9ca3af;
  }

  .asset-hero__author {
    font-size: var(--text-base);
    color: var(--accent-foreground);
  }

  .asset-hero__author-link {
    color: var(--accent);
    text-decoration: none;
    font-weight: var(--font-weight-semibold);
  }

  .asset-hero__author-link:hover {
    text-decoration: underline;
  }

  /* View Mode Toggle */
  .view-mode {
    display: flex;
    flex-direction: column;
    gap: var(--gap-lg);
    padding: var(--spacing-lg) 0;
  }

  .view-mode__current {
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm);
  }

  .view-mode__badge {
    display: inline-block;
    align-self: flex-start;
    padding: var(--spacing-xs) var(--spacing-lg);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .view-mode__badge--edit {
    background-color: rgba(59, 130, 246, 0.2);
    color: #2563eb;
  }

  .view-mode__badge--preview {
    background-color: rgba(168, 85, 247, 0.2);
    color: #9333ea;
  }

  .view-mode__description {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--muted-foreground);
  }

  .view-mode__toggle {
    text-decoration: none;
  }

  /* File List */
  .file-item {
    display: flex;
    align-items: center;
    gap: var(--gap-lg);
    padding: var(--spacing-2xl);
    background-color: var(--muted);
    border-radius: var(--radius-md);
    margin-bottom: var(--spacing-md);
  }

  .file-item__icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--muted-foreground);
  }

  .file-item__info {
    flex: 1;
    min-width: 0;
  }

  .file-item__name {
    margin: 0 0 var(--spacing-xs) 0;
    font-size: var(--text-base);
    font-weight: var(--font-weight-semibold);
    color: var(--foreground);
  }

  .file-item__description {
    margin: 0 0 var(--spacing-xs) 0;
    font-size: var(--text-sm);
    color: var(--muted-foreground);
    line-height: var(--leading-normal);
  }

  .file-item__meta {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--muted-foreground);
  }

  .file-item__download {
    flex-shrink: 0;
    text-decoration: none;
  }

  /* Sidebar Card (Royalties Section) */
  .sidebar-card__price {
    padding: var(--spacing-2xl);
    background-color: var(--muted);
    border-radius: var(--radius-md);
    margin-bottom: var(--spacing-2xl);
  }

  .sidebar-card__price-label {
    margin: 0 0 var(--spacing-sm) 0;
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--muted-foreground);
  }

  .sidebar-card__price-value {
    margin: 0;
    font-size: var(--text-3xl);
    font-weight: var(--font-weight-bold);
    color: var(--foreground);
  }

  .sidebar-card__royalties {
    padding: var(--spacing-2xl) 0;
  }

  .sidebar-card__royalties-title {
    margin: 0 0 var(--spacing-2xl) 0;
    font-size: var(--text-base);
    font-weight: var(--font-weight-semibold);
    color: var(--foreground);
  }

  .royalty-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
  }

  .royalty-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--spacing-lg);
    background-color: var(--muted);
    border-radius: var(--radius-md);
  }

  .royalty-item__user {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs);
  }

  .royalty-item__name {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--foreground);
  }

  .royalty-item__role {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--muted-foreground);
  }

  .royalty-item__amount {
    font-size: var(--text-base);
    font-weight: var(--font-weight-semibold);
    color: var(--primary);
  }

  /* License Card */
  .license-card__link {
    color: var(--primary);
    text-decoration: none;
    font-weight: var(--font-weight-medium);
  }

  .license-card__link:hover {
    text-decoration: underline;
  }

  /* Asset Tags */
  .asset-tags__link {
    text-decoration: none;
    display: inline-block;
    margin-right: var(--spacing-sm);
    margin-bottom: var(--spacing-sm);
  }

  /* Asset About Section */
  .asset-about-text {
    margin: 0;
    font-size: var(--text-base);
    color: var(--foreground);
    line-height: var(--leading-relaxed);
  }

  .asset-about-empty {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--muted-foreground);
    font-style: italic;
  }

  .asset-author-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: var(--font-weight-medium);
  }

  .asset-author-link:hover {
    text-decoration: underline;
  }

  /* Asset Meta Information */
  .asset-meta {
    display: flex;
    flex-direction: column;
    gap: var(--gap-lg);
  }

  .asset-meta__item {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: var(--spacing-lg);
    border-bottom: 1px solid var(--border);
  }

  .asset-meta__item:last-child {
    border-bottom: none;
  }

  .asset-meta__label {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--muted-foreground);
    margin: 0;
  }

  .asset-meta__value {
    font-size: var(--text-base);
    font-weight: var(--font-weight-semibold);
    color: var(--foreground);
    margin: 0;
  }

  .asset-status-badge {
    display: inline-block;
    padding: var(--spacing-xs) var(--spacing-lg);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .asset-status-badge--published {
    background-color: rgba(34, 197, 94, 0.2);
    color: #16a34a;
  }

  .asset-status-badge--draft {
    background-color: rgba(59, 130, 246, 0.2);
    color: #2563eb;
  }

  .asset-status-badge--archived {
    background-color: rgba(156, 163, 175, 0.2);
    color: #6b7280;
  }

  /* ===== Responsive ===== */
  @media (max-width: 768px) {
    .asset-hero {
      min-height: 250px;
    }

    .asset-hero__content {
      padding: var(--spacing-3xl) var(--spacing-2xl);
    }

    .asset-hero__title {
      font-size: var(--text-3xl);
    }

    .asset-hero__meta {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--gap-sm);
    }

    .asset-layout {
      grid-template-columns: 1fr;
    }

    .asset-main {
      order: 1;
    }

    .asset-sidebar {
      order: 2;
    }

    .view-mode {
      flex-direction: column;
      align-items: stretch;
      gap: var(--gap-md);
    }

    .view-mode__toggle {
      width: 100%;
    }

    .view-mode__toggle a {
      display: block;
      width: 100%;
    }
  }
</style>
