---
import Layout from "@/layouts/Layout.astro";
import HomeSubscribeSection from "@/components/home/HomeSubscribeSection.astro";
import HomeHeroSection from "@/components/home/HomeHeroSection.astro";
import GalleryGrid from "@/components/GalleryGrid.astro";
import HomeFeaturesSection from "@/components/home/HomeFeaturesSection.astro";
import HomeJamsSection from "@/components/home/HomeJamsSection.astro";
import { getUsersByDateJoined } from "@/lib/data-access/users";
import type { User } from "@/types";
import { getAllProducts, getProductImages } from "@/lib/data-access/products";
import { getPublicAssets, getAssetImages } from "@/lib/data-access/assets";
import { getActiveJam } from "@/lib/data-access/jams";


const features: {
  title: string;
  description: string;
}[] = [
  {
    title: 'Asset Licensing',
    description: 'License your assets for usage on Game Loopers or define your own terms for use anywhere.'
  },
  {
    title: 'Asset Royalties',
    description: 'A royalty network allows payments to be issued whenever your assets are used and purchased across Game Loopers.',
  },
  {
    title: 'Asset Creation',
    description: 'Upload 3D sculpture, illustrations, and documents or Create your own right here on Game Loopers.',
  },
  {
    title: 'Product Listings',
    description: 'Game Loopers is a full storefront which allows you to share or embed your profile, or organically find creations',
  },
  {
    title: 'Community',
    description: 'Create and get organized with community members, share product listings and royalties between each other.',
  },
];

const productData = await getAllProducts()
console.log('productData',productData)
const products:{url: string; alt?: string, href: string}[] = await Promise.all(
  productData.slice(0,10).map(async (product) => {
    const images = await getProductImages(product.id);
    const coverImage = images.length > 0
      ? images.sort((a, b) => a.position - b.position)[0]
      : null;
    const imageUrl = coverImage?.file_url || 'https://placehold.co/600x600';
    return {
      url: imageUrl,
      alt: product.title,
      href: `/products/${product.handle}`
    };
  })
)

const assetData = await getPublicAssets()
const assets:{url: string; alt?: string, href: string}[] = await Promise.all(
  assetData.slice(0,10).map(async (asset) => {
    const images = await getAssetImages(asset.id);
    const coverImage = images.length > 0
      ? images.sort((a, b) => a.position - b.position)[0]
      : null;
    const firstImage = coverImage?.file_url || 'https://placehold.co/600x600';

    return {
      url: firstImage,
      alt: asset.title,
      href: `/assets/${asset.handle}`
    };
  })
)

const userData: User[] = await getUsersByDateJoined()
const profiles:{url: string; alt?: string, href: string}[] = userData.map(user => ({
  url: user.avatar_url || 'https://placehold.co/600x600',
  alt: user.handle,
  href: `/users/${user.handle}`
}))

const activeJam = await getActiveJam()

---

<Layout title="Game Loopers">
  <div class="page">
    <div class="page__container">
      <div class="page-columns__column">
      {activeJam && <HomeJamsSection jam={activeJam} />}
      <HomeHeroSection/>
      <GalleryGrid images={products} cols={5} />
      <HomeFeaturesSection features={features}/>
      <GalleryGrid images={assets} cols={5}/>
      <GalleryGrid images={profiles} cols={9} borderRadius="circle"/>
      <HomeSubscribeSection/>
      </div>
    </div>
  </div>
</Layout>