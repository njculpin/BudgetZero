---
import Layout from "@/layouts/Layout.astro";
import SubscribeCTA from "@/components/SubscribeCTA.astro";
import Hero from "@/components/Hero.astro";
import GalleryGrid from "@/components/GalleryGrid.astro";
import Features from "@/components/Features.astro"
import Jams from "@/components/Jams.astro";


const features: {
  title: string;
  description: string;
}[] = [
  {
    title: 'Asset Licensing',
    description: 'License your assets for usage on Game Loopers or define your own terms for use anywhere.'
  },
  {
    title: 'Asset Royalties',
    description: 'A royalty network allows payments to be issued whenever your assets are used and purchased across Game Loopers.',
  },
  {
    title: 'Asset Creation',
    description: 'Upload 3D sculpture, illustrations, and documents or Create your own right here on Game Loopers.',
  },
  {
    title: 'Product Listings',
    description: 'Game Loopers is a full storefront which allows you to share or embed your profile, or organically find creations',
  },
  {
    title: 'Community',
    description: 'Create and get organized with community members, share product listings and royalties between each other.',
  },
];

const placeholder = {url: 'https://placehold.co/600x600', alt:'alt', href: '/'}
const products:{url: string; alt?: string, href: string}[] = Array.from({ length: 10 }, () => placeholder)
const assets:{url: string; alt?: string, href: string}[] = Array.from({ length: 10 }, () => placeholder)
const profiles:{url: string; alt?: string, href: string}[] = Array.from({ length: 27 }, () => placeholder)
---

<Layout title="Game Loopers">
  <div class="page">
    <div class="page__container">
      <Jams title="Jam" description="SOMETHING GREAT"/>
      <Hero/>
      <GalleryGrid title="Products" images={products} cols={5} rows={2}/>
      <Features features={features}/>
      <GalleryGrid title="Assets" images={assets} cols={5} rows={2}/>
      <GalleryGrid title="Creators" images={profiles} cols={9} rows={3} borderRadius="circle"/>
      <SubscribeCTA/>
    </div>
  </div>
</Layout>