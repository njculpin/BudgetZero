---
import Layout from "@/layouts/Layout.astro";
import SubscribeCTA from "@/components/SubscribeCTA.astro";
import Hero from "@/components/Hero.astro";
import GalleryGrid from "@/components/GalleryGrid.astro";
import Features from "@/components/Features.astro"
import Jams from "@/components/Jams.astro";
import { getUsersByDateJoined } from "@/lib/data-access/users";
import type { User } from "@/types";
import { getAllProducts } from "@/lib/data-access/products";
import { getPublishedAssets } from "@/lib/data-access/assets";


const features: {
  title: string;
  description: string;
}[] = [
  {
    title: 'Asset Licensing',
    description: 'License your assets for usage on Game Loopers or define your own terms for use anywhere.'
  },
  {
    title: 'Asset Royalties',
    description: 'A royalty network allows payments to be issued whenever your assets are used and purchased across Game Loopers.',
  },
  {
    title: 'Asset Creation',
    description: 'Upload 3D sculpture, illustrations, and documents or Create your own right here on Game Loopers.',
  },
  {
    title: 'Product Listings',
    description: 'Game Loopers is a full storefront which allows you to share or embed your profile, or organically find creations',
  },
  {
    title: 'Community',
    description: 'Create and get organized with community members, share product listings and royalties between each other.',
  },
];

const productData = await getAllProducts()
const products:{url: string; alt?: string, href: string}[] = productData.slice(0,10).map(product => ({
  url: 'https://placehold.co/600x600',
  alt: product.title,
  href: `/products/${product.handle}`
}))

const assetData = await getPublishedAssets()
console.log(assetData)
const assets:{url: string; alt?: string, href: string}[] = assetData.slice(0,10).map(asset => ({
  url: 'https://placehold.co/600x600',
  alt: asset.title,
  href: `/assets/${asset.handle}`
}))

const userData: User[] = await getUsersByDateJoined()
const profiles:{url: string; alt?: string, href: string}[] = userData.map(user => ({
  url: user.avatar_url || 'https://placehold.co/600x600',
  alt: user.handle,
  href: `/users/${user.handle}`
}))

---

<Layout title="Game Loopers">
  <div class="page">
    <div class="page__container">
      <div class="page-columns__column">
      <Jams title="Jam" description="SOMETHING GREAT"/>
      <Hero/>
      <GalleryGrid images={products} cols={5} />
      <Features features={features}/>
      <GalleryGrid images={assets} cols={5}/>
      <GalleryGrid images={profiles} cols={9} borderRadius="circle"/>
      <SubscribeCTA/>
      </div>
    </div>
  </div>
</Layout>