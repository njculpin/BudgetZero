---
import Layout from "@/layouts/Layout.astro";
import Button from "@/components/Button.astro";
import { getAllProducts, getProductImages, getProductFiles, getProductDocuments, getProductComponents } from "@/lib/data-access/products";
import { getActiveJam } from "@/lib/data-access/jams";
import { getUserById } from "@/lib/data-access/users";

// Fetch products with full details
const allProducts = await getAllProducts();

// Get product cards for sections (with enhanced data)
const getProductCards = async (products: typeof allProducts) => {
  return await Promise.all(
    products.map(async (product) => {
      const images = await getProductImages(product.id);
      const coverImage = images.length > 0
        ? images.sort((a, b) => a.position - b.position)[0]
        : null;
      const owner = await getUserById(product.user_id);

      // Get content counts for "What's Included" preview
      const files = await getProductFiles(product.id);
      const documents = await getProductDocuments(product.id);
      const components = await getProductComponents(product.id);

      return {
        id: product.id,
        handle: product.handle,
        title: product.title,
        description: product.description?.slice(0, 100) + '...' || '',
        imageUrl: coverImage?.file_url || 'https://placehold.co/600x400?text=' + encodeURIComponent(product.title),
        ownerName: owner?.name || owner?.handle || 'Creator',
        ownerHandle: owner?.handle || '',
        status: product.status,
        createdAt: product.created_at,
        fileCount: files.length,
        documentCount: documents.length,
        componentCount: components.length,
      };
    })
  );
};

const newLaunches = await getProductCards(allProducts.slice(0, 6));
const trending = await getProductCards(allProducts.slice(6, 12));

const activeJam = await getActiveJam();
---

<Layout title="Game Loopers - Bring Creative Projects to Life">
  <div class="home-wrapper">

    <div class="page">
      <div class="page__container">

      <!-- Active Jam Banner -->
      {activeJam && (
        <a href={`/jams/${activeJam.handle}`} class="jam-banner">
          <div class="jam-banner__content">
            <h3 class="jam-banner__title">{activeJam.title}</h3>
          </div>
          <div class="jam-banner__cta">
            View Jam →
          </div>
        </a>
      )}

      <!-- New Launches Section -->
      <section class="section">
        <div class="section__header">
          <h2 class="section__title">New Launches</h2>
          <a href="/products?sort=newest" class="section__link">See more</a>
        </div>
        <div class="product-grid">
          {newLaunches.map((product) => (
            <a href={`/products/${product.handle}`} class="product-card">
              <div class="product-card__image">
                <img src={product.imageUrl} alt={product.title} />
              </div>
              <div class="product-card__content">
                <p class="product-card__creator">
                  by {product.ownerName}
                </p>
                <h3 class="product-card__title">{product.title}</h3>
              </div>
            </a>
          ))}
        </div>
      </section>

      <!-- Trending Section -->
      <section class="section">
        <div class="section__header">
          <h2 class="section__title">Trending Now</h2>
          <a href="/products?sort=popular" class="section__link">See more</a>
        </div>
        <div class="product-grid">
          {trending.map((product) => (
            <a href={`/products/${product.handle}`} class="product-card">
              <div class="product-card__image">
                <img src={product.imageUrl} alt={product.title} />
              </div>
              <div class="product-card__content">
                <p class="product-card__creator">
                  by {product.ownerName}
                </p>
                <h3 class="product-card__title">{product.title}</h3>
              </div>
            </a>
          ))}
        </div>
      </section>

      <!-- CTA Section -->
      <section class="cta-section">
        <div class="cta-section__content">
          <h2 class="cta-section__title">Ready to bring your game to life?</h2>
          <p class="cta-section__description">
            Join thousands of creators sharing their tabletop game projects with the community
          </p>
          <div class="cta-section__actions">
            <a href="/sign-up">
              <Button variant="primary" size="lg">
                <span slot="text">Start Creating</span>
              </Button>
            </a>
            <a href="/products">
              <Button variant="outline" size="lg">
                <span slot="text">Explore Products</span>
              </Button>
            </a>
          </div>
        </div>
      </section>

      </div>
    </div>
  </div>
</Layout>

<style>
  /* ===== Home Wrapper ===== */
  .home-wrapper {
    width: 100%;
  }

  /* ===== Jam Banner ===== */
  .jam-banner {
    display: flex;
    align-items: center;
    gap: var(--spacing-xl);
    padding: var(--spacing-2xl);
    margin-bottom: var(--spacing-5xl);
    background: linear-gradient(135deg, var(--primary) 0%, oklch(from var(--primary) calc(l * 0.9) c h) 100%);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: var(--primary-foreground);
    transition: transform 0.2s var(--ease-in-out);
  }

  .jam-banner:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }

  .jam-banner__icon {
    font-size: var(--text-4xl);
    flex-shrink: 0;
  }

  .jam-banner__content {
    flex: 1;
  }

  .jam-banner__title {
    margin: 0 0 var(--spacing-xs) 0;
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-bold);
    color: var(--background);
  }

  .jam-banner__description {
    margin: 0;
    opacity: 0.9;
  }

  .jam-banner__cta {
    font-weight: var(--font-weight-semibold);
    white-space: nowrap;
  }

  /* ===== Sections ===== */
  .section {
    margin-bottom: var(--spacing-6xl);
  }

  .section__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--spacing-3xl);
  }

  .section__title {
    font-size: var(--text-3xl);
    font-weight: var(--font-weight-bold);
    margin: 0;
  }

  .section__link {
    font-size: var(--text-base);
    font-weight: var(--font-weight-semibold);
    color: var(--primary);
    text-decoration: none;
    transition: opacity 0.2s var(--ease-in-out);
  }

  .section__link:hover {
    opacity: 0.8;
  }

  /* ===== Product Grid ===== */
  .product-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-4xl);
  }

  .product-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform 0.2s var(--ease-in-out), box-shadow 0.2s var(--ease-in-out);
  }

  .product-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .product-card__image {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: var(--muted);
  }

  .product-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s var(--ease-in-out);
  }

  .product-card:hover .product-card__image img {
    transform: scale(1.05);
  }

  .product-card__content {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    padding: var(--spacing-xl);
  }

  .product-card__creator {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--muted-foreground);
    font-weight: var(--font-weight-medium);
  }

  .product-card__title {
    margin: 0;
    font-size: var(--text-xl);
    font-weight: var(--font-weight-bold);
    line-height: var(--leading-tight);
    color: var(--foreground);
  }

  /* ===== CTA Section ===== */
  .cta-section {
    margin: var(--spacing-6xl) 0;
    padding: var(--spacing-6xl) var(--spacing-3xl);
    background: linear-gradient(
      135deg,
      var(--muted) 0%,
      oklch(from var(--muted) calc(l * 0.98) c h) 100%
    );
    border-radius: var(--radius-2xl);
    text-align: center;
  }

  .cta-section__content {
    max-width: 700px;
    margin: 0 auto;
  }

  .cta-section__title {
    font-size: var(--text-4xl);
    font-weight: var(--font-weight-bold);
    margin: 0 0 var(--spacing-lg) 0;
  }

  .cta-section__description {
    font-size: var(--text-xl);
    color: var(--muted-foreground);
    margin: 0 0 var(--spacing-4xl) 0;
    line-height: var(--leading-relaxed);
  }

  .cta-section__actions {
    display: flex;
    gap: var(--spacing-lg);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ===== Responsive ===== */
  @media (max-width: 1024px) {
    .product-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--spacing-3xl);
    }
  }

  @media (max-width: 768px) {
    .categories__inner {
      padding: var(--spacing-md) var(--spacing-lg);
    }

    .jam-banner {
      flex-direction: column;
      text-align: center;
      gap: var(--spacing-lg);
    }

    .section__header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--spacing-md);
    }

    .product-grid {
      grid-template-columns: 1fr;
      gap: var(--spacing-2xl);
    }

    .cta-section {
      padding: var(--spacing-4xl) var(--spacing-2xl);
    }

    .cta-section__title {
      font-size: var(--text-3xl);
    }

    .cta-section__description {
      font-size: var(--text-lg);
    }

    .cta-section__actions {
      flex-direction: column;
    }

    .cta-section__actions a {
      width: 100%;
    }
  }

</style>
