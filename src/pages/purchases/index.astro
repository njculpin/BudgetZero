---
import Layout from "@/layouts/Layout.astro";
import Card from "@/components/Card.astro";
import CardHeader from "@/components/CardHeader.astro";
import CardTitle from "@/components/CardTitle.astro";
import CardContent from "@/components/CardContent.astro";
import Button from "@/components/Button.astro";
import { setSession } from "@/lib/auth";
import { getUserSales, getSaleItems } from "@/lib/data-access/sales";
import { getProductById, getProductFiles, getProductComponents, getProductDocuments } from "@/lib/data-access/products";
import PageHeader from "@/components/PageHeader.astro";
import EmptyState from "@/components/EmptyState.astro";

const { url } = Astro;
const searchParams = url.searchParams;

let currentUser = null;
const accessToken = Astro.cookies.get("sb-access-token");
const refreshToken = Astro.cookies.get("sb-refresh-token");

if (accessToken && refreshToken) {
  try {
    const session = await setSession({
      refresh_token: refreshToken.value,
      access_token: accessToken.value,
    });
    if (!session.error && session.data.user) {
      currentUser = session.data.user;
    }
  } catch (error) {
    // Continue as guest
  }
}

if (!currentUser) {
  return Astro.redirect("/sign-in");
}

// Get user's purchases
const sales = await getUserSales(currentUser.id);
const completedSales = sales.filter(sale => sale.status === 'paid');

// Fetch details for each purchase
const purchasesWithDetails = await Promise.all(
  completedSales.map(async (sale) => {
    const saleItems = await getSaleItems(sale.id);

    const itemsWithDetails = await Promise.all(
      saleItems.map(async (item) => {
        const product = await getProductById(item.product_id);

        // Get files from the main product
        const mainProductFiles = product ? await getProductFiles(product.id) : [];

        // Get documents from the main product
        const mainProductDocuments = product ? await getProductDocuments(product.id) : [];
        const mainProductDocumentFiles = mainProductDocuments.map(doc => ({
            id: doc.id,
            document_id: doc.document_id,
            title: doc.document?.title || 'Document',
            description: doc.document?.description || '',
            file_url: doc.pdf_url || `/documents/${doc.document?.handle}`, // Fallback to document view if no PDF
            storage_path: doc.pdf_storage_path || '',
            file_size_bytes: 0, // PDFs don't have size stored
            mime_type: 'application/pdf',
            position: doc.position,
            price_cents: doc.price_cents,
            source_product_title: product?.title || 'Unknown Product',
            is_document: true,
            has_pdf: !!doc.pdf_url,
          }));

        // Get embedded products and their files + documents
        const embeddedProducts = product ? await getProductComponents(product.id) : [];
        const embeddedFilesAndDocs = await Promise.all(
          embeddedProducts.map(async (component) => {
            const childProduct = await getProductById(component.child_product_id);
            const childFiles = childProduct ? await getProductFiles(childProduct.id) : [];
            const childDocuments = childProduct ? await getProductDocuments(childProduct.id) : [];

            const childDocumentFiles = childDocuments.map(doc => ({
                id: doc.id,
                document_id: doc.document_id,
                title: doc.document?.title || 'Document',
                description: doc.document?.description || '',
                file_url: doc.pdf_url || `/documents/${doc.document?.handle}`,
                storage_path: doc.pdf_storage_path || '',
                file_size_bytes: 0,
                mime_type: 'application/pdf',
                position: doc.position,
                price_cents: doc.price_cents,
                source_product_title: childProduct?.title || 'Unknown Product',
                is_document: true,
                has_pdf: !!doc.pdf_url,
              }));

            return [
              ...childFiles.map(file => ({
                ...file,
                source_product_title: childProduct?.title || 'Unknown Product',
                is_document: false,
              })),
              ...childDocumentFiles,
            ];
          })
        );

        // Flatten and combine all files and documents
        const allFiles = [
          ...mainProductFiles.map(file => ({
            ...file,
            source_product_title: product?.title || 'Unknown Product',
            is_document: false,
          })),
          ...mainProductDocumentFiles,
          ...embeddedFilesAndDocs.flat(),
        ];

        return {
          ...item,
          product,
          files: allFiles,
        };
      })
    );

    return {
      ...sale,
      items: itemsWithDetails,
    };
  })
);
---

<Layout title="My Downloads - Game Loopers">
  <div class="page">
    <div class="page__container">
      <div class="page-header--with-action">
        <PageHeader
          title="Purchases"
          description="Browse your purchases and download your digital products."
        />
      </div>

      {purchasesWithDetails.length > 0 ? (
        <div class="purchases-list">
          {purchasesWithDetails.map((purchase) => (
            <Card>
              <CardHeader>
                <div class="purchase-header">
                  <div class="purchase-header__info">
                    <CardTitle>
                      Order from {new Date(purchase.created_at).toLocaleDateString()}
                    </CardTitle>
                    <p class="purchase-header__id">Order ID: {purchase.id}</p>
                  </div>
                  <div class="purchase-header__amount">
                    {purchase.currency.toUpperCase()} {(purchase.price_cents / 100).toFixed(2)}
                  </div>
                </div>
              </CardHeader>
              <CardContent>
                <div class="purchase-items">
                  {purchase.items.map((item) => (
                    <div class="purchase-item">
                      <div class="purchase-item__header">
                        <h3 class="purchase-item__product">
                          {item.product?.title}
                        </h3>
                        {item.product?.description && (
                          <p class="purchase-item__description">
                            {item.product.description}
                          </p>
                        )}
                      </div>

                      {item.files && item.files.length > 0 ? (
                        <div class="purchase-item__assets">
                          <h4 class="purchase-item__assets-title">Available Downloads</h4>
                          <div class="asset-download__files">
                            {item.files.map((file) => (
                              <div class="file-download">
                                <div class="file-download__info">
                                  <div class="file-download__name-row">
                                    <span class="file-download__name">{file.title}</span>
                                    {file.is_document && (
                                      <span class="file-download__badge">
                                        {file.has_pdf ? 'PDF' : 'DOCUMENT'}
                                      </span>
                                    )}
                                  </div>
                                  {file.source_product_title && file.source_product_title !== item.product?.title && (
                                    <span class="file-download__source">
                                      From: {file.source_product_title}
                                    </span>
                                  )}
                                  {file.description && (
                                    <span class="file-download__description">{file.description}</span>
                                  )}
                                  {!file.is_document && file.file_size_bytes > 0 && (
                                    <span class="file-download__size">
                                      {(file.file_size_bytes / 1024 / 1024).toFixed(2)} MB
                                    </span>
                                  )}
                                </div>
                                {file.is_document ? (
                                  file.has_pdf ? (
                                    <a
                                      href={file.file_url}
                                      download
                                      target="_blank"
                                      rel="noopener noreferrer"
                                      class="file-download__button"
                                    >
                                      <Button variant="outline" size="sm">
                                        <span slot="text">Download PDF</span>
                                      </Button>
                                    </a>
                                  ) : (
                                    <a
                                      href={file.file_url}
                                      target="_blank"
                                      rel="noopener noreferrer"
                                      class="file-download__button"
                                    >
                                      <Button variant="outline" size="sm">
                                        <span slot="text">View Document</span>
                                      </Button>
                                    </a>
                                  )
                                ) : (
                                  <form method="POST" action="/api/download">
                                    <input type="hidden" name="file_id" value={file.id} />
                                    <input type="hidden" name="product_id" value={item.product_id} />
                                    <Button type="submit" variant="outline" size="sm">
                                      <span slot="text">Download</span>
                                    </Button>
                                  </form>
                                )}
                              </div>
                            ))}
                          </div>
                        </div>
                      ) : (
                        <p class="purchase-item__no-assets">
                          No digital downloads available for this item
                        </p>
                      )}
                    </div>
                  ))}
                </div>
              </CardContent>
            </Card>
          ))}
        </div>
      ) : (
        <Card>
          <CardContent>
            <EmptyState
              icon="purchases"
              title="No purchases yet"
              description="When you purchase products, your digital downloads will appear here."
              actionText="Browse Products"
              actionHref="/products"
            />
          </CardContent>
        </Card>
      )}
    </div>
  </div>
</Layout>

<style>
.purchases-list {
  display: flex;
  flex-direction: column;
  gap: var(--gap-2xl);
}

.purchase-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: var(--gap-lg);
}

.purchase-header__info {
  flex: 1;
}

.purchase-header__id {
  margin: var(--spacing-xs) 0 0 0;
  font-size: var(--text-sm);
  color: var(--muted-foreground);
  font-family: monospace;
}

.purchase-header__amount {
  font-size: var(--text-xl);
  font-weight: var(--font-weight-bold);
  color: var(--foreground);
}

.purchase-items {
  display: flex;
  flex-direction: column;
  gap: var(--gap-2xl);
}

.purchase-item {
  padding: var(--spacing-3xl) 0;
  border-bottom: var(--border-width-default) solid var(--border);
}

.purchase-item:last-child {
  border-bottom: none;
}

.purchase-item__header {
  margin-bottom: var(--spacing-2xl);
}

.purchase-item__product {
  margin: 0 0 var(--spacing-xs) 0;
  font-size: var(--text-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--foreground);
}

.purchase-item__description {
  margin: 0;
  font-size: var(--text-sm);
  color: var(--muted-foreground);
  line-height: var(--leading-relaxed);
}

.purchase-item__assets-title {
  margin: 0 0 var(--spacing-lg) 0;
  font-size: var(--text-base);
  font-weight: var(--font-weight-semibold);
  color: var(--foreground);
}

.purchase-item__assets {
  display: flex;
  flex-direction: column;
  gap: var(--gap-lg);
}

.purchase-item__no-assets {
  margin: 0;
  font-size: var(--text-sm);
  color: var(--muted-foreground);
  font-style: italic;
}

.asset-download__files {
  display: flex;
  flex-direction: column;
  gap: var(--gap-sm);
}

.file-download {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-lg);
  border-top: var(--border-width-default) solid var(--border);
}

.file-download:first-child {
  border-top: none;
}

.file-download__info {
  display: flex;
  flex-direction: column;
  gap: var(--gap-xs);
  flex: 1;
}

.file-download__name-row {
  display: flex;
  align-items: center;
  gap: var(--gap-sm);
}

.file-download__name {
  font-size: var(--text-sm);
  font-weight: var(--font-weight-medium);
  color: var(--foreground);
}

.file-download__badge {
  display: inline-flex;
  align-items: center;
  padding: var(--spacing-xxs) var(--spacing-sm);
  background-color: var(--primary);
  color: var(--primary-foreground);
  font-size: var(--text-xs);
  font-weight: var(--font-weight-semibold);
  border-radius: var(--radius-sm);
  text-transform: uppercase;
  letter-spacing: var(--tracking-wide);
}

.file-download__source {
  font-size: var(--text-xs);
  color: var(--primary);
  font-weight: var(--font-weight-medium);
  font-style: italic;
}

.file-download__description {
  font-size: var(--text-xs);
  color: var(--muted-foreground);
  line-height: var(--leading-relaxed);
}

.file-download__size {
  font-size: var(--text-xs);
  color: var(--muted-foreground);
}

.file-download form {
  margin: 0;
}

.file-download__button {
  text-decoration: none;
}

.downloads-empty {
  text-align: center;
  padding: var(--spacing-5xl) var(--spacing-3xl);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--gap-2xl);
}

.downloads-empty__text {
  margin: 0;
  font-size: var(--text-lg);
  font-weight: var(--font-weight-medium);
  color: var(--foreground);
}

.downloads-empty__description {
  margin: 0;
  font-size: var(--text-base);
  color: var(--muted-foreground);
}

.downloads-empty a {
  text-decoration: none;
}
</style>
