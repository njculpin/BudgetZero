---
import Layout from "@/layouts/Layout.astro";
import { setSession } from "@/lib/auth";
import { getUserSales, getSaleItems } from "@/lib/data-access/sales";
import { getProductById, getProductFiles, getProductComponents, getProductDocuments } from "@/lib/data-access/products";
import PageHeader from "@/components/PageHeader.astro";
import { PurchasesList } from "@/components/purchases";

const { url } = Astro;
const searchParams = url.searchParams;

// Get pagination and filter params from URL
const currentPage = parseInt(searchParams.get("page") || "1", 10);
const searchQuery = searchParams.get("search") || "";
const filterQuery = searchParams.get("filter") || "all";

let currentUser = null;
const accessToken = Astro.cookies.get("sb-access-token");
const refreshToken = Astro.cookies.get("sb-refresh-token");

if (accessToken && refreshToken) {
  try {
    const session = await setSession({
      refresh_token: refreshToken.value,
      access_token: accessToken.value,
    });
    if (!session.error && session.data.user) {
      currentUser = session.data.user;
    }
  } catch (error) {
    // Continue as guest
  }
}

if (!currentUser) {
  return Astro.redirect("/sign-in");
}

// Get user's purchases
const sales = await getUserSales(currentUser.id);
const completedSales = sales.filter(sale => sale.status === 'paid');

// Fetch details for each purchase
const purchasesWithDetails = await Promise.all(
  completedSales.map(async (sale) => {
    const saleItems = await getSaleItems(sale.id);

    const itemsWithDetails = await Promise.all(
      saleItems.map(async (item) => {
        const product = await getProductById(item.product_id);

        // Get files from the main product
        const mainProductFiles = product ? await getProductFiles(product.id) : [];

        // Get documents from the main product (all will have PDFs generated on purchase)
        const mainProductDocuments = product ? await getProductDocuments(product.id) : [];
        const mainProductDocumentFiles = mainProductDocuments
          .filter(doc => doc.pdf_url) // Only include documents with PDFs
          .map(doc => ({
            id: doc.id,
            document_id: doc.document_id,
            title: doc.document?.title || 'Document',
            description: doc.document?.description || '',
            file_url: doc.pdf_url!,
            storage_path: doc.pdf_storage_path || '',
            file_size_bytes: 0, // PDFs don't have size stored
            mime_type: 'application/pdf',
            position: doc.position,
            price_cents: doc.price_cents,
            source_product_title: product?.title || 'Unknown Product',
            is_document: true,
          }));

        // Get embedded products and their files + documents
        const embeddedProducts = product ? await getProductComponents(product.id) : [];
        const embeddedFilesAndDocs = await Promise.all(
          embeddedProducts.map(async (component) => {
            const childProduct = await getProductById(component.child_product_id);
            const childFiles = childProduct ? await getProductFiles(childProduct.id) : [];
            const childDocuments = childProduct ? await getProductDocuments(childProduct.id) : [];

            const childDocumentFiles = childDocuments
              .filter(doc => doc.pdf_url) // Only include documents with PDFs
              .map(doc => ({
                id: doc.id,
                document_id: doc.document_id,
                title: doc.document?.title || 'Document',
                description: doc.document?.description || '',
                file_url: doc.pdf_url!,
                storage_path: doc.pdf_storage_path || '',
                file_size_bytes: 0,
                mime_type: 'application/pdf',
                position: doc.position,
                price_cents: doc.price_cents,
                source_product_title: childProduct?.title || 'Unknown Product',
                is_document: true,
              }));

            return [
              ...childFiles.map(file => ({
                ...file,
                source_product_title: childProduct?.title || 'Unknown Product',
                is_document: false,
              })),
              ...childDocumentFiles,
            ];
          })
        );

        // Flatten and combine all files and documents
        const allFiles = [
          ...mainProductFiles.map(file => ({
            ...file,
            source_product_title: product?.title || 'Unknown Product',
            is_document: false,
          })),
          ...mainProductDocumentFiles,
          ...embeddedFilesAndDocs.flat(),
        ];

        return {
          ...item,
          product,
          files: allFiles,
        };
      })
    );

    return {
      ...sale,
      items: itemsWithDetails,
    };
  })
);
---

<Layout title="My Downloads - Game Loopers">
  <div class="page">
    <div class="page__container">
      <div class="page-header--with-action">
        <PageHeader
          title="Purchases"
          description="Browse your purchases and download your digital products."
        />
      </div>

      <PurchasesList
        client:load
        initialPurchases={purchasesWithDetails}
        initialPage={currentPage}
        initialSearch={searchQuery}
        initialFilter={filterQuery}
        totalCount={purchasesWithDetails.length}
      />
    </div>
  </div>
</Layout>
