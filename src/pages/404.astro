---
import Layout from "@/layouts/Layout.astro";
import Button from "@/components/Button.astro";
import { findSimilarRoutes, detectPatternMatch } from "@/lib/utils/fuzzy-route-match";

const requestedPath = Astro.url.pathname;

// Find similar routes using fuzzy matching
const similarRoutes = findSimilarRoutes(requestedPath, 5, 3);

// Check if this looks like a dynamic route pattern
const patternMatch = detectPatternMatch(requestedPath);
---

<Layout title="Page Not Found - Game Loopers">
  <main class="not-found">
    <div class="not-found__container">
      <div class="not-found__content">
        <h1 class="not-found__title">404 - Page Not Found</h1>

        <div class="not-found__context">
          <p class="not-found__message">
            The page you're looking for doesn't exist or has been moved.
          </p>

          {requestedPath && (
            <div class="not-found__details">
              <p class="not-found__path">
                <strong>Requested path:</strong> <code>{requestedPath}</code>
              </p>
            </div>
          )}
        </div>

        {(similarRoutes.length > 0 || patternMatch) && (
          <section class="not-found__suggestions not-found__suggestions--smart">
            <h2 class="not-found__suggestions-title">Did you mean?</h2>
            <p class="not-found__smart-subtitle">We found similar routes that might be what you're looking for:</p>

            <div class="not-found__smart-matches">
              {patternMatch && (
                <div class="not-found__pattern-match">
                  <div class="not-found__match-header">
                    <span class="not-found__match-badge not-found__match-badge--pattern">Pattern Match</span>
                    <span class="not-found__match-similarity">Exact Segment Match</span>
                  </div>
                  <a href={patternMatch} class="not-found__match-link">
                    <strong class="not-found__match-path">{patternMatch}</strong>
                    <span class="not-found__match-description">
                      Looks like you're trying to access a specific item. Try the listing page instead.
                    </span>
                  </a>
                </div>
              )}

              {similarRoutes.map((route) => (
                <div class="not-found__fuzzy-match">
                  <div class="not-found__match-header">
                    <span class="not-found__match-badge not-found__match-badge--fuzzy">Fuzzy Match</span>
                    <span class="not-found__match-similarity">{Math.round(route.similarity)}% similar</span>
                  </div>
                  <a href={route.path} class="not-found__match-link">
                    <strong class="not-found__match-path">{route.path}</strong>
                    <span class="not-found__match-label">{route.label}</span>
                    <span class="not-found__match-description">{route.description}</span>
                  </a>
                </div>
              ))}
            </div>
          </section>
        )}

        <section class="not-found__suggestions">
          <h2 class="not-found__suggestions-title">Or explore these sections</h2>

          <div class="not-found__links">
            <a href="/">
              <Button variant="primary" size="md">
                <span slot="text">Go to Homepage</span>
              </Button>
            </a>

            <a href="/products">
              <Button variant="outline" size="md">
                <span slot="text">Browse Products</span>
              </Button>
            </a>

            <a href="/assets">
              <Button variant="outline" size="md">
                <span slot="text">Browse Assets</span>
              </Button>
            </a>

            <a href="/about">
              <Button variant="ghost" size="md">
                <span slot="text">About Us</span>
              </Button>
            </a>
          </div>
        </section>

        <section class="not-found__context-info">
          <h2 class="not-found__context-title">For AI Assistants & Web Crawlers</h2>
          <div class="not-found__metadata">
            <p><strong>Status:</strong> HTTP 404 - Resource Not Found</p>
            <p><strong>Site:</strong> Game Loopers - Tabletop Game Creator Platform</p>
            <p><strong>Fuzzy Search:</strong> This page uses Levenshtein distance algorithm to suggest similar routes (up to 5 character edits). Check the "Did you mean?" section above for intelligent suggestions.</p>
            <p><strong>Available Sections:</strong></p>
            <ul class="not-found__sitemap">
              <li><strong>/products</strong> - Browse game products and digital downloads</li>
              <li><strong>/documents</strong> - Collaborative document editor (authenticated users)</li>
              <li><strong>/users</strong> - Creator directory</li>
              <li><strong>/feed</strong> - Activity feed</li>
              <li><strong>/cart</strong> - Shopping cart</li>
              <li><strong>/purchases</strong> - Purchase history (authenticated)</li>
              <li><strong>/about</strong> - About Game Loopers</li>
              <li><strong>/sign-in</strong> - User authentication</li>
            </ul>
            {similarRoutes.length > 0 && (
              <p><strong>Smart Suggestions:</strong> Found {similarRoutes.length} similar route{similarRoutes.length > 1 ? 's' : ''} based on fuzzy matching.</p>
            )}
          </div>
        </section>
      </div>
    </div>
  </main>
</Layout>

<style>
/* ===== Container ===== */
.not-found {
  min-height: calc(100vh - 200px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-4xl) var(--spacing-2xl);
  background-color: var(--background);
}

.not-found__container {
  width: 100%;
}

.not-found__content {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-4xl);
}

/* ===== Title & Message ===== */
.not-found__title {
  font-size: var(--text-5xl);
  font-weight: var(--font-weight-bold);
  color: var(--foreground);
  margin: 0;
  text-align: center;
}

.not-found__context {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-lg);
  text-align: center;
}

.not-found__message {
  font-size: var(--text-lg);
  color: var(--muted-foreground);
  margin: 0;
}

.not-found__details {
  padding: var(--spacing-xl);
  background-color: var(--muted);
  border-radius: var(--radius-md);
  border: 1px solid var(--border);
}

.not-found__path {
  margin: 0;
  font-size: var(--text-sm);
  color: var(--foreground);
}

.not-found__path code {
  padding: var(--spacing-xs) var(--spacing-sm);
  background-color: var(--background);
  border-radius: var(--radius-sm);
  font-family: monospace;
  font-size: var(--text-sm);
  color: var(--destructive);
  border: 1px solid var(--border);
}

/* ===== Suggestions ===== */
.not-found__suggestions {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-2xl);
  padding: var(--spacing-3xl);
  background-color: var(--card);
  border-radius: var(--radius-lg);
  border: 1px solid var(--border);
}

.not-found__suggestions--smart {
  background: linear-gradient(135deg, oklch(from var(--accent) l c h / 0.05) 0%, var(--card) 100%);
  border: 2px solid var(--accent);
}

.not-found__suggestions-title {
  font-size: var(--text-2xl);
  font-weight: var(--font-weight-semibold);
  color: var(--foreground);
  margin: 0;
  text-align: center;
}

.not-found__smart-subtitle {
  margin: 0;
  font-size: var(--text-sm);
  color: var(--muted-foreground);
  text-align: center;
}

.not-found__links {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-lg);
  justify-content: center;
  align-items: center;
}

.not-found__links a {
  text-decoration: none;
}

/* ===== Smart Matches (Fuzzy Search) ===== */
.not-found__smart-matches {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-lg);
}

.not-found__pattern-match,
.not-found__fuzzy-match {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
  padding: var(--spacing-xl);
  background-color: var(--background);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  transition: all var(--duration-fast) var(--ease-in-out);
}

.not-found__pattern-match:hover,
.not-found__fuzzy-match:hover {
  border-color: var(--accent);
  box-shadow: var(--shadow-md);
  transform: translateY(-1px);
}

.not-found__match-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--spacing-md);
  margin-bottom: var(--spacing-xs);
}

.not-found__match-badge {
  display: inline-flex;
  padding: var(--spacing-xxs) var(--spacing-md);
  font-size: var(--text-xs);
  font-weight: var(--font-weight-semibold);
  border-radius: var(--radius-full);
  text-transform: uppercase;
  letter-spacing: var(--tracking-wide);
}

.not-found__match-badge--pattern {
  background-color: oklch(from var(--primary) l c h / 0.15);
  color: var(--primary);
  border: 1px solid var(--primary);
}

.not-found__match-badge--fuzzy {
  background-color: oklch(from var(--accent) l c h / 0.15);
  color: var(--accent);
  border: 1px solid var(--accent);
}

.not-found__match-similarity {
  font-size: var(--text-xs);
  font-weight: var(--font-weight-medium);
  color: var(--muted-foreground);
}

.not-found__match-link {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-xs);
  text-decoration: none;
  color: inherit;
}

.not-found__match-link:hover .not-found__match-path {
  color: var(--accent);
}

.not-found__match-path {
  font-size: var(--text-lg);
  font-weight: var(--font-weight-bold);
  font-family: monospace;
  color: var(--foreground);
  transition: color var(--duration-fast) var(--ease-in-out);
}

.not-found__match-label {
  font-size: var(--text-sm);
  font-weight: var(--font-weight-semibold);
  color: var(--foreground);
}

.not-found__match-description {
  font-size: var(--text-sm);
  color: var(--muted-foreground);
  line-height: var(--leading-relaxed);
}

/* ===== Context Info (for LLMs) ===== */
.not-found__context-info {
  padding: var(--spacing-3xl);
  background-color: var(--muted);
  border-radius: var(--radius-lg);
  border: 1px solid var(--border);
}

.not-found__context-title {
  font-size: var(--text-xl);
  font-weight: var(--font-weight-semibold);
  color: var(--muted-foreground);
  margin: 0 0 var(--spacing-xl) 0;
}

.not-found__metadata {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
}

.not-found__metadata p {
  margin: 0;
  font-size: var(--text-sm);
  color: var(--muted-foreground);
}

.not-found__sitemap {
  margin: var(--spacing-md) 0 0 0;
  padding-left: var(--spacing-2xl);
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
}

.not-found__sitemap li {
  font-size: var(--text-sm);
  color: var(--muted-foreground);
  line-height: var(--leading-relaxed);
}

.not-found__sitemap li strong {
  color: var(--foreground);
  font-family: monospace;
}

/* ===== Responsive ===== */
@media (max-width: 768px) {
  .not-found__title {
    font-size: var(--text-3xl);
  }

  .not-found__message {
    font-size: var(--text-base);
  }

  .not-found__links {
    flex-direction: column;
    width: 100%;
  }

  .not-found__links a {
    width: 100%;
  }

  .not-found__suggestions,
  .not-found__context-info {
    padding: var(--spacing-2xl);
  }

  .not-found__match-header {
    flex-direction: column;
    align-items: flex-start;
  }

  .not-found__match-path {
    font-size: var(--text-base);
  }
}
</style>
