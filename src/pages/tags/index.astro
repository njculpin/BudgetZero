---
import Layout from "@/layouts/Layout.astro";
import Card from "@/components/Card.astro";
import CardContent from "@/components/CardContent.astro";
import { getAllTags } from "@/lib/data-access/tags";

const tags = await getAllTags();
---

<Layout title="Tags - Game Loopers">
  <div class="page">
    <div class="page__container">
      <div class="tags-page">
        <!-- Header -->
        <div class="tags-header">
          <h1 class="tags-header__title">Browse Tags</h1>
          <p class="tags-header__description">
            Explore products and assets by topic
          </p>
        </div>

        <!-- Tags Grid -->
        {tags.length > 0 ? (
          <div class="tags-grid">
            {tags.map((tag) => (
              <a href={`/tags/${encodeURIComponent(tag.value)}`} class="tag-card">
                <div class="tag-card__content">
                  <div class="tag-card__header">
                    <span class="tag-card__icon">#</span>
                    <h3 class="tag-card__name">{tag.value}</h3>
                  </div>
                  <div class="tag-card__stats">
                    <div class="tag-card__stat">
                      <span class="tag-card__stat-value">{tag.count}</span>
                      <span class="tag-card__stat-label">total items</span>
                    </div>
                    <div class="tag-card__breakdown">
                      {tag.productCount > 0 && (
                        <span class="tag-card__breakdown-item">
                          {tag.productCount} product{tag.productCount !== 1 ? 's' : ''}
                        </span>
                      )}
                      {tag.assetCount > 0 && (
                        <span class="tag-card__breakdown-item">
                          {tag.assetCount} asset{tag.assetCount !== 1 ? 's' : ''}
                        </span>
                      )}
                    </div>
                  </div>
                </div>
              </a>
            ))}
          </div>
        ) : (
          <Card>
            <CardContent>
              <div class="tags-empty">
                <svg class="tags-empty__icon" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
                  <line x1="7" y1="7" x2="7.01" y2="7"></line>
                </svg>
                <p class="tags-empty__text">No tags found</p>
                <p class="tags-empty__description">Tags will appear here as products and assets are created</p>
              </div>
            </CardContent>
          </Card>
        )}
      </div>
    </div>
  </div>
</Layout>

<style>
  /* ===== Tags Page ===== */
  .tags-page {
    display: flex;
    flex-direction: column;
    gap: var(--gap-4xl);
  }

  /* ===== Tags Header ===== */
  .tags-header {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
  }

  .tags-header__title {
    margin: 0;
    font-size: var(--text-4xl);
    font-weight: var(--font-weight-bold);
    color: var(--foreground);
  }

  .tags-header__description {
    margin: 0;
    font-size: var(--text-lg);
    color: var(--muted-foreground);
  }

  /* ===== Tags Grid ===== */
  .tags-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--gap-2xl);
  }

  @media (min-width: 768px) {
    .tags-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .tags-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* ===== Tag Card ===== */
  .tag-card {
    display: flex;
    flex-direction: column;
    background-color: var(--card);
    border: var(--border-width-default) solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--spacing-3xl);
    text-decoration: none;
    transition: all var(--duration-normal) var(--ease-in-out);
  }

  .tag-card:hover {
    border-color: var(--primary);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .tag-card__content {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xl);
  }

  .tag-card__header {
    display: flex;
    align-items: center;
    gap: var(--gap-md);
  }

  .tag-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    background-color: var(--primary);
    color: var(--primary-foreground);
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-bold);
  }

  .tag-card__name {
    margin: 0;
    font-size: var(--text-xl);
    font-weight: var(--font-weight-semibold);
    color: var(--foreground);
  }

  .tag-card__stats {
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm);
  }

  .tag-card__stat {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs);
  }

  .tag-card__stat-value {
    font-size: var(--text-3xl);
    font-weight: var(--font-weight-bold);
    color: var(--foreground);
  }

  .tag-card__stat-label {
    font-size: var(--text-sm);
    color: var(--muted-foreground);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .tag-card__breakdown {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-md);
  }

  .tag-card__breakdown-item {
    font-size: var(--text-sm);
    color: var(--muted-foreground);
  }

  /* ===== Empty State ===== */
  .tags-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-5xl) var(--spacing-4xl);
    text-align: center;
    gap: var(--gap-lg);
  }

  .tags-empty__icon {
    color: var(--muted-foreground);
    opacity: 0.5;
  }

  .tags-empty__text {
    margin: 0;
    font-size: var(--text-xl);
    font-weight: var(--font-weight-semibold);
    color: var(--foreground);
  }

  .tags-empty__description {
    margin: 0;
    font-size: var(--text-base);
    color: var(--muted-foreground);
  }
</style>