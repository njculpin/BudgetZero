---
// This page is for the public user profile which will not show a header.
import '@fontsource/inter';
import '@/styles/global.css'

interface Props {
  title?: string;
  showCTA?: boolean;
}

const { title = "Game Loopers", showCTA = false } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
		{showCTA && (
			<footer class="profile-footer">
				<p class="profile-footer__text">
					Powered by <a href="/" class="profile-footer__link">Game Loopers</a> - <a href="/sign-up" class="profile-footer__link">Make yours now</a>
				</p>
			</footer>
		)}
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	/* ===== Profile Footer ===== */
	.profile-footer {
		border-top: 1px solid var(--color-border, #e5e7eb);
		background-color: var(--color-surface, #fff);
		padding: 2rem 1rem;
		text-align: center;
	}

	.profile-footer__text {
		margin: 0;
		font-size: 0.875rem;
		color: var(--muted-foreground);
	}

	.profile-footer__link {
		color: var(--color-primary, #0070f3);
		text-decoration: none;
		font-weight: 500;
	}

	.profile-footer__link:hover {
		text-decoration: underline;
	}
</style>
