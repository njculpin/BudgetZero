# `npm audit fix --force` "fixes" the @vercel/routing-utils -> path-to-regexp
# advisory by DOWNGRADING @astrojs/vercel from 11.x to 8.0.4. That version is
# older, requires astro@^5 (this project is on 7), and reintroduces
# GHSA-mr6q-rp88-fx84 — an unauthenticated x-astro-path override that bypasses
# the route protection in src/middleware.ts.
#
# There is no adapter release that fixes the advisory. Do not run
# `npm audit fix --force` here. Re-check after each @astrojs/vercel release.
#
# engine-strict is off deliberately: package.json pins node 22.x to match the
# Vercel runtime, but a newer local Node only warns rather than blocking install.
engine-strict=false
