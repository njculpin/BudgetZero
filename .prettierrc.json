{
  "printWidth": 90,
  "singleQuote": true,
  "trailingComma": "es5",
  "plugins": ["prettier-plugin-astro"],
  "overrides": [
    {
      "files": "*.astro",
      "options": { "parser": "astro" }
    },
    {
      "files": "*.md",
      "options": { "printWidth": 80, "proseWrap": "preserve" }
    }
  ]
}
