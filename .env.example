# Stripe Configuration
# Get your API keys from https://dashboard.stripe.com/test/apikeys
# Secret key (starts with sk_test_ for test mode)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
# Publishable key (starts with pk_test_ for test mode)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
# Webhook signing secret (get from Stripe CLI or webhook dashboard)
# Use Stripe CLI for local development: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here