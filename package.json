{
  "name": "gameloopers",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:clean": "bash scripts/clean-start.sh",
    "dev:astro": "npm run dev -w @gameloopers/web",
    "build": "npm run build -w @gameloopers/web",
    "preview": "npm run preview -w @gameloopers/web",
    "astro": "npm run astro -w @gameloopers/web",
    "check": "npm run check -w @gameloopers/core && npm run check -w @gameloopers/api && npm run check -w @gameloopers/web",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --project unit --coverage",
    "test:ui": "vitest --ui",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset",
    "email": "start http://127.0.0.1:55324"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@types/node": "^24.9.1",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "baseline-browser-mapping": "^2.9.11",
    "dotenv": "^17.2.3",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.12.0",
    "jsdom": "^27.0.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "1.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "workspaces": [
    "packages/*"
  ]
}
